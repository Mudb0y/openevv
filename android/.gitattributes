# Line endings, kept the same everywhere on purpose.
#
# Two things here stop working silently if they get CRLF on a Windows
# checkout. A shell script under native/ is misread by bash a line at a time.
# And a C source rewritten with CRLF grows stray carriage returns in the middle
# of lines when anything edits it.
* text=auto eol=lf

# The one that genuinely wants CRLF.
*.bat text eol=crlf

# Left alone.
*.jar binary
*.png binary
*.dic binary
