	<!-- Background and stability -->
	<string name="stability_label">Background and stability</string>
	<string name="stability_intro">If speech cuts out or the engine seems to crash, the phone may be stopping OpenEVV in the background to save battery. Turn battery optimisation and app hibernation off for OpenEVV, allow it to auto start, and lock it in recent apps.</string>
	<string name="stability_battery">Battery optimisation</string>
	<string name="stability_hibernation">App hibernation</string>
	<string name="stability_autostart">Allow auto start</string>
	<string name="stability_autostart_missing">This phone has no auto start screen OpenEVV knows of. App info is open instead: look for auto start, background activity or battery there.</string>
	<string name="stability_pinning">Lock in recent apps</string>
	<string name="stability_pinning_help">Some phones close apps when recent apps are cleared. To keep OpenEVV open: open OpenEVV, then open recent apps. Long press OpenEVV\'s card, or open its menu, and choose Lock, Pin or Keep open. The name differs from phone to phone, and stock Android has no such option.</string>
	<string name="stability_exits_label">Why OpenEVV stopped</string>
	<string name="stability_exits_since">Since %1$s:</string>
	<string name="stability_exits_killed">Closed by the phone while in use: %1$d</string>
	<string name="stability_exits_crashed">Crashed: %1$d</string>
	<string name="stability_exits_unresponsive">Stopped responding: %1$d</string>
	<string name="stability_exits_user">Stopped by you, with Force stop or clearing it: %1$d</string>
	<string name="stability_exits_idle">Closed while idle to free memory, which is normal: %1$d</string>
	<string name="stability_exits_none">Android has no record of OpenEVV stopping.</string>
	<string name="stability_exits_unavailable">Android 11 and later can say why OpenEVV stopped. This phone cannot.</string>
	<string name="stability_exits_advice_killed">The phone has been closing OpenEVV while your screen reader was using it, which is when speech cuts out. Turn on auto start and lock OpenEVV in recent apps.</string>
	<string name="stability_exits_advice_crashed">OpenEVV itself has crashed or stopped responding. Please report it, with what you were doing at the time.</string>

