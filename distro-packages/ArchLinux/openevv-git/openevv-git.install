# shellcheck shell=bash

configuration_notice() {
    printf '%s\n' \
        'OpenEVV and its Speech Dispatcher module are installed.' \
        'Enable OpenEVV without hiding other installed modules with:' \
        'openevv-speechd-enable' \
        'sudo openevv-speechd-enable --system' \
        'The helper does not restart Speech Dispatcher.' \
        'Warning: restarting Speech Dispatcher temporarily stops speech.' \
        'Continue only from a session you can recover without hearing.'
}

post_install() {
    configuration_notice
}

post_upgrade() {
    configuration_notice
}
