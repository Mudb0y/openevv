  set h_rcx to sym eti_s_13c11e
  go to p333bc
  place p333ac
  place t333ac_8 on 8
  set h_rcx to sym eti_s_13c0de
  place p333bc
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p333c9
  place t333c9_3 on 3
  call savescptr 3 addr c100
  place p333db
  place t333db_9 on 9
  put cell c100 value into arg 2 at 4
  match
end
