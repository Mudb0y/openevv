# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's German module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3ac10
  place p3ac4f
  place p3ac82
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3ad20
  end
  place p3acd6
  call test_string_s 1 1 sym eti_s_13c108
  if answer is not 0
    go to p3ad20
  end
  place p3acee
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3ad20
  end
  place p3ad04
  call test_string_s 1 1 sym eti_s_13c0d9
  if answer is 0
    match
  end
  place p3ad20
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3ad80
  end
  place p3ad36
  call test_string_s 1 1 sym eti_s_13c121
  if answer is not 0
    go to p3ad80
  end
  place p3ad4e
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3ad80
  end
  place p3ad64
  call test_string_s 1 1 sym eti_s_13c0da
  if answer is 0
    match
  end
  place p3ad80
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p3ad96
  call test_string_s 1 1 sym eti_s_13c123
  if answer is not 0
    give up
  end
  place p3adae
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p3adc4
  call test_string_s 1 1 sym eti_s_13c122
  if answer is 0
    match
  end
  give up
end

