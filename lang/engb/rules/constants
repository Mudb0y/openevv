# Bytes a rule of British English's names by address, laid down by
# tools/rules/consts.py into delta_authored_engb.c and recorded in
# rules/symbols. They are not ASCII but one code per character in the
# alphabet the statement type declares, which is American English's
# alphabet unchanged.

# What eng_tok_lookup in ut_norm.up tests a token against and lays down, as
# in lang/enus/rules/constants: the marks after which a word is not left to
# be spelled, the three endings process_final_parenthetical already folds
# into the word, and the space, behind the byte insert_r reads as the width
# of what follows it.
bytes eng_open_paren    46            # (
bytes eng_paren_s       46 19 47      # (s)
bytes eng_paren_es      46 02 19 47   # (es)
bytes eng_paren_ed      46 02 0d 47   # (ed)
bytes eng_open_bracket  50            # [
bytes eng_open_brace    52            # {
bytes eng_number_sign   4a            # #
bytes eng_dollar        55            # $
bytes eng_asterisk      4e            # *
bytes eng_tilde         4d            # ~
bytes eng_space         c7 48
