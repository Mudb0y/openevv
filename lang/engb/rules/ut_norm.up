# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's British English module. 6.1 reads a
# sentence mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3b310
  place p3b34f
  place p3b382
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b420
  end
  place p3b3d6
  call test_string_s 1 1 sym eti_s_1c2105
  if answer is not 0
    go to p3b420
  end
  place p3b3ee
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b420
  end
  place p3b404
  call test_string_s 1 1 sym eti_s_1c20d9
  if answer is 0
    go to p3b50d
  end
  place p3b420
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b480
  end
  place p3b436
  call test_string_s 1 1 sym eti_s_1c211e
  if answer is not 0
    go to p3b480
  end
  place p3b44e
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b480
  end
  place p3b464
  call test_string_s 1 1 sym eti_s_1c20da
  if answer is 0
    go to p3b50d
  end
  place p3b480
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b4dc
  end
  place p3b496
  call test_string_s 1 1 sym eti_s_1c2120
  if answer is not 0
    go to p3b4dc
  end
  place p3b4ae
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b4dc
  end
  place p3b4c4
  call test_string_s 1 1 sym eti_s_1c211f
  if answer is 0
    go to p3b50d
  end
  place p3b4dc
  give up
  place p3b50d
  match
end

