# Names shortened out of words, said by the letters they are written with
# rather than by the words they stand for, so that what is heard can be
# typed: kubectl as kube C T L and not cube control, which a listener new to
# it would spell with the whole word. A name its maker says otherwise keeps
# the maker's reading, as nginx, btrfs and Qt do.
kubectl	kube C T L
kubeadm	kube ay D M
sysctl	sis C T L
bluetoothctl	bluetooth C T L
hyprctl	hyper C T L
playerctl	player C T L
brightnessctl	brightness C T L
powerprofilesctl	power profiles C T L
dmesg	D M E S G
swaymsg	sway M S G
nixpkgs	nix P K G S
udevadm	yue dev ay D M
efibootmgr	E F igh boot M G R
pkexec	P K exec
nmtui	N M T U I
mkdir	M K dir
lsusb	L S U S B
lspci	L S P C I
lscpu	L S C P U
lsof	L S O F
findmnt	find M N T
btop	B top
nvtop	N V top
ffplay	F F play
yq	Y Q
runc	run C
stdin	S T D in
stdout	S T D out
stderr	S T D err
stdlib	S T D lib
nullptr	null P T R
strcpy	S T R C P Y
strncpy	S T R N C P Y
strcat	S T R cat
strlen	S T R len
memcpy	mem C P Y

# Abbreviations from chat, said by their letters
IIRC	igh igh ar cea
Iirc	igh igh ar cea
iirc	igh igh ar cea
FWIW	eff doubleyou igh doubleyou
Fwiw	eff doubleyou igh doubleyou
fwiw	eff doubleyou igh doubleyou
AFAIK	ay eff ay igh keigh
Afaik	ay eff ay igh keigh
afaik	ay eff ay igh keigh
