# 6.1's phone numbers, lifted by tools/rules/lift64.py out of Apple's English
# module. 4.3's convert_eng_phone_number asked is_US_phone_number and read the
# digits itself; 6.1's hands a North American number to convert_NA_phone_number,
# which reads a nought as oh and leaves the mark after the number in place, so
# a phone number at the end of a sentence ends it.

rule convert_eng_phone_number takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  place p11013c
  place p110179
  place p1101ac
  call get_parm addr c100 arg 1 -6
  call get_parm addr cf0 arg 2 -6
  call fence 0 sym eti_null
  if global half 2334 is not global half 2330
    give up
  end
  place p1101f2
  call starttest_e 2
  call bspush_ca_boa 3
  call convert_NA_phone_number addr c100 addr cf0
  if answer is 0
    set unwind to 1
  end
  if answer is not 0
    set unwind to 0
  end
  backtrack
  place p110254
  place t110254_3 on 3
  call bspop_boa
  give up
  place p110287
  place t110287_2 on 2
  place t110287_4 on 4
  put cell cf0 value into arg 2 at 4
  match
end

