  put cell c148 value into arg 3 at 4
  match
end

# Not lifted: 6.1 keeps the month names in a dictionary of their own, which
# this module has not got, and finds them by its action number in a switch
# lift64.py cannot read. What it does is done here the same way. A month
# written out, capital first, is put in small letters; one of the eleven
# short forms is replaced by the month in small letters; anything else, a
# small or a capital first letter included, is not a month to this rule.

rule eng_months takes 3
  afresh
  local start bytes 8
  local end bytes 8
  local after bytes 8
  call get_parm addr start arg 1 -6
  call get_parm addr end arg 2 -6
  call push_ptr_init addr after
  call fence 0 sym eti_null
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 7 sym month_January
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 8 sym month_February
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 5 sym month_March
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 5 sym month_April
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_May
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 4 sym month_June
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 4 sym month_July
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 6 sym month_August
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 9 sym month_September
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 7 sym month_October
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 8 sym month_November
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 8 sym month_December
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Jan
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 7 sym month_january 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Feb
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 8 sym month_february 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Mar
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 5 sym month_march 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Apr
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 5 sym month_april 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Jun
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 4 sym month_june 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Jul
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 4 sym month_july 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Aug
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 6 sym month_august 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Sep
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 9 sym month_september 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 4 sym month_Sept
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 9 sym month_september 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Oct
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 7 sym month_october 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Nov
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 8 sym month_november 0
        if answer is 0
