      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 3 sym month_Jan
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        call lpta_rpta_loadp addr start addr end
        call insert_2pt_s 1 7 sym month_january 0
        if answer is 0
          match
        end
        give up
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
