  give up
place whole
  call lpta_loadp addr start
  call setscan_r 1
  if answer is not 0
    go to lower
  end
  call advance_tok
  if answer is not 0
    go to lower
  end
  call savescptr 17 addr after
place lower
  call convert_to_lowercase addr start addr after
  match
end
