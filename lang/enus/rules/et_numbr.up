  set cf0 to 65532
  call fence 0 sym eti_null
  call starttest 1
  set h_rax to answer
  call lpta_loadp addr c110
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p115017
  call testFldeq 1 3 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p11502c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p115038
  call bspush_ca_scan 2
  set h_rax to answer
  call testFldeq 1 3 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p115058
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p115083
  end
  set unwind to 0
  backtrack
  place p115083
  place t115083_2 on 2
  call savescptr 2 addr c100
  set h_rax to answer
  call end_of_word addr c100
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p1150a7
  call string_to_short addr c110 addr c100 addr cf0
  set h_rax to answer
  set h_rax to cell cf0 field
  add -32 to h_rax
  set n1150cf_0 to h_rax
  and 65535 into n1150cf_0
  if n1150cf_0 is below 65505
    give up
  end
  place p1150d5
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
end

rule copy_token takes 5
