rule convert_to_day_of_month takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  place p114914
  place p11495a
  place p11498d
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr c120 arg 3 -6
  call fence 0 sym eti_null
  call convert_to_eng_ordinal addr c110 addr c100 addr c120
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    go to p114a47
  end
  place p114a09
  call advance_tok
  if answer is not 0
    go to p114a47
  end
  place p114a15
  call advance_tok
  if answer is not 0
    go to p114a47
  end
  place p114a21
  call lpta_loadp addr c100
  call test_ptr
  if answer is 0
    go to p114aaa
  end
  place p114a47
  call convert_eng_single_digit addr c110 addr c100
  place p114a5d
  put cell c100 value into arg 2 at 4
  put cell c120 value into arg 3 at 4
  place p114a76
  match
  place p114aaa
  call convert_eng_double addr c110 addr c100
  call lpta_loadp addr c100
  call setscan_l 1
  if answer is not 0
    go to p114a5d
  end
  place p114ad5
  call test_string_s 1 3 sym eti_s_1be20b
  if answer is not 0
    go to p114a5d
  end
  place p114af2
  call rpta_loadp addr c120
  call insert_l 1 2 sym eti_s_1be20e 0
  go to p114a5d
end

rule is_valid_date takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  place p114f3c
  place p114f7f
  place p114fb2
  call get_parm addr c110 arg 1 -6
