    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
        go to whole
      end
    end
  end
  call lpta_loadp addr start
  call setscan_r 1
  if answer is 0
    call test_string_s 1 7 sym month_October
    if answer is 0
      call lpta_loadp addr end
      call test_ptr
      if answer is 0
