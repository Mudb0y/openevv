# has_lex_prefix written as what it does. The lower form of it is in
# et_prfx.dr, which this stands in for; tools/rules/check-upper.sh holds the two
# against each other, call for call, through the engine.
#
# It is here because of its shape rather than its size: two alternatives, a
# tail they share, and a dispatch through six planted places, which is what
# most of the language's real rules are made of.

rule has_lex_prefix takes 3 from et_prfx.obj
  through wrappers
  local word bytes 8
  local scan bytes 8
  local chosen

  call ZZget_parm_ptr2 addr word arg 1 addr scan arg 2
  call ZZfence_null
  plant test first
  if global half 4078 is 1
    match
  end

place first
  plant test second
  call ZZlpta_load__setscan_r__1 addr word
  if answer is not 0
    go to second
  end
  call ZZtest_string_s_1_2_ZZstring278
  if answer is not 0
    go to second
  end
  plant test done
  plant choice cleanup with boa
  set chosen to 351

place try
  call ZZlprp_load__setd addr word addr scan chosen
  if answer is 0
    set unwind to 1
  end
  backtrack

place second
  plant test done
  plant choice cleanup with boa
  set chosen to 350
  go to try

place cleanup
  call bspop_boa
  give up

place done
  set global half 4078 to 1
  match
end

# 6.1's strip_scientific_prefixes, lifted by tools/rules/lift64.py out of
# Apple's English module. 4.3's knew four prefixes; 6.1's knows audio, cardio,
# chemo, electro, hydro, neuro, nitro, radio, ribo, tele and more, so a word
# built on one is read as the prefix and the root rather than guessed whole:
# neuroscience was nuh-RAH-shunts.
#
# 6.1 tested its thirteen one string at a time, each a choice point of its
# own, so a prefix could only be added by threading another into the chain.
# This one reads them from set scientific_prefix in lang/enus/enus.words: it
# steps the scan over the word a letter at a time and asks the set whether
# the letters from the word's start are one, and where they are it plants a
# choice to go on looking for a longer one should what follows fail. What
# follows a prefix found is 6.1's own. A prefix in the set needs its sound in
# nonlex_prefixes in enus.dict, which is what the rule lays down for it.
#
# A form in set combining_form is taken off only where what follows it is
# more than one syllable, as one_eng_syllable judges it, and not one of the
# endings in set combining_form_ending; elsewhere it is passed over as if
# not found. The rules stress the root after a prefix taken off, and
# Merriam-Webster stresses the form before a root of one syllable
# (HEK-suh-pod, EK-tuh-derm) and before -plasty and -mancy, and the linking
# vowel before -graphy, -metry, -logy and the like (krip-TOG-ruh-fee,
# kro-NOM-uh-tree), all of which the letter rules already do.
# 6.1's thirteen are taken off wherever they are found, as 6.1 does: its
# words with a short root, telegram and thermostat, are in
# prefix_1stress_nouns and need it.

rule strip_scientific_prefixes takes 1
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local v108 word
  local v110 word
  local h_r13
  local h_r14
  local h_rcx
  local h_rdx
  local h_rsi
  local csci bytes 8
  local sci_short
  local sci_linking
  local s1531b2
  local s15338a
  local s15339f
  local s1533e8
  variable g668 word 876
  variable g678 word 884
  place p153038
  place p15306d
  place p1530cd
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rsi to addr csci
  call push_ptr_init h_rsi
  set cf0 to 65532
  set h_rdx to sym eti_null
  set h_r14 to 0
  set h_rsi to 0
  call fence 0 sym eti_null
  set h_rdx to sym eti_s_1be896
  set h_r13 to 1
  set h_rsi to 1
  call fence 1 sym eti_s_1be896
  set v108 to addr g668
  set cell c130 value to global word 880
  set h_rsi to 1
  call startloop h_rsi
  set v110 to addr g678
  place p15316f
  set h_rsi to 1
  call bspush_ca h_rsi
  set h_rsi to addr g668
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to p15347a
  end
  place p153197
  set h_r13 to h_r14
  place sci_try
  call advance_tok
  set s1531b2 to answer
  if s1531b2 is not 0
    set unwind to h_r13
    backtrack
  end
  place sci_check
  set h_rsi to 5
  set h_rdx to addr csci
  call savescptr h_rsi h_rdx
  set h_rsi to addr g668
  set h_rdx to addr csci
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  call setd_lookup h_rsi 512
  if answer is 0
    go to sci_found
  end
  set h_rsi to addr g668
  set h_rdx to addr csci
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  call setd_lookup h_rsi 514
  if answer is not 0
    go to sci_try
  end
  set h_rsi to addr csci
  set h_rdx to addr g678
  call one_eng_syllable h_rsi h_rdx
  set sci_short to answer
  set h_rsi to addr csci
  set h_rdx to addr g678
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  call setd_lookup h_rsi 513
  set sci_linking to answer
  set h_rsi to addr csci
  call lpta_loadp h_rsi
  set h_rdx to 1
  call setscan_r h_rdx
  if sci_short is 0
    go to sci_try
  end
  if sci_linking is 0
    go to sci_try
  end
  place sci_found
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rcx to h_r13
  go to p15341e
  place sci_longer on 3
  set h_r13 to unwind
  go to sci_try
  place sci_moved on 5
  set h_r13 to unwind
  go to sci_check
  place p153339
  place t153339_18 on 18
  set h_r13 to unwind
  set h_rsi to 20
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is 0
    go to p15339c
  end
  place p15335a
  place t15335a_20 on 20
  set h_r13 to unwind
  set h_rsi to 23
  call starttest h_rsi
  set h_r14 to addr cf0
  set h_rdx to 1
  set h_rsi to addr cf0
  call move_i h_rsi h_rdx
  set h_rdx to addr c100
  set h_rsi to addr g668
  set h_rcx to addr cf0
  call nonlex_prefixes h_rsi h_rdx h_rcx
  set s15338a to answer
  set h_rsi to h_r13
  if s15338a is not 0
    set unwind to h_rsi
    backtrack
  end
  place p15339a
  go to p1533fd
  place p15339c
  place t15339c_21 on 21
  set h_r13 to unwind
  call advance_tok
  set s15339f to answer
  set h_rsi to h_r13
  if s15339f is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1533af
  set h_rsi to 21
  call bspush_ca_scan h_rsi
  place p1533ba
  place t1533ba_22 on 22
  set h_r13 to unwind
  set h_rsi to 22
  set h_r14 to addr c120
  set h_rdx to addr c120
  call savescptr h_rsi h_rdx
  set h_rsi to addr g668
  set h_rdx to addr c120
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 349
  call setd_lookup h_rsi 340
  set s1533e8 to answer
  set h_rsi to h_r13
  if s1533e8 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1533f8
  match
  place p1533fd
  place t1533fd_23 on 23
  set h_r13 to unwind
  set h_rsi to 1
  set h_rdx to 2
  call while_iterate h_rsi h_rdx
  place p15340b
  place t15340b_24 on 24
  set h_r13 to unwind
  set h_r14 to h_r13
  set h_r13 to 1
  go to p15316f
  place p15341b
  place t15341b_4 on 4
  set h_r13 to unwind
  set h_rcx to h_r13
  place p15341e
  set h_r13 to h_rcx
  set h_rsi to 4
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  place p153433
  place t153433_2 on 2
  set h_r13 to unwind
  set h_rsi to addr g668
  set h_rdx to addr g678
  call eng_roots_dict_lookup h_rsi h_rdx
  if answer is 0
    match
  end
  place p153449
  place t153449_17 on 17
  set h_r13 to unwind
  set h_rsi to 18
  call starttest h_rsi
  set h_rsi to 19
  call bspush_ca_boa h_rsi
  set h_rsi to addr c100
  call potential_prefix h_rsi
  if answer is 0
    set h_r13 to 1
  end
  set h_r14 to h_r13
  place p15347a
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place p153482
  place t153482_1 on 1
  set h_r13 to unwind
  set h_rsi to addr g668
  call lpta_loadpn h_rsi
  set h_rsi to addr c130
  call rpta_loadpn h_rsi
  call compare_ptas
  if answer is not 0
    match
  end
  place p1534a8
  call testeq
  if answer is not 0
    match
  end
  place p1534b4
  give up
  place p1534b9
  place t1534b9_19 on 19
  set h_r13 to unwind
  call bspop_boa
  match
  place tm_25 on 25
  match
end
