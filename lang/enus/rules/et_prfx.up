  end
  place p1532d1
  place t1532d1_13 on 13
  set h_r13 to unwind
  set h_rcx to sym eti_s_1be8dd
  set h_rsi to 1
  set h_rdx to 3
  go to p15331d
  place p1532df
  place t1532df_14 on 14
  set h_r13 to unwind
  set h_rsi to 15
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8e4
  place p1532f1
  set h_rsi to 1
  set h_rdx to 5
  go to p15331d
  place p1532f8
  place t1532f8_15 on 15
  set h_r13 to unwind
  set h_rsi to 16
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8e9
  place p15330a
  set h_rsi to 1
  set h_rdx to 4
  go to p15331d
  place p153311
  place t153311_16 on 16
  set h_r13 to unwind
  set h_rcx to sym eti_s_1be8ed
  place p153318
  set h_rsi to 1
  set h_rdx to 6
  place p15331d
  call test_string_s h_rsi h_rdx h_rcx
  set s153321 to answer
  set h_rcx to h_r13
  set h_rsi to h_r13
  if s153321 is not 0
