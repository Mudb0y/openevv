  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set cf0 to 65532
  set h_rdx to sym eti_null
  set h_r14 to 0
  set h_rsi to 0
  call fence 0 sym eti_null
  set h_rdx to sym eti_s_1be896
  set h_r13 to 1
  set h_rsi to 1
  call fence 1 sym eti_s_1be896
  set v108 to addr g668
  set cell c130 value to global word 880
  set h_rsi to 1
  call startloop h_rsi
  set v110 to addr g678
  place p15316f
  set h_rsi to 1
  call bspush_ca h_rsi
  set h_rsi to addr g668
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to p15347a
  end
  place p153197
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rdx to 5
  set h_rcx to sym eti_s_1be8b5
  call test_string_s h_rsi h_rdx h_rcx
  set s1531b2 to answer
  set h_rcx to h_r14
  if s1531b2 is not 0
    go to p15347a
  end
  place p1531c2
  go to p15341e
  place p1531f9
  place t1531f9_3 on 3
  set h_r13 to unwind
  set h_rsi to 5
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8ba
  go to p153318
  place p153210
  place t153210_5 on 5
  set h_r13 to unwind
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8c0
  go to p1532f1
  place p153227
  place t153227_6 on 6
  set h_r13 to unwind
  set h_rsi to 7
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8c5
  set h_rsi to 1
  set h_rdx to 7
  go to p15331d
  place p153243
  place t153243_7 on 7
  set h_r13 to unwind
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8cc
  go to p1532f1
  place p15325a
  place t15325a_8 on 8
  set h_r13 to unwind
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8d1
  go to p1532f1
  place p153271
  place t153271_9 on 9
  set h_r13 to unwind
  set h_rsi to 10
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8d6
  go to p1532f1
  place p153285
  place t153285_10 on 10
  set h_r13 to unwind
  set h_rsi to 11
  call bspush_ca_scan h_rsi
  set h_rsi to 12
  call bspush_ca_scan h_rsi
  go to p1532d1
  place p15329d
  place t15329d_11 on 11
  set h_r13 to unwind
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be8e0
  go to p15330a
  place p1532b1
  place t1532b1_12 on 12
  set h_r13 to unwind
  set h_rcx to sym eti_s_1be8db
  set h_rsi to 1
  set h_rdx to 2
  call test_string_s h_rsi h_rdx h_rcx
  set s1532c1 to answer
  set h_rsi to h_r13
  if s1532c1 is not 0
