  place p15339a
  go to p1533fd
  place p15339c
  place t15339c_21 on 21
  set h_r13 to unwind
  call advance_tok
  set s15339f to answer
  set h_rsi to h_r13
  if s15339f is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1533af
  set h_rsi to 21
  call bspush_ca_scan h_rsi
  place p1533ba
  place t1533ba_22 on 22
  set h_r13 to unwind
  set h_rsi to 22
  set h_r14 to addr c120
  set h_rdx to addr c120
  call savescptr h_rsi h_rdx
  set h_rsi to addr g668
  set h_rdx to addr c120
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 349
  call setd_lookup h_rsi 340
  set s1533e8 to answer
  set h_rsi to h_r13
  if s1533e8 is not 0
