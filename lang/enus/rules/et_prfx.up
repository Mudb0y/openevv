    backtrack
  end
  place p1533f8
  match
  place p1533fd
  place t1533fd_23 on 23
  set h_r13 to unwind
  set h_rsi to 1
  set h_rdx to 2
  call while_iterate h_rsi h_rdx
  place p15340b
  place t15340b_24 on 24
  set h_r13 to unwind
  set h_r14 to h_r13
  set h_r13 to 1
  go to p15316f
  place p15341b
  place t15341b_4 on 4
  set h_r13 to unwind
  set h_rcx to h_r13
  place p15341e
  set h_r13 to h_rcx
  set h_rsi to 4
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  place p153433
  place t153433_2 on 2
  set h_r13 to unwind
  set h_rsi to addr g668
  set h_rdx to addr g678
  call eng_roots_dict_lookup h_rsi h_rdx
  if answer is 0
