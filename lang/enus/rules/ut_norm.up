rule punctuation takes 3
  afresh
  local c100 bytes 8
  local c110 bytes 8
  local c130 bytes 8
  local v118 word
  local v11c word
  local h_r12
  local h_r13
  local h_r14
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  local s30169
  local k3065c_0
  variable g568 word 748
  place p3004c
  set h_r13 to arg 2
  set h_r12 to arg 1
  place p3008b
  place p300ba
  set h_r15 to addr c110
  set h_r14 to -6
  set h_rsi to addr c110
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c100
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_r12 to 0
  set h_rsi to 0
  call fence 0 sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p3015d
  end
  give up
  place p3015d
  set h_rsi to 1
  set h_rdx to 3
  set h_rcx to 4
  call testFldeq h_rsi h_rdx h_rcx
  set s30169 to answer
  set h_rax to s30169
  set v118 to arg 2
  if h_rax is not 0
    go to p30665
  end
  place p3017d
  call advance_tok
  set h_rax to answer
  set h_r14 to 0
  set h_r12 to 0
  if h_rax is not 0
    go to p30665
  end
  place p30193
  place t30193_2 on 2
  set h_r14 to unwind
  set h_r15 to h_r14
  set h_rsi to 2
  set h_r14 to addr c100
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rax to global half 1626
  set global half 1590 to h_rax
  set h_rsi to addr c110
  set h_rdx to addr c100
  call read_punct_by_name h_rsi h_rdx
  set h_rax to answer
  set h_r14 to h_r15
  if h_rax is 0
    go to p305f4
  end
  place p301d6
  place t301d6_3 on 3
  set h_r14 to unwind
  set h_rsi to addr c110
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p30208
  end
  place p301ec
  set h_rcx to sym eti_s_1b90de
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  if h_rax is 0
    go to p3037a
  end
  place p30208
  place t30208_4 on 4
  set h_r14 to unwind
  set h_rsi to addr c110
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p3023a
  end
  place p3021e
