# A word run straight into digits or into an opening mark is spelled out
# letter by letter: Windows10 is W I N D O W S ten and this(thing) is T H I,
# a pause, then S thing. Nothing about the word decides that. letter_sequence
# spells any run of letters that does not end where a word ends, which is
# right for MP3 and H2O and wrong for a word somebody happened not to space.
# So a space goes in where one was left out, before anything reads the token,
# and the pair is then read as it would be if it had been typed.
#
# Before a digit only where the letters are four or more. Shorter runs are
# mostly the acronyms spelling is right for, and several of them read worse
# as words: utf8 would say utf as one syllable, CO2 co, amd64 amd, and A4
# the article. Before an opening bracket, brace, number sign, dollar,
# asterisk or tilde the same four, which keeps the currency codes out of it:
# AUD$5 spaced is Australian dollars five dollars. Before an opening
# parenthesis two letters are enough, because IBM's reading of a short word
# there is broken outright -- sum(x) comes out S U, a pause, M X -- except
# where it opens the (s), (es) or (ed) that process_final_parenthetical
# folds into the word, as in friend(s).
#
# The token is looked up whole first, so a dictionary entry for the token as
# written, Win32 or one a caller added, still wins, and looked up again
# after the space has gone in. It stands where tok_lookup stood in
# normalize_text and hands over to it either way.
rule eng_tok_lookup takes 2 from ut_norm.obj
  afresh
  local here bytes 8
  local cut bytes 8
  local letters
  call ZZget_parmPTR addr here arg 1
  call ZZfence_null
  call tok_lookup arg 1
  if answer is 0
    match
  end
  call ZZlpta_load__setscan_r__1 addr here
  if answer is not 0
    give up
  end
  set letters to 0
  while 1
    call testFldeq 1 3 1                        # a letter
    if answer is not 0
      leave
    end
    increment letters
    call advance_tok
    if answer is not 0
      give up
    end
  end
  if letters is less than 2
    give up
  end
  call savescptr 1 addr cut
  call test_string_s 1 1 sym eng_open_paren
  if answer is 0
    call lpta_loadp addr cut
    call setscan_r 1
    call test_string_s 1 3 sym eng_paren_s
    if answer is 0
      give up
    end
    call lpta_loadp addr cut
    call setscan_r 1
    call test_string_s 1 4 sym eng_paren_es
    if answer is 0
      give up
    end
    call lpta_loadp addr cut
    call setscan_r 1
    call test_string_s 1 4 sym eng_paren_ed
    if answer is 0
      give up
    end
    go to space
  end
  if letters is less than 4
    give up
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call testFldeq 1 3 2                          # a digit
  if answer is 0
    go to space
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call test_string_s 1 1 sym eng_open_bracket
  if answer is 0
    go to space
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call test_string_s 1 1 sym eng_open_brace
  if answer is 0
    go to space
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call test_string_s 1 1 sym eng_number_sign
  if answer is 0
    go to space
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call test_string_s 1 1 sym eng_dollar
  if answer is 0
    go to space
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call test_string_s 1 1 sym eng_asterisk
  if answer is 0
    go to space
  end
  call lpta_loadp addr cut
  call setscan_r 1
  call test_string_s 1 1 sym eng_tilde
  if answer is 0
    go to space
  end
  give up
place space
  call lpta_loadp addr cut
  call insert_r 1 2 sym eng_space 0
  call tok_lookup arg 1
  if answer is 0
    match
  end
  give up
end

# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's English module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  afresh
  local c100 bytes 8
  local c110 bytes 8
  place p3b6ac
  place p3b6eb
  place p3b71e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b7bc
  end
  place p3b772
  call test_string_s 1 1 sym eti_s_1b9104
  if answer is not 0
    go to p3b7bc
  end
  place p3b78a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b7bc
  end
  place p3b7a0
  call test_string_s 1 1 sym eti_s_1b90d8
  if answer is 0
    go to p3b8a9
  end
  place p3b7bc
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b81c
  end
  place p3b7d2
  call test_string_s 1 1 sym eti_s_1b911d
  if answer is not 0
    go to p3b81c
  end
  place p3b7ea
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b81c
  end
  place p3b800
  call test_string_s 1 1 sym eti_s_1b90d9
  if answer is 0
    go to p3b8a9
  end
  place p3b81c
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b878
  end
  place p3b832
  call test_string_s 1 1 sym eti_s_1b911f
  if answer is not 0
    go to p3b878
  end
  place p3b84a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b878
  end
  place p3b860
  call test_string_s 1 1 sym eti_s_1b911e
  if answer is 0
    go to p3b8a9
  end
  place p3b878
  give up
  place p3b8a9
  match
end

