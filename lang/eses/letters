# Castilian Spanish letter-to-sound.
#
# One block a letter and its arms in order, the first that matches winning.
# The last arm of a block is the bare letter: what it says when nothing else
# applies. An arm may also say what must stand to its left and right without
# swallowing it -- `after', `before', and `vowel', `consonant' or `glide' in
# either place -- and `at start' or `at end' for a run that has to begin or
# end where the piece of the word does.
#
# Spanish spells what it says, so most of these are one arm. The letters with
# real rules in them are c, g, l, n, p, q, r, s, x, y, z and the vowels, and
# those are not written here yet; h is not either, because it is silent and
# `says nothing' is not ready -- tools/rules/letters.py says why.

rules in st_phone.obj named apply_span_%s_rules
a piece runs from 704 to 872

letter b
  b    says b

letter d
  d    says d

letter f
  f    says f

letter j
  j    says j

letter k
  k    says k

letter m
  m    says m

letter ñ as enye
  ñ    says N

letter v
  v    says b         # v and b are one sound

letter w
  w    says w

letter z
  z    says T         # the Castilian theta

letter ç as c_cedilla
  ç    says s

letter l
  ll   says L         # calle, llamar
  l    says l

letter q
  qu before e   says k    # que, quedar
  qu before i   says k    # quien, quinto
  qu before é   says k
  qu before í   says k
  q             says k

letter t
  t    says t

letter s
  s before d   says z     # desde
  s before l   says z     # isla
  s before m   says z     # abismo
  s before n   says z     # asno
  s            says s
letter a
  ai   says a y     # aire, baile -- the a rule spells both letters
  ái   says a y     # an accent does not stop a falling diphthong
  a    says a

letter e
  ei   says e y     # peine, reina
  éi   says e y     # aboliríais, agnusdéi
  e    says e

letter o
  oi   says o y     # boina, oigo
  o    says o

letter i
  í                says i     # an accent is stress, and a stressed vowel does not glide
  i before vowel   says y     # abecedario, radio
  i                says i

letter u
  ú                says u     # aúlico, noúmeno -- an accent is stress
  ü before e       says w     # bilingüe
  ü before i       says w     # güira, piragüismo
  ü                says u     # lingüística
  u before a       says w     # agua
  u before e       says w     # bueno
  u before i       says w     # cuido, acuicultura
  u before í       says w     # acuífero
  u before o       says w     # cuota
  u after a        says w     # causa, auto
  u after e        says w     # deuda, Europa
  u after o        says w
  u                says u

letter c
  ch           says C     # mucho, chico
  c before e   says T     # cena
  c before i   says T     # cine
  c before é   says T
  c before í   says T
  c            says k     # casa, cosa

letter g
  gu before e  says g     # guerra
  gu before i  says g     # guitarra
  gu before í  says g     # borceguí
  gu before é  says g
  g before e   says j     # gente
  g before i   says j     # gitano
  g before é   says j
  g before í   says j
  g            says g     # gato

letter n
  ng at end    says n     # hong -- the g goes with it
  n            says n

letter p
  ps at start  says s     # psique, psicopatía -- silent only at the start
  p    says p

letter r
  rr            says R     # perro, carro
  r at start    says R     # rosa, ropa -- trilled at the start of a piece
  r after l     says R     # alrota
  r after n     says R     # enredar
  r after s     says R     # desrabar
  r             says r

letter y
  y before vowel   says Y     # yo, ya
  y after vowel    says y     # muy, rey
  y                says i     # the word y
