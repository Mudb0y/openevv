  set h_r14 to h_rdx
  set h_r15 to h_rcx
  call bspush_ca_scan_boa h_rsi
  set h_rcx to h_r15
  set h_rdx to 0
  set h_rsi to 1
  call testFldeq h_rsi h_rdx h_rcx
  if answer is 0
    set h_r14 to 1
  end
  set h_r12 to h_r14
  go to p3340d
  place p3370c
  place t3370c_25 on 25
  set h_r12 to unwind
  call bspop_boa
  place p33714
  place t33714_32 on 32
  set h_r12 to unwind
