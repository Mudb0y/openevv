  place t3372a_6 on 6
  place t3372a_14 on 14
  place t3372a_15 on 15
  place t3372a_24 on 24
  place t3372a_29 on 29
  place t3372a_35 on 35
  place t3372a_36 on 36
  set h_r12 to unwind
  set h_rcx to arg 2
  put cell c100 value into arg 2 at 4
  set h_r14 to 0
  match
  place p33744
  place t33744_31 on 31
  set h_r12 to unwind
  set h_r14 to h_r12
  go to p3339f
  place p3374c
  place t3374c_33 on 33
  set h_r12 to unwind
  set h_rsi to 33
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rsi to addr c118
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  if answer is not 0
    go to p3372a
  end
  place p33774
  call lpta_loadp addr g578
  call test_ptr
  if answer is not 0
    go to p3372a
  end
  place p3379a
  go to p33714
  place p3379f
  place t3379f_34 on 34
  set h_r12 to unwind
  set h_r14 to h_r12
  go to p333d5
end

rule quote_mark takes 3
