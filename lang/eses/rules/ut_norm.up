# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's Castilian Spanish module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3a0d0
  place p3a10f
  place p3a142
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3a1e0
  end
  place p3a196
  call test_string_s 1 1 sym eti_s_ea110
  if answer is not 0
    go to p3a1e0
  end
  place p3a1ae
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3a1e0
  end
  place p3a1c4
  call test_string_s 1 1 sym eti_s_ea0e4
  if answer is 0
    match
  end
  place p3a1e0
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3a240
  end
  place p3a1f6
  call test_string_s 1 1 sym eti_s_ea129
  if answer is not 0
    go to p3a240
  end
  place p3a20e
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3a240
  end
  place p3a224
  call test_string_s 1 1 sym eti_s_ea0e5
  if answer is 0
    match
  end
  place p3a240
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p3a256
  call test_string_s 1 1 sym eti_s_ea12b
  if answer is not 0
    give up
  end
  place p3a26e
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p3a284
  call test_string_s 1 1 sym eti_s_ea12a
  if answer is 0
    match
  end
  give up
end

