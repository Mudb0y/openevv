# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's Mexican Spanish module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p398b4
  place p398f3
  place p39926
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p399c4
  end
  place p3997a
  call test_string_s 1 1 sym eti_s_e9120
  if answer is not 0
    go to p399c4
  end
  place p39992
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p399c4
  end
  place p399a8
  call test_string_s 1 1 sym eti_s_e90f4
  if answer is 0
    match
  end
  place p399c4
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p39a24
  end
  place p399da
  call test_string_s 1 1 sym eti_s_e9139
  if answer is not 0
    go to p39a24
  end
  place p399f2
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p39a24
  end
  place p39a08
  call test_string_s 1 1 sym eti_s_e90f5
  if answer is 0
    match
  end
  place p39a24
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p39a3a
  call test_string_s 1 1 sym eti_s_e913b
  if answer is not 0
    give up
  end
  place p39a52
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p39a68
  call test_string_s 1 1 sym eti_s_e913a
  if answer is 0
    match
  end
  give up
end

