  set h_rdx to 3
  set h_rcx to 1
  set h_rsi to 1
  call testFldeq h_rsi h_rdx h_rcx
  set s32ea1 to answer
  set h_rcx to 73
  set h_rsi to 27
  set h_rdx to h_r15
  set h_r12 to h_r15
  if s32ea1 is not 0
    go to p32bf1
  end
  place p32eb9
  go to p32ec3
  place p32ebb
  place t32ebb_21 on 21
  set h_r12 to unwind
  set h_rcx to 72
  set h_rsi to 20
  set h_rdx to h_r12
  place p32ec3
  set h_r14 to h_rdx
  set h_r15 to h_rcx
  call bspush_ca_scan_boa h_rsi
  set h_rcx to h_r15
  set h_rdx to 0
  set h_rsi to 1
  call testFldeq h_rsi h_rdx h_rcx
  if answer is 0
    set h_r14 to 1
  end
  set h_r12 to h_r14
  go to p32bf1
  place p32ef0
  place t32ef0_25 on 25
  set h_r12 to unwind
  call bspop_boa
  place p32ef8
  place t32ef8_32 on 32
  set h_r12 to unwind
  set h_rsi to addr c118
  set h_rdx to addr c100
  call single_chars h_rsi h_rdx
  place p32f0e
  place t32f0e_3 on 3
  place t32f0e_6 on 6
  place t32f0e_14 on 14
  place t32f0e_15 on 15
  place t32f0e_24 on 24
  place t32f0e_29 on 29
  place t32f0e_35 on 35
  place t32f0e_36 on 36
  set h_r12 to unwind
  set h_rcx to arg 2
  put cell c100 value into arg 2 at 4
  set h_r14 to 0
  match
  place p32f28
  place t32f28_31 on 31
  set h_r12 to unwind
  set h_r14 to h_r12
  go to p32b83
  place p32f30
  place t32f30_33 on 33
  set h_r12 to unwind
  set h_rsi to 33
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rsi to addr c118
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  if answer is not 0
    go to p32f0e
  end
  place p32f58
  call lpta_loadp addr g578
  call test_ptr
  if answer is not 0
    go to p32f0e
  end
  place p32f7e
  go to p32ef8
  place p32f83
  place t32f83_34 on 34
  set h_r12 to unwind
  set h_r14 to h_r12
  go to p32bb9
end

rule quote_mark takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_rcx
  place p32378
  place p323b7
  place p3241a
  set h_rcx to -6
  call get_parm addr c110 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c100 arg 2 h_rcx
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is 0
    go to p32482
  end
  give up
  place p32482
  call bspush_ca_scan 2
  set h_rcx to sym eti_s_e90f6
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to p32595
  end
  place p324a9
  set unwind to 0
  backtrack
  place p324e4
  place t324e4_2 on 2
  call bspush_ca_scan 4
  set h_rcx to sym eti_s_e90f7
  go to p32588
  place p32504
