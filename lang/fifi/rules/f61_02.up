rule setup_lang_reg takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local n584a_2
  local n584a_r
  local scratch
  variable g158 word 184
  variable g168 word 192
  place p5714
  place p5753
  place p57b6
  call get_parm addr cf4 arg 1 -4
  call get_parm addr cf0 arg 2 -4
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr g158 addr g168
  call insert_2pt_s 1 14 sym eti_s_fb00e 0
  if answer is 0
    go to p5832
  end
  set unwind to 0
  backtrack
  place p5832
  set cell cf4 field to 9
  and 0 into cell cf0 field
  put 9 into arg 1 at 2 half
  set scratch to through arg 2 half 2
  and 0 into scratch
  put scratch into arg 2 at 2 half
  set n584a_r to scratch
  set n584a_2 to n584a_r
  and 65535 into n584a_2
  match
end

