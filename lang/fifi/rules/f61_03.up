rule reset_sent_vars takes 1
  instead
  variable g158 word 184
  variable g918 word 1328
  variable ge10 word 2436
  variable ge70 word 2504
  place p707e
  place p70ad
  place p7107
  call fence 0 sym eti_null
  set global word 712 to global word 188
  set global word 728 to global word 792
  set global word 960 to global word 2224
