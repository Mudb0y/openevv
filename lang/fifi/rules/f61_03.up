  and 0 into global half 1364
  and 0 into global half 1542
  and 0 into global half 1546
  call lpta_loadp addr g158
  call setscan_r 1
  if answer is not 0
    go to p71c6
  end
  place p71a9
  call bspush_ca_scan 2
  call savescptr 3 addr g918
  place p71c6
  call copyvar addr ge10 addr ge70
  set global half 2440 to 1
  set global word 336 to global word 2224
  set global word 1224 to 0
  set global word 1232 to 0
  set global word 1240 to 0
  set global word 1216 to 0
