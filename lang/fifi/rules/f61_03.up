  set global word 3204 to global word 188
  and 0 into global half 3242
  set global word 496 to global word 2224
  call reset_lang_sent_vars
  set global word 808 to global word 712
  call reset_phrase_vars
  call increment_output_file_number
  match
end

rule increment_output_file_number takes 1
  instead
  local h_rax
  local h_rcx
  local n735f_0
  local n736d_0
  place p72b9
  place p72e8
  place p733e
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 2694
  if h_rax is 0
    match
  end
  place p735f
  set n735f_0 to h_rax
  shift left 16 into n735f_0
  shift right 16 into n735f_0
  if n735f_0 is less than 999
    go to p7374
  end
  place p7365
  set h_rcx to h_rax
  add -1999 to h_rcx
  set n736d_0 to h_rcx
  and 65535 into n736d_0
  if n736d_0 is below 64538
    match
  end
  place p7374
  increment h_rax
  set global half 2694 to h_rax
  match
end

rule init_symbolic_vars takes 1
  instead
  place p738f
  place p73c2
  place p73f1
  call fence 0 sym eti_null
  and 0 into global half 2586
  set global word 2648 to global word 712
  set global word 2664 to global word 712
  match
end

rule init_tm_vars takes 1
  instead
  variable g290 word 340
  variable gf58 word 2652
  variable gf78 word 2668
  place p744f
  place p747e
  place p74d8
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr g290
  call setscan_r 4
  if answer is not 0
    match
  end
  place p750e
  call bspush_ca_scan 2
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p7525
  go to p752c
  place p752c
  place t752c_2 on 2
  call savescptr 2 addr gf78
  call bspush_ca_scan 3
  call advance_tok
  if answer is 0
    go to p7586
  end
  set unwind to 0
  backtrack
  place p7586
  place t7586_3 on 3
  call savescptr 3 addr gf58
  match
  place tm_1 on 1
  match
end

rule init_word_ptrs takes 1
  instead
  place p759d
  place p75d0
  place p75ff
  call fence 0 sym eti_null
  call init_current_word_ptrs
  call init_adjacent_word_ptrs
