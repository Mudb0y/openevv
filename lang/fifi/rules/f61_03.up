  set h_rax to global word 424
  set global word 368 to h_rax
  match
  place p8e5d
  set n8e5d_1 to h_rax
  and 65535 into n8e5d_1
  if global half 542 is not n8e5d_1
    match
  end
  place p8e6a
  set h_rsi to addr g310
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr g2c0
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p8ea0
  end
  place p8e94
  call testeq
  set h_rax to answer
  if h_rax is 0
    go to p8edf
  end
  place p8ea0
  place t8ea0_15 on 15
  set h_r12 to unwind
  set h_rsi to addr g300
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr g2c0
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p8eca
  call testeq
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p8ed6
  set h_rax to global half 550
  go to p8ee6
  place p8edf
  set h_rax to global half 546
  place p8ee6
  set global half 530 to h_rax
  match
  place tm_11 on 11
  place tm_16 on 16
  match
end
