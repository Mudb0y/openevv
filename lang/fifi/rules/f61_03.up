# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule init_vars takes 1
  instead
  variable g168 word 192
  variable g568 word 788
  variable gbdc word 1968
  variable gc30 word 2030
  variable gc50 word 2044
  variable ge30 word 2452
  variable ge70 word 2504
  place p6140
  place p617d
  place p61b0
  call fence 0 sym eti_null
  set global half 2506 to 3
  call copyvar addr ge70 addr gbdc
  set global half 2032 to 5
  call move_i addr gc30 1
  call npush_s 1
  set global half 2046 to 1
  call npop addr gc50
  set global half 2046 to 5
  call move_i addr gc50 1
  set global half 1750 to 1
  set global half 1906 to global half 1854
  and 0 into global half 1342
  set global half 1674 to global half 1678
  set global half 2112 to global half 1298
  set global half 3710 to global half 1298
  set global half 3714 to global half 1298
  set global half 3718 to global half 1298
  and 0 into global half 1694
  and 0 into global half 1670
  set global word 1316 to global word 188
  set global word 800 to global word 188
  call rpta_loadp addr g168
  call insert_l 1 1 sym eti_s_fb047 0
  call lpta_storep addr g568
  call lpta_loadp addr g568
  call proj_def_mult 9 sym eti_s_fb048 addr g568
  set global word 1436 to global word 800
  set global word 728 to global word 792
  and 0 into global half 1400
  set global half 2282 to global half 2286
  call settvar_i addr ge30 1
  set global half 2642 to 4
  and 0 into global half 2258
  and 0 into global half 2830
  set global word 3228 to global word 800
  set global word 2524 to 1000000
  call init_lang_vars
  match
end

