  set h_xmm0 to 10000
  call npush_f h_xmm0
  call if_testgt
  set sbf08 to answer
  set h_xmm0 to cell ce0 field
  multiply 10000 into h_xmm0
  if sbf08 is 0
    go to pbf3f
  end
  place pbf22
  if h_xmm0 is at least global word 2860
    match
  end
  place pbf28
  set global word 2860 to h_xmm0
  match
  place pbf3f
  if global word 2860 is less than h_xmm0
    go to pbf28
  end
  match
end

