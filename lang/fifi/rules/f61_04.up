  variable g310 word 428
  variable g404 word 600
  variable g4c8 word 708
  variable g4d8 word 716
  variable g578 word 796
  variable g628 word 884
  variable g638 word 892
  variable g648 word 900
  variable g658 word 908
  place p9030
  place p9069
  place p90cf
  set cell cf0 kind to 65532
  call push_ptr_init addr c150
  call push_ptr_init addr c140
  call push_ptr_init addr c128
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  set vf8 to addr g300
  set cell c150 value to global word 424
  set cell c140 value to global word 432
  set v118 to addr g310
  call lpta_loadpn addr g310
  call rpta_loadpn addr g4d8
  call compare_ptas
  if answer is not 0
    go to p91b7
  end
  place p9170
  call testneq
  if answer is not 0
    go to p91b7
  end
  place p917c
  call lpta_loadp addr g310
  call setscan_r 7
  if answer is not 0
    go to p91b7
  end
  place p9192
  call advanc
  if answer is not 0
    go to p91b7
  end
  place p919e
  go to p91a5
  place p91a5
  place t91a5_2 on 2
  call savescptr 2 addr c140
  place p91b7
  set v130 to addr g4c8
  set v110 to addr g648
  set v108 to addr g404
  set v100 to addr g658
  place p9208
  place t9208_1 on 1
  call lpta_loadpn addr g300
  call rpta_loadpn addr g4c8
  call compare_ptas
  if answer is not 0
    go to p9359
  end
  place p9236
  call testeq
  if answer is not 0
    go to p9359
  end
  place p9246
  set cell c150 value to global word 800
  call starttest 3
  call lpta_loadp addr g300
  call setscan_r 2
  if answer is not 0
    go to p9359
  end
  place p9279
  place t9279_4 on 4
  call savescptr 4 addr c128
  call testFldeq 2 9 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p92a4
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p92b4
  call lpta_loadp addr c128
  call setscan_l 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p92ce
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p92de
  call lpta_loadp addr g578
  call test_ptr
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p9308
  place t9308_5 on 5
  call savescptr 5 addr g648
  call get_h_dur addr g648 addr g300 addr cf0
  place p9339
  place t9339_6 on 6
  call insert_dur addr cf0 addr g648 addr g300 addr g404
  place p9359
  place t9359_3 on 3
  call startloop 7
  call lpta_loadpn addr c150
  call lpta_mover 2
  call lpta_storep addr g628
  call lpta_loadpn addr c140
  call lpta_mover 2
  call lpta_storep addr c128
  call forall_to_test addr g628 addr c128
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p93d2
  place t93d2_15 on 15
  call bspush_ca 9
  call lpta_loadp addr g628
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p93f3
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p9403
  place t9403_10 on 10
  call savescptr 10 addr g638
  place p9411
  place t9411_8 on 8
  call lpta_loadp addr g638
  call setscan_r 2
  if answer is not 0
    go to p9446
  end
  place p9423
  call advanc
  if answer is not 0
    go to p9446
  end
  place p942f
  place t942f_12 on 12
  call savescptr 12 addr g658
  go to p94f3
  place p9446
  place t9446_11 on 11
  call lpta_loadp addr g638
  call insert_r 2 1 sym eti_s_fb054 0
  call rpta_storep addr g658
  call lpta_loadpn addr g638
  call rpta_loadpn addr g310
  call compare_ptas
  if answer is not 0
    go to p94f3
  end
  place p94ad
  call testeq
  if answer is not 0
    go to p94f3
  end
  place p94b9
  call lpta_loadp addr g638
  call rpta_loadp addr g658
  call proj_r 7
  place p94f3
  place t94f3_13 on 13
  call get_trans_dur addr cf0
  place p94fe
  place t94fe_14 on 14
  call starttest 9
  call insert_dur addr cf0 addr g638 addr g658 addr g404
  place p9525
  place t9525_9 on 9
  call forto_adv_upto_r 7 8 15 2 addr g628 addr c128
  if answer is 0
    go to p9582
  end
  set unwind to 0
  backtrack
  place p9582
  match
  place tm_7 on 7
  match
end

