# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule run_filters takes 3
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local h_rax
  local nc3e4_0
  local nc41e_0
  local nc423_0
  local nc47d_0
  variable g1270 word 3268
  place pc2cb
  place pc304
  place pc35e
  call get_parm addr ce0 arg 1 -4
  set h_rax to answer
  call get_parm addr ce4 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set global half 3270 to 5
  call if_testneq_v_i addr g1270 50
  set h_rax to answer
  if h_rax is not 0
    go to pc407
  end
  place pc3b6
  if cell ce0 field is at least 6
    go to pc3c7
  end
  place pc3c0
  go to pc3f1
  place pc3c7
  place tc3c7_2 on 2
  call starttest 1
  set h_rax to answer
  call bspush_ca 4
  set h_rax to answer
  set h_rax to global half 1074
  place pc3e4
  set nc3e4_0 to h_rax
  and 65535 into nc3e4_0
  if nc3e4_0 is not cell ce0 field
    set unwind to 0
    backtrack
  end
  place pc3f1
  place tc3f1_5 on 5
  call size_filter addr ce0 addr ce4
  set h_rax to answer
  place pc407
  place tc407_1 on 1
  place tc407_3 on 3
  place tc407_6 on 6
  set h_rax to global half 2822
  if h_rax is not global half 2814
    go to pc43f
  end
  place pc417
  set h_rax to cell ce0 field
  set nc41e_0 to h_rax
  shift left 16 into nc41e_0
  shift right 16 into nc41e_0
  if nc41e_0 is at most 0
    go to pc43f
  end
  place pc423
  set nc423_0 to h_rax
  shift left 16 into nc423_0
  shift right 16 into nc423_0
  if nc423_0 is more than 5
    go to pc43f
  end
  place pc429
  call filter_by_range addr ce0 addr ce4
  set h_rax to answer
  place pc43f
  place tc43f_7 on 7
  set global half 3270 to 3
  call if_testeq_v_i addr g1270 8000
  set h_rax to answer
  if h_rax is not 0
    go to pc50e
  end
  place pc460
  call starttest_l 8
  set h_rax to answer
  call bspush_ca 9
  set h_rax to answer
  set h_rax to global half 1050
  place pc47d
  set nc47d_0 to h_rax
  and 65535 into nc47d_0
  if nc47d_0 is cell ce0 field
    go to pc4f8
  end
  set unwind to 0
  backtrack
  place pc4bb
  place tc4bb_4 on 4
  set h_rax to global half 1078
  go to pc3e4
  place pc4c7
  place tc4c7_9 on 9
  call bspush_ca 11
  set h_rax to answer
  set h_rax to global half 1054
  go to pc47d
  place pc4db
  place tc4db_11 on 11
  call bspush_ca 12
  set h_rax to answer
  set h_rax to global half 1070
  go to pc47d
  place pc4ef
  place tc4ef_12 on 12
  set h_rax to global half 1074
  go to pc47d
  place pc4f8
  place tc4f8_10 on 10
  call eightkHz_filter addr ce0 addr ce4
  set h_rax to answer
  place pc50e
  place tc50e_8 on 8
  set h_rax to cell ce4 field
  put h_rax into arg 2 at 2 half
  match
end

rule size_filter takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local nc636_0
  local nc71e_0
  variable g1270 word 3268
  place pc55c
  place pc597
  place pc5f7
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  set nc636_0 to h_rax
  shift left 16 into nc636_0
  shift right 16 into nc636_0
  if nc636_0 is at most 5
    go to pc689
  end
  place pc63c
  if global half 1078 is not h_rax
    go to pc6b3
  end
  place pc645
  set global half 3270 to 5
  call if_testge_v_i addr g1270 40
  set h_rax to answer
  if h_rax is not 0
    go to pc72e
  end
  place pc668
  set h_rax to global half 2818
  if h_rax is not global half 2814
    go to pc72e
  end
  place pc67c
  shift left 3 into cell cf0 field
  go to pc72e
  place pc689
  set h_rax to cell cf0 field
  set h_rcx to global signed half 3246
  multiply h_rax into h_rcx
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  go to pc72e
  place pc6b3
  if global half 1074 is not h_rax
    go to pc72e
  end
  place pc6bc
  set global half 3270 to 4
  call if_testneq_v_i addr g1270 0
  set h_rax to answer
  if h_rax is not 0
    go to pc72e
  end
  place pc6dd
  set global half 3270 to 5
  call if_testge_v_i addr g1270 40
  set h_rax to answer
  set h_rcx to cell cf0 field
  if h_rax is not 0
    go to pc71e
  end
  place pc6ff
  set h_rax to h_rcx
  shift left 4 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set h_rcx to h_rax
  set cell cf0 field to h_rax
  place pc71e
  set nc71e_0 to h_rcx
  shift left 16 into nc71e_0
  shift right 16 into nc71e_0
  if nc71e_0 is less than 3001
    go to pc72e
  end
  place pc725
  set cell cf0 field to 3000
  place pc72e
  set h_rax to cell cf0 field
  put h_rax into arg 2 at 2 half
  match
end

rule filter_by_range takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local nc838_0
  local nc842_0
  local nc84c_0
  local nc878_1
  local nc885_1
  local nc973_0
  local nc985_0
  local nc9fe_0
  local nca18_0
  local nca45_0
  local nca4b_0
  local nca51_0
  place pc74e
  place pc789
  place pc7e9
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  if global half 1042 is not h_rax
    go to pc868
  end
  place pc831
  set h_rax to cell cf0 field
  set nc838_0 to h_rax
  shift left 16 into nc838_0
  shift right 16 into nc838_0
  if nc838_0 is at most 350
    go to pca66
  end
  place pc842
  set nc842_0 to h_rax
  shift left 16 into nc842_0
  shift right 16 into nc842_0
  if nc842_0 is at most 500
    go to pc95a
  end
  place pc84c
  set nc84c_0 to h_rax
  shift left 16 into nc84c_0
  shift right 16 into nc84c_0
  if nc84c_0 is more than 650
    go to pc9c8
  end
  place pc856
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11800 over 10000
  go to pca82
  place pc868
  place pc876
  set h_rcx to h_rax
  set nc878_1 to h_rax
  and 65535 into nc878_1
  if global half 1046 is nc878_1
    go to pca3e
  end
  place pc885
  set nc885_1 to h_rax
  and 65535 into nc885_1
  if global half 1050 is nc885_1
    go to pca29
  end
  place pc892
  place tc892_12 on 12
  call starttest 13
  set h_rax to answer
  set h_rax to global half 1054
  if h_rax is not cell cf4 field
    go to pc8c7
  end
  place pc8ad
  call bspush_ca 14
  set h_rax to answer
  if global signed half 3186 is at most 0
    set unwind to 0
    backtrack
  end
  place pc8c2
  go to pc97e
  place pc8c7
  place tc8c7_13 on 13
  call starttest 6
  set h_rax to answer
  set h_rax to global half 1058
  if h_rax is not cell cf4 field
    go to pca8d
  end
  place pc8e6
  call bspush_ca 19
  set h_rax to answer
  if global signed half 3194 is more than 0
    go to pc96c
  end
  set unwind to 0
  backtrack
  place pc92a
  place tc92a_14 on 14
  if global signed half 3190 is at most 0
    set unwind to 0
    backtrack
  end
  place pc934
  go to pc97e
  place pc936
  place tc936_19 on 19
  if global signed half 3198 is at most 0
    set unwind to 0
    backtrack
  end
  place pc940
  go to pc96c
  place pc942
  place tc942_7 on 7
  set h_rax to cell cf4 field
  go to pc885
  place pc94e
  place tc94e_1 on 1
  set h_rax to cell cf4 field
  go to pc876
  place pc95a
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11000 over 10000
  go to pca82
  place pc96c
  place tc96c_20 on 20
  set h_rax to cell cf0 field
  set nc973_0 to h_rax
  shift left 16 into nc973_0
  shift right 16 into nc973_0
  if nc973_0 is at most 2700
    go to pc98b
  end
  place pc979
  go to pca16
  place pc97e
  place tc97e_15 on 15
  set h_rax to cell cf0 field
  set nc985_0 to h_rax
  shift left 16 into nc985_0
  shift right 16 into nc985_0
  if nc985_0 is more than 3000
    go to pc9fc
  end
  place pc98b
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12000 over 10000
  go to pca82
  place pc99d
  place tc99d_18 on 18
  place tc99d_23 on 23
  set h_rax to cell cf0 field
  go to pca75
  place pc9a9
  place tc9a9_2 on 2
  set h_rax to cell cf0 field
  go to pc842
  place pc9b5
  place tc9b5_4 on 4
  set h_rax to cell cf0 field
  go to pc84c
  place pc9c1
  place tc9c1_5 on 5
  set h_rax to cell cf0 field
  place pc9c8
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12500 over 10000
  go to pca82
  place pc9da
  place tc9da_8 on 8
  set h_rax to cell cf0 field
  go to pca4b
  place pc9e3
  place tc9e3_10 on 10
  set h_rax to cell cf0 field
  go to pca51
  place pc9ec
  place tc9ec_11 on 11
  set h_rax to cell cf0 field
  go to pca57
  place pc9f5
  place tc9f5_16 on 16
  set h_rax to cell cf0 field
  place pc9fc
  set h_rcx to h_rax
  set nc9fe_0 to h_rax
  shift left 16 into nc9fe_0
  shift right 16 into nc9fe_0
  if nc9fe_0 is less than 3651
    go to pca75
  end
  place pca04
  set cell cf0 field to 4200
  go to pca8d
  place pca0f
  place tca0f_21 on 21
  set h_rax to cell cf0 field
  place pca16
  set h_rcx to h_rax
  set nca18_0 to h_rax
  shift left 16 into nca18_0
  shift right 16 into nca18_0
  if nca18_0 is less than 4000
    go to pca75
  end
  place pca1e
  set cell cf0 field to 4600
  go to pca8d
  place pca29
  set h_rax to cell cf0 field
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11900 over 10000
  go to pca82
  place pca3e
  set h_rax to cell cf0 field
  set nca45_0 to h_rax
  shift left 16 into nca45_0
  shift right 16 into nca45_0
  if nca45_0 is at most 1100
    go to pca66
  end
  place pca4b
  set nca4b_0 to h_rax
  shift left 16 into nca4b_0
  shift right 16 into nca4b_0
  if nca4b_0 is at most 1300
    go to pca75
  end
  place pca51
  set nca51_0 to h_rax
  shift left 16 into nca51_0
  shift right 16 into nca51_0
  if nca51_0 is at most 1700
    go to pcaa8
  end
  place pca57
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12100 over 10000
  go to pca82
  place pca66
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10700 over 10000
  go to pca82
  place pca75
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11500 over 10000
  place pca82
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  place pca8d
  place tca8d_3 on 3
  place tca8d_6 on 6
  place tca8d_9 on 9
  place tca8d_17 on 17
  place tca8d_22 on 22
  set h_rax to cell cf0 field
  put h_rax into arg 2 at 2 half
  match
  place pcaa8
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11700 over 10000
  go to pca82
end

rule eightkHz_filter takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_rdx
  local h_xmm0
  local ncc03_0
  local ncc36_0
  local ncc9e_0
  local ncd19_0
  local ncd36_0
  local ncd48_0
  local scratch
  local fcd51
  variable g1270 word 3268
  place pcb18
  place pcb53
  place pcbb3
  set h_rdx to arg 1
  set h_rcx to -4
  call get_parm addr cf4 h_rdx h_rcx
  set h_rax to answer
  set h_rdx to arg 2
  set h_rcx to -4
  call get_parm addr cf0 h_rdx h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  set h_rcx to cell cf0 field
  if global half 1050 is not h_rax
    go to pcc27
  end
  place pcc03
  set ncc03_0 to h_rcx
  shift left 16 into ncc03_0
  shift right 16 into ncc03_0
  if ncc03_0 is at most 3600
    go to pcc27
  end
  place pcc0a
  set cell cf0 field to 3600
  set h_rcx to 3600
  set h_rdx to 3600
  if global half 1054 is not h_rax
    go to pcc46
  end
  place pcc22
  go to pcd5f
  place pcc27
  if global half 1054 is not h_rax
    go to pcc46
  end
  place pcc30
  set h_rax to 3900
  set h_rdx to h_rcx
  set ncc36_0 to h_rcx
  shift left 16 into ncc36_0
  shift right 16 into ncc36_0
  if ncc36_0 is at least 3901
    go to pcd56
  end
  place pcc41
  go to pcd5f
  place pcc46
  set h_rdx to h_rcx
  if global half 1074 is not h_rax
    go to pccae
  end
  place pcc51
  set h_rax to h_rdx
  set scratch to h_rax
  multiply 15 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pcd24
  end
  place pcc91
  set h_rcx to cell cf0 field
  set h_rax to 3000
  set h_rdx to h_rcx
  set ncc9e_0 to h_rcx
  shift left 16 into ncc9e_0
  shift right 16 into ncc9e_0
  if ncc9e_0 is at least 3001
    go to pcd56
  end
  place pcca9
  go to pcd5f
  place pccae
  if global half 1070 is not h_rax
    go to pcd5f
  end
  place pccbb
  set h_rax to global half 2822
  if h_rax is not global half 2814
    go to pcd5f
  end
  place pcccf
  set global half 3270 to 5
  set h_rdx to 30
  call if_testgt_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pcd2a
  end
  place pccf1
  set global half 3270 to 5
  set h_rdx to 40
  call if_testge_v_i addr g1270 h_rdx
  set h_rax to answer
  set h_rcx to cell cf0 field
  if h_rax is 0
    go to pcd41
  end
  place pcd13
  set h_rax to h_rcx
  add h_rax to h_rax
  set h_rcx to h_rax
  set ncd19_0 to h_rax
  and 65535 into ncd19_0
  set h_rcx to 500
  set fcd51 to 0
  if ncd19_0 is less than 500
    set fcd51 to 1
  end
  go to pcd51
  place pcd24
  set h_rax to 1000
  go to pcd56
  place pcd2a
  set h_rax to cell cf0 field
  shift left 3 into h_rax
  set h_rcx to h_rax
  set ncd36_0 to h_rax
  and 65535 into ncd36_0
  set h_rcx to 3000
  set fcd51 to 0
  if ncd36_0 is less than 3000
    set fcd51 to 1
  end
  go to pcd51
  place pcd41
  set h_rax to h_rcx
  shift left 2 into h_rax
  set h_rcx to h_rax
  set ncd48_0 to h_rax
  shift left 16 into ncd48_0
  shift right 16 into ncd48_0
  set h_rcx to 1000
  set fcd51 to 0
  if ncd48_0 is less than 1000
    set fcd51 to 1
  end
  place pcd51
  if fcd51 is not 0
    set h_rcx to h_rax
  end
  set h_rax to h_rcx
  place pcd56
  set cell cf0 field to h_rax
  set h_rdx to h_rax
  place pcd5f
  put h_rdx into arg 2 at 2 half
  match
end

rule set_word_default_acoustic_vals takes 1
  instead
  local h_rax
  local h_rcx
  local h_rdx
  local h_xmm0
  local h_xmm1
  local scfda
  local scratch
  variable g1270 word 3268
  place pcd78
  place pcda9
  place pce05
  call fence 0 sym eti_null
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pced8
  end
  place pce33
  set global half 3270 to 4
  set h_rdx to 0
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pcfc4
  end
  place pce51
  set h_rax to global signed half 3284
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  scale h_xmm0 by 430000 over 10000
  add 560000 to h_xmm0
  set h_rcx to h_xmm0
  add 1 to h_rcx
  if h_rcx is less than 1
    subtract 2 from h_rcx
  end
  truncate h_rcx by 1 over 10000
  set global half 2942 to h_rcx
  if global half 3250 is not 0
    go to pcea3
  end
  place pce89
  set scratch to h_rax
  multiply 35 into scratch
  set h_rcx to scratch
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rcx to h_xmm0
  add 1 to h_rcx
  if h_rcx is less than 1
    subtract 2 from h_rcx
  end
  truncate h_rcx by 1 over 10000
  set global half 3146 to h_rcx
  place pcea3
  if global half 3254 is not 0
    go to pcfc4
  end
  place pceb1
  set scratch to h_rax
  multiply 20 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  add 340000 to h_xmm0
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3142 to h_rax
  go to pcfc4
  place pced8
  set h_rax to 100
  set h_rcx to global half 2726
  set h_rdx to 85
  if h_rcx is not 4
    set h_rdx to 100
  end
  set h_rax to 70
  if h_rcx is not 3
    set h_rax to h_rdx
  end
  set global half 2942 to h_rax
  if global half 3250 is not 0
    go to pcf28
  end
  place pcf07
  set h_rax to global signed half 3284
  set scratch to h_rax
  multiply 36 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3146 to h_rax
  place pcf28
  if global half 3254 is not 0
    go to pcf53
  end
  place pcf32
  set h_rax to global signed half 3284
  set scratch to h_rax
  multiply 50 into scratch
