# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule synthesizeRange takes 7
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local vf8 word
  local h_r15
  local h_rsi
  local s10207
  place p10043
  set vf8 to arg 5
  set h_r15 to arg 1
  place p1008b
  place p100eb
  set h_rsi to addr cf0
  call get_parm h_rsi arg 1 -4
  set h_rsi to addr c108
  set h_r15 to -6
  call get_parm h_rsi arg 2 -6
  set h_rsi to addr c148
  call get_parm h_rsi arg 3 -6
  set h_rsi to addr c138
  call get_parm h_rsi arg 4 -5
  set h_rsi to addr c128
  call get_parm h_rsi arg 5 -5
  set h_rsi to addr c118
  call get_parm h_rsi arg 6 -5
  call fence 0 sym eti_null
  set h_rsi to addr c108
  call PhonemeIndex h_rsi addr c148
  set h_r15 to 0
  place p101a2
  place t101a2_1 on 1
  set h_r15 to unwind
  if global half 2846 is not 0
    match
  end
  place p101b0
  if global half 2850 is not 0
    match
  end
  place p101be
  set h_rsi to 2
  call starttest_l h_rsi
  set h_rsi to 3
  call bspush_ca_boa h_rsi
  set h_rsi to addr cf0
  call callInternalSynthesizer h_rsi addr c108 addr c148 addr c138 addr c128 addr c118
  set s10207 to answer
  set h_rsi to 1
  if s10207 is 0
    set unwind to h_rsi
    backtrack
  end
  place p10213
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  place p1024b
  place t1024b_3 on 3
  set h_r15 to unwind
  call bspop_boa
  give up
  place tm_2 on 2
  match
end

rule set_klattparms takes 1
  instead
  local vf8 word
  local h_rax
  local h_rdx
  local h_xmm0
  local h_xmm1
  variable g1068 word 2804
  variable g1270 word 3268
  variable gfcc word 2720
  variable gfd4 word 2728
  place p1026c
  place p102a1
  place p10301
  call fence 0 sym eti_null
  set global half 3270 to 3
  set h_rdx to addr g1270
  call copyvar addr gfcc h_rdx
  set h_rax to answer
  and 0 into global half 2826
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p1035e
  end
  place p1034e
  place t1034e_1 on 1
  set h_rax to global half 2818
  set global half 2814 to h_rax
  go to p10390
  place p1035e
  set h_rax to global half 2822
  set global half 2814 to h_rax
  set global half 3270 to 5
  set h_rdx to 30
  call if_testgt_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p10390
  end
  place p10387
  set global half 2826 to 1
  place p10390
  set h_rax to addr gfd4
  set vf8 to addr gfd4
  place p103ac
  place t103ac_2 on 2
  place t103ac_3 on 3
  call set_num_formants
  set h_rax to answer
  place p103b4
  place t103b4_4 on 4
  set global half 3270 to 1
  set h_rdx to addr g1270
  call copyvar addr gfd4 h_rdx
  set h_rax to answer
  if global half 2826 is not 1
    go to p10417
  end
  place p103d9
  set h_rax to 10000000
  set global word 2752 to 10000000
  set global word 2760 to 10000000
  set global word 2736 to 0
  set h_rax to 900000
  set global word 2744 to 900000
  set h_xmm0 to 50000
  go to p1054c
  place p10417
  place t10417_5 on 5
  if global half 2726 is not 3
    go to p10479
  end
  place p10421
  set h_rax to 10000000
  set global word 2752 to 10000000
  set global word 2760 to 10000000
  set h_rax to 1000000
  set global word 2736 to 1000000
  set h_rax to 150000
  set global word 2744 to 150000
  set h_rax to 70000
  set global word 2776 to 70000
  set h_xmm0 to 70000
  go to p1054c
  place p10479
  place t10479_7 on 7
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p104f1
  end
  place p10494
  place t10494_8 on 8
  set h_rax to 3500000
  set global word 2752 to 3500000
  set h_rax to 5000000
  set global word 2760 to 5000000
  set global word 2768 to 5000000
  set global word 2736 to 0
  set h_rax to 900000
  set global word 2744 to 900000
  set h_rax to 40000
  set global word 2776 to 40000
  set h_xmm0 to 40000
  go to p1054c
  place p104f1
  set h_rax to 3500000
  set global word 2752 to 3500000
  set h_rax to 5000000
  set global word 2760 to 5000000
  set global word 2768 to 5000000
  set global word 2736 to 0
  set h_rax to 900000
  set global word 2744 to 900000
  set h_rax to 30000
  set global word 2776 to 30000
  set h_xmm0 to 30000
  place p1054c
  set h_rax to global signed half 2730
  add -100 to h_rax
  set h_xmm1 to h_rax
  multiply 10000 into h_xmm1
  scale h_xmm1 by 2500 over 10000
  add h_xmm0 to h_xmm1
  set global word 2776 to h_xmm1
  set h_rax to 60000
  set global word 2792 to 60000
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  set h_xmm0 to -30000
  if h_rax is 0
    go to p105aa
  end
  place p105a2
  place t105a2_9 on 9
  set h_xmm0 to -50000
  place p105aa
  set global word 2800 to h_xmm0
  place p105b2
  place t105b2_10 on 10
  call starttest 11
  set h_rax to answer
  call bspush_ca 12
  set h_rax to answer
  set global half 3270 to 4
  set h_rdx to 0
  place p105da
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p10633
  end
  set unwind to 0
  backtrack
  place p10612
  place t10612_12 on 12
  set global half 3270 to 4
  set h_rdx to 2
  go to p105da
  place p10626
  place t10626_6 on 6
  set h_xmm0 to global word 2776
  go to p1054c
  place p10633
  place t10633_13 on 13
  set h_xmm0 to 0
  go to p1065b
  place p10638
  place t10638_11 on 11
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p1068d
  end
  place p10653
  place t10653_15 on 15
  set h_xmm0 to -100000
  place p1065b
  set global word 2784 to h_xmm0
  place p10663
  place t10663_14 on 14
  set global half 3270 to 8
  set h_rdx to addr g1270
  call copyvar addr g1068 h_rdx
  set h_rax to answer
  match
  place p1068d
  set h_xmm0 to -70000
  go to p1065b
end

rule set_num_formants takes 1
  instead
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local s107e7
  local s10800
  local n107ac_0
  variable g1270 word 3268
  place p106d8
  place p10709
  place p10765
  call fence 0 sym eti_null
  set h_rax to global half 2830
  if h_rax is 0
    go to p107cc
  end
  place p10779
  set global half 2726 to h_rax
  place p10780
  set global half 3270 to 3
  set h_rdx to 8000
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p107a1
  set h_rax to global half 2726
  set h_rcx to h_rax
  decrement h_rcx
  set n107ac_0 to h_rax
  shift left 16 into n107ac_0
  shift right 16 into n107ac_0
  set h_rax to 3
  if n107ac_0 is at least 3
    set h_rax to h_rcx
  end
  set global half 2726 to h_rax
  match
  place p107cc
  set global half 3270 to 3
  set h_rdx to 16000
  call if_testeq_v_i addr g1270 h_rdx
  set s107e7 to answer
  set h_rax to s107e7
  set h_r15 to h_rax
  set global half 3270 to 4
  set h_rdx to 0
  call if_testeq_v_i addr g1270 h_rdx
  set s10800 to answer
  set h_rax to s10800
  if h_r15 is 0
    go to p10855
  end
  place p1080a
  if h_rax is 0
    go to p10878
  end
  place p1080e
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p10780
  end
  place p1082d
  set global half 3270 to 5
  set h_rdx to 30
  call if_testge_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p108a1
  end
  place p10848
  set global half 3270 to 5
  set h_rdx to 40
  go to p10883
  place p10855
  if h_rax is 0
    go to p108af
  end
  place p10859
  set global half 3270 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p10780
  end
  place p10878
  set global half 3270 to 5
  set h_rdx to 30
  place p10883
  call if_testge_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to p108a1
  end
  place p10893
  set global half 2726 to 5
  go to p10780
  place p108a1
  set global half 2726 to 4
  go to p10780
  place p108af
  set global half 2726 to 7
  go to p10780
end
