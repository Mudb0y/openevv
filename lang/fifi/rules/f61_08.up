end

rule init_voice_vars takes 1
  instead
  local cf0 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local h_rax
  local h_xmm0
  local n12061_0
  local scratch
  variable g1270 word 3268
  variable g14d0 word 3672
  variable g14e0 word 3680
  variable g1500 word 3696
  variable g6d8 word 972
  variable g6e8 word 980
  variable gcdc word 2166
  variable gce0 word 2170
  variable gce4 word 2174
