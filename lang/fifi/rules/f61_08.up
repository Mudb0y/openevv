  call bspush_ca 2
  set global half 3270 to 10
  call npush_v addr g1270
  set global half 3374 to 10
  call npush_v addr g12f0
  call if_testneq
  if answer is not 0
    go to p11bbf
  end
  place p11b82
  place t11b82_3 on 3
  call starttest 1
  call move_i addr cf0 5
  call insert_f0 addr g310 addr cf0 addr g136c
  if answer is 0
