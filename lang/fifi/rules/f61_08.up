  end
  place p11836
  go to p1193d
  place p1183b
  place t1183b_9 on 9
  set h_r12 to unwind
  call advance_tok
  set s1183e to answer
  set h_rax to s1183e
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1184e
  go to p117fe
  place p11850
  place t11850_14 on 14
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  call advanc
  set s1185b to answer
  set h_rax to s1185b
  set h_rsi to h_r12
  if h_rax is not 0
