rule insert_phrase_final_tones takes 1
  instead
  place p119b8
  place p119e7
  place p11a3d
  call fence 0 sym eti_null
  if global half 1306 is not global half 386
    match
  end
  place p11a62
  call phrase_tone
  call insert_preset_phrase_tone
  if global half 590 is not global half 510
    match
  end
  place p11a82
  call boundary_tone
  match
end

rule add_f0_for_next_voice takes 1
  instead
  local cf0 bytes 8
  variable g1270 word 3268
  variable g12f0 word 3372
  variable g136c word 3460
