# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule generate_intonation takes 1
  instead
  place p10930
  place p10965
  place p109c5
  call fence 0 sym eti_null
  if global half 514 is not 1
    go to p109e8
  end
  place p109e0
  call add_f0_for_new_voice
  place p109e8
  place p109fa
  place t109fa_1 on 1
  if global half 518 is not 1
    go to p10a0c
  end
  place p10a04
  call init_phrase_inton_vars
  place p10a0c
  place t10a0c_2 on 2
  if global half 514 is not 1
    go to p10a1e
  end
  place p10a16
  call init_word_inton_vars
  place p10a1e
  place t10a1e_3 on 3
  call init_syll_inton_vars
  place p10a26
  place t10a26_4 on 4
  if global half 518 is not 1
    go to p10a38
  end
  place p10a30
  call phr_initial_F0
  place p10a38
  place t10a38_5 on 5
  call is_target_syll
  if answer is not 0
    go to p10ae6
  end
  place p10a48
  if global half 550 is global half 526
    go to p10b25
  end
  place p10a5c
  place t10a5c_7 on 7
  call starttest 9
  call bspush_ca 10
  if global half 554 is global half 526
    go to p10ade
  end
  set unwind to 0
  backtrack
  place p10ab2
  place t10ab2_10 on 10
  if global half 1474 is not global half 2148
    set unwind to 0
    backtrack
  end
  place p10ac2
  go to p10ade
  place p10ac4
  place t10ac4_9 on 9
  if global half 542 is not global half 526
    go to p10ade
  end
  place p10ad4
  call prenucl_f0
  go to p10ae6
  place p10ade
  place t10ade_11 on 11
  place t10ade_13 on 13
  call postnucl_f0
  place p10ae6
  place t10ae6_6 on 6
  place t10ae6_8 on 8
  place t10ae6_12 on 12
  place t10ae6_14 on 14
  call first_postnucl_accent
  place p10aee
  place t10aee_15 on 15
  call insert_target_t3
  place p10af6
  place t10af6_16 on 16
  call insert_phrase_final_tones
  place p10afe
  place t10afe_17 on 17
  if global half 1306 is not global half 502
    match
  end
  place p10b0e
  call add_f0_for_next_voice
  match
  place p10b25
  call nucl_f0
  go to p10ae6
  place tm_18 on 18
  match
end

rule add_f0_for_new_voice takes 1
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c118 bytes 8
  local v100 word
  local v108 word
  variable g1270 word 3268
  variable g12b0 word 3320
  variable g300 word 420
  place p10b7c
  place p10bb5
  place p10c18
  call push_ptr_init addr c118
  set cf4 to 65532
  set cf0 to 65532
  call fence 0 sym eti_null
  call lpta_loadp addr g300
  call setscan_l 4
  if answer is not 0
    match
  end
  place p10c66
  call advance_tok
  if answer is not 0
    match
  end
  place p10c76
  set v108 to addr g300
  call starttest_l 1
  call bspush_ca 2
  set global half 3270 to 10
  set v100 to addr g1270
  call npush_v addr g1270
  set global half 3322 to 10
  call npush_v addr g12b0
  call if_testneq
  if answer is not 0
    go to p10d86
  end
  place p10ce0
  go to p10ce7
  place p10ce7
  place t10ce7_3 on 3
  call init_voice_vars
  place p10cef
  place t10cef_4 on 4
  call lpta_loadp addr g300
  call setscan_l 2
  if answer is not 0
    match
  end
  place p10d09
  call test_string_s 2 1 sym eti_s_fb05c
  if answer is not 0
    match
  end
  place p10d26
  place t10d26_5 on 5
  call savescptr 5 addr c118
  call starttest_l 1
  call move_i addr cf4 95
  call move_i addr cf0 50
  call insert_f0 addr c118 addr cf4 addr cf0
  if answer is 0
    match
  end
  place p10d86
  set unwind to 0
  backtrack
  place p10dc0
  place t10dc0_2 on 2
  set global half 3270 to 9
  call npush_v addr g1270
  set global half 3322 to 9
  call npush_v addr g12b0
  call if_testneq
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p10df6
  go to p10ce7
  place tm_1 on 1
  match
end

rule init_phrase_inton_vars takes 1
  instead
  local cf0 bytes 8
  variable g1500 word 3696
  variable g278 word 328
  variable g5a8 word 820
  variable g5b8 word 828
  place p10e18
  place p10e4b
  place p10ea9
  call push_ptr_init addr cf0
  call fence 0 sym eti_null
  set global half 706 to global half 1310
  set global half 390 to global half 542
  set global half 526 to global half 542
  and 0 into global half 3510
  or -1 into global half 3426
  set global half 3498 to 1
  set global half 3430 to 25
  set cell cf0 value to global word 832
  call estimate_nsylls addr g5a8 addr cf0 addr g1500
  call init_voice_vars
  call init_nuclwrd_vars
  if global half 1474 is not global half 2148
    match
  end
  place p10f5c
  call num_words_in_range addr g5a8 addr g5b8 addr g278
  match
end

rule init_word_inton_vars takes 1
  instead
  local h_rcx
  variable g280 word 332
  variable g6c8 word 964
  place p10f8a
  place p10fb7
  place p1100f
  call fence 0 sym eti_null
  set h_rcx to global half 558
  if global half 550 is not global half 390
    go to p11040
  end
  place p11037
  set global half 390 to h_rcx
  match
  place p11040
  if h_rcx is global half 390
    match
  end
  place p11045
  call lpta_loadpn addr g280
  call rpta_loadpn addr g6c8
  call compare_ptas
  if answer is not 0
    match
  end
  place p1106f
  call testeq
  if answer is 0
    go to p1108a
  end
  match
  place p1108a
  set h_rcx to global half 550
  go to p11037
end

rule init_syll_inton_vars takes 1
  instead
  local h_rcx
  place p11098
  place p110c5
  place p1111d
  call fence 0 sym eti_null
  set global word 660 to global word 2224
  set global word 668 to global word 2224
  set h_rcx to global half 526
  if global half 550 is not h_rcx
    go to p11161
  end
  place p1115d
  set h_rcx to global half 554
  go to p11183
  place p11161
  if global half 554 is not h_rcx
    go to p1116f
  end
  place p11166
  set h_rcx to global half 558
  go to p11183
  place p1116f
  if global half 550 is not global half 390
    match
  end
  place p11178
  set h_rcx to global half 550
  if global half 550 is not global half 530
    match
  end
  place p11183
  set global half 526 to h_rcx
  match
end

rule is_target_syll takes 1
  instead
  place p1119e
  place p111cb
  place p1121f
  call fence 0 sym eti_null
  if global half 3562 is not global half 3522
    go to p1124e
  end
  place p11247
  if global signed half 522 is more than 0
    match
  end
  give up
  place p1124e
  if global half 522 is not 1
    give up
  end
  match
end

rule nucl_f0 takes 1
  instead
  local cf0 bytes 8
  local h_rax
  local h_rcx
  local n11346_1
  local n11362_1
  local n1137e_1
  local n1139a_1
  local n113b4_1
  variable g280 word 332
  place p11265
  place p112a2
  place p112d5
  set cf0 to 65532
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 550
  if h_rax is not global half 526
    give up
  end
  place p11304
  place p11316
  place t11316_1 on 1
  call position_t_ptrs
  set h_rax to answer
  place p1131e
  place t1131e_2 on 2
  set h_rcx to global half 2148
  set h_rax to h_rcx
  if global half 2184 is not h_rcx
    go to p11344
  end
  place p11330
  call nucl_high_tone
  set h_rax to answer
  go to p113c5
  place p1133d
  place t1133d_3 on 3
  set h_rax to global half 2148
  place p11344
  set h_rcx to h_rax
  set n11346_1 to h_rax
  and 65535 into n11346_1
  if global half 2188 is not n11346_1
    go to p11360
  end
  place p1134f
  call nucl_low_tone
  set h_rax to answer
  go to p113c5
  place p11359
  place t11359_6 on 6
  set h_rax to global half 2148
  place p11360
  set h_rcx to h_rax
  set n11362_1 to h_rax
  and 65535 into n11362_1
  if global half 2196 is not n11362_1
    go to p1137c
  end
  place p1136b
  call nucl_low_high_star_tone
  set h_rax to answer
  go to p113c5
  place p11375
  place t11375_8 on 8
  set h_rax to global half 2148
  place p1137c
  set h_rcx to h_rax
  set n1137e_1 to h_rax
  and 65535 into n1137e_1
  if global half 2192 is not n1137e_1
    go to p11398
  end
  place p11387
  call nucl_low_star_high_tone
  set h_rax to answer
  go to p113c5
  place p11391
  place t11391_10 on 10
  set h_rax to global half 2148
  place p11398
  set h_rcx to h_rax
  set n1139a_1 to h_rax
  and 65535 into n1139a_1
  if global half 2204 is not n1139a_1
    go to p113b4
  end
  place p113a3
  call nucl_high_low_star_tone
  set h_rax to answer
  go to p113c5
  place p113ad
  place t113ad_12 on 12
  set h_rax to global half 2148
  place p113b4
  set n113b4_1 to h_rax
  and 65535 into n113b4_1
  if global half 2200 is not n113b4_1
    go to p113c5
  end
  place p113bd
  call nucl_high_star_low_tone
  set h_rax to answer
  place p113c5
  place t113c5_4 on 4
  place t113c5_5 on 5
  place t113c5_7 on 7
  place t113c5_9 on 9
  place t113c5_11 on 11
  place t113c5_13 on 13
  place t113c5_14 on 14
  call starttest 15
  set h_rax to answer
  call lpta_loadp addr g280
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p11471
  end
  place p113e6
  set h_rcx to 1
  call testFldeq 4 5 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p113fb
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p11407
  call starttest_l 15
  set h_rax to answer
  call move_i addr cf0 3
  set h_rax to answer
  call modulate_pwind addr cf0
  set h_rax to answer
  if h_rax is 0
    go to p11471
  end
  set unwind to 0
  backtrack
  place p11471
  place t11471_15 on 15
  set h_rax to global word 432
  set global word 496 to h_rax
  match
end

rule first_postnucl_accent takes 1
  instead
  place p114f8
  place p11525
  place p11554
  call fence 0 sym eti_null
  if global half 554 is not global half 526
    give up
  end
  place p11575
  if global half 590 is not global half 510
    go to p115aa
  end
  give up
  place p115aa
  if global half 3562 is not global half 3522
    match
  end
  place p115ba
  call fin_first_postnucl_accent
  match
end

