rule phr_prediction_anno takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local h_rcx
  local s1a777
  variable gca4 word 2110
  place p1a558
  place p1a59a
  place p1a5fd
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c130 arg 2 h_rcx
  set h_rcx to -6
  call get_parm addr c100 arg 3 h_rcx
  call push_ptr_init addr c110
  set cf0 to 65532
  call fence 0 sym eti_null
  call lpta_loadp addr c130
  call setscan_r 1
  if answer is 0
    go to p1a67f
  end
  give up
