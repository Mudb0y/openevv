# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule process_annotation takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local v118 word
  local h_r14
  local h_rcx
  local h_rsi
  local s195ba
  local s195d9
  local s19632
  local s196f0
  local s19818
  local s1983b
  local s1985e
  local s19881
  local s198a4
  local s1994b
  local s19979
  place p194c3
  set h_r14 to arg 1
  place p19502
  place p19565
  set h_rsi to addr c110
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c128
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  call fence 0 sym eti_null
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r 1
  set s195ba to answer
  set h_r14 to 0
  if s195ba is not 0
    go to p19601
  end
  place p195ca
  set h_rcx to sym eti_s_fb067
  set h_rsi to 1
  call test_string_s h_rsi 1 h_rcx
  set s195d9 to answer
  set h_r14 to 0
  if s195d9 is not 0
    go to p19601
  end
  place p195e5
  set v118 to arg 2
  set h_rcx to 2
  go to p19642
  place p195f6
  place t195f6_1 on 1
  set h_r14 to unwind
  place p19601
  set v118 to arg 2
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p19622
  set h_rcx to sym eti_s_fb068
  set h_rsi to 1
  call test_string_s h_rsi 2 h_rcx
  set s19632 to answer
  set h_rcx to 5
  if s19632 is not 0
    give up
  end
  place p19642
  set h_rsi to h_rcx
  place p19657
  call savescptr h_rsi addr c100
  place p1965f
  place t1965f_3 on 3
  set h_r14 to unwind
  set h_rsi to addr c110
  call is_afterslash_char h_rsi addr c128
  if answer is 0
    go to p19a2f
  end
  place p19679
  place t19679_6 on 6
  set h_r14 to unwind
  set h_rsi to addr c110
  set h_rcx to addr c128
  call SPR_anno h_rsi addr c100 h_rcx
  if answer is 0
    go to p19a2f
  end
  place p1969a
  place t1969a_8 on 8
  set h_r14 to unwind
  set h_rsi to addr c100
  call emphasis_anno h_rsi addr c128
  if answer is 0
    go to p19a2f
  end
  place p196b4
  place t196b4_9 on 9
  set h_r14 to unwind
  set h_rsi to addr c110
  set h_rcx to addr c128
  call phr_final_anno h_rsi addr c100 h_rcx
  if answer is 0
    go to p19a2f
  end
  place p196d5
  place t196d5_10 on 10
  set h_r14 to unwind
  set h_rsi to 11
  call starttest h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r 1
  set s196f0 to answer
  set h_rcx to h_r14
  if s196f0 is not 0
    go to p197c1
  end
  place p19700
  set h_r14 to h_rcx
  place p1970a
  set h_rsi to 12
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi 3 h_rcx
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p1972a
  call advance_tok
  if answer is 0
    go to p1970a
  end
  place p19736
  set unwind to h_r14
  backtrack
  place p19738
  place t19738_13 on 13
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p19700
  place p19776
  place t19776_12 on 12
  set h_r14 to unwind
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to 2
  call testFldeq h_rsi 3 h_rcx
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p19796
  call advance_tok
  if answer is 0
    go to p19776
  end
  place p197a2
  set unwind to h_r14
  backtrack
  place p197a4
  place t197a4_16 on 16
  place t197a4_17 on 17
  set h_r14 to unwind
  go to p199a2
  place p197ac
  place t197ac_14 on 14
  set h_r14 to unwind
  set h_rsi to 14
  call savescptr h_rsi addr c128
  place p197ba
  place t197ba_11 on 11
  set h_r14 to unwind
  place p197c1
  set h_rsi to addr c128
  call lpta_loadpn h_rsi
  set h_rsi to addr c100
  call rpta_loadpn h_rsi
  call compare_ptas
  if answer is not 0
    go to p19805
  end
  place p197ee
  call testeq
  if answer is 0
    go to p198b9
  end
  place p197fe
  place p19805
  set h_rsi to addr c110
  set h_rcx to addr c128
  call phr_prediction_anno h_rsi addr c100 h_rcx
  set s19818 to answer
  set h_rcx to h_r14
  if s19818 is 0
    go to p199a2
  end
  place p19828
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call pause_anno h_rsi addr c100 h_rcx
  set s1983b to answer
  set h_rcx to h_r14
  if s1983b is 0
    go to p199a2
  end
  place p1984b
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call textnorm_anno h_rsi addr c100 h_rcx
  set s1985e to answer
  set h_rcx to h_r14
  if s1985e is 0
    go to p199a2
  end
  place p1986e
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call environment_anno h_rsi addr c100 h_rcx
  set s19881 to answer
  set h_rcx to h_r14
  if s19881 is 0
    go to p199a2
  end
  place p19891
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call voice_anno h_rsi addr c100 h_rcx
  set s198a4 to answer
  set h_rcx to h_r14
  if s198a4 is not 0
    go to p19938
  end
  place p198b4
  go to p199a2
  place p198b9
  set h_rsi to addr c110
  call single_chars h_rsi addr c128
  go to p199a2
  place p198d7
  place t198d7_15 on 15
  set h_r14 to unwind
  go to p197fe
  place p198e3
  place t198e3_18 on 18
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p19828
  place p198f5
  place t198f5_19 on 19
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1984b
  place p19907
  place t19907_20 on 20
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1986e
  place p19919
  place t19919_21 on 21
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p19891
  place p1992b
  place t1992b_22 on 22
  set h_r14 to unwind
  set h_rcx to h_r14
  place p19938
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call word_accent_anno h_rsi addr c100 h_rcx
  set s1994b to answer
  set h_rcx to h_r14
  if s1994b is not 0
    go to p19966
  end
  place p19957
  go to p199a2
  place p19959
  place t19959_23 on 23
  set h_r14 to unwind
  set h_rcx to h_r14
  place p19966
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call dict_anno h_rsi addr c100 h_rcx
  set s19979 to answer
  set h_rcx to h_r14
  if s19979 is not 0
    go to p1998d
  end
  place p19985
  go to p199a2
  place p19987
  place t19987_24 on 24
  set h_r14 to unwind
  set h_rcx to h_r14
  place p1998d
  set h_r14 to h_rcx
  set h_rsi to addr c110
  call handle_invalid_anno h_rsi addr c128
  place p199a2
  set h_rsi to 7
  call starttest h_rsi
  set h_rsi to 25
  call bspush_ca_boa h_rsi
  set h_rsi to addr c128
  call legal_end_of_anno h_rsi
  if answer is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p199d5
  place t199d5_2 on 2
  set h_r14 to unwind
  set h_rsi to 2
  go to p19657
  place p199e4
  place t199e4_5 on 5
  set h_r14 to unwind
  set h_rcx to 5
  go to p19642
  place p199f5
  place t199f5_25 on 25
  set h_r14 to unwind
  call bspop_boa
  call lpta_loadp addr c128
  set h_rcx to sym eti_s_fb06a
  set h_rsi to 1
  call insert_r h_rsi 2 h_rcx 0
  place p19a2f
  place t19a2f_7 on 7
  set h_r14 to unwind
  set h_rcx to arg 2
  put cell c128 value into arg 2 at 4
  set h_r14 to 0
  match
end

rule is_afterslash_char takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p19ab0
  place p19af3
  place p19b26
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p19b7d
  call testFldeq 1 2 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p19b91
  call advance_tok
  if answer is 0
    go to p19bc1
  end
  set unwind to 0
  backtrack
  place p19bc1
  call single_chars_to_punct addr c110 addr c100
  place p19bd7
  place t19bd7_2 on 2
  place t19bd7_3 on 3
  put cell c100 value into arg 2 at 4
  match
end

rule SPR_anno takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable ga40 word 1556
  place p19c17
  place p19c5d
  place p19c90
  call get_parm addr c110 arg 1 -6
  call get_parm addr c130 arg 2 -6
  call get_parm addr c100 arg 3 -6
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  call lpta_loadp addr c130
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p19d03
  call test_string_s 1 1 sym eti_s_fb08f
  if answer is not 0
    give up
  end
  place p19d1b
  call savescptr 2 addr c120
  call handle_SPR addr c110 addr c120 addr c100 addr ga40
  if answer is 0
    go to p19d6c
  end
  place p19d54
  call handle_invalid_anno addr c110 addr c100
  go to p19d7a
  place p19d6c
  set global half 1546 to global half 1566
  place p19d7a
  put cell c100 value into arg 3 at 4
  match
end

rule emphasis_anno takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  local h_rdx
  local h_rsi
  variable g6f8 word 988
  variable gbd8 word 1964
  variable gbdc word 1968
  variable gbe4 word 1976
  variable gbec word 1984
  variable gbf0 word 1988
  variable gbf4 word 1992
  variable ge10 word 2436
  place p19dba
  place p19df5
  place p19e55
  set h_rsi to addr c110
  set h_rdx to arg 1
  call get_parm h_rsi h_rdx -6
  set h_rax to answer
  set h_rsi to addr c100
  set h_rdx to arg 2
  call get_parm h_rsi h_rdx -6
  set h_rax to answer
  set cell cf0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p1a0c1
  end
  place p19ec0
  set h_rsi to 1
  set h_rdx to 3
  call testFldeq h_rsi h_rdx 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p19ed9
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p19ee9
  set h_rsi to addr g6f8
  call savetok h_rsi
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p19f00
  go to p19f07
  place p19f07
  place t19f07_2 on 2
  set h_rsi to 2
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx sym eti_s_fb06c
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p19f35
  set h_rsi to addr g6f8
  set h_rdx to addr cf0
  call token_to_number h_rsi h_rdx
  set h_rax to answer
  set h_rax to cell cf0 field
  if h_rax is above 4
    go to p19ff0
  end
  place p19f5d
  if h_rax is 0
    go to p19fd1
  end
  if h_rax is 1
    go to p19f6d
  end
  if h_rax is 2
    go to p19f86
  end
  if h_rax is 3
    go to p19f9f
  end
  if h_rax is 4
    go to p19fb8
  end
  give up
  place p19f6d
  set h_rsi to addr ge10
  set global half 2438 to 3
  set h_rdx to addr gbdc
  go to p19fe8
  place p19f86
  set h_rsi to addr ge10
  set global half 2438 to 3
  set h_rdx to addr gbd8
  go to p19fe8
  place p19f9f
  set h_rsi to addr ge10
  set global half 2438 to 3
  set h_rdx to addr gbf0
  go to p19fe8
  place p19fb8
  set h_rsi to addr ge10
  set global half 2438 to 3
  set h_rdx to addr gbf4
  go to p19fe8
  place p19fd1
  place t19fd1_3 on 3
  set h_rsi to addr ge10
  set global half 2438 to 3
  set h_rdx to addr gbe4
  place p19fe8
  call copyvar h_rsi h_rdx
  set h_rax to answer
  place p19ff0
  place t19ff0_4 on 4
  place t19ff0_5 on 5
  place t19ff0_6 on 6
  place t19ff0_7 on 7
  place t19ff0_8 on 8
  set global half 2438 to 3
  set h_rsi to addr ge10
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to addr gbd8
  call npush_v h_rsi
  set h_rax to answer
  call if_testlt
  set h_rax to answer
  if h_rax is not 0
    go to p1a181
  end
  place p1a02a
  set h_rsi to 1
  call npush_s h_rsi
  set h_rax to answer
  set global half 2438 to 5
  set h_rsi to addr ge10
  call npop h_rsi
  set h_rax to answer
  set h_rax to global half 3522
  if global half 3534 is h_rax
    go to p1a181
  end
  place p1a05d
  if global half 3554 is h_rax
    go to p1a181
  end
  place p1a06a
  set global half 2438 to 3
  set h_rsi to addr ge10
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to addr gbf0
  call npush_v h_rsi
  set h_rax to answer
  call if_testlt
  set h_rax to answer
  if h_rax is not 0
    go to p1a181
  end
  place p1a09d
  set h_rsi to 3
  call npush_s h_rsi
  set h_rax to answer
  set global half 2438 to 4
  set h_rsi to addr ge10
  call npop h_rsi
  set h_rax to answer
  go to p1a1e4
  place p1a0c1
  place t1a0c1_1 on 1
  set h_rsi to 11
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p1a0e6
  set h_rsi to 1
  set h_rdx to 2
  call test_string_s h_rsi h_rdx sym eti_s_fb06d
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p1a103
  place t1a103_12 on 12
  set h_rsi to 12
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx sym eti_s_fb06c
  set h_rax to answer
  if h_rax is 0
    go to p1a162
  end
  set unwind to 0
  backtrack
  place p1a162
  set h_rsi to addr ge10
  set global half 2438 to 3
  set h_rdx to addr gbec
  call copyvar h_rsi h_rdx
  set h_rax to answer
  place p1a181
  place t1a181_9 on 9
  place t1a181_10 on 10
  set global half 2438 to 6
  set h_rsi to addr ge10
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to 0
  call ncompare_s h_rsi
  set h_rax to answer
  call testeq
  set h_rax to answer
  if h_rax is 0
    go to p1a1e8
  end
  place p1a1b2
  place t1a1b2_13 on 13
  set global half 2438 to 6
  set h_rsi to addr ge10
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to 2
  call ncompare_s h_rsi
  set h_rax to answer
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p1a209
  end
  place p1a1e4
  set h_rax to 3
  go to p1a1ea
  place p1a1e8
  set h_rax to 1
  place p1a1ea
  set h_rsi to h_rax
  call npush_s h_rsi
  set h_rax to answer
  set global half 2438 to 6
  set h_rsi to addr ge10
  call npop h_rsi
  set h_rax to answer
  place p1a209
  place t1a209_14 on 14
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
end

rule phr_final_anno takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
