  place p1a429
  place t1a429_4 on 4
  call savescptr 4 addr c110
  place p1a43b
  place t1a43b_2 on 2
  call savescptr 2 addr c100
  go to p1a51e
  place p1a452
  place t1a452_1 on 1
  call lpta_loadp addr c130
  call setscan_r 1
  if answer is not 0
