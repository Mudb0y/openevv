  end
  place p1a46c
  call test_string_s 1 1 sym eti_s_fb070
  if answer is not 0
    give up
  end
  place p1a488
  place t1a488_8 on 8
  call savescptr 8 addr c100
  call starttest_l 9
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p1a51e
  end
  place p1a4ba
  call testFldeq 1 3 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1a4cf
  call advance_tok
  if answer is 0
    go to p1a510
  end
  set unwind to 0
  backtrack
  place p1a510
  set global half 1698 to global half 1714
  place p1a51e
  place t1a51e_5 on 5
  place t1a51e_6 on 6
  place t1a51e_9 on 9
  put cell c100 value into arg 3 at 4
