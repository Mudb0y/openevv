# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule user_rootdict takes 3
  instead
  local c108 bytes 8
  local c118 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local vf8 word
  local v120 word
  local h_r12
  local h_rax
  local h_rsi
  local s1f8a0
  variable ga3c word 1552
  variable gfc4 word 2712
  place p1f728
  set h_r12 to 94
  place p1f767
  place p1f7ca
  set h_rsi to addr c118
  set h_r12 to -6
  call get_parm h_rsi arg 1 -6
  set h_rax to answer
  set h_rsi to addr c108
  call get_parm h_rsi arg 2 -6
  set h_rax to answer
  set h_rsi to addr c140
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  if global half 3718 is 0
    give up
  end
  place p1f835
  set h_rax to addr gfc4
  set vf8 to addr gfc4
  set h_rax to addr ga3c
  set v120 to addr ga3c
  set h_rsi to 3
  set h_r12 to 0
  place p1f869
  if global half 2622 is 1
    give up
  end
  place p1f877
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 4
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rax to 0
  set h_rsi to addr gfc4
  call callUserDictLookup h_rsi addr c118 addr c108
  set s1f8a0 to answer
  set h_rax to s1f8a0
  place p1f8a5
  set h_rsi to 1
  if h_rax is 0
    set unwind to h_rsi
    backtrack
  end
  place p1f8ac
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place p1f8e1
  place t1f8e1_3 on 3
  set h_r12 to unwind
  set h_rsi to 5
  call starttest h_rsi
  set h_rax to answer
  set h_rax to global half 3562
  if h_rax is not global half 3522
    go to p1f95d
  end
  place p1f8fc
  set h_rsi to 6
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c108
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 4
  call lpta_ctxtr h_rsi
  set h_rax to answer
  set h_rsi to addr c140
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to addr c108
  call is_suffix_sequence h_rsi addr c140
  set h_rax to answer
  go to p1f8a5
  place p1f95d
  place t1f95d_5 on 5
  set h_r12 to unwind
  set h_rsi to addr c118
  call is_spr h_rsi addr c130
  set h_rax to answer
  if h_rax is not 0
    go to p1f9be
  end
  place p1f973
  set h_rsi to 10
  call starttest_l h_rsi
  set h_rax to answer
  set h_rsi to 11
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c118
  call handle_SPR h_rsi addr c130 addr c108 addr ga3c
  set h_rax to answer
  go to p1f8a5
  place p1f9ae
  place t1f9ae_2 on 2
  set h_r12 to unwind
  set h_rsi to 3
  go to p1f877
  place p1f9b6
  place t1f9b6_1 on 1
  set h_r12 to unwind
  set h_rsi to 3
  go to p1f869
  place p1f9be
  place t1f9be_9 on 9
  set h_r12 to unwind
  set h_rsi to addr c118
  call isLegalWord h_rsi addr c108
  set h_rax to answer
  if h_rax is not 0
    go to p1fa07
  end
  place p1f9d8
  set h_rsi to addr c118
  call insert_userdict_root h_rsi addr c108
  set h_rax to answer
  place p1f9ee
  place t1f9ee_8 on 8
  place t1f9ee_10 on 10
  place t1f9ee_14 on 14
  set h_r12 to unwind
  set global half 2622 to 1
  match
  place p1f9ff
  place t1f9ff_6 on 6
  place t1f9ff_11 on 11
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  place p1fa07
  place t1fa07_13 on 13
  set h_r12 to unwind
  set h_rsi to addr c118
  call user_dict_error h_rsi addr c108 addr gfc4
  set h_rax to answer
  give up
  place p1fa2d
  place t1fa2d_4 on 4
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  give up
end

rule user_dict_error takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  place p1fa74
  place p1fab2
  place p1fb12
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call get_parm addr cf0 arg 3 -4
  call fence 0 sym eti_null
  call callInsertLastDictString addr cf0 addr c100 addr c110
  if global half 2718 is not cell cf0 field
    match
  end
  place p1fb93
  set global half 1550 to 1
  match
end

