rule insert_userdict_root takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p1ff74
  place p1ffb3
  place p20016
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  set global half 2622 to 1
  if global half 3550 is global half 3522
    go to p20084
  end
  place p2006e
  call convert_to_lowercase addr c110 addr c100
  place p20084
  place p2009c
  place t2009c_1 on 1
  call starttest 2
  call internal_dict_lookup addr c110 addr c100
  if answer is 0
    match
  end
  place p200b6
  place t200b6_2 on 2
  call lpta_rpta_loadp addr c110 addr c100
  call insert_2pt_s 3 1 sym eti_s_fb09c 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_3 on 3
  match
end

rule internal_dict_lookup takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  place p2012a
  place p20167
  place p20196
  call get_parm addr c100 arg 1 -6
  call get_parm addr cf0 arg 2 -6
  call fence 0 sym eti_null
  if global half 3562 is not global half 3522
    give up
  end
  place p201e5
  call fin_roots addr c100 addr cf0 addr cf0
  if answer is 0
    match
  end
  give up
end

