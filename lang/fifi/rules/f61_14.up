  set h_r12 to unwind
  set h_rdx to addr c120
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to 0
  call print_stream 8 h_rdx h_rcx sym eti_s_f857c
  place p2147a
  place t2147a_3 on 3
  set h_r12 to unwind
  set h_rcx to addr c110
  set h_r15 to h_r12
  set h_rdx to 2
  set h_rcx to 6
  call forto_adv_upto_r 1 h_rdx h_rcx 4 addr c100 addr c110
  if answer is not 0
    go to p2156d
  end
  place p214ae
  place t214ae_1 on 1
  set h_r12 to unwind
  set h_r15 to h_r12
  call lpta_loadpn addr c140
  set h_r14 to addr g4d8
  call rpta_loadpn addr g4d8
  call compare_ptas
  set s214d5 to answer
  set h_r12 to 0
