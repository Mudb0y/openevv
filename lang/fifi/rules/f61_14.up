rule phrase_level_printouts takes 1
  instead
  variable g588 word 804
  variable g598 word 812
  place p21018
  place p21045
  place p21099
  call fence 0 sym eti_null
  if global half 2302 is not 3
    match
  end
  place p210ab
  call print_normalized_inp addr g588 addr g598
  match
end

rule init_gcat_vars takes 1
  instead
  place p210d2
  place p21105
  place p21134
  call fence 0 sym eti_null
  and 0 into global half 2006
  match
end

rule reset_gcat_vars takes 1
  instead
  place p21173
  place p211a6
  place p211d5
  call fence 0 sym eti_null
  match
end

rule print_normalized_inp takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local h_r12
  local h_r14
  local h_r15
  local h_rcx
  local h_rdx
  local s21389
  local s213d2
  local s2143d
  local s214d5
  local s214e8
  local s2152d
  local s215d6
  variable g4d8 word 716
  variable g4e8 word 724
  place p2120c
  set h_r14 to arg 2
  set h_r15 to arg 1
  set h_r12 to 94
  place p2124b
  go to p212b1
  place p2127a
  set h_rcx to 0
  match
  place p212b1
  set h_r12 to addr c150
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c150 h_rdx h_rcx
  set h_r15 to addr c140
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c140 h_rdx h_rcx
  set h_r14 to addr c100
  call push_ptr_init addr c100
  call push_ptr_init addr c120
  call push_ptr_init addr c110
  call push_ptr_init addr c130
  call fence 0 sym eti_null
  call startloop 1
  call lpta_loadpn addr c150
  set h_r12 to 4
  call lpta_mover 4
  call lpta_storep addr c100
  call lpta_loadpn addr c140
  call lpta_mover 4
  call lpta_storep addr c110
  set h_rdx to addr c110
  call forall_to_test addr c100 h_rdx
  set s21389 to answer
  set h_r14 to 0
  set h_r15 to 0
  if s21389 is not 0
    go to p2156d
  end
  place p2139c
  go to p213a6
  place p213a3
  place t213a3_6 on 6
  set h_r12 to unwind
  set h_r14 to h_r12
  place p213a6
  call bspush_ca 3
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is 0
