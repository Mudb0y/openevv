  set h_r15 to h_r12
  call starttest 5
  set h_r14 to addr c100
  call lpta_loadpn addr c100
  call lpta_movel 4
  set h_r12 to addr c130
  call lpta_storep addr c130
  set h_rdx to addr c100
  call print_interword_chars addr c130 h_rdx
  set s2143d to answer
