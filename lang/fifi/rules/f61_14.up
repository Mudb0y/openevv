  end
  place p21539
  set h_r15 to h_rcx
  call bspush_ca_scan 11
  call bspush_ca_scan_boa 12
  set h_r14 to 1
  set h_rdx to 3
  set h_rcx to 4
  call testFldeq 1 h_rdx h_rcx
  if answer is 0
    set h_r15 to 1
  end
  place p2156d
  set h_r12 to h_r15
  set h_r14 to sym eti_s_fb0a3
  set unwind to h_r12
  backtrack
  place p215b3
  place t215b3_11 on 11
  set h_r12 to unwind
  call bspush_ca_scan 14
  set h_rdx to 1
  set h_rcx to sym eti_s_fb0a2
  go to p215f2
  place p215cb
  place t215cb_12 on 12
  set h_r12 to unwind
  call bspop_boa
  call advance_tok
