  place p25060
  go to p250f8
  go to p25065
  place t25065_5 on 5
  set h_r14 to unwind
  set h_rcx to unwind
  place p25065
  set h_rcx to h_r14
  place p25068
  set h_r14 to h_rcx
  set h_rsi to 4
  call starttest h_rsi
  set h_rsi to addr c120
  call lang_non_phrasal_comma h_rsi
