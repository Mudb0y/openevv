# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule build_phrases takes 3
  instead
  local c108 bytes 8
  local c118 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local vf8 word
  local v120 word
  local h_r14
  local h_rsi
  local s2428e
  local s242b6
  local s242c9
  local s24330
  variable g578 word 796
  variable g588 word 804
  variable g598 word 812
  place p23f80
  place p23fbb
  place p2401b
  set h_r14 to addr c118
  set h_rsi to addr c118
  call get_parm h_rsi arg 1 -6
  set h_rsi to addr c140
  call get_parm h_rsi arg 2 -6
  set h_rsi to addr c108
  call push_ptr_init h_rsi
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to addr g578
  call lpta_loadpn h_rsi
  set h_rsi to addr c118
  call rpta_loadpn h_rsi
  set h_rsi to 4
  call rpta_ctxtl h_rsi
  call compare_ptas
  if answer is not 0
    go to p240cf
  end
  place p240bf
  call testeq
  if answer is 0
    give up
  end
  place p240cf
  set vf8 to addr g588
  set v120 to addr g598
  set h_rsi to 2
  set h_r14 to 0
  place p24100
  call starttest h_rsi
  set h_rsi to 3
  call bspush_ca_boa h_rsi
  call lpta_loadp addr c118
  set h_rsi to 5
  call lpta_tstctxtl h_rsi
  if answer is not 0
    go to p24168
  end
  place p2413c
  set h_rsi to 5
  call lpta_tstmovel h_rsi
  if answer is not 0
    go to p24168
  end
  place p2414b
  set h_rsi to 4
  call setscan_r h_rsi
  if answer is not 0
    go to p24168
  end
  place p2415a
  call advance_tok
  if answer is 0
    set h_r14 to 1
  end
  place p24168
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place p241a4
  place t241a4_2 on 2
  set h_r14 to unwind
  if global signed half 1538 is more than global signed half 1470
    go to p241ca
  end
  place p241b4
  set h_rsi to addr c118
  call delimit_sentence h_rsi addr c140
  place p241ca
  place t241ca_4 on 4
  set h_r14 to unwind
  set h_rsi to addr c118
  call delimit_major_phrase h_rsi
  place p241d9
  place t241d9_5 on 5
  set h_r14 to unwind
  call mark_word_categories
  place p241e1
  place t241e1_6 on 6
  set h_r14 to unwind
  call apply_comma_phr_rules
  place p241e9
  place t241e9_7 on 7
  set h_r14 to unwind
  set h_rsi to addr c118
  call insert_major_phrase h_rsi addr c140
  place p241ff
  place t241ff_8 on 8
  set h_r14 to unwind
  if global half 3546 is global half 3522
    go to p24340
  end
  place p24213
  if global half 3558 is global half 3522
    go to p24340
  end
  place p24220
  set h_rsi to 9
  call startloop h_rsi
  set h_rsi to addr g588
  call lpta_loadpn h_rsi
  set h_rsi to 5
  call lpta_mover h_rsi
  set h_rsi to addr c108
  call lpta_storep h_rsi
  set h_rsi to addr g598
  call lpta_loadpn h_rsi
  set h_rsi to 5
  call lpta_mover h_rsi
  set h_rsi to addr c130
  call lpta_storep h_rsi
  set h_rsi to addr c108
  call forall_to_test h_rsi addr c130
  set s2428e to answer
  set h_rsi to h_r14
  if s2428e is not 0
    set unwind to h_rsi
    backtrack
  end
  place p2429e
  place t2429e_13 on 13
  set h_r14 to unwind
  set h_rsi to 11
  call bspush_ca h_rsi
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 5
  set s242b6 to answer
  set h_rsi to h_r14
  if s242b6 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p242c6
  call advance_tok
  set s242c9 to answer
  set h_rsi to h_r14
  if s242c9 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p242d9
  place t242d9_12 on 12
  set h_r14 to unwind
  set h_rsi to 12
  call savescptr h_rsi addr c150
  place p242eb
  place t242eb_10 on 10
  set h_r14 to unwind
  set h_rsi to 11
  call starttest h_rsi
  set h_rsi to addr c108
  call adjust_words_in_phrase h_rsi addr c150
  place p2430c
  place t2430c_11 on 11
  set h_r14 to unwind
  set h_rsi to 9
  call forto_adv_upto_r h_rsi 10 13 5 addr c108 addr c130
  set s24330 to answer
  set h_rsi to h_r14
  if s24330 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p24340
  place t24340_9 on 9
  set h_r14 to unwind
  set h_rsi to 14
  call starttest h_rsi
  set h_rsi to addr c140
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    match
  end
  place p24361
  place t24361_16 on 16
  set h_r14 to unwind
  set h_rsi to 15
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_fb0b5
  if answer is 0
    go to p24361
  end
  place p24381
  go to p24168
  place p24386
  place t24386_1 on 1
  set h_r14 to unwind
  set h_rsi to 2
  go to p24100
  place p2438e
  place t2438e_3 on 3
  set h_r14 to unwind
  call bspop_boa
  give up
  place p2439b
  place t2439b_15 on 15
  set h_r14 to unwind
  set h_rsi to 15
  call savescptr h_rsi addr g588
  match
  place tm_14 on 14
  match
end

rule delimit_sentence takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable g4c8 word 708
  variable g4d8 word 716
  variable g4e8 word 724
  place p24404
  place p2443f
  place p2449f
  call get_parm addr c130 arg 1 -6
  call get_parm addr c120 arg 2 -6
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  set global half 1364 to 1
  call lpta_loadpn addr c130
  call lpta_ctxtl 4
  call lpta_movel 4
  call lpta_storep addr g4d8
  call lpta_loadpn addr g4c8
  call lpta_mover 4
  call lpta_storep addr g4c8
  call lpta_loadp addr g4c8
  call proj_def 5
  call lpta_loadp addr g4d8
  call proj_def 5
  set global word 728 to cell c120 value
  call lpta_loadp addr c120
  call proj_def_mult 8 sym eti_s_fb0b6 addr g4e8
  call starttest 1
  call bspush_ca_boa 2
  call lpta_loadp addr g4e8
  call setscan_l 0
  if answer is 0
    set unwind to 1
  end
  if answer is not 0
    set unwind to 0
  end
  backtrack
  place p2464f
  place t2464f_2 on 2
  call bspop_boa
  call divide_char_count_token addr g4e8
  place p24662
  place t24662_1 on 1
  set global word 760 to global word 2224
  set global word 768 to global word 2224
  set cell c110 value to global word 2224
  set cell c100 value to global word 2224
  match
end

rule delimit_major_phrase takes 2
  instead
  local c100 bytes 8
  variable g588 word 804
  variable g598 word 812
  place p24699
  place p246d9
  place p2470c
  call get_parm addr c100 arg 1 -6
  call fence 0 sym eti_null
  call lpta_loadpn addr g588
  call lpta_ctxtr 4
  call lpta_mover 4
  call lpta_storep addr g588
  call lpta_loadpn addr c100
  call lpta_ctxtl 4
  call lpta_movel 4
  call lpta_storep addr g598
  call lpta_loadp addr g588
  call proj_def 5
  call lpta_loadp addr g598
  call proj_def 5
  match
end

