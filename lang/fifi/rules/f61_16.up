  place t24a92_8 on 8
  place t24a92_13 on 13
  call lpta_loadpn addr c138
  call lpta_mover 4
  call lpta_storep addr c128
  call forall_cont_from 2 3 0 addr c148 addr c128
  go to p2497d
  place p24b05
  place t24b05_4 on 4
