  place p250b3
  set h_rcx to h_r14
  place p250b6
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  go to p250f8
  place t250f8_4 on 4
  place t250f8_6 on 6
  set h_r14 to unwind
  set h_rcx to unwind
  place p250f8
  set h_rsi to 2
