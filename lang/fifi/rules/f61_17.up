  place p2c6a3
  set v120 to arg 1
  set v108 to arg 2
  set v110 to arg 4
  place p2c6f5
  set h_rcx to -6
  call get_parm addr c130 arg 1 h_rcx
  set h_rcx to -4
  call get_parm addr cf8 arg 2 h_rcx
  set h_rcx to -4
