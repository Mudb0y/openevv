# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule normalize_text takes 3
  instead
  local c100 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local v108 word
  local v110 word
  local h_rax
  local h_rsi
  local n2d06e_0
  variable g568 word 788
  variable g978 word 1398
  variable g990 word 1424
  place p2cc04
  place p2cc3f
  place p2cc9f
  set h_rsi to addr c140
  call get_parm h_rsi arg 1 -6
  set h_rax to answer
  set h_rsi to addr c120
  call get_parm h_rsi arg 2 -6
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c160
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rax to global word 2224
  set cell c130 value to h_rax
  set cell c100 value to h_rax
  if global half 1360 is not 1
    go to p2cd79
  end
  place p2cd39
  set h_rsi to addr c140
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p2cd79
  end
  place p2cd4f
  set h_rax to cell c120 value
  call lpta_loadp addr c120
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    go to p2d17a
  end
  place p2cd79
  set h_rax to addr g978
  set v110 to addr g978
  set h_rax to addr g568
  set v108 to addr g568
  place p2cda3
  place t2cda3_1 on 1
  and 0 into global half 1404
  set h_rsi to addr g978
  call count_input h_rsi
  set h_rax to answer
  place p2cdba
  place t2cdba_3 on 3
  set h_rsi to 4
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr c140
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to addr c120
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c160
  call lpta_storep h_rsi
  set h_rax to answer
  place p2ce20
  place t2ce20_14 on 14
  set h_rsi to addr c130
  call forall_to_test h_rsi addr c160
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2ce32
  place t2ce32_41 on 41
  set h_rsi to 6
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2ce4f
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p2cebb
  end
  set unwind to 0
  backtrack
  place p2ce90
  place t2ce90_6 on 6
  set h_rsi to 4
  call forto_adv_upto_r h_rsi 5 41 1 addr c130 addr c160
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  match
  place p2cebb
  place t2cebb_5 on 5
  set h_rsi to addr c130
  call reset_token_vars h_rsi
  set h_rax to answer
  place p2cec6
  place t2cec6_7 on 7
  set h_rsi to addr c130
  call merge_adjacent_spaces h_rsi
  set h_rax to answer
  place p2ced1
  place t2ced1_8 on 8
  set h_rsi to addr c130
  call space h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cee7
  place t2cee7_9 on 9
  set h_rsi to addr c130
  call process_annotation h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cefd
  place t2cefd_11 on 11
  set h_rsi to addr c130
  call ellipsis h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cf13
  place t2cf13_12 on 12
  set h_rsi to addr c130
  call three_letter_extension h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2d144
  end
  place p2cf26
  place t2cf26_13 on 13
  set h_rsi to addr c130
  call interpret_single_char_modes h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cf3c
  place t2cf3c_15 on 15
  set h_rsi to addr c130
  call tok_lookup h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2d144
  end
  place p2cf4f
  place t2cf4f_16 on 16
  set h_rsi to addr c130
  call punctuation h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cf65
  place t2cf65_17 on 17
  set h_rsi to addr c130
  call parenthesis h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cf7b
  place t2cf7b_18 on 18
  set h_rsi to addr c130
  call apostrophe h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cf91
  place t2cf91_19 on 19
  set h_rsi to addr c130
  call email_address h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2d144
  end
  place p2cfa4
  place t2cfa4_20 on 20
  set h_rsi to addr c130
  call URL h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2d144
  end
  place p2cfb7
  place t2cfb7_21 on 21
  set h_rsi to addr c130
  call is_pathname h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2d144
  end
  place p2cfca
  place t2cfca_22 on 22
  set h_rsi to addr c130
  call letter_sequence h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cfdc
  place t2cfdc_23 on 23
  set h_rsi to addr c130
  call convert_digits_to_words h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2cfee
  place t2cfee_24 on 24
  set h_rsi to addr c130
  call hyphen h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2d000
  place t2d000_25 on 25
  set h_rsi to addr c130
  call slash h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2d012
  place t2d012_26 on 26
  set h_rsi to addr c130
  call quote_mark h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2d024
  place t2d024_27 on 27
  set h_rsi to addr c130
  call span_inverted_punct h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2d036
  place t2d036_28 on 28
  set h_rsi to addr c130
  call bracket h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2d056
  end
  place p2d048
  place t2d048_29 on 29
  set h_rsi to addr c130
  call misc_chars h_rsi addr c100
  set h_rax to answer
  place p2d056
  place t2d056_10 on 10
  set h_rsi to addr c130
  call init_ptr_End_reproc_string h_rsi addr c100
  set h_rax to answer
  place p2d064
  place t2d064_30 on 30
  set h_rax to global half 1546
  add -10 to h_rax
  set n2d06e_0 to h_rax
  and 65535 into n2d06e_0
  if n2d06e_0 is below 65527
    go to p2d082
  end
  place p2d074
  set h_rsi to addr c130
  call build_words h_rsi addr c100
  set h_rax to answer
  place p2d082
  place t2d082_31 on 31
  set h_rax to cell c100 value
  set global word 1428 to h_rax
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr g568
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p2d0cb
  end
  place p2d0b6
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p2d0cb
  end
  place p2d0c2
  set global half 1404 to 1
  place p2d0cb
  place t2d0cb_32 on 32
  set h_rsi to addr c100
  call forced_synthesis h_rsi
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2d0de
  place t2d0de_33 on 33
  if global half 1470 is 0
    go to p2d0f6
  end
  place p2d0e8
  set h_rsi to addr c130
  call build_phrases h_rsi addr c100
  set h_rax to answer
  place p2d0f6
  place t2d0f6_34 on 34
  if global half 1404 is 1
    go to p2d15d
  end
  place p2d100
  place t2d100_35 on 35
  if global half 1364 is 1
    match
  end
  place p2d10a
  place t2d10a_40 on 40
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to 4
  call forall_cont_from h_rsi 5 0 addr c130 addr c150
  set h_rax to answer
  go to p2ce20
  place p2d144
  set h_rsi to 4
  call forall_cont_from h_rsi 5 0 addr c130 addr c130
  set h_rax to answer
  go to p2ce20
  place p2d15d
  if global half 1360 is 0
    go to p2d198
  end
  place p2d167
  place t2d167_36 on 36
  if global half 1364 is not 0
    match
  end
  place p2d171
  set h_rsi to addr c100
  go to p2d181
  place p2d17a
  set h_rsi to addr c120
  place p2d181
  call handle_end_of_delta h_rsi
  set h_rax to answer
  match
  place p2d198
  set h_rsi to addr g990
  call create_final_sync h_rsi addr c100
  set h_rax to answer
  match
  place tm_2 on 2
  place tm_4 on 4
  place tm_37 on 37
  place tm_38 on 38
  place tm_39 on 39
  match
end

rule handle_end_of_delta takes 2
  instead
  local cf0 bytes 8
  local h_r14
  local s2d344
  place p2d25c
  set h_r14 to arg 1
  place p2d290
  place p2d2ec
  call get_parm addr cf0 arg 1 -6
  set h_r14 to 0
  call fence 0 sym eti_null
  call starttest 1
  call bspush_ca_boa 2
  call lpta_loadp addr cf0
  call setscan_l 4
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2d341
  call advance_tok
  set s2d344 to answer
  set h_r14 to 0
  set h_r14 to 0
  if s2d344 is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p2d382
  place t2d382_1 on 1
  call create_sentence addr cf0
  match
  place p2d393
  place t2d393_2 on 2
  call bspop_boa
  set global half 1420 to 1
  match
  place tm_3 on 3
  match
end

rule reset_token_vars takes 2
  instead
  local ce0 bytes 8
  local h_rax
  place p2d3b8
  place p2d3ea
  place p2d444
  call get_parm addr ce0 arg 1 -6
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into global half 1838
  set h_rax to 1
  if global half 1842 is 1
    go to p2d496
  end
  place p2d480
  if global half 1846 is not 1
    go to p2d494
  end
  place p2d48a
  if global half 1546 is 0
    go to p2d496
  end
  place p2d494
  set h_rax to 0
  place p2d496
  set global half 1846 to h_rax
  and 0 into global half 1842
  set h_rax to global half 1546
  if h_rax is 0
    go to p2d4b8
  end
  place p2d4b1
  set global half 1542 to h_rax
  place p2d4b8
  and 0 into global half 1546
  and 0 into global half 1602
  and 0 into global half 1630
  and 0 into global half 1830
  and 0 into global half 1754
  and 0 into global half 1470
  and 0 into global half 1722
  and 0 into global half 1550
  and 0 into global half 1458
  and 0 into global half 1738
  set h_rax to global half 3562
  if h_rax is not global half 3522
    match
  end
  place p2d518
  call init_fin_textnorm_vars addr ce0
  set h_rax to answer
  match
end

rule merge_adjacent_spaces takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r12
  local h_r13
  local h_rcx
  local s2d65e
  local s2d696
  place p2d53b
  place p2d577
  place p2d5da
  set h_r13 to addr c120
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  set h_r12 to 0
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c120
  call setscan_l 1
  if answer is 0
    go to p2d64a
  end
  match
  place p2d64a
  set h_rcx to sym eti_s_fb0d4
  call test_string_s 1 1 h_rcx
  set s2d65e to answer
  set h_r13 to 0
  if s2d65e is not 0
    match
  end
  place p2d66e
  set h_r12 to 0
  place p2d671
  place t2d671_2 on 2
  set h_r12 to unwind
  set h_r13 to h_r12
  call savescptr 2 addr c100
  set h_rcx to sym eti_s_fb0d4
  call test_string_s 1 1 h_rcx
  set s2d696 to answer
  set h_rcx to h_r12
  if s2d696 is not 0
    go to p2d6e4
  end
  place p2d6a2
  place t2d6a2_3 on 3
  set h_r12 to unwind
  call savescptr 3 addr c110
  call starttest_l 1
  call bspush_ca_boa 4
  call lpta_loadp addr c100
  call setscan_l 0
  if answer is 0
    set h_r12 to 1
  end
  set h_rcx to h_r12
  place p2d6e4
  set h_r12 to h_rcx
  set unwind to h_r12
  backtrack
  place p2d720
  place t2d720_4 on 4
  set h_r12 to unwind
  call bspop_boa
  call lpta_rpta_loadp addr c110 addr c120
  set h_r13 to 0
  set h_rcx to sym eti_s_fb0d4
  call insert_2pt_s 1 1 h_rcx 0
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  match
  place tm_1 on 1
  match
end

rule space takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p2d780
  place p2d7c3
  place p2d7f6
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p2d84b
  call test_string_s 1 1 sym eti_s_fb0d4
  if answer is not 0
    give up
  end
  place p2d863
  call savescptr 2 addr c100
  put cell c100 value into arg 2 at 4
  match
end

rule ellipsis takes 3
  instead
  local c100 bytes 8
  local c118 bytes 8
  local v108 word
  place p2d8b5
  set v108 to arg 2
  place p2d8f8
  place p2d927
  call get_parm addr c118 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  if global half 1686 is not global half 1674
    go to p2d9ab
  end
  give up
  place p2d9ab
  place p2d9be
  place t2d9be_1 on 1
  call starttest 3
  call lpta_loadp addr c118
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p2d9df
  call bspush_ca_scan 4
  call test_string_s 1 2 sym eti_s_fb106
  if answer is 0
    go to p2db7d
  end
  set unwind to 0
  backtrack
  place p2da3c
  place t2da3c_5 on 5
  place t2da3c_7 on 7
  place t2da3c_9 on 9
  call savescptr 7 addr c100
  set global half 1546 to global half 1590
  call lpta_loadp addr c118
  call lpta_tstctxtl 4
  if answer is not 0
    go to p2da98
  end
  place p2da85
  call setscan_l 5
  if answer is 0
    go to p2dc29
  end
  place p2da98
  place t2da98_11 on 11
  call skip_delimiters addr c100
  place p2daa7
  place t2daa7_14 on 14
  call starttest 15
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p2db9b
  end
  place p2dacc
  call testFldeq 1 3 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2dae5
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2daf5
  go to p2dbd9
  place p2dafa
  call bspush_ca_scan 7
  place p2db05
  place t2db05_8 on 8
  call test_string_s 1 1 sym eti_s_fb10d
  if answer is 0
    go to p2dafa
  end
  place p2db1e
  set unwind to 0
  backtrack
  place p2db23
  place t2db23_4 on 4
  call bspush_ca_scan 8
  call test_string_s 1 3 sym eti_s_fb108
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2db4b
  go to p2db58
  place p2db4d
  call bspush_ca_scan 9
  place p2db58
  place t2db58_10 on 10
  call test_string_s 1 2 sym eti_s_fb10b
  if answer is 0
    go to p2db4d
  end
  place p2db6d
  set unwind to 0
  backtrack
  place p2db72
  call bspush_ca_scan 5
  place p2db7d
  place t2db7d_6 on 6
  call test_string_s 1 1 sym eti_s_fb0db
  if answer is 0
    go to p2db72
  end
  place p2db96
  set unwind to 0
  backtrack
  place p2db9b
  place t2db9b_15 on 15
  call build_phrase_final_structure addr c100
  place p2dbaa
  place t2dbaa_17 on 17
  set global half 1698 to global half 1702
  place p2dbb8
  place t2dbb8_2 on 2
  place t2dbb8_12 on 12
  place t2dbb8_13 on 13
  place t2dbb8_16 on 16
  put cell c100 value into arg 2 at 4
  match
  place p2dbd9
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p2dbb8
  end
  place p2dbef
  call test_string_s 1 1 sym eti_s_fb101
  if answer is not 0
    go to p2dbb8
  end
  place p2dc07
  set global half 1698 to global half 1702
  call punctuation addr c100 addr c100
  go to p2dbb8
  place p2dc29
  call skip_punct_and_delimiters addr c100
  go to p2dbb8
end

rule three_letter_extension takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local h_r15
  local h_rcx
  local h_rsi
  local s2dda2
  local s2ddf5
  local s2de11
  local s2de35
  local s2de67
  local s2de95
  local s2deb5
  local s2ded1
  local s2def1
  local s2df1c
  local s2df78
  local s2dfc4
  place p2dc88
  place p2dcc4
  place p2dcf7
  set h_rsi to addr c100
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c140
  call push_ptr_init h_rsi
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  if global half 1678 is not global half 1674
    give up
  end
  place p2dd6d
  set h_rsi to 3
  set h_r15 to 0
  place p2dd82
  call starttest h_rsi
  set h_rsi to 4
  call bspush_ca h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 4
  set s2dda2 to answer
  set h_rcx to h_r15
  if s2dda2 is 0
    go to p2df4b
  end
  place p2ddb2
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  place p2dde8
  place t2dde8_4 on 4
  set h_r15 to unwind
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 1
  set s2ddf5 to answer
  set h_rsi to h_r15
  if s2ddf5 is not 0
    set unwind to h_rsi
