# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule convert_digits_to_words takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3daaf
  place p3daee
  place p3db1d
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is 0
    go to p3dba4
  end
  give up
  place p3dba4
  call testFldeq 1 3 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p3dbb9
  call advance_tok
  if answer is 0
    go to p3dbf0
  end
  set unwind to 0
  backtrack
  place p3dbf0
  set global half 1546 to global half 1574
  call convert_lang_digits_to_words addr c110 addr c100
  place p3dc14
  place t3dc14_2 on 2
  call separate_tokens addr c100
  place p3dc23
  place t3dc23_3 on 3
  place t3dc23_4 on 4
  put cell c100 value into arg 2 at 4
  match
end

rule convert_digits takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3dc42
  place p3dc85
  place p3dcb4
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call count_digits addr c110 addr c100
  call get_number_info addr c110 addr c100
  call convert_numbers addr c110 addr c100
  call reset_enum_ptr addr c100
  put cell c100 value into arg 2 at 4
  match
end

rule count_digits takes 3
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local vf8 word
  local v110 word
  local v118 word
  local h_r13
  local h_rax
  local h_rsi
  local n3e0b8_0
  variable gb50 word 1828
  variable gb64 word 1848
  place p3dd65
  set vf8 to arg 2
  place p3dda4
  place p3de04
  set h_rsi to addr c138
  call get_parm h_rsi arg 1 -6
  set h_rax to answer
  set h_rsi to addr c128
  call get_parm h_rsi arg 2 -6
  set h_rax to answer
  set cf0 to 65532
  set h_rsi to addr c108
  call push_ptr_init h_rsi
  set h_rax to answer
  call fence 0 sym eti_null
  and 0 into global half 1842
  and 0 into global half 1834
  set h_rax to addr gb50
  set v118 to addr gb50
  and 0 into global half 1830
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rax to 0
  if global half 3526 is not global half 3522
    go to p3deb7
  end
  place p3deb4
  place t3deb4_4 on 4
  set h_r13 to unwind
  set h_rax to 1
  place p3deb7
  set v110 to addr gb64
  set h_rsi to h_rax
  set unwind to h_rsi
  backtrack
  place p3df07
  place t3df07_2 on 2
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  and 0 into global half 1850
  and 0 into cell cf0 field
  set h_rsi to 6
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call copyvar h_rsi addr c138
  set h_rax to answer
  place p3df3c
  place t3df3c_18 on 18
  set h_r13 to unwind
  set h_rsi to 8
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3df60
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3df73
  place t3df73_9 on 9
  set h_r13 to unwind
  set h_rsi to 9
  call savescptr h_rsi addr c108
  set h_rax to answer
  place p3df85
  place t3df85_7 on 7
  set h_r13 to unwind
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p3dfd5
  end
  place p3df97
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_fb165
  set h_rax to answer
  if h_rax is not 0
    go to p3dfd5
  end
  place p3dfb0
  set h_rsi to 10
  call starttest_l h_rsi
  set h_rax to answer
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is 0
    go to p3e235
  end
  place p3dfd5
  place t3dfd5_10 on 10
  set h_r13 to unwind
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p3e025
  end
  place p3dfe7
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_fb166
  set h_rax to answer
  if h_rax is not 0
    go to p3e025
  end
  place p3e000
  set h_rsi to 12
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is 0
    go to p3e16d
  end
  place p3e025
  place t3e025_12 on 12
  set h_r13 to unwind
  set h_rsi to 16
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is 0
    go to p3e05d
  end
  place p3e042
  place t3e042_16 on 16
  set h_r13 to unwind
  set h_rsi to addr gb50
  call c_assvar h_rsi
  set h_rax to answer
  increment global half 1830
  go to p3e146
  place p3e05d
  set h_rsi to 17
  place p3e062
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  place p3e068
  place t3e068_14 on 14
  set h_r13 to unwind
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e084
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    set h_r13 to 1
  end
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place p3e09a
  place t3e09a_3 on 3
  set h_r13 to unwind
  set h_rsi to 5
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rax to global half 3546
  go to p3e0b5
  place p3e0ae
  place t3e0ae_5 on 5
  set h_r13 to unwind
  set h_rax to global half 3550
  place p3e0b5
  set h_rsi to h_r13
  set n3e0b8_0 to h_rax
  and 65535 into n3e0b8_0
  if n3e0b8_0 is not global half 3522
    set unwind to h_rsi
    backtrack
  end
  place p3e0c5
  go to p3deb4
  place p3e0ca
  place t3e0ca_11 on 11
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to addr cf0
  go to p3e13e
  place p3e0de
  place t3e0de_13 on 13
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to 15
  call starttest h_rsi
  set h_rax to answer
  if cell cf0 field is 1
    go to p3e2d4
  end
  place p3e0ff
  place t3e0ff_15 on 15
  set h_r13 to unwind
  set h_rsi to addr c128
  call lpta_rpta_loadp h_rsi addr c108
  set h_rax to answer
  set h_rsi to 1
  call insert_2pt_s h_rsi 1 sym eti_s_fb165 0
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e134
  set h_rsi to addr gb64
  place p3e13e
  call move_i h_rsi 1
  set h_rax to answer
  place p3e146
  place t3e146_8 on 8
  set h_r13 to unwind
  set h_rsi to 6
  call forall_adv_over_r h_rsi 7 18 1 addr c128
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e168
  go to p3e2d4
  place p3e16d
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e189
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e19c
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e1b8
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e1cb
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e1e7
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e1fa
  set h_rsi to 13
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_fb165
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e230
  go to p3e068
  place p3e235
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e251
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e264
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e280
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e293
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e2af
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e2c2
  set h_rsi to 11
  go to p3e062
  place p3e2cc
  place t3e2cc_17 on 17
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  place p3e2d4
  place t3e2d4_1 on 1
  place t3e2d4_6 on 6
  set h_r13 to unwind
  set h_rax to global half 1830
  set global half 1834 to h_rax
  if h_rax is not 1
    go to p3e324
  end
  place p3e2e8
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p3e324
  end
  place p3e2fe
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_fb167
  set h_rax to answer
  if h_rax is not 0
    go to p3e324
  end
  place p3e316
  set h_rax to global half 1306
  set global half 1842 to h_rax
  place p3e324
  place t3e324_19 on 19
  set h_r13 to unwind
  set h_rax to cell c128 value
  put h_rax into arg 2 at 4
  match
end

rule get_number_info takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  place p3e398
  place p3e3d5
  place p3e404
  call get_parm addr c100 arg 1 -6
  call get_parm addr cf0 arg 2 -6
  call fence 0 sym eti_null
  put cell cf0 value into arg 2 at 4
  match
end

rule convert_numbers takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  local h_rcx
  local n3e599_0
  local n3e5a3_0
  place p3e47b
  place p3e4b6
  place p3e516
  set h_rcx to -6
  call get_parm addr c110 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c100 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to global half 1830
  if h_rax is not 1
    go to p3e589
  end
  place p3e559
  call convert_single_digit addr c110 addr c100
  set h_rax to answer
  place p3e56f
  place t3e56f_2 on 2
  place t3e56f_3 on 3
  place t3e56f_5 on 5
  place t3e56f_7 on 7
  place t3e56f_11 on 11
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
  place p3e589
  place p3e597
  set h_rcx to h_rax
  set n3e599_0 to h_rax
  and 65535 into n3e599_0
  if n3e599_0 is 2
    go to p3e67e
  end
  place p3e5a3
  set n3e5a3_0 to h_rax
  and 65535 into n3e5a3_0
  if n3e5a3_0 is 3
    go to p3e663
  end
  place p3e5ad
  place t3e5ad_6 on 6
  call starttest 8
  set h_rax to answer
  call bspush_ca 9
  set h_rax to answer
  if global signed half 1830 is less than 16
    go to p3e62d
  end
  set unwind to 0
  backtrack
  place p3e5fc
  place t3e5fc_9 on 9
  set h_rax to global half 3526
  if h_rax is not global half 3522
    set unwind to 0
    backtrack
  end
  place p3e60c
  if global signed half 1830 is more than 18
    set unwind to 0
    backtrack
  end
  place p3e616
  go to p3e62d
  place p3e618
  place t3e618_4 on 4
  set h_rax to global half 1830
  go to p3e5a3
  place p3e621
  place t3e621_1 on 1
  set h_rax to global half 1830
  go to p3e597
  place p3e62d
  place t3e62d_10 on 10
  call convert_large_numbers addr c110 addr c100
  set h_rax to answer
  go to p3e56f
  place p3e648
  place t3e648_8 on 8
  call spell_out_large_num addr c110 addr c100
  set h_rax to answer
  go to p3e56f
  place p3e663
  call convert_hundreds addr c110 addr c100
  set h_rax to answer
  go to p3e56f
  place p3e67e
  call convert_double addr c110 addr c100
  set h_rax to answer
  go to p3e56f
end

rule reset_enum_ptr takes 2
  instead
  local cf0 bytes 8
  place p3e6cc
  place p3e704
  place p3e733
  call get_parm addr cf0 arg 1 -6
  call fence 0 sym eti_null
  put cell cf0 value into arg 1 at 4
  match
end

rule convert_large_numbers takes 3
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local vf8 word
  local v110 word
  local h_rax
  variable gb50 word 1828
  place p3e78f
  set vf8 to arg 2
  place p3e7ce
  place p3e82e
  call get_parm addr c130 arg 1 -6
  set h_rax to answer
  call get_parm addr c120 arg 2 -6
  set h_rax to answer
  set cell c108 kind to 65533
  set h_rax to addr cf0
  set cf0 to 65532
  call push_ptr_init addr c140
  set h_rax to answer
  call fence 0 sym eti_null
  set cell c108 value to 0
  call startloop 1
  set h_rax to answer
  set h_rax to addr gb50
  set v110 to addr gb50
  place p3e8c2
  place t3e8c2_16 on 16
  call bspush_ca 1
  set h_rax to answer
  if global signed half 1830 is at least 4
    go to p3e906
  end
  set unwind to 0
  backtrack
  place p3e906
  place t3e906_2 on 2
  call starttest 3
  set h_rax to answer
  call move_i addr cf0 3
  set h_rax to answer
  set h_rax to 0
  call modulo addr gb50 addr cf0 addr c108
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p3e95f
  place t3e95f_3 on 3
  set h_rax to cell c108 value
  if cell c108 value is 0
    go to p3e9ff
  end
  place p3e972
  if h_rax is not 2
    go to p3e9c3
  end
  place p3e978
  call lpta_loadp addr c130
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p3e9b0
  end
  place p3e98a
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p3e9b0
  end
  place p3e996
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p3e9b0
  end
  place p3e9a2
  place t3e9a2_11 on 11
  call savescptr 11 addr c140
  set h_rax to answer
  place p3e9b0
  place t3e9b0_10 on 10
  call convert_double addr c130 addr c140
  set h_rax to answer
  go to p3ea5c
  place p3e9c3
  place t3e9c3_9 on 9
  call lpta_loadp addr c130
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p3e9ef
  end
  place p3e9d5
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p3e9ef
  end
  place p3e9e1
  place t3e9e1_14 on 14
  call savescptr 14 addr c140
  set h_rax to answer
  place p3e9ef
  place t3e9ef_13 on 13
  call insert_single_digit addr c130 addr c140
  set h_rax to answer
  go to p3ea5c
  place p3e9ff
  call lpta_loadp addr c130
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p3ea43
  end
  place p3ea11
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p3ea43
  end
  place p3ea1d
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p3ea43
  end
  place p3ea29
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p3ea43
  end
  place p3ea35
  place t3ea35_6 on 6
  call savescptr 6 addr c140
  set h_rax to answer
  place p3ea43
  place t3ea43_5 on 5
  call convert_hundreds addr c130 addr c140
  set h_rax to answer
  place p3ea51
  place t3ea51_7 on 7
  set cell c108 value to 3
  place p3ea5c
  place t3ea5c_8 on 8
  place t3ea5c_12 on 12
  call insert_lang_large_number addr c130 addr c140
  set h_rax to answer
  place p3ea6a
  place t3ea6a_15 on 15
  set h_rax to cell c108 value
  subtract h_rax from global half 1830
  call while_iterate 1 2
  set h_rax to answer
  go to p3e8c2
  place p3ea8b
  place t3ea8b_4 on 4
  set h_rax to cell c108 value
  go to p3e972
  place p3ea97
  place t3ea97_1 on 1
  call convert_hundreds addr c130 addr c120
  set h_rax to answer
  place p3eaad
  place t3eaad_17 on 17
  set h_rax to cell c120 value
  put h_rax into arg 2 at 4
  match
end

rule spell_out_large_num takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  place p3eb18
  place p3eb51
  place p3ebaf
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call push_ptr_init addr cf0
  call fence 0 sym eti_null
  if global half 3562 is not global half 3522
    go to p3ec8a
  end
  place p3ec08
  call starttest 2
  call lpta_loadp addr c100
  call setscan_l 1
  if answer is 0
    go to p3eca4
  end
  place p3ec29
  place t3ec29_2 on 2
  call spell_out_alphanum addr c110 addr cf0
  place p3ec3f
  place t3ec3f_4 on 4
  call rpta_loadp addr cf0
  call insert_l 1 2 sym eti_s_fb168 0
  call fin_digits addr cf0 addr c100
  place p3ec8a
  place t3ec8a_1 on 1
  place t3ec8a_5 on 5
  put cell c100 value into arg 2 at 4
  match
  place p3eca4
  call testFldeq 1 3 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p3ecb9
  call advance_tok
  if answer is 0
    go to p3ecfa
  end
  set unwind to 0
