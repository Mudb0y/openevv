  set h_rax to answer
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_rsi to 0
