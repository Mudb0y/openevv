  set h_rax to answer
  set h_rdx to sym eti_s_fb19a
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rsi to 1
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr c120
  set h_rdx to addr c130
  call copyvar h_rsi h_rdx
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to addr c140
  call copyvar h_rsi h_rdx
  set h_rax to answer
  set h_r12 to 0
  place p417b3
