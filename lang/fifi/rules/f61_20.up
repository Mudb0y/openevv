  place p41862
  place t41862_3 on 3
  set h_r12 to unwind
  set h_rcx to addr c110
  set h_rsi to 1
  set h_rdx to 2
  set h_rcx to 18
  call forto_adv_r h_rsi h_rdx h_rcx 1 addr c120 addr c110
  set s41881 to answer
  set h_rax to s41881
