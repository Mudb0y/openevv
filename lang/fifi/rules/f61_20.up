# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule print_spr takes 1
  instead
  local c118 bytes 8
  local c128 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local h_r12
  local h_rcx
  local h_rsi
  local s40cf4
  local s40da0
  local s40dbc
  local s40ee3
  local s40f0c
  local s40f1f
  local s40fef
  variable g4c8 word 708
  variable g4d8 word 716
  variable g578 word 796
  variable g628 word 884
  variable g638 word 892
  place p40b74
  place p40ba9
  place p40c09
  and 0 into cell c140 half 0
  set c140 to -65529
  set h_rsi to addr c128
  call push_ptr_init h_rsi
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rsi to addr c118
  call push_ptr_init h_rsi
  set h_r12 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call startloop h_rsi
  set h_rsi to addr g578
  set v108 to addr g578
  call lpta_loadpn h_rsi
  set h_rsi to 2
  call lpta_mover h_rsi
  set h_rsi to addr g628
  call lpta_storep h_rsi
  set h_rsi to addr g4d8
  set v100 to addr g4d8
  call lpta_loadpn h_rsi
  set h_rsi to 2
  call lpta_mover h_rsi
  set h_rsi to addr c128
  call lpta_storep h_rsi
  set vf8 to addr g4c8
  place p40ce7
  place t40ce7_17 on 17
  set h_r12 to unwind
  set h_rsi to addr g628
  call forall_to_test h_rsi addr c128
  set s40cf4 to answer
  set h_rcx to h_r12
  if s40cf4 is not 0
    go to p40d44
  end
  place p40d00
  set h_r12 to h_rcx
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rsi to addr g628
  call lpta_loadp h_rsi
  call setscan_r 2
  if answer is not 0
    go to p40d44
  end
  place p40d20
  set h_rsi to 4
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 2
  set h_rcx to 36
  call testFldeq h_rsi 0 h_rcx
  if answer is 0
    set h_r12 to 1
  end
  place p40d44
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place p40d80
  place t40d80_3 on 3
  set h_r12 to unwind
  set h_rcx to addr c128
  set h_rsi to 1
  set h_rcx to 18
  call forto_adv_upto_r h_rsi 2 h_rcx 2 addr g628 addr c128
  set s40da0 to answer
  set h_rsi to h_r12
  if s40da0 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place p40db1
  place t40db1_4 on 4
  set h_r12 to unwind
  call bspop_boa
  call advance_tok
  set s40dbc to answer
  set h_rsi to h_r12
  if s40dbc is not 0
    set unwind to h_rsi
    backtrack
  end
  place p40dcc
  place t40dcc_5 on 5
  set h_r12 to unwind
  set h_rsi to 5
  call savescptr h_rsi addr g638
  place p40dda
  place t40dda_2 on 2
  set h_r12 to unwind
  set h_rsi to addr g628
  call lpta_loadp h_rsi
  call setscan_l 4
  if answer is not 0
    go to p40e4d
  end
  place p40dec
  set h_rsi to addr g628
  call lpta_loadpn h_rsi
  set h_rsi to addr g4c8
  call rpta_loadpn h_rsi
  call compare_ptas
  if answer is not 0
    go to p40e30
  end
  place p40e12
  call testeq
  if answer is not 0
    go to p40e30
  end
  place p40e1e
  set h_rsi to addr g578
  call print_between_word_chars h_rsi addr g628
  place p40e30
  place t40e30_7 on 7
  set h_r12 to unwind
  set h_rsi to addr g628
  call print_word_stress h_rsi
  place p40e3b
  place t40e3b_8 on 8
  set h_r12 to unwind
  set h_rsi to 8
  call print_lit h_rsi sym eti_s_f7e24
  place p40e4d
  place t40e4d_6 on 6
  set h_r12 to unwind
  set h_rsi to addr g628
  call lpta_loadp h_rsi
  call setscan_r 7
  if answer is not 0
    go to p40f7d
  end
  place p40e63
  call advance_tok
  if answer is not 0
    go to p40f7d
  end
  place p40e73
  set h_rsi to addr c140
  call savetok h_rsi
  if answer is not 0
    go to p40f7d
  end
  place p40e8a
  place t40e8a_10 on 10
  set h_r12 to unwind
  set h_rsi to 10
  call savescptr h_rsi addr c150
  if global half 3562 is not global half 3522
    go to p40f41
  end
  place p40eb0
  set h_rsi to 11
  call starttest_l h_rsi
  set h_rsi to addr g628
  call lpta_loadp h_rsi
  call setscan_r 2
  if answer is not 0
    go to p40f41
  end
  place p40ecd
  set h_rsi to 12
  call bspush_ca_scan h_rsi
  set h_rcx to 2
  set h_rsi to 2
  call testFldeq h_rsi 1 h_rcx
  set s40ee3 to answer
  set h_rsi to h_r12
  if s40ee3 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p40ef3
  set h_rsi to 2
  set h_rcx to 1
  go to p40f0c
  place p40f01
  place t40f01_12 on 12
  set h_r12 to unwind
  set h_rcx to 2
  set h_rsi to 2
  place p40f0c
  call testFldeq h_rsi 9 h_rcx
  set s40f0c to answer
  set h_rsi to h_r12
  if s40f0c is not 0
    set unwind to h_rsi
    backtrack
  end
  place p40f1c
  place t40f1c_13 on 13
  set h_r12 to unwind
  call advance_tok
  set s40f1f to answer
  set h_rsi to h_r12
  if s40f1f is not 0
    set unwind to h_rsi
    backtrack
  end
  place p40f2f
  set h_rsi to 8
  call print_lit h_rsi sym eti_s_f7e27
  place p40f41
  place t40f41_11 on 11
  set h_r12 to unwind
  set h_rsi to 8
  call print_lit h_rsi sym eti_s_f7e29
  if global half 3534 is global half 3522
    go to p40f7d
  end
  place p40f63
  and 0 into cell c140 field
  set h_rsi to 8
  call print_var h_rsi addr c140
  place p40f7d
  place t40f7d_9 on 9
  set h_r12 to unwind
  set h_rsi to addr g628
  call lang_specific_SPR h_rsi addr g638
  place p40f8b
  place t40f8b_14 on 14
  set h_r12 to unwind
  set h_rsi to addr g638
  call lpta_loadp h_rsi
  call setscan_l 4
  if answer is not 0
    go to p40fff
  end
  place p40f9d
  set h_rsi to 8
  call print_lit h_rsi sym eti_s_f7e2b
  set h_rsi to 15
  call starttest h_rsi
  set h_rsi to addr g638
  call lpta_loadpn h_rsi
  set h_rsi to 4
  call lpta_mover h_rsi
  set h_rsi to addr c118
  call lpta_storep h_rsi
  set h_rsi to addr g638
  call print_between_word_chars h_rsi addr c118
  set s40fef to answer
  set h_rsi to h_r12
  if s40fef is not 0
    set unwind to h_rsi
    backtrack
  end
  place p40fff
  place t40fff_15 on 15
  set h_r12 to unwind
  set h_rsi to addr g638
  call lpta_loadpn h_rsi
  set h_rsi to addr g4d8
  call rpta_loadpn h_rsi
  call compare_ptas
  if answer is not 0
    go to p41031
  end
  place p41025
  call testeq
  if answer is 0
    match
  end
  place p41031
  place t41031_16 on 16
  set h_r12 to unwind
  set h_rsi to addr g638
  call lpta_loadpn h_rsi
  set h_rsi to 2
  call lpta_mover h_rsi
  set h_rsi to addr c118
  call lpta_storep h_rsi
  set h_rsi to 1
  set h_rcx to addr g628
  call forall_cont_from h_rsi 2 0 h_rcx addr c118
  go to p40ce7
  place p41076
  place t41076_18 on 18
  set h_r12 to unwind
  set h_rcx to h_r12
  go to p40d00
  place tm_1 on 1
  match
end

rule print_between_word_chars takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g4d8 word 716
  place p410dc
  place p4111f
  place p41152
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call print_after_word_chars addr c110 addr c100
  call lpta_loadpn addr c110
  call rpta_loadpn addr g4d8
  call compare_ptas
  if answer is not 0
    go to p411ed
  end
  place p411cf
  call testneq
  if answer is not 0
    go to p411ed
  end
  place p411db
  call print_lit 8 sym eti_s_f7e22
  place p411ed
  match
end

