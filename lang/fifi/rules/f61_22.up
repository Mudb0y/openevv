  call starttest 1
  set h_rax to answer
  call move_i addr c104 10
  set h_rax to answer
  call modulus addr c100 addr c104 addr c118
  set h_rax to answer
  if h_rax is 0
    go to p48345
  end
  set unwind to 0
  backtrack
  place p48345
  place t48345_1 on 1
  set h_xmm0 to cell c100 value
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell c100 value to h_rax
  put h_rax into arg 1 at 4
  set h_rax to cell c118 value
  put h_rax into arg 2 at 4
  match
end

