# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule token_to_number takes 3
  instead
  local cf0 bytes 8
  local c110 bytes 9
  local c128 bytes 9
  local h_rax
  place p44f08
  place p44f47
  place p44faa
  set c110 to through arg 1 word 0
  set cell c110 word 0 to through arg 1 word 4
  set cell c110 byte 4 to through arg 1 byte 8
  set c110 to -65535
  call get_parm addr cf0 arg 2 -4
  set h_rax to answer
  and 0 into cell c128 word 0
  set cell c128 byte 4 to 0
  set c128 to -65535
  call fence 0 sym eti_null
  set h_rax to answer
  call starttest 1
  set h_rax to answer
  call settvar_s addr c128 53
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is 0
    go to p45255
  end
  place p45038
  set unwind to 0
  backtrack
  place p4507b
  place t4507b_1 on 1
  call starttest 3
  set h_rax to answer
  call settvar_s addr c128 54
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p450a6
  go to p4527e
  place p450ab
  place t450ab_3 on 3
  call starttest 4
  set h_rax to answer
  call settvar_s addr c128 55
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p450da
  go to p4528d
  place p450df
  place t450df_4 on 4
  call starttest 5
  set h_rax to answer
  call settvar_s addr c128 56
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4510e
  go to p4529c
  place p45113
  place t45113_5 on 5
  call starttest 6
  set h_rax to answer
  call settvar_s addr c128 57
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45142
  go to p452ab
  place p45147
  place t45147_6 on 6
  call starttest 7
  set h_rax to answer
  call settvar_s addr c128 58
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45176
  go to p452ba
  place p4517b
  place t4517b_7 on 7
  call starttest 8
  set h_rax to answer
  call settvar_s addr c128 59
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p451aa
  go to p452c9
  place p451af
  place t451af_8 on 8
  call starttest 9
  set h_rax to answer
  call settvar_s addr c128 60
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p451de
  go to p452d8
  place p451e3
  place t451e3_9 on 9
  call starttest 10
  set h_rax to answer
  call settvar_s addr c128 61
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45212
  go to p452ea
  place p45217
  place t45217_10 on 10
  call starttest 11
  set h_rax to answer
  call settvar_s addr c128 62
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45246
  set cell cf0 field to 9
  set h_rax to 9
  go to p4525f
  place p45255
  and 0 into cell cf0 field
  set h_rax to 0
  place p4525f
  put h_rax into arg 2 at 2 half
  match
  place p45275
  place t45275_2 on 2
  set h_rax to cell cf0 field
  go to p4525f
  place p4527e
  set cell cf0 field to 1
  set h_rax to 1
  go to p4525f
  place p4528d
  set cell cf0 field to 2
  set h_rax to 2
  go to p4525f
  place p4529c
  set cell cf0 field to 3
  set h_rax to 3
  go to p4525f
  place p452ab
  set cell cf0 field to 4
  set h_rax to 4
  go to p4525f
  place p452ba
  set cell cf0 field to 5
  set h_rax to 5
  go to p4525f
  place p452c9
  set cell cf0 field to 6
  set h_rax to 6
  go to p4525f
  place p452d8
  set cell cf0 field to 7
  set h_rax to 7
  go to p4525f
  place p452ea
  set cell cf0 field to 8
  set h_rax to 8
  go to p4525f
end

rule string_to_short takes 4
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local v100 word
  local h_r15
  local h_rax
  local h_rcx
  local scratch
  place p4532c
  set v100 to arg 3
  place p4536e
  place p453ce
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c110 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf4 arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr cf0
  set cell cf0 kind to 65532
  call push_ptr_init addr c130
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cf0 field
  and 0 into cell cf4 field
  set h_rax to addr c110
  set h_rax to cell c110 value
  set cell c130 value to h_rax
  call startloop 1
  set h_rax to answer
  set h_r15 to 1
  place p4547e
  place t4547e_6 on 6
  call bspush_ca 1
  set h_rax to answer
  call lpta_loadpn addr c130
  set h_rax to answer
  call rpta_loadpn addr c120
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p454af
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p454e9
  end
  set unwind to 0
  backtrack
  place p454e9
  place t454e9_2 on 2
  call token_to_digit addr c130 addr cf0
  set h_rax to answer
  place p454fb
  place t454fb_3 on 3
  set h_rax to h_r15
  multiply cell cf0 field into h_rax
  add h_rax to cell cf4 field
  set h_rax to h_r15
  set scratch to h_rax
  multiply 10 into scratch
  set h_rax to scratch
  set h_r15 to h_rax
  call lpta_loadp addr c130
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p4554d
  end
  place p45528
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r15
  if h_rax is not 0
    go to p4554d
  end
  place p45537
  go to p4553c
  place p45539
  place t45539_5 on 5
  set h_rcx to h_r15
  place p4553c
  set h_r15 to h_rcx
  call savescptr 5 addr c130
  set h_rax to answer
  place p4554d
  place t4554d_4 on 4
  call while_iterate 1 2
  set h_rax to answer
  go to p4547e
  place p45560
  place t45560_1 on 1
  set h_rax to cell cf4 field
  set h_rcx to arg 3
  put h_rax into arg 3 at 2 half
  match
end

rule token_to_digit takes 3
  instead
  local c100 bytes 8
  local c104 bytes 8
  local h_rax
  place p455a0
  place p455e3
  place p45616
  call get_parm addr c100 arg 1 -6
  set h_rax to answer
  call get_parm addr c104 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45682
  end
  place p45666
  call test_string_s 1 1 sym eti_s_fb1b6
  set h_rax to answer
  if h_rax is 0
    go to p45842
  end
  place p45682
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p456b4
  end
  place p45698
  call test_string_s 1 1 sym eti_s_fb1b7
  set h_rax to answer
  if h_rax is 0
    go to p45846
  end
  place p456b4
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p456e6
  end
  place p456ca
  call test_string_s 1 1 sym eti_s_fb1b8
  set h_rax to answer
  if h_rax is 0
    go to p4584c
  end
  place p456e6
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45718
  end
  place p456fc
  call test_string_s 1 1 sym eti_s_fb1b9
  set h_rax to answer
  if h_rax is 0
    go to p45852
  end
  place p45718
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p4574a
  end
  place p4572e
  call test_string_s 1 1 sym eti_s_fb1ba
  set h_rax to answer
  if h_rax is 0
    go to p45858
  end
  place p4574a
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p4577c
  end
  place p45760
  call test_string_s 1 1 sym eti_s_fb1bb
  set h_rax to answer
  if h_rax is 0
    go to p4585e
  end
  place p4577c
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p457ae
  end
  place p45792
  call test_string_s 1 1 sym eti_s_fb1bc
  set h_rax to answer
  if h_rax is 0
    go to p45864
  end
  place p457ae
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p457e0
  end
  place p457c4
  call test_string_s 1 1 sym eti_s_fb1bd
  set h_rax to answer
  if h_rax is 0
    go to p4586a
  end
  place p457e0
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p4580e
  end
  place p457f6
  call test_string_s 1 1 sym eti_s_fb1be
  set h_rax to answer
  if h_rax is 0
    go to p45870
  end
  place p4580e
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p45824
  call test_string_s 1 1 sym eti_s_fb1bf
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p4583c
  set h_rax to 9
  go to p45874
  place p45842
  set h_rax to 0
  go to p45874
  place p45846
  set h_rax to 1
  go to p45874
  place p4584c
  set h_rax to 2
  go to p45874
  place p45852
  set h_rax to 3
  go to p45874
  place p45858
  set h_rax to 4
  go to p45874
  place p4585e
  set h_rax to 5
  go to p45874
  place p45864
  set h_rax to 6
  go to p45874
  place p4586a
  set h_rax to 7
  go to p45874
  place p45870
  set h_rax to 8
  place p45874
  set cell c104 field to h_rax
  put h_rax into arg 2 at 2 half
  match
end

rule string_to_number takes 4
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local vf8 word
  local h_r15
  local h_rax
  local h_rcx
  local scratch
  place p458b8
  set vf8 to arg 3
  place p458fa
  place p4595a
  set h_rcx to -6
  call get_parm addr c128 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c118 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -3
  call get_parm addr c108 arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr cf0
  set cell cf0 kind to 65532
  call push_ptr_init addr c138
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cf0 field
  set cell c108 value to 0
  set h_rax to addr c118
  set h_rax to cell c118 value
  set cell c138 value to h_rax
  call startloop 1
  set h_rax to answer
  set h_r15 to 1
  place p45a07
  place t45a07_6 on 6
  call bspush_ca 1
  set h_rax to answer
  call lpta_loadpn addr c138
  set h_rax to answer
  call rpta_loadpn addr c128
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45a38
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p45a72
  end
  set unwind to 0
  backtrack
  place p45a72
  place t45a72_2 on 2
  call token_to_digit addr c138 addr cf0
  set h_rax to answer
  place p45a84
  place t45a84_3 on 3
  set h_rax to cell cf0 field
  multiply h_r15 into h_rax
  add h_rax to cell c108 value
  set scratch to h_r15
  multiply 10 into scratch
  set h_r15 to scratch
  call lpta_loadp addr c138
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45ad2
  end
  place p45aad
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r15
  if h_rax is not 0
    go to p45ad2
  end
  place p45abc
  go to p45ac1
  place p45abe
  place t45abe_5 on 5
  set h_rcx to h_r15
  place p45ac1
  set h_r15 to h_rcx
  call savescptr 5 addr c138
  set h_rax to answer
  place p45ad2
  place t45ad2_4 on 4
  call while_iterate 1 2
  set h_rax to answer
  go to p45a07
  place p45ae5
  place t45ae5_1 on 1
  set h_rax to cell c108 value
  set h_rcx to arg 3
  put h_rax into arg 3 at 4
  match
end

rule absval takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rcx
  place p45b24
  place p45b67
  place p45b96
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  call fence 0 sym eti_null
  set h_rcx to cell cf4 field
  negate h_rcx
  if h_rcx is less than 0
    set h_rcx to cell cf4 field
  end
  set cell cf0 field to h_rcx
  put h_rcx into arg 2 at 2 half
  match
end

rule find_last_syll takes 4
  instead
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local vf8 word
  local v100 word
  local h_r12
  local h_r14
  local h_r15
  local h_rcx
  local h_rsi
  local s45d4d
  local s45dea
  local s45df9
  local s45e12
  local s45e96
  place p45c30
  set v100 to arg 3
  set vf8 to arg 2
  place p45c76
  place p45cd6
  set h_r14 to addr c130
  set h_r12 to -6
  set h_rsi to addr c130
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c110
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rsi to addr c120
  set h_rcx to -6
  call get_parm h_rsi arg 3 h_rcx
  set h_r12 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_l 2
  set s45d4d to answer
  set h_rcx to 0
  if s45d4d is not 0
    go to p45e3b
  end
  place p45d5d
  go to p45d64
  place p45d64
  set h_r14 to h_rcx
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rsi to 3
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 2
  set h_r15 to 1
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  if answer is 0
    set h_r14 to 1
  end
  set h_rcx to h_r14
  place p45d9b
  set h_r12 to 1
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place p45dde
  place t45dde_2 on 2
  set h_r15 to unwind
  set h_rsi to 2
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  set s45dea to answer
  set h_rsi to h_r15
  if s45dea is not 0
    set unwind to h_rsi
    backtrack
  end
  place p45df6
  call advance_tok
  set s45df9 to answer
  set h_rsi to h_r15
  if s45df9 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p45e05
  go to p45e26
  place p45e07
  place t45e07_3 on 3
  set h_r15 to unwind
  call bspop_boa
  call advance_tok
  set s45e12 to answer
  set h_rcx to h_r15
  set h_rsi to h_r15
  if s45e12 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p45e21
  go to p45d64
  place p45e26
  place t45e26_5 on 5
  set h_r15 to unwind
  set h_rsi to 5
  call savescptr h_rsi addr c110
  place p45e38
  place t45e38_1 on 1
  set h_r15 to unwind
  set h_r12 to h_r15
  place p45e3b
  set h_r14 to h_r12
  set h_rsi to 6
  call starttest h_rsi
  call lpta_loadp addr c110
  set h_rsi to 7
  call lpta_tstctxtl h_rsi
  if answer is not 0
    go to p45eb8
  end
  place p45e72
  set h_rsi to 7
  call setscan_r h_rsi
  if answer is not 0
    go to p45eb8
  end
  place p45e81
  set h_rsi to 7
  call savescptr h_rsi addr c110
  call advance_tok
  set s45e96 to answer
  set h_rcx to h_r14
  if s45e96 is not 0
    go to p45d9b
  end
  place p45ea6
  place t45ea6_8 on 8
  set h_r15 to unwind
  set h_rsi to 8
  call savescptr h_rsi addr c120
  place p45eb8
  place t45eb8_6 on 6
  set h_r15 to unwind
  set h_rcx to arg 2
  put cell c110 value into arg 2 at 4
  set h_rcx to arg 3
  put cell c120 value into arg 3 at 4
  match
  place p45eeb
  place t45eeb_4 on 4
  set h_r15 to unwind
  set h_rcx to h_r15
  go to p45d64
  place p45ef3
  place t45ef3_7 on 7
  set h_r15 to unwind
  set h_r14 to h_r15
  go to p45e81
end

rule get_numRootSylls takes 5
  instead
  local cf0 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local vf8 word
  local v100 word
  place p45f18
  place p45f64
  place p45f9c
  call get_parm addr c140 arg 1 -6
  call get_parm addr c130 arg 2 -6
  set vf8 to arg 3
  call get_parm addr cf0 arg 3 -4
  set v100 to arg 4
  call get_parm addr c110 arg 4 -6
  call push_ptr_init addr c120
  call push_ptr_init addr c160
  call push_ptr_init addr c150
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  call find_last_syll addr c130 addr c120 addr c110
  place p46077
  place t46077_1 on 1
  call startloop 2
  call copyvar addr c160 addr c140
  call copyvar addr c150 addr c110
  call forall_to_test addr c160 addr c150
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p460b8
  place t460b8_5 on 5
  call bspush_ca 4
  call lpta_loadp addr c160
  call setscan_r 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p460d5
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p460e1
  place t460e1_3 on 3
  call c_assvar addr cf0
  increment cell cf0 field
  place p460f7
  place t460f7_4 on 4
  call forto_adv_r 2 3 5 7 addr c160 addr c150
  if answer is 0
    go to p4614a
  end
  set unwind to 0
  backtrack
  place p4614a
  place t4614a_2 on 2
  put cell cf0 field into arg 3 at 2 half
  put cell c110 value into arg 4 at 4
  match
end

rule mark_syll_stress takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  place p461b8
  place p461fe
  place p46231
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr cf0 arg 3 -4
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr c110 addr c100
  call mark_v 7 0 addr cf0 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p462b9
  call lpta_rpta_loadp addr c110 addr c100
  call mark_v 2 7 addr cf0 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
end

rule insert_stress takes 4
