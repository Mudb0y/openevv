# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule set_fin_global_constants takes 1
  instead
  place p4a66a
  place p4a6a1
  place p4a6d4
  call fence 0 sym eti_null
  set global half 4074 to 1
  set global half 4078 to 2
  and 0 into global half 4082
  set global half 4086 to 1
  set global half 4090 to 2
  set global half 4094 to 3
  set global half 4098 to 4
  set global half 4102 to 5
  set global half 4106 to 6
  set global half 4110 to 7
  set global half 4114 to 8
  set global half 4118 to 9
  set global half 4122 to 10
  set global half 4126 to 11
  set global half 4130 to 12
  set global half 4134 to 13
  set global half 4138 to 1
  set global half 4142 to 2
  set global half 2100 to 3
  set global half 2104 to 2
  match
end

rule init_fin_vars takes 1
  instead
  place p4a7b8
  place p4a7eb
  place p4a81a
  call fence 0 sym eti_null
  set global half 3522 to global half 3562
  match
end

rule reset_fin_sent_vars takes 1
  instead
  variable gc50 word 2044
  place p4a85f
  place p4a892
  place p4a8c1
  call fence 0 sym eti_null
  call npush_s 1
  set global half 2046 to 3
  call npop addr gc50
  call npush_s 3
  set global half 2046 to 2
  call npop addr gc50
  match
end

rule init_fin_textnorm_vars takes 2
  instead
  local cf0 bytes 8
  variable g1708 word 4176
  place p4a93d
  place p4a971
  place p4a9cd
  call get_parm addr cf0 arg 1 -6
  call fence 0 sym eti_null
  call init_case_and_grade
  set global word 4148 to global word 2224
  set global word 4156 to global word 2224
  set global word 4164 to global word 2224
  set global word 4172 to global word 2224
  call lpta_loadpn addr cf0
  call lpta_ctxtl 4
  call rpta_loadpn addr g1708
  call compare_ptas
  if answer is not 0
    match
  end
  place p4aa49
  call testneq
  if answer is not 0
    match
  end
  place p4aa55
  set global word 4180 to global word 2224
  match
end

rule init_case_and_grade takes 1
  instead
  place p4aa77
  place p4aaaa
  place p4aad9
  call fence 0 sym eti_null
  set global half 4066 to global half 4054
  and 0 into global half 4054
  and 0 into global half 4058
  and 0 into global half 4062
  match
end

rule init_morph_vars takes 1
  instead
  place p4ab36
  place p4ab69
  place p4ab98
  call fence 0 sym eti_null
  and 0 into global half 4186
  and 0 into global half 4190
  set global word 4196 to global word 2224
  match
end

