  set h_rax to answer
  place p5ac86
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5ac8a
  set h_rsi to 2
  set h_rdx to 0
  call npush_fld h_rsi h_rdx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5ac9b
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5aca7
  and 0 into cell c128 field
  set h_rsi to addr c128
  call npush_vf h_rsi
  set h_rax to answer
  call if_testeq
  set h_rax to answer
  if h_rax is 0
    go to p5ad2d
  end
  set unwind to 0
  backtrack
  place p5acf8
  place t5acf8_19 on 19
  set h_rsi to 21
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fbb45
  go to p5ab87
  place p5ad18
  place t5ad18_21 on 21
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fbb44
  go to p5ab87
  place p5ad2d
  set h_rax to v108
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  add global word 2252 to h_xmm0
  scale h_xmm0 by 5000 over 10000
  set global word 2252 to h_xmm0
  match
  place tm_25 on 25
  match
end

rule setcdur takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_xmm0
  local h_xmm1
  place p5adcc
  place p5ae07
  place p5ae67
  call get_parm addr cf4 arg 1 -4
  call get_parm addr cf0 arg 2 -4
  call fence 0 sym eti_null
  set h_xmm1 to cell cf4 field
  multiply 10000 into h_xmm1
  scale h_xmm1 by global word 2252 over 10000
  scale h_xmm1 by 10000 over 1000000
  set global word 2252 to h_xmm1
  set h_xmm0 to cell cf0 field
  multiply 10000 into h_xmm0
  if cell cf4 field is at most 99
    go to p5aedc
  end
  place p5aed4
  if h_xmm0 is less than h_xmm1
    go to p5aee2
  end
  match
  place p5aedc
  if h_xmm1 is at least h_xmm0
    match
  end
  place p5aee2
  set global word 2252 to h_xmm0
  match
end
