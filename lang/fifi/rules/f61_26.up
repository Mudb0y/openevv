rule fin_first_postnucl_accent takes 1
  instead
  local cd0 bytes 8
  local cd4 bytes 8
  local h_rax
  local h_rcx
  local n6089d_0
  variable g330 word 444
  place p60775
  place p607a4
  place p607fe
  set h_rax to 65532
  set cell cd4 kind to 65532
  set cell cd0 kind to 65532
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cd0 field
  call fence 1 sym eti_s_fbb48
  set h_rax to answer
  set h_rcx to global half 2184
  set h_rax to 7
  if h_rcx is global half 2152
    go to p60876
  end
  place p6084f
  set h_rcx to global half 1522
  set h_rax to 50
  if h_rcx is not global half 2144
    go to p60876
  end
  place p60863
  set h_rax to 90
  set h_rcx to 40
  if global half 386 is 1
    set h_rcx to 90
  end
  set h_rax to h_rcx
  place p60876
  set cell cd4 field to h_rax
  call set_first_postnuc_value addr cd0
  set h_rax to answer
  set h_rax to global half 4310
  set h_rcx to cell cd0 field
  set n6089d_0 to h_rax
  shift left 16 into n6089d_0
  shift right 16 into n6089d_0
  if n6089d_0 is at least cell cd0 field
    go to p608ab
  end
  place p608a2
  set cell cd0 field to h_rax
  set h_rcx to h_rax
  place p608ab
  set global half 3426 to h_rcx
  set h_rcx to addr cd0
  call insert_f0 addr g330 addr cd4 h_rcx
  set h_rax to answer
  match
end

rule fin_boundary_tone takes 2
  instead
  local cd0 bytes 8
  local cd4 bytes 8
  local ce8 bytes 8
  local h_rax
  local k60a22_2
  variable g5b8 word 828
  place p608e3
  place p60915
  place p6096f
