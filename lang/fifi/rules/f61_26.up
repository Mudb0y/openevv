# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule fin_phr_initial_F0 takes 1
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local cf8 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local h_xmm1
  variable g1330 word 3424
  variable g4c8 word 708
  variable g5a8 word 820
  place p5af6c
  place p5af9d
  place p5aff9
  set h_rax to 65532
  set cell ce0 kind to 65532
  set cell ce4 kind to 65532
  call push_ptr_init addr cf8
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell ce4 field
  set h_rax to global word 424
  set cell cf8 value to h_rax
  call lpta_loadpn addr g5a8
  set h_rax to answer
  call rpta_loadpn addr g4c8
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p5b091
  end
  place p5b071
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p5b091
  end
  place p5b07d
  set h_rcx to global half 1506
  set h_rax to 100
  if h_rcx is global half 2144
    go to p5b095
  end
  place p5b091
  set h_rax to 70
  place p5b095
  set cell ce0 field to h_rax
  set global half 4306 to h_rax
  set global half 4310 to h_rax
  set h_rax to global half 1474
  if h_rax is not global half 2148
    go to p5b102
  end
  place p5b0ba
  call set_first_postnuc_value addr g1330
  set h_rax to answer
  set h_rax to global signed half 3426
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  set h_rax to cell ce0 field
  set h_rcx to global signed half 3430
  multiply h_rax into h_rcx
  set h_xmm1 to h_rcx
  multiply 10000 into h_xmm1
  scale h_xmm1 by 10000 over 1000000
  add h_xmm0 to h_xmm1
  set h_rax to h_xmm1
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell ce0 field to h_rax
  go to p5b10a
  place p5b102
  and 0 into cell ce4 field
  place p5b10a
  set h_rcx to addr ce0
  call insert_f0 addr cf8 addr ce4 h_rcx
  set h_rax to answer
  call lpta_loadpn addr g5a8
  set h_rax to answer
  call rpta_loadpn addr g4c8
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p5b149
  call testeq
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p5b155
  set h_rax to global half 1474
  set global half 4314 to h_rax
  match
end

rule set_first_postnuc_value takes 2
  instead
  local cf0 bytes 8
  local vf8 word
  local h_rax
