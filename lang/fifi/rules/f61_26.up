    go to p5b272
  end
  place p5b245
  set h_rax to global signed half 4310
  add h_rax to h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 50000
  set h_rax to global signed half 402
  set h_xmm1 to h_rax
  multiply 10000 into h_xmm1
  add h_xmm0 to h_xmm1
  set h_rax to h_xmm1
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  go to p5b475
  place p5b272
  set h_rax to addr g6c8
  set vf8 to addr g6c8
  place p5b28f
  place t5b28f_1 on 1
  set h_rax to global half 2184
  if h_rax is global half 2152
    go to p5b4a2
  end
  place p5b2a3
  place t5b2a3_3 on 3
  if global signed half 2160 is more than 2
    go to p5b497
  end
  place p5b2b1
  place t5b2b1_4 on 4
  set h_rax to global half 1522
  if h_rax is not global half 2144
    go to p5b2f3
  end
  place p5b2c1
  call lpta_loadp addr g6c8
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p5b2f3
  end
  place p5b2d7
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p5b2f3
  end
  place p5b2e3
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p5b4ad
  end
  place p5b2f3
  place t5b2f3_5 on 5
  if global half 2160 is not 2
    go to p5b40d
  end
  place p5b301
  call lpta_loadp addr g6c8
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p5b33f
  end
  place p5b317
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p5b33f
  end
  place p5b323
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p5b33f
  end
  place p5b32f
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p5b4b8
  end
  place p5b33f
  place t5b33f_7 on 7
  call starttest 9
  set h_rax to answer
  call lpta_loadp addr g6c8
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p5b392
  end
  place p5b360
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p5b392
  end
  place p5b36c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p5b392
  end
  place p5b378
  place t5b378_10 on 10
  set h_rcx to sym eti_s_fbb48
  call test_synch 10 1 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b38d
  go to p5b424
  place p5b392
  place t5b392_9 on 9
  call starttest 11
  set h_rax to answer
  call lpta_loadp addr g6c8
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p5b418
  end
  place p5b3b3
  call advance_tok
  set h_rax to answer
  set h_rcx to 5
  if h_rax is not 0
    go to p5b428
  end
  place p5b3c3
  place t5b3c3_12 on 12
  set h_rcx to sym eti_s_fbb48
  call test_synch 12 1 h_rcx
  set h_rax to answer
  if h_rax is 0
    go to p5b41e
  end
  set unwind to 0
  backtrack
  place p5b40d
  place t5b40d_6 on 6
  set cell cf0 field to 15
  go to p5b47c
  place p5b418
  place t5b418_11 on 11
  set h_rcx to 5
  go to p5b428
  place p5b41e
  set h_rcx to 10
  go to p5b428
  place p5b424
  set h_rcx to 20
  place p5b428
  set cell cf0 field to h_rcx
  place p5b42f
  place t5b42f_8 on 8
  if global half 386 is not 1
    go to p5b44e
  end
  place p5b439
  set h_rax to cell cf0 field
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 30000
  go to p5b471
  place p5b44e
  place t5b44e_13 on 13
  set h_rax to global half 2196
  if h_rax is not global half 2148
    go to p5b47c
  end
  place p5b45e
  set h_rax to cell cf0 field
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 5000 over 10000
  place p5b471
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  place p5b475
  set cell cf0 field to h_rax
  place p5b47c
  place t5b47c_2 on 2
  place t5b47c_14 on 14
  set h_rax to cell cf0 field
  put h_rax into arg 1 at 2 half
  match
  place p5b497
  set cell cf0 field to 65511
  go to p5b47c
  place p5b4a2
  set cell cf0 field to 70
  go to p5b47c
  place p5b4ad
  set cell cf0 field to 40
  go to p5b47c
  place p5b4b8
  set h_rcx to 30
  go to p5b428
end

rule fin_prenucl_f0 takes 1
  instead
  local ce0 bytes 8
  place p5b500
  place p5b535
  place p5b590
  set cell ce0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell ce0 field
  call is_accentable_syllable addr ce0
  if cell ce0 field is at most 0
    give up
  end
  place p5b5cc
  if cell ce0 field is not 1
    go to p5b5dc
  end
  place p5b5d5
  call fin_2stress_acc
  match
  place p5b5dc
  call fin_position_t_ptrs
  call realize_prenucl_tone
  decrement global half 3498
  match
end

rule is_accentable_syllable takes 2
  instead
  local cf0 bytes 8
  local h_rax
  local n5b6c9_0
  local n5b6fe_0
  local n5b7a1_0
  local n5b7ef_0
  variable g280 word 332
  variable g5a8 word 820
  place p5b5fd
  place p5b639
  place p5b69c
  call get_parm addr cf0 arg 1 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 398
  set n5b6c9_0 to h_rax
  shift left 16 into n5b6c9_0
  shift right 16 into n5b6c9_0
  if n5b6c9_0 is at most 0
    go to p5b6f3
  end
  place p5b6ce
  set h_rax to global half 522
  if global half 522 is not 1
    go to p5b7a1
  end
  place p5b6e1
  place t5b6e1_14 on 14
  set cell cf0 field to 2
  set h_rax to 2
  go to p5b83e
  place p5b6f3
  place p5b6fe
  set n5b6fe_0 to h_rax
  and 65535 into n5b6fe_0
  if n5b6fe_0 is 0
    go to p5b7c6
  end
  place p5b707
  place t5b707_6 on 6
  call starttest 10
  set h_rax to answer
  call lpta_loadp addr g280
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p5b834
  end
  place p5b728
  call testFldeq 4 4 3
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b73d
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p5b7dc
  end
  set unwind to 0
  backtrack
  place p5b782
  place t5b782_1 on 1
  set h_rax to global half 398
  go to p5b6fe
  place p5b78e
  place t5b78e_3 on 3
  place t5b78e_5 on 5
  place t5b78e_8 on 8
  place t5b78e_12 on 12
  place t5b78e_15 on 15
  set h_rax to cell cf0 field
  go to p5b83e
  place p5b79a
  place t5b79a_2 on 2
  set h_rax to global half 522
  place p5b7a1
  set n5b7a1_0 to h_rax
  and 65535 into n5b7a1_0
  if n5b7a1_0 is not 2
    go to p5b834
  end
  place p5b7ab
  set cell cf0 field to 1
  set h_rax to 1
  go to p5b83e
  place p5b7bd
  place t5b7bd_11 on 11
  set h_rax to global half 402
  go to p5b7ef
  place p5b7c6
  if global half 402 is 1
    go to p5b834
  end
  place p5b7d0
  place t5b7d0_7 on 7
  if global half 522 is 1
    go to p5b7ab
  end
  place p5b7da
  go to p5b834
  place p5b7dc
  set h_rax to global half 402
  if global signed half 402 is at least 3
    go to p5b6e1
  end
  place p5b7ef
  set n5b7ef_0 to h_rax
  and 65535 into n5b7ef_0
  if n5b7ef_0 is not 2
    go to p5b834
  end
  place p5b7f5
  call lpta_loadpn addr g280
  set h_rax to answer
  call rpta_loadpn addr g5a8
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p5b6e1
  end
  place p5b81f
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p5b6e1
  end
  place p5b82f
  go to p5b7ab
  place p5b834
  place t5b834_4 on 4
  place t5b834_9 on 9
  place t5b834_10 on 10
  place t5b834_13 on 13
  and 0 into cell cf0 field
  set h_rax to 0
  place p5b83e
  put h_rax into arg 1 at 2 half
  match
end

rule fin_2stress_acc takes 1
  instead
