  set h_rax to answer
  set cell cd4 kind to 65532
  call push_ptr_init addr ce8
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global word 2224
  set cell ce8 value to h_rax
  call lpta_loadp addr g5b8
  call setscan_l 2
  set h_rax to answer
  if h_rax is not 0
    go to p609ef
  end
  place p609d1
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p609ef
  end
  place p609dd
  call savescptr 2 addr ce8
  set h_rax to answer
  place p609ef
  set cell cd4 field to 99
  set h_rax to global half 2184
  if h_rax is not global half 2156
    go to p60a27
  end
  place p60a12
  set h_rax to cell cd0 field
  if global half 2188 is not global half 2152
    go to p60a4f
  end
  place p60a22
  add 20 to h_rax
  set k60a22_2 to h_rax
  go to p60a52
  place p60a27
  if global half 2188 is not global half 2156
    go to p60a59
  end
  place p60a2c
  if global half 1506 is global half 2144
    go to p60a59
  end
  place p60a3c
  if h_rax is global half 2152
    go to p60a59
  end
  place p60a45
  add -10 to cell cd0 field
  go to p60a59
  place p60a4f
  add 10 to h_rax
  place p60a52
  set cell cd0 field to h_rax
  place p60a59
  call insert_f0 addr ce8 addr cd4 addr cd0
  set h_rax to answer
  match
end
