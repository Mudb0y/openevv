  set h_rax to answer
  call fence 0 sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 2
  set h_rsi to addr g638
  call lpta_loadp h_rsi
  call setscan_r h_rdx
