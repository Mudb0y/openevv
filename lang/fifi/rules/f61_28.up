  set h_rax to cell cf0 field
  add -5 to h_rax
  set k6c707_2 to h_rax
  set cell cf0 field to h_rax
  go to p6c723
  place p6c71c
  place t6c71c_3 on 3
  set h_rax to cell cf0 field
  place p6c723
  set h_rcx to h_rax
  set n6c725_0 to h_rax
  shift left 16 into n6c725_0
  shift right 16 into n6c725_0
  if n6c725_0 is more than 9
    go to p6c741
  end
  place p6c72b
  set cell cf0 field to 10
  set h_rax to 10
  go to p6c741
  place p6c73a
  place t6c73a_6 on 6
  set h_rax to cell cf0 field
  place p6c741
  put h_rax into arg 1 at 2 half
  match
end
