# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule find_fin_nucleus takes 1
  instead
  local h_rsi
  local s66998
  variable g300 word 420
  variable g320 word 436
  variable g330 word 444
  place p66748
  place p66781
  place p667e4
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call fence h_rsi sym eti_s_fbb6c
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to addr g300
  call lpta_loadp h_rsi
  call setscan_r 2
  if answer is 0
    go to p6690d
  end
  place p66833
  place t66833_1 on 1
  set h_rsi to 6
  call starttest h_rsi
  set h_rsi to addr g300
  call lpta_loadp h_rsi
  call setscan_r 2
  if answer is 0
    go to p668a9
  end
  match
  place p6688f
  place t6688f_3 on 3
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6689b
  go to p6690d
  place p6689d
  place t6689d_8 on 8
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p668a9
  place t668a9_7 on 7
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p668cb
  place t668cb_9 on 9
  set h_rsi to 9
  call savescptr h_rsi addr g320
  set h_rsi to 2
  call testFldeq h_rsi 1 3
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p668f6
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p66906
  place t66906_10 on 10
  set h_rsi to 10
  go to p669ac
  place p6690d
  place t6690d_2 on 2
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rsi to 4
  call bspush_ca_scan h_rsi
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p66933
  place t66933_4 on 4
  set h_rsi to 4
  call savescptr h_rsi addr g320
  set h_rsi to 2
  call testFldeq h_rsi 1 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6695d
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6696d
  set h_rsi to 5
  call bspush_ca_scan h_rsi
  set h_rsi to 2
  call testFldeq h_rsi 1 3
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p66995
  call advance_tok
  set s66998 to answer
  set h_rsi to 5
  if s66998 is not 0
    set unwind to 0
    backtrack
  end
  place p669a8
  go to p669ad
  place p669aa
  place t669aa_5 on 5
  set h_rsi to 5
  place p669ac
  place p669ad
  call savescptr h_rsi addr g330
  match
  place tm_6 on 6
  match
end

