rule add_tilt takes 2
  instead
  local ce0 bytes 8
  local h_rax
  local h_rdx
  local h_xmm0
  local h_xmm1
  place p814e0
  place p8151c
  place p8154b
  set h_rdx to arg 1
  call get_parm addr ce0 h_rdx -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to global signed half 3146
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  set h_rdx to 100
  subtract h_rax from h_rdx
  multiply cell ce0 field into h_rdx
  set h_xmm1 to h_rdx
  multiply 10000 into h_xmm1
  scale h_xmm1 by 10000 over 1000000
  add h_xmm0 to h_xmm1
  set h_rax to h_xmm1
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 2990 to h_rax
  match
end

