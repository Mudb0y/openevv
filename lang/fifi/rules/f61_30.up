rule adjust_AV_for_vow_vow_sequence takes 1
  instead
  local cf0 bytes 8
  local h_rcx
  variable g320 word 436
  place p8a4f8
  place p8a529
  go to p8a588
  place p8a558
  place t8a558_5 on 5
  give up
  place p8a588
  call push_ptr_init addr cf0
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr g320
  call setscan_l 2
  if answer is not 0
    go to p8a65c
  end
  place p8a5c7
  go to p8a5ce
  place p8a5ce
  place t8a5ce_2 on 2
  call savescptr 2 addr cf0
  set h_rcx to sym eti_s_fbba4
  call test_string_s 2 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8a5f9
  call lpta_loadp addr cf0
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8a60f
  set h_rcx to 29
  place p8a616
  call testFldeq 2 0 h_rcx
  if answer is 0
    go to p8a6e3
  end
  set unwind to 0
  backtrack
  place p8a65c
  place t8a65c_1 on 1
  call starttest 4
  call lpta_loadp addr g320
  call setscan_r 2
  if answer is not 0
    go to p8a696
  end
  place p8a679
  set h_rcx to sym eti_s_fbba9
  call test_string_s 2 1 h_rcx
  if answer is 0
    go to p8a733
  end
  place p8a696
  place t8a696_4 on 4
  call starttest 3
  call lpta_loadp addr g320
  call setscan_r 2
  if answer is not 0
    match
  end
  place p8a6ba
  set h_rcx to sym eti_s_fbba8
  call test_string_s 2 1 h_rcx
  if answer is not 0
    match
  end
  place p8a6d7
  set h_rcx to 33
  go to p8a616
  place p8a6e3
  call npush_fld 2 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8a6f9
  call npush_i 0
  call if_testeq
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8a713
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8a723
  add -3 to global half 2946
  place p8a72b
  place t8a72b_3 on 3
  match
  place p8a733
  set h_rcx to 30
  go to p8a616
end

