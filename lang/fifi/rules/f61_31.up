  end
  place p94cde
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rax to answer
  go to p94cd2
  place p94ceb
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place p94d1d
  place t94d1d_2 on 2
  set h_r13 to unwind
  set h_rsi to 2
  call savescptr h_rsi addr c100
  set h_rax to answer
  set h_rsi to 4
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  call lpta_rpta_loadp h_rsi addr c100
  set h_rax to answer
  set h_rsi to 1
  call setd_lookup h_rsi 77
  set h_rax to answer
  go to p94d82
  place p94d6c
  place t94d6c_4 on 4
  set h_r13 to unwind
  set h_rsi to addr c110
  call is_initial_construct_word h_rsi addr c100
  set h_rax to answer
  place p94d82
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p94d8d
  place t94d8d_5 on 5
  place t94d8d_6 on 6
  set h_r13 to unwind
  set h_rsi to 7
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 8
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call legal_root_init_cons h_rsi
  set s94dad to answer
  set h_rax to s94dad
  set h_rcx to 1
  if h_rax is 0
    go to p94dbc
  end
  place p94db9
  set h_rcx to h_r13
  place p94dbc
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place p94dc3
  place t94dc3_8 on 8
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place p94dd0
  place t94dd0_7 on 7
  set h_r13 to unwind
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
end

