rule is_root_with_disharmonic_vows takes 3
  instead
  local c110 bytes 8
  local c120 bytes 8
  local vf8 word
  local v100 word
  local h_rdx
  variable g1720 word 4192
  variable gd10 word 2220
  place p97660
  place p9769f
  place p97702
  set h_rdx to arg 1
  call get_parm addr c110 h_rdx -6
  set h_rdx to arg 2
  call get_parm addr c120 h_rdx -6
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to addr c120
  call lpta_rpta_loadp addr c110 h_rdx
  set h_rdx to 79
  call setd_lookup 1 h_rdx
  if answer is 0
    match
  end
  place p97770
  set v100 to addr g1720
  set vf8 to addr gd10
  place p97797
  place t97797_1 on 1
  call starttest 3
  call lpta_loadpn addr g1720
  call rpta_loadpn addr gd10
  call compare_ptas
  if answer is not 0
    give up
  end
  place p977d0
  call testneq
  if answer is not 0
    give up
  end
  place p977e0
  call bspush_ca 4
  set h_rdx to addr c120
  call lpta_rpta_loadp addr c110 h_rdx
  set h_rdx to 106
  place p97806
  call setd_lookup 1 h_rdx
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place p9783e
  place t9783e_4 on 4
  set h_rdx to addr c120
  call lpta_rpta_loadp addr c110 h_rdx
  set h_rdx to 107
  go to p97806
  place tm_2 on 2
  place tm_5 on 5
  match
end
