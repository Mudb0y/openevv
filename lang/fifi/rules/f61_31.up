# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule analyze_compound takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p94568
  place p945a7
  place p9460a
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call init_morph_vars
  place p94661
  place t94661_1 on 1
  call roots_dict_lookup addr c110 addr c100
  if answer is 0
    match
  end
  place p94673
  place t94673_2 on 2
  call starttest 4
  call split_compound addr c110 addr c100
  if answer is 0
    match
  end
  place p94690
  place t94690_4 on 4
  call lpta_rpta_loadp addr c110 addr c100
  call insert_2pt_s 3 1 sym eti_s_fbbc1 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_3 on 3
  match
end

rule split_compound takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local h_r12
  local h_r14
  local h_r15
  local h_rax
  local h_rcx
  local h_rsi
  local s94881
  local s94900
  local s94a2e
  local k948af_0
  local k949d2_0
  place p94710
  set h_r14 to arg 2
  set h_r15 to arg 1
  place p9474b
  place p947ab
  set h_rsi to addr c110
  set h_r12 to -6
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rax to answer
  set h_rsi to addr c120
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rax to answer
  set h_r15 to addr c100
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_r14 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rsi to 1
  call fence h_rsi sym eti_s_fbbc2
  set h_rax to answer
  set h_rax to global word 2224
  set cell c100 value to h_rax
  if global half 2582 is not 1
    go to p94ab5
  end
  place p9483a
  set h_rsi to 1
  call starttest_l h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p94ab5
  end
  place p9485f
  set h_rsi to 2
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 7
  call testFldeq h_rsi 1 h_rcx
  set s94881 to answer
  set h_rax to s94881
  set h_r15 to 0
  if h_rax is not 0
    go to p94b32
  end
  place p94891
  set h_rsi to 4
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 3
  call testFldeq h_rsi 2 h_rcx
  set h_rax to answer
  set h_rcx to 0
  set k948af_0 to h_rax
  set h_rax to 0
