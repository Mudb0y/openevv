    set h_rax to 1
  end
  set h_rcx to h_rax
  set h_r15 to h_rcx
  go to p94b32
  place p948f5
  place t948f5_3 on 3
  set h_r12 to unwind
  set h_rsi to 4
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  set s94900 to answer
  set h_rax to s94900
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p9490c
  go to p94916
  place p9490e
  place t9490e_4 on 4
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  place p94916
  place t94916_5 on 5
  set h_r12 to unwind
  call advance_tok
  set h_rax to answer
  go to p949d2
  place p94923
  place t94923_6 on 6
  set h_r12 to unwind
  set h_rsi to 8
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p94968
  end
  place p94940
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94968
  end
  place p9494c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94968
  end
  place p94958
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p949ee
  end
  place p94968
  place t94968_8 on 8
  set h_r12 to unwind
  set h_rsi to addr c110
