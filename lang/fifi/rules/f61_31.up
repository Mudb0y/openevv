    go to p94a40
  end
  place p94982
  place t94982_13 on 13
  set h_r12 to unwind
  set h_rsi to addr c110
  set h_rcx to addr c120
  call find_compound h_rsi addr c100 h_rcx
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p949a3
  place t949a3_12 on 12
  place t949a3_14 on 14
  set h_r12 to unwind
  set h_rsi to 11
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 17
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  set h_rcx to addr c120
  call is_possible_compound h_rsi addr c100 h_rcx
  set h_rax to answer
  place p949d2
  set k949d2_0 to h_rax
  set h_rax to 1
  if k949d2_0 is 0
    set h_r12 to 1
  end
  place p949db
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place p949e3
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rax to answer
  place p949ee
  place t949ee_10 on 10
  set h_r12 to unwind
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p949e3
  end
  place p949fa
  go to p949db
  place p949fc
  place t949fc_9 on 9
  set h_r12 to unwind
  set h_rsi to 9
  set h_r14 to addr c110
  call savescptr h_rsi addr c130
  set h_rax to answer
  set h_rsi to addr c110
  set h_rcx to addr c100
  call fin_compounds h_rsi addr c130 h_rcx
  set s94a2e to answer
  set h_rax to s94a2e
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p94a3e
  go to p94a77
  place p94a40
  set h_rsi to 14
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 15
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call possible_root_to_right h_rsi
  set h_rax to answer
  go to p949d2
  place p94a6a
  place t94a6a_2 on 2
  place t94a6a_7 on 7
  place t94a6a_15 on 15
  place t94a6a_17 on 17
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place p94a77
  place t94a77_11 on 11
  set h_r12 to unwind
  set h_rsi to addr c110
  call insert_compound h_rsi addr c100
  set h_rax to answer
  place p94a8d
  place t94a8d_18 on 18
  set h_r12 to unwind
  set h_rsi to addr c100
  call analyze_compound h_rsi addr c120
  set h_rax to answer
  match
  place p94ab2
  place t94ab2_1 on 1
  set h_r12 to unwind
  set h_r14 to h_r12
  place p94ab5
  set h_r15 to h_r14
  set h_rsi to 6
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 7
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  set h_r14 to 1
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p94b32
  end
  place p94ae8
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94b32
  end
  place p94af4
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94b32
  end
  place p94b00
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94b32
  end
  place p94b0c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94b32
  end
  place p94b18
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p94b32
  end
  place p94b24
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    set h_r15 to 1
  end
  place p94b32
  set h_rsi to h_r15
  set h_r15 to 9
  set unwind to h_rsi
