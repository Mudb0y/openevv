# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule fin_funct_words takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c130 bytes 8
  local c148 bytes 8
  local v118 word
  local v120 word
  local v138 word
  local h_r14
  local h_r15
  local h_rcx
  local h_rdx
  local h_rsi
  local s97a49
  local s97d40
  local s97e7f
  local s97ebd
  local s97ee9
  local s97f07
  variable gbec word 1984
  variable gbf8 word 1996
  variable gbfc word 2000
  place p978e8
  set h_r14 to arg 3
  place p97926
  place p97986
  set h_rsi to addr c100
  set h_r15 to -6
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rsi to addr c110
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rsi to addr c148
  set h_rdx to arg 3
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_r15 to addr c130
  set v120 to 0
  and 0 into v118
  set cell c130 kind to 4
  set h_rdx to sym eti_null
  set h_r14 to 0
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rdx to sym eti_s_fbbd7
  set h_rsi to 1
  call fence h_rsi h_rdx
  set cell c130 field to 3
  set h_rdx to addr gbf8
  set h_rsi to addr c130
  set v138 to addr gbf8
  call copyvar h_rsi h_rdx
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rdx to 18
  set h_rsi to 1
  call setd_lookup h_rsi h_rdx
  set s97a49 to answer
  set h_r15 to 0
  if s97a49 is 0
    go to p97dc0
  end
  place p97a59
  place t97a59_1 on 1
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 10
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97c4b
  end
  place p97a85
  place t97a85_3 on 3
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 11
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97c4f
  end
  place p97ab1
  place t97ab1_4 on 4
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 12
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97c53
  end
  place p97add
  place t97add_5 on 5
  set h_r15 to unwind
  set h_r14 to h_r15
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 13
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97c87
  end
  place p97b0c
  set h_r15 to h_r14
  place p97b0f
  place t97b0f_6 on 6
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 14
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97c8e
  end
  place p97b3b
  place t97b3b_7 on 7
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 16
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97cb9
  end
  place p97b67
  place t97b67_8 on 8
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 15
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97d55
  end
  place p97b93
  place t97b93_9 on 9
  set h_r15 to unwind
  set h_r14 to h_r15
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 19
  call setd_lookup h_rsi h_rdx
  if answer is 0
    go to p97d9b
  end
  place p97bc2
  set h_r15 to h_r14
  place p97bc5
  place t97bc5_10 on 10
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 17
  call setd_lookup h_rsi h_rdx
  if answer is not 0
    give up
  end
  place p97bf1
  set h_rsi to 1
  call npush_s h_rsi
  set h_r14 to addr c130
  set cell c130 field to 1
  set h_rsi to addr c130
  call npop h_rsi
  set h_rsi to 6
  call npush_s h_rsi
  set cell c130 field to 2
  set h_rsi to addr c130
  call npop h_rsi
  set cell c130 field to 3
  set h_rsi to addr c130
  set h_rdx to addr gbf8
  go to p97cf1
  place p97c4b
  set h_rsi to 8
  go to p97c55
  place p97c4f
  set h_rsi to 8
  go to p97cbb
  place p97c53
  set h_rsi to 5
  place p97c55
  call npush_s h_rsi
  set h_r14 to addr c130
  set cell c130 field to 1
  set h_rsi to addr c130
  call npop h_rsi
  set cell c130 field to 3
  set h_rdx to addr gbec
  go to p97ceb
  place p97c87
  set h_rsi to 12
  go to p97d9d
  place p97c8e
  set h_rsi to 8
  call npush_s h_rsi
  set h_r14 to addr c130
  set cell c130 field to 1
  set h_rsi to addr c130
  call npop h_rsi
  set h_rsi to 9
  go to p97d7b
  place p97cb9
  set h_rsi to 9
  place p97cbb
  call npush_s h_rsi
  set h_r14 to addr c130
  set cell c130 field to 1
  set h_rsi to addr c130
  call npop h_rsi
  set cell c130 field to 3
  set h_rdx to addr gbfc
  place p97ceb
  set h_rsi to addr c130
  place p97cf1
  call copyvar h_rsi h_rdx
  place p97cf6
  place t97cf6_2 on 2
  set h_r15 to unwind
  set h_r14 to h_r15
  place p97cf9
  set h_rsi to 12
  call starttest h_rsi
  set h_rsi to 13
  call bspush_ca_boa h_rsi
  set h_rsi to addr c100
  set h_rdx to 4
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to p97e01
  end
  place p97d29
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rsi to 4
  set h_rdx to 6
  set h_rcx to 1
  call testFldeq h_rsi h_rdx h_rcx
  set s97d40 to answer
  set h_rcx to h_r14
  if s97d40 is not 0
    go to p97e01
  end
  place p97d50
  go to p97ded
  place p97d55
  set h_rsi to 3
  call npush_s h_rsi
  set h_r14 to addr c130
  set cell c130 field to 1
  set h_rsi to addr c130
  call npop h_rsi
  set h_rsi to 11
  place p97d7b
  call npush_s h_rsi
  set cell c130 field to 2
  set h_rsi to addr c130
  call npop h_rsi
  go to p97cf6
  place p97d9b
  set h_rsi to 1
  place p97d9d
  call npush_s h_rsi
  set h_rsi to addr c130
  set cell c130 field to 1
  call npop h_rsi
  go to p97cf9
  place p97dc0
  set h_rsi to 2
  call npush_s h_rsi
  set h_rsi to addr c130
  set cell c130 field to 1
  call npop h_rsi
  set h_r14 to 0
  go to p97cf9
  place p97ded
  set h_r14 to h_rcx
  call advance_tok
  if answer is 0
    set h_r14 to 1
  end
  place p97e01
  set h_rsi to h_r14
  set h_r14 to 4
  set unwind to h_rsi
  backtrack
  place p97e45
  place t97e45_13 on 13
  set h_r15 to unwind
  call bspop_boa
  set h_rsi to addr c100
  set h_rdx to addr c148
  call lpta_rpta_loadp h_rsi h_rdx
  set cell c130 field to 3
  set h_rsi to 4
  set h_rdx to 3
  set h_rcx to addr c130
  call mark_v h_rsi h_rdx h_rcx 0
  set s97e7f to answer
  set h_rsi to h_r15
  if s97e7f is not 0
    set unwind to h_rsi
    backtrack
  end
  place p97e8b
  place t97e8b_12 on 12
  set h_r15 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c148
  call lpta_rpta_loadp h_rsi h_rdx
  set cell c130 field to 1
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to addr c130
  call mark_v h_rsi h_rdx h_rcx 0
  set s97ebd to answer
  set h_rsi to h_r15
  if s97ebd is not 0
    set unwind to h_rsi
    backtrack
  end
  place p97ecd
  set cell c130 field to 2
  set h_rsi to 4
  set h_rdx to 2
  set h_rcx to addr c130
  call mark_v h_rsi h_rdx h_rcx 0
  set s97ee9 to answer
  set h_rsi to h_r15
  if s97ee9 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place p97efb
  place t97efb_14 on 14
  set h_r15 to unwind
  set h_rsi to 4
  set h_rdx to 6
  set h_rcx to 3
  call testFldeq h_rsi h_rdx h_rcx
  set s97f07 to answer
  set h_rcx to h_r15
  set h_rsi to h_r15
  if s97f07 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p97f1a
  go to p97ded
  place p97f1f
  place t97f1f_15 on 15
  set h_r15 to unwind
  set h_rcx to h_r15
  go to p97ded
end

rule mark_fin_content_word takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  place p97f74
  place p97fba
  place p97fed
  call get_parm addr c100 arg 1 -6
  call get_parm addr c120 arg 2 -6
  call get_parm addr c110 arg 3 -6
  call fence 0 sym eti_null
  call fence 1 sym eti_s_fbbd7
  call is_proper_name addr c100
  if answer is not 0
    go to p980ba
  end
  place p9806a
  call lpta_rpta_loadp addr c100 addr c110
  call mark_s 4 1 7 0
  if answer is not 0
    go to p980ba
  end
  place p9809b
  call mark_s 4 2 8 0
  if answer is 0
    match
  end
  place p980ba
  call is_number addr c100 addr c120 addr c110
  if answer is 0
    go to p9813a
  end
  place p980db
  call is_adverb addr c100 addr c120 addr c110
  if answer is 0
    go to p9813a
  end
  place p980fc
  call is_verb addr c100 addr c120 addr c110
  if answer is 0
    go to p9813a
  end
  place p9811d
  call adverb_vs_nounadj addr c100 addr c120 addr c110
  place p9813a
  match
end

rule is_number takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local h_r13
  local h_r14
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  place p98172
  set h_r14 to arg 3
  set h_r13 to arg 2
  set h_r15 to arg 1
  place p981b4
  place p98217
  set h_rsi to addr c120
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c140
  set h_rdx to arg 3
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_r14 to addr c130
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_r13 to 0
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rdx to sym eti_s_fbbd7
  set h_r15 to 1
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rax to addr c120
  set h_rax to cell c120 value
  set cell c100 value to h_rax
  set cell c130 value to h_rax
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p98710
  end
  place p982e6
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbd8
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rcx to 0
  set h_rdx to 0
  set h_r13 to 1
  if h_rax is not 0
    go to p988e0
  end
  place p98320
  go to p986bb
  place p9835c
  place t9835c_3 on 3
  set h_r15 to unwind
  set h_rsi to 4
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbd9
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r15
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p98382
  set h_rsi to 5
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbda
  go to p9846f
  place p98399
  place t98399_4 on 4
  set h_r15 to unwind
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbd8
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r15
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p983c3
  set h_rsi to 7
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbdb
  go to p9841f
  place p983e2
  place t983e2_6 on 6
  set h_r15 to unwind
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbde
  go to p98480
  place p983f9
  place t983f9_7 on 7
  set h_r15 to unwind
  set h_rsi to 11
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 12
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbdd
  go to p98450
  place p98418
  place t98418_8 on 8
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbdc
  place p9841f
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r15
  if h_rax is not 0
