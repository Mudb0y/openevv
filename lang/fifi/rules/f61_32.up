  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbde
  go to p985e0
  place p98559
  place t98559_23 on 23
  set h_r15 to unwind
  set h_rsi to 27
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 28
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fbbdd
  go to p985b0
  place p98578
  place t98578_24 on 24
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbdc
  place p9857f
  set h_rdx to 1
  set h_rsi to 1
