  end
  place p98437
  place t98437_9 on 9
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbdb
  go to p9846f
  place p98440
  place t98440_11 on 11
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbd9
  go to p9846f
  place p98449
  place t98449_12 on 12
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbdc
  place p98450
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
