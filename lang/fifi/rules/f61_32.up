  place p985a0
  place t985a0_27 on 27
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbd9
  go to p985cf
  place p985a9
  place t985a9_28 on 28
  set h_r15 to unwind
  set h_rcx to sym eti_s_fbbdc
  place p985b0
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r15
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p985c8
