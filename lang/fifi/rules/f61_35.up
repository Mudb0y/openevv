rule add_abbr_case_and_num takes 2
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c108 bytes 8
  place pae250
  place pae290
  place pae2bf
  call get_parm addr c108 arg 1 -6
  set cell cf4 kind to 65532
  set cell cf0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell cf4 field
  and 0 into cell cf0 field
  call get_abbr_case_and_num addr c108 addr cf4 addr cf0
  call modify_abbr addr c108 addr cf4 addr cf0
  match
end

rule get_abbr_case_and_num takes 4
