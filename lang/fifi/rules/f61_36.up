# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule convert_fin_digits_to_words takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c11c bytes 8
  local c120 bytes 8
  local v118 word
  place pb29a3
  place pb29e6
  place pb2a19
  call get_parm addr c100 arg 1 -6
  set v118 to arg 2
  call get_parm addr c110 arg 2 -6
  set c120 to 65532
  set c11c to 65532
  call fence 0 sym eti_null
  call starttest 1
  call move_i addr c120 0
  call move_i addr c11c 0
  call convert_fin_monetary_exp addr c100 addr c110 addr c120 addr c11c
  if answer is 0
    go to pb2bfc
  end
  place pb2abe
  set unwind to 0
  backtrack
  place pb2b03
  place tb2b03_1 on 1
  call convert_fin_date addr c100 addr c110
  if answer is 0
    go to pb2bfc
  end
  place pb2b21
  place tb2b21_3 on 3
  call convert_fin_time addr c100 addr c110
  if answer is 0
    go to pb2bfc
  end
  place pb2b3f
  place tb2b3f_4 on 4
  call convert_fin_sports_time addr c100 addr c110
  if answer is 0
    go to pb2bfc
  end
  place pb2b5d
  place tb2b5d_5 on 5
  call starttest 6
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pb2bcc
  end
  place pb2b7e
  call test_string_s 1 1 sym eti_s_fbe50
  if answer is not 0
    go to pb2bcc
  end
  place pb2b97
  place tb2b97_8 on 8
  call bspush_ca_scan 7
  call testFldeq 1 3 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb2bbb
  call advance_tok
  if answer is 0
    go to pb2b97
  end
  place pb2bc7
  set unwind to 0
  backtrack
  place pb2bcc
  place tb2bcc_6 on 6
  call is_fin_fraction addr c100 addr c110
  if answer is 0
    go to pb2bfc
  end
  place pb2be6
  place tb2be6_10 on 10
  call convert_fin_digits addr c100 addr c110
  place pb2bfc
  place tb2bfc_2 on 2
  place tb2bfc_9 on 9
  put cell c110 value into arg 2 at 4
  match
  place pb2c44
  place tb2c44_7 on 7
  call savescptr 7 addr c110
  call single_chars addr c100 addr c110
  go to pb2bfc
end

