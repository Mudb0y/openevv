rule assign_vow_phoneme takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  variable g710 word 998
  place pbbea4
  place pbbedf
  place pbbf3f
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  call fence 1 sym eti_s_fbf90
  call starttest 1
  call lpta_loadp addr c110
  call setscan_nof_l 1
  if answer is 0
    go to pbc07e
  end
  place pbbfdb
  place tbbfdb_1 on 1
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pbc00d
  end
  place pbbff1
  call test_string_s 1 1 sym eti_s_fbfae
  if answer is 0
    go to pbc359
  end
  place pbc00d
  place tbc00d_4 on 4
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pbc163
  end
  place pbc027
  call test_string_s 1 1 sym eti_s_fbfaf
  if answer is not 0
    go to pbc163
  end
  place pbc043
  call lpta_rpta_loadp addr c100 addr c110
  call insert_2pt_s 2 1 sym eti_s_fbfa8 0
  if answer is not 0
    go to pbc163
  end
  place pbc079
  go to pbc3cf
  place pbc07e
  place pbc093
  place tbc093_2 on 2
  call savescptr 2 addr c120
  call savetok addr g710
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pbc0b0
  call lpta_loadp addr c120
  call setscan_nof_r 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pbc0d9
  call npush_fld 1 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pbc0ea
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pbc0f6
  and 0 into global half 1000
  call npush_vf addr g710
  call if_testeq
  if answer is 0
    go to pbc143
  end
  set unwind to 0
  backtrack
  place pbc143
  place tbc143_3 on 3
  call savescptr 3 addr c110
  set global half 4354 to 1
  go to pbbfdb
  place pbc163
  place tbc163_7 on 7
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pbc195
  end
  place pbc179
  call test_string_s 1 1 sym eti_s_fbfb0
  if answer is 0
    go to pbc371
  end
  place pbc195
  place tbc195_8 on 8
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pbc1c7
