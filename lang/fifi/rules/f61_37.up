# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule generate_diaphones takes 3
  instead
  local c100 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  local c168 bytes 8
  local v108 word
  local h_r14
  local h_r15
  local h_rcx
  local h_rdx
  local h_rsi
  local sbb20e
  local sbb26e
  local sbb315
  local sbb350
  local sbb3da
  local sbb451
  local sbb54e
  local sbb56a
  variable g668 word 916
  variable g678 word 924
  place pbb06c
  set h_r14 to arg 1
  set h_r15 to 94
  place pbb0ab
  place pbb10e
  set h_r15 to addr c168
  set h_rsi to addr c168
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rsi to addr c158
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rsi to addr c148
  call push_ptr_init h_rsi
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rsi to addr c118
  call push_ptr_init h_rsi
  set h_rsi to addr c128
  call push_ptr_init h_rsi
  set h_rsi to addr c138
  call push_ptr_init h_rsi
  set h_rdx to sym eti_null
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rsi to 1
  call startloop h_rsi
  set h_rsi to addr c168
  call lpta_loadpn h_rsi
  set h_r15 to 3
  set h_rsi to 3
  call lpta_mover h_rsi
  set h_r14 to addr g668
  set h_rsi to addr g668
  call lpta_storep h_rsi
  set h_rsi to addr c158
  call lpta_loadpn h_rsi
  set h_rsi to 3
  call lpta_mover h_rsi
  set h_rsi to addr c148
  call lpta_storep h_rsi
  set v108 to addr g668
  set h_rsi to addr g668
  set h_rdx to addr c148
  call forall_to_test h_rsi h_rdx
  set sbb20e to answer
  set h_rcx to 0
  set h_r14 to 0
  if sbb20e is not 0
    go to pbb4ec
  end
  place pbb221
  go to pbb22b
  place pbb228
  place tbb228_19 on 19
  set h_r14 to unwind
  set h_rcx to h_r14
  place pbb22b
  set h_r14 to h_rcx
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rdx to 3
  set h_rsi to addr g668
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to pbb4ec
  end
  place pbb253
  set h_rsi to 3
  set h_rdx to 1
  set h_rcx to 0
  call testFldeq h_rsi h_rdx h_rcx
  if answer is not 0
    go to pbb4ec
  end
  place pbb26b
  call advance_tok
  set sbb26e to answer
  set h_rcx to h_r14
  if sbb26e is not 0
    go to pbb4ec
  end
  place pbb27e
  go to pbb283
  place pbb280
  place tbb280_4 on 4
  set h_r14 to unwind
  set h_rcx to h_r14
  place pbb283
  set h_r15 to h_rcx
  set h_rdx to addr g678
  set h_rsi to 4
  call savescptr h_rsi h_rdx
  go to pbb29d
  place pbb29a
  place tbb29a_2 on 2
  set h_r14 to unwind
  set h_r15 to h_r14
  place pbb29d
  set h_r14 to addr g668
  set h_rsi to 3
  call startloop h_rsi
  set h_rsi to addr g668
  call lpta_loadpn h_rsi
  set h_r14 to 1
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rsi to addr c100
  call lpta_storep h_rsi
  set h_rsi to addr g678
  call lpta_loadpn h_rsi
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rsi to addr c128
  call lpta_storep h_rsi
  set h_r14 to h_r15
  place pbb304
  place tbb304_17 on 17
  set h_r14 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c128
  call forall_to_test h_rsi h_rdx
  set sbb315 to answer
  set h_rcx to h_r14
  if sbb315 is not 0
    go to pbb4ec
  end
  place pbb325
  set h_r14 to h_rcx
  set h_rsi to 6
  call bspush_ca h_rsi
  set h_rsi to addr c100
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to pbb4ec
  end
  place pbb34d
  call advance_tok
  set sbb350 to answer
  set h_rcx to h_r14
  if sbb350 is not 0
    go to pbb4ec
  end
  place pbb360
  go to pbb36a
  place pbb362
  place tbb362_18 on 18
  set h_r14 to unwind
  set h_rcx to h_r14
  go to pbb325
  place pbb367
  place tbb367_7 on 7
  set h_r14 to unwind
  set h_rcx to h_r14
  place pbb36a
  set h_r15 to h_rcx
  set h_rsi to 7
  set h_rdx to addr c118
  call savescptr h_rsi h_rdx
  go to pbb384
  place pbb381
  place tbb381_5 on 5
  set h_r14 to unwind
  set h_r15 to h_r14
  place pbb384
  set h_rsi to 8
  call starttest h_rsi
  set h_rsi to addr c100
  set h_r14 to 1
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is 0
    go to pbb424
  end
  place pbb3a9
  set h_r14 to h_r15
  place pbb3ac
  place tbb3ac_8 on 8
  set h_r14 to unwind
  set h_rsi to addr c100
  set h_rdx to addr c118
  call assign_vow_phoneme h_rsi h_rdx
  place pbb3c2
  place tbb3c2_10 on 10
  place tbb3c2_11 on 11
  set h_r14 to unwind
  set h_rsi to 12
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 2
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set sbb3da to answer
  set h_rcx to h_r14
  if sbb3da is 0
    go to pbb48b
  end
  place pbb3ea
  place tbb3ea_12 on 12
  set h_r14 to unwind
  set h_rsi to 16
  call starttest h_rsi
  set h_rsi to addr c118
  call lpta_loadpn h_rsi
  set h_rsi to addr g678
  call rpta_loadpn h_rsi
  call compare_ptas
  if answer is 0
    go to pbb44e
  end
  place pbb41f
  place tbb41f_16 on 16
  set h_r14 to unwind
  set h_rdx to h_r14
  go to pbb464
  place pbb424
  set h_rsi to 9
  call bspush_ca_scan_boa h_rsi
  set h_rdx to 4
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi h_rdx h_rcx
  if answer is 0
    set h_r15 to 1
  end
  set h_r14 to h_r15
  go to pbb4ec
  place pbb44e
  call testeq
  set sbb451 to answer
  set h_rdx to h_r14
  set h_rcx to h_r14
  if sbb451 is 0
    go to pbb59d
  end
  place pbb464
  set h_r14 to h_rdx
  set h_rsi to 3
  set h_rdx to 5
  set h_rcx to addr c100
  call forall_cont_from h_rsi h_rdx 0 h_rcx addr c118
  go to pbb304
  place pbb488
  place tbb488_13 on 13
  set h_r14 to unwind
  set h_rcx to h_r14
  place pbb48b
  set h_r14 to h_rcx
  set h_rsi to 13
  set h_rdx to addr c138
  call savescptr h_rsi h_rdx
  call advanc
  if answer is not 0
    go to pbb4ec
  end
  place pbb4ac
  set h_rsi to addr c138
  set h_rdx to 2
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to pbb4ec
  end
  place pbb4c2
  set h_rsi to 14
  call bspush_ca_scan_boa h_rsi
  place pbb4cd
  place tbb4cd_15 on 15
  set h_r14 to unwind
  set h_rcx to sym eti_s_fbf90
  set h_rsi to 15
  set h_r15 to 1
  set h_rdx to 1
  call test_synch h_rsi h_rdx h_rcx
  if answer is 0
    set h_r14 to 1
  end
  place pbb4ec
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place pbb52f
  place tbb52f_6 on 6
  set h_r14 to unwind
  set h_rcx to addr c128
  set h_rsi to 3
  set h_rdx to 5
  set h_rcx to 18
  call forto_adv_upto_r h_rsi h_rdx h_rcx 1 addr c100 addr c128
  set sbb54e to answer
  set h_rcx to h_r14
  set h_rsi to h_r14
  if sbb54e is not 0
    set unwind to h_rsi
    backtrack
  end
  place pbb55d
  go to pbb59d
  place pbb55f
  place tbb55f_9 on 9
  set h_r14 to unwind
  call bspop_boa
  call advance_tok
  set sbb56a to answer
  set h_rsi to h_r14
  if sbb56a is not 0
    set unwind to h_rsi
    backtrack
  end
  place pbb576
  set h_rsi to addr c100
  set h_rdx to addr c118
  call assign_con_phonemes h_rsi h_rdx
  go to pbb3c2
  place pbb59a
  place tbb59a_3 on 3
  set h_r14 to unwind
  set h_rcx to h_r14
  place pbb59d
  set h_r14 to h_rcx
  set h_rcx to addr c148
  set h_rsi to 1
  set h_rdx to 2
  set h_rcx to 19
  call forto_adv_upto_r h_rsi h_rdx h_rcx 3 addr g668 addr c148
  if answer is not 0
    go to pbb4ec
  end
  match
  place pbb5d9
  place tbb5d9_14 on 14
  set h_r14 to unwind
  call bspop_boa
  call lpta_loadp addr c100
  set h_rsi to 2
  call delete_1pt h_rsi
  go to pbb3ea
  place tm_1 on 1
  match
end

rule assign_con_phonemes takes 3
