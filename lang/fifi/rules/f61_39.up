  place pc264e
  place tc264e_7 on 7
  set h_rcx to sym eti_s_fbfc5
  go to pc2608
  place pc2657
  place tc2657_8 on 8
  set h_rcx to sym eti_s_fbfc6
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc266f
  go to pc26fa
  place pc2674
  place tc2674_1 on 1
