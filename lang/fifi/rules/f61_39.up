# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule strip_fin_clitics takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local v138 word
  local h_rcx
  place pc127c
  place pc12be
  place pc1321
  set h_rcx to -6
  call get_parm addr c130 arg 1 h_rcx
  set v138 to arg 2
  set h_rcx to -6
  call get_parm addr c120 arg 2 h_rcx
  set h_rcx to -6
  call get_parm addr c110 arg 3 h_rcx
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  call fence 1 sym eti_s_fbfc2
  call starttest 1
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to pc13d5
  end
  place pc13c5
  call advance_tok
  if answer is 0
    go to pc1618
  end
  place pc13d5
  place tc13d5_1 on 1
  call lpta_loadpn addr c100
  call rpta_loadpn addr c110
  call compare_ptas
  if answer is not 0
    go to pc140f
  end
  place pc13ff
  call testeq
  if answer is 0
    give up
  end
  place pc140f
  place tc140f_4 on 4
  call starttest 5
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pc144c
  end
  place pc1430
  set h_rcx to sym eti_s_fbfc3
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to pc158e
  end
  place pc144c
  place tc144c_5 on 5
  call starttest 10
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pc1489
  end
  place pc146d
  set h_rcx to sym eti_s_fbfc7
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to pc15a5
  end
  place pc1489
  place tc1489_10 on 10
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pc14bc
  end
  place pc149f
  set h_rcx to sym eti_s_fbfcc
  call test_string_s 1 3 h_rcx
  if answer is 0
    go to pc15ea
  end
  place pc14bc
  place tc14bc_14 on 14
  call starttest 16
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pc14f9
  end
  place pc14dd
  set h_rcx to sym eti_s_fbfc7
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to pc15bc
  end
  place pc14f9
  place tc14f9_16 on 16
  call starttest 20
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to pc1536
  end
  place pc151a
  set h_rcx to sym eti_s_fbfd0
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to pc15d3
  end
  place pc1536
  place tc1536_20 on 20
  call starttest 24
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place pc155b
  set h_rcx to sym eti_s_fbfd0
  call test_string_s 1 1 h_rcx
  if answer is not 0
    give up
  end
  place pc1577
  call bspush_ca_scan 25
  set h_rcx to sym eti_s_fbfc4
  go to pc1832
  place pc158e
  call bspush_ca_scan 6
  set h_rcx to sym eti_s_fbfc4
  go to pc16cc
  place pc15a5
  call bspush_ca_scan 11
  set h_rcx to sym eti_s_fbfc8
  go to pc172d
  place pc15bc
  call bspush_ca_scan 17
  set h_rcx to sym eti_s_fbfc2
  go to pc178f
  place pc15d3
  call bspush_ca_scan 21
  set h_rcx to sym eti_s_fbfc4
  go to pc17d4
  place pc15ea
  set h_rcx to addr c120
  call handle_kin addr c130 addr c100 h_rcx addr c110
  go to pc186b
  place pc1618
  place tc1618_3 on 3
  go to pc1629
  place pc161e
  call bspush_ca_scan 2
  place pc1629
  call advance_tok
  if answer is 0
    go to pc161e
  end
  set unwind to 0
  backtrack
  place pc166a
  place tc166a_2 on 2
  call savescptr 2 addr c100
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc1688
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc1694
  call lpta_rpta_loadp addr c100 addr c110
  call setd_lookup 1 80
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc16c0
  go to pc13d5
  place pc16c5
  place tc16c5_6 on 6
  set h_rcx to sym eti_s_fbfc5
  place pc16cc
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc16e1
  place tc16e1_7 on 7
  set h_rcx to sym eti_s_fbfc6
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc16fd
  set h_rcx to addr c120
  call handle_han addr c130 addr c100 h_rcx addr c110
  go to pc186b
  place pc1726
  place tc1726_11 on 11
  set h_rcx to sym eti_s_fbfca
  place pc172d
  call test_string_s 1 2 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc1743
  place tc1743_12 on 12
  set h_rcx to sym eti_s_fbfc6
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc175f
  set h_rcx to addr c120
  call handle_kaan addr c130 addr c100 h_rcx addr c110
  go to pc186b
  place pc1788
  place tc1788_17 on 17
  set h_rcx to sym eti_s_fbfcf
  place pc178f
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc17a4
  place tc17a4_18 on 18
  set h_rcx to addr c120
  call handle_ko addr c130 addr c100 h_rcx addr c110
  go to pc186b
  place pc17cd
  place tc17cd_21 on 21
  set h_rcx to sym eti_s_fbfc5
  place pc17d4
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc17e9
  place tc17e9_22 on 22
  set h_rcx to sym eti_s_fbfd1
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc1805
  set h_rcx to addr c120
  call handle_pas addr c130 addr c100 h_rcx addr c110
  go to pc186b
  place pc182b
  place tc182b_25 on 25
  set h_rcx to sym eti_s_fbfc5
  place pc1832
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc1847
  place tc1847_26 on 26
  set h_rcx to addr c120
  call handle_pa addr c130 addr c100 h_rcx addr c110
  place pc186b
  place tc186b_8 on 8
  place tc186b_9 on 9
  place tc186b_13 on 13
  place tc186b_15 on 15
  place tc186b_19 on 19
  place tc186b_23 on 23
  place tc186b_27 on 27
  set h_rcx to arg 2
  put cell c120 value into arg 2 at 4
  match
end

rule handle_han takes 5
  instead
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local h_rax
  place pc18f4
  place pc1940
  set vf8 to arg 1
  set v100 to arg 2
  set v108 to arg 4
  place pc198b
  call get_parm addr c128 arg 1 -6
  set h_rax to answer
  call get_parm addr c148 arg 2 -6
  set h_rax to answer
  call get_parm addr c118 arg 3 -6
  set h_rax to answer
  call get_parm addr c138 arg 4 -6
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call fence 1 sym eti_s_fbfc2
  set h_rax to answer
  call lpta_rpta_loadp addr c128 addr c148
  set h_rax to answer
  call setd_lookup 1 0
  set h_rax to answer
  if h_rax is not 0
    go to pc1a72
  end
  place pc1a44
  call lpta_rpta_loadp addr c128 addr c138
  set h_rax to answer
  call mark_s 4 1 7 0
  set h_rax to answer
  if h_rax is 0
    go to pc1ab4
  end
  place pc1a72
  set h_rax to cell c148 value
  set cell c118 value to h_rax
  place pc1a80
  put h_rax into arg 3 at 4
  match
  place pc1ab4
  set h_rax to cell c118 value
  go to pc1a80
end

rule handle_kaan takes 5
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local v118 word
  local h_rcx
  place pc1ac2
  set h_rcx to 94
  place pc1b0e
  place pc1b46
  set h_rcx to -6
  call get_parm addr c100 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c110 arg 2 h_rcx
  set v118 to arg 3
  set h_rcx to -6
  call get_parm addr c138 arg 3 h_rcx
  set h_rcx to -6
  call get_parm addr c128 arg 4 h_rcx
  call fence 0 sym eti_null
  call fence 1 sym eti_s_fbfc2
  call lpta_rpta_loadp addr c100 addr c110
  call setd_lookup 1 1
  if answer is not 0
    go to pc1c25
  end
  place pc1bf3
  call lpta_rpta_loadp addr c100 addr c128
  set h_rcx to 9
  call mark_s 4 1 h_rcx 0
  if answer is 0
    go to pc1cee
  end
  go to pc1c25
  place tc1c25_1 on 1
  set h_rcx to 94
  place pc1c25
  call lpta_rpta_loadp addr c100 addr c110
  call setd_lookup 1 2
  if answer is not 0
    go to pc1c7a
  end
  place pc1c4d
  call lpta_rpta_loadp addr c100 addr c128
  set h_rcx to 1
  call mark_s 4 1 h_rcx 0
  if answer is 0
    go to pc1cee
  end
  go to pc1c7a
  place tc1c7a_3 on 3
  set h_rcx to 94
  place pc1c7a
  call lpta_rpta_loadp addr c100 addr c110
  call setd_lookup 1 3
  if answer is not 0
    go to pc1cd0
  end
  place pc1ca2
  call lpta_rpta_loadp addr c100 addr c128
  set h_rcx to 7
  call mark_s 4 1 h_rcx 0
  if answer is 0
    go to pc1cee
  end
  go to pc1cd0
  place tc1cd0_4 on 4
  set h_rcx to 94
  place pc1cd0
  call is_word_boundary addr c100 addr c110
  if answer is 0
    go to pc1df8
  end
  go to pc1cee
  place tc1cee_2 on 2
  set h_rcx to 94
  place pc1cee
  call starttest 5
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    go to pc1e06
  end
  place pc1d13
  call advance_tok
  if answer is not 0
    go to pc1e06
  end
  place pc1d23
  call advance_tok
  if answer is not 0
    go to pc1e06
  end
  place pc1d33
  call advance_tok
  if answer is not 0
    go to pc1e06
  end
  place pc1d43
  call advance_tok
  if answer is not 0
    go to pc1e06
  end
  place pc1d53
  go to pc1d68
  place tc1d68_6 on 6
  set h_rcx to 94
  place pc1d68
  call savescptr 6 addr c138
  set h_rcx to sym eti_s_fbfc7
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc1d93
  call bspush_ca_scan 7
  set h_rcx to sym eti_s_fbfc2
  place pc1dae
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to pc1e06
  end
  set unwind to 0
  backtrack
  go to pc1dea
  place tc1dea_7 on 7
  set h_rcx to 94
  place pc1dea
  set h_rcx to sym eti_s_fbfcf
  go to pc1dae
  place pc1df8
  set cell c138 value to cell c110 value
  go to pc1e06
  place tc1e06_5 on 5
  set h_rcx to 94
  place pc1e06
  set h_rcx to arg 3
  put cell c138 value into arg 3 at 4
  match
end

rule handle_kin takes 5
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c114 bytes 8
  local c128 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local v130 word
  local h_rcx
  local h_rdx
  place pc1e6c
  set h_rcx to 94
  place pc1eb8
  place pc1ef0
  set h_rcx to -6
  set h_rdx to arg 1
  call get_parm addr c100 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c110 h_rdx h_rcx
  set v130 to arg 3
  set h_rdx to arg 3
  set h_rcx to -6
  call get_parm addr c140 h_rdx h_rcx
  set h_rdx to arg 4
  set h_rcx to -6
  call get_parm addr c128 h_rdx h_rcx
  set c114 to 65532
  call push_ptr_init addr c160
  call push_ptr_init addr c150
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_fbfc2
  call fence 1 h_rdx
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 4
  call setd_lookup 1 h_rdx
  if answer is 0
    go to pc2155
  end
  place pc1fc9
  place tc1fc9_1 on 1
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 5
  call setd_lookup 1 h_rdx
  if answer is not 0
    go to pc2022
  end
  place pc1ff1
  set h_rdx to addr c128
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rcx to 1
  set h_rdx to 1
  call mark_s 4 h_rdx h_rcx 0
  if answer is 0
    go to pc20bb
  end
  place pc2022
  place tc2022_4 on 4
  call starttest 5
  set h_rdx to 1
  call lpta_loadp addr c110
  call setscan_l h_rdx
  if answer is 0
    go to pc22b9
  end
  place pc2047
  place tc2047_5 on 5
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 6
  call setd_lookup 1 h_rdx
  if answer is not 0
    go to pc209d
  end
  place pc206f
  set h_rdx to addr c128
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to 7
  call mark_s 4 h_rdx h_rcx 0
  if answer is 0
    go to pc20bb
  end
  place pc209d
  place tc209d_10 on 10
  set h_rdx to addr c110
  call is_word_boundary addr c100 h_rdx
  if answer is 0
    go to pc2190
  end
  place pc20bb
  place tc20bb_3 on 3
  call starttest 11
  set h_rdx to 1
  call lpta_loadp addr c110
  call setscan_r h_rdx
  if answer is not 0
    go to pc21d2
  end
  place pc20e0
  call advance_tok
  if answer is not 0
    go to pc21d2
  end
  place pc20f0
  call advance_tok
  if answer is not 0
    go to pc21d2
  end
  place pc2100
  call advance_tok
  if answer is not 0
    go to pc21d2
  end
  place pc2110
  place tc2110_12 on 12
  set h_rdx to addr c140
  call savescptr 12 h_rdx
  set h_rcx to sym eti_s_fbfc7
  set h_rdx to 1
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc213e
  call bspush_ca_scan 13
  set h_rcx to sym eti_s_fbfc2
  go to pc221c
  place pc2155
  call starttest 2
  set h_rdx to 0
  call move_i addr c114 h_rdx
  set h_rdx to addr c114
  call mark_word_stress addr c100 h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc218e
  go to pc21e9
  place pc2190
  set cell c140 value to cell c110 value
  go to pc21d2
  place pc21d2
  place tc21d2_11 on 11
  set h_rcx to arg 3
  put cell c140 value into arg 3 at 4
  match
  place pc21e9
  place tc21e9_2 on 2
  set h_rdx to addr c128
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to 9
  place pc2207
  call mark_s 4 h_rdx h_rcx 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc2217
  go to pc20bb
  place pc221c
  set h_rdx to 1
  call test_string_s 1 h_rdx h_rcx
  if answer is 0
    go to pc21d2
  end
  set unwind to 0
  backtrack
  place pc2262
  place tc2262_8 on 8
  set h_rdx to addr c160
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 46
  place pc227d
  call setd_lookup 1 h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc228a
  place tc228a_9 on 9
  set h_rdx to addr c128
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to 11
  go to pc2207
  place pc22ad
  place tc22ad_13 on 13
  set h_rcx to sym eti_s_fbfcf
  go to pc221c
  place pc22b9
  place tc22b9_6 on 6
  set h_rdx to addr c150
  call savescptr 6 h_rdx
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc22db
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc22eb
  set h_rdx to 1
  call lpta_loadp addr c150
  call setscan_r h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc2305
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc2315
  place tc2315_7 on 7
  set h_rdx to addr c160
  call savescptr 7 h_rdx
  call bspush_ca 8
  set h_rdx to addr c160
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 38
  go to pc227d
end

rule handle_ko takes 5
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
