end

rule estimate_fin_nsylls takes 4
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c120 bytes 9
  local c130 bytes 8
  local c148 bytes 9
  local c158 bytes 8
  local c168 bytes 8
  local c178 bytes 8
  local vf8 word
  local h_rcx
  local h_rsi
  local sc702b
  local sc707b
  place pc6d88
  set vf8 to arg 1
  place pc6dca
  place pc6e2a
  set h_rsi to addr cf0
  set h_rcx to -4
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c168
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rsi to addr c158
  set h_rcx to -6
  call get_parm h_rsi arg 3 h_rcx
  and 0 into cell c148 word 0
  set cell c148 byte 4 to 0
  set c148 to -65535
  set h_rsi to addr c178
  call push_ptr_init h_rsi
  set h_rsi to addr c108
  call push_ptr_init h_rsi
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set cell c120 byte 4 to 0
  and 0 into cell c120 word 0
  set c120 to -65535
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call fence h_rsi sym eti_s_fc03e
  set h_rsi to 1
  call startloop h_rsi
  set h_rsi to addr c168
  call lpta_loadpn h_rsi
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rsi to addr c178
  call lpta_storep h_rsi
  set h_rsi to addr c158
  call lpta_loadpn h_rsi
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rsi to addr c130
  call lpta_storep h_rsi
  place pc6f5c
  place tc6f5c_11 on 11
  set h_rsi to addr c178
  call forall_to_test h_rsi addr c130
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc6f72
  place tc6f72_12 on 12
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rsi to addr c178
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc6f93
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi 4 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc6fac
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc6fbc
  set h_rsi to addr c148
  call savetok h_rsi
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc6fd3
  place tc6fd3_4 on 4
  set h_rsi to 4
  call savescptr h_rsi addr c108
  place pc6fe5
  place tc6fe5_2 on 2
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    go to pc703b
  end
  place pc6ffb
  call advance_tok
  if answer is not 0
    go to pc703b
  end
  place pc7007
  set h_rsi to addr c120
  call savetok h_rsi
  if answer is not 0
    go to pc703b
  end
  place pc701a
  set h_rsi to addr c148
  call testeq_tvars h_rsi addr c120
  set sc702b to answer
  set h_rsi to 6
  if sc702b is 0
    go to pc711d
  end
  place pc703b
  place tc703b_5 on 5
  set h_rsi to 7
  call starttest h_rsi
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    go to pc712c
  end
  place pc7060
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to sym eti_s_fc039
  call test_string_s h_rsi 1 h_rcx
  set sc707b to answer
  set h_rsi to 9
  if sc707b is 0
    go to pc711d
  end
  set unwind to 0
  backtrack
  place pc70b9
  place tc70b9_3 on 3
  set h_rsi to 1
  set h_rcx to 12
  call forto_adv_upto_r h_rsi 2 h_rcx 1 addr c178 addr c130
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc70da
  go to pc7150
  place pc70dc
  place tc70dc_8 on 8
  set h_rsi to 10
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to sym eti_s_fc03d
  go to pc7109
  place pc70f9
  place tc70f9_10 on 10
  set h_rsi to 1
  set h_rcx to sym eti_s_fc03f
  place pc7109
  call test_string_s h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc7116
  place tc7116_9 on 9
  set h_rsi to 9
  go to pc711c
  place pc711a
  place tc711a_6 on 6
  set h_rsi to 6
  place pc711c
  place pc711d
  call savescptr h_rsi addr c108
  place pc712c
  place tc712c_7 on 7
  increment cell cf0 field
  set h_rsi to 1
  set h_rcx to addr c178
  call forall_cont_from h_rsi 2 0 h_rcx addr c108
  go to pc6f5c
  place pc7150
  place tc7150_1 on 1
  set h_rcx to arg 1
  put cell cf0 field into arg 1 at 2 half
  match
end
