  go to pc6942
  place pc6906
  set h_rsi to 2
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  set h_rdx to 1
  set h_rcx to 2
  set h_rsi to 2
  call testFldeq h_rsi h_rdx h_rcx
  set sc691c to answer
  set h_rax to sc691c
  set h_r14 to 0
  if h_rax is not 0
    go to pc6942
  end
  place pc6928
  call advance_tok
  set sc692b to answer
  set h_rax to sc692b
  set h_r14 to 0
  set kc6933_0 to h_rax
  set h_rax to 0
  if kc6933_0 is 0
    set h_rax to 1
  end
  set h_r14 to h_rax
  go to pc6942
  place pc6942
  set h_rsi to h_r14
  set h_r15 to 1
  set h_r14 to 2
  set unwind to h_rsi
  backtrack
  place pc6986
  place tc6986_5 on 5
  set h_r13 to unwind
  set h_rsi to 5
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  place pc6998
  place tc6998_7 on 7
  set h_r13 to unwind
  set h_rsi to 7
  set h_rdx to 1
  set h_rcx to sym eti_s_fc034
  call test_synch h_rsi h_rdx h_rcx
  set sc69a8 to answer
  set h_rax to sc69a8
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc69b4
  go to pc6b5d
  place pc69b9
  place tc69b9_8 on 8
  set h_r13 to unwind
  set h_rsi to 15
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 16
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc036
  go to pc6a7e
  place pc69e4
  place tc69e4_10 on 10
  set h_r13 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc036
  call test_string_s h_rsi h_rdx h_rcx
  set sc69f4 to answer
  set h_rax to sc69f4
  set h_rcx to h_r13
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc6a07
  go to pc6c1b
  place pc6a0c
  place tc6a0c_11 on 11
  set h_r13 to unwind
  set h_rsi to 13
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc038
  go to pc6a39
  place pc6a29
  place tc6a29_13 on 13
  set h_r13 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc039
  place pc6a39
  call test_string_s h_rsi h_rdx h_rcx
  set sc6a39 to answer
  set h_rax to sc6a39
  set h_rcx to h_r13
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc6a4c
  go to pc6c53
  place pc6a51
  place tc6a51_15 on 15
  set h_r13 to unwind
  set h_rsi to 21
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rdx to 2
  set h_rcx to sym eti_s_fc03b
  go to pc6ad4
  place pc6a6e
  place tc6a6e_16 on 16
  set h_r13 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc035
  place pc6a7e
  call test_string_s h_rsi h_rdx h_rcx
  set sc6a7e to answer
  set h_rax to sc6a7e
  set h_rsi to h_r13
  if h_rax is not 0
