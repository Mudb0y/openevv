# The rules of Finnish, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule create_syllables takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable gedc word 2560
  place pc6544
  place pc657f
  place pc65e3
  call get_parm addr c130 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call push_ptr_init addr c100
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  call startloop 1
  call lpta_loadpn addr c130
  call lpta_mover 2
  call lpta_storep addr c100
  call lpta_loadpn addr c110
  call lpta_mover 2
  call lpta_storep addr c120
  call forall_to_test addr c100 addr c120
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc66b4
  go to pc66bb
  place pc66bb
  place tc66bb_5 on 5
  call bspush_ca 3
  call lpta_loadp addr c100
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc66dc
  call testFldeq 2 1 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc66f0
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pc66fc
  place tc66fc_2 on 2
  call starttest 4
  call assign_syll_onset addr c100
  place pc6716
  place tc6716_4 on 4
  call c_assvar addr gedc
  increment global half 2562
  place pc672c
  place tc672c_3 on 3
  call forto_adv_upto_r 1 2 5 2 addr c100 addr c120
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_1 on 1
  match
end

rule assign_syll_onset takes 2
  instead
  local c100 bytes 8
  local h_r13
  local h_r14
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  local sc68b7
  local sc691c
  local sc692b
  local sc69a8
  local sc69f4
  local sc6a39
  local sc6a7e
  local sc6ad4
  local sc6ae7
  local sc6b15
  local sc6b3d
  local sc6c0b
  local sc6c39
  local sc6c66
  local sc6ce4
  local kc6933_0
  place pc67a4
  set h_r14 to arg 1
  set h_r15 to 94
  place pc67e0
  place pc6843
  set h_r15 to addr c100
  set h_rcx to -6
  set h_rsi to addr c100
  set h_rdx to arg 1
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_r14 to 0
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rdx to sym eti_s_fc034
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 2
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pc6906
  end
  place pc689f
  set h_rsi to 4
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  set h_rdx to 2
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set sc68b7 to answer
  set h_rax to sc68b7
  set h_r13 to h_r14
  if h_rax is not 0
    go to pc6ba6
  end
  place pc68c7
  place tc68c7_6 on 6
  set h_r13 to unwind
  set h_r14 to 1
  set h_r15 to 2
  place pc68d3
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to 2
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    go to pc6901
  end
  place pc68e8
  call advance_tok
