  place pc6cf4
  go to pc6cf9
  place pc6cf6
  place tc6cf6_26 on 26
  set h_r13 to unwind
  set h_rcx to h_r13
  place pc6cf9
  set h_r14 to h_rcx
  set h_rcx to sym eti_s_fc036
  set h_rsi to 2
