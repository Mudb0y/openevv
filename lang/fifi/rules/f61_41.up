  end
  place pc6a8e
  place tc6a8e_17 on 17
  set h_r13 to unwind
  set h_rsi to 18
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rdx to 4
  set h_rcx to 1
  go to pc6ae7
  place pc6aa7
  place tc6aa7_18 on 18
  set h_r13 to unwind
  set h_rsi to 20
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc034
  go to pc6ad4
  place pc6ac4
  place tc6ac4_20 on 20
  set h_r13 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc03a
  place pc6ad4
  call test_string_s h_rsi h_rdx h_rcx
  set sc6ad4 to answer
  set h_rax to sc6ad4
  go to pc6aff
  place pc6adb
  place tc6adb_21 on 21
  set h_r13 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to 2
  place pc6ae7
  call testFldeq h_rsi h_rdx h_rcx
  set sc6ae7 to answer
  set h_rax to sc6ae7
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc6af7
  call advance_tok
  set h_rax to answer
  place pc6aff
  set h_rcx to h_r13
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc6b0d
  go to pc6c76
  place pc6b12
  place tc6b12_23 on 23
  set h_r13 to unwind
  call advance_tok
  set sc6b15 to answer
  set h_rax to sc6b15
  set h_rcx to h_r13
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc6b28
  go to pc6cc6
  place pc6b2d
  place tc6b2d_25 on 25
  set h_r13 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_fc03d
  call test_string_s h_rsi h_rdx h_rcx
  set sc6b3d to answer
  set h_rax to sc6b3d
  set h_rcx to h_r13
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pc6b50
  go to pc6cf9
  place pc6b55
  place tc6b55_2 on 2
  place tc6b55_22 on 22
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  place pc6b5d
  place tc6b5d_3 on 3
  set h_r13 to unwind
  set h_rax to cell c100 value
  call lpta_loadp addr c100
  set h_rsi to 7
  call proj_def h_rsi
  set h_rax to answer
  set h_r14 to 0
  match
  place pc6b8a
  place tc6b8a_14 on 14
  place tc6b8a_19 on 19
  set h_r13 to unwind
  set h_rcx to h_r13
  go to pc6c76
  place pc6b9b
  place tc6b9b_1 on 1
  set h_r13 to unwind
  set h_r14 to h_r13
  go to pc689f
  place pc6ba3
  place tc6ba3_4 on 4
  set h_r13 to unwind
  set h_r14 to h_r13
  place pc6ba6
  set h_rsi to 3
  call starttest h_rsi
  set h_rax to answer
  set h_rax to cell c100 value
  call lpta_loadp addr c100
  set h_rsi to 2
  call setscan_nof_l h_rsi
  set h_rax to answer
  if h_rax is not 0
    go to pc6b5d
  end
  place pc6bda
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 10
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fc035
  set h_rsi to 2
  set h_rdx to 1
  call test_string_s h_rsi h_rdx h_rcx
  set sc6c0b to answer
  set h_rax to sc6c0b
  set h_rcx to h_r14
  if h_rax is not 0
    go to pc6942
  end
  place pc6c1b
  set h_r14 to h_rcx
  set h_rsi to 11
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fc037
  set h_rsi to 2
  set h_rdx to 1
  call test_string_s h_rsi h_rdx h_rcx
  set sc6c39 to answer
  set h_rax to sc6c39
  set h_rcx to h_r14
  if h_rax is not 0
    go to pc6942
  end
  place pc6c49
  go to pc6c53
  place pc6c4b
  place tc6c4b_9 on 9
  set h_r13 to unwind
  set h_rcx to h_r13
  go to pc6c1b
  place pc6c50
  place tc6c50_12 on 12
  set h_r13 to unwind
  set h_rcx to h_r13
  place pc6c53
  set h_r14 to h_rcx
  set h_rcx to sym eti_s_fc03a
  set h_rsi to 2
  set h_rdx to 1
  call test_string_s h_rsi h_rdx h_rcx
  set sc6c66 to answer
  set h_rax to sc6c66
  set h_rcx to h_r14
  if h_rax is not 0
    go to pc6942
  end
  place pc6c76
  set h_r15 to h_rcx
  set h_rsi to 14
  set h_r14 to addr c100
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rsi to 22
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rdx to 2
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pc6cb3
  end
  place pc6cab
  set h_r14 to h_r15
  go to pc6942
  place pc6cb3
  set h_rsi to 23
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to h_r15
  go to pc6cc6
  place pc6cc3
  place tc6cc3_24 on 24
  set h_r13 to unwind
  set h_rcx to h_r13
  place pc6cc6
  set h_r14 to h_rcx
  set h_rsi to 25
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_fc038
  set h_rsi to 2
