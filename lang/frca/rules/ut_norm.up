# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's Canadian French module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3b69c
  place p3b6db
  place p3b70e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b7ac
  end
  place p3b762
  call test_string_s 1 1 sym eti_s_156113
  if answer is not 0
    go to p3b7ac
  end
  place p3b77a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b7ac
  end
  place p3b790
  call test_string_s 1 1 sym eti_s_1560e7
  if answer is 0
    match
  end
  place p3b7ac
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b80c
  end
  place p3b7c2
  call test_string_s 1 1 sym eti_s_156136
  if answer is not 0
    go to p3b80c
  end
  place p3b7da
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b80c
  end
  place p3b7f0
  call test_string_s 1 1 sym eti_s_1560e8
  if answer is 0
    match
  end
  place p3b80c
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p3b822
  call test_string_s 1 1 sym eti_s_156138
  if answer is not 0
    give up
  end
  place p3b83a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p3b850
  call test_string_s 1 1 sym eti_s_156137
  if answer is 0
    match
  end
  give up
end

