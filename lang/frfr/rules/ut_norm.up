# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's French module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3b0ec
  place p3b12b
  place p3b15e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b1fc
  end
  place p3b1b2
  call test_string_s 1 1 sym eti_s_13a11f
  if answer is not 0
    go to p3b1fc
  end
  place p3b1ca
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b1fc
  end
  place p3b1e0
  call test_string_s 1 1 sym eti_s_13a0f3
  if answer is 0
    match
  end
  place p3b1fc
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p3b25c
  end
  place p3b212
  call test_string_s 1 1 sym eti_s_13a142
  if answer is not 0
    go to p3b25c
  end
  place p3b22a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p3b25c
  end
  place p3b240
  call test_string_s 1 1 sym eti_s_13a0f4
  if answer is 0
    match
  end
  place p3b25c
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p3b272
  call test_string_s 1 1 sym eti_s_13a144
  if answer is not 0
    give up
  end
  place p3b28a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p3b2a0
  call test_string_s 1 1 sym eti_s_13a143
  if answer is 0
    match
  end
  give up
end

