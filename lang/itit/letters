# Italian letter-to-sound.
#
# One block a letter and its arms in order, the first that matches winning.
# The last arm of a block is the bare letter: what it says when nothing else
# applies. An arm may also say what must stand to its left and right without
# swallowing it -- `after', `before', and `vowel', `consonant' or `glide' in
# either place -- and `at start' or `at end' for a run that has to begin or
# end where the piece of the word does.
#
# Italian doubles its consonants and means it: a doubled letter is two phones
# and one long sound, which IBM says by marking both `geminate'. Without the
# mark the phones are right and the sound is not, so the word gate passes and
# the sentences move. r is the exception, its double being one trill.
#
# An n before a hard c, g or q is the velar nasal, marked to be written as n,
# where IBM's rule builds that record at run time. It is the same record
# either way, and the ear cannot tell which built it.
#
# Some of what Italian says is decided by word rather than by letter, and IBM
# keeps those words in lists named for what they decide: an s between vowels
# is unvoiced in asepsi and dinosauro because their roots begin with an entry
# of VsV_pronounced_s. An arm names such a list last of all, `where the root
# begins <list>' or `where the root is <list>'.

rules in it_phone.obj named apply_ital_%s_rules
a piece runs from 864 to 872
a word runs from 704 to 712

letter b
  bb   says b b   marked geminate yes
  b    says b

letter d
  dd   says d d   marked geminate yes
  d    says d

letter f
  ff   says f f   marked geminate yes
  f    says f

letter p
  pp   says p p   marked geminate yes
  p    says p

letter t
  tt   says t t   marked geminate yes
  t    says t

letter v
  vv   says v v   marked geminate yes
  v    says v


letter r
  rr   says R     # carro -- one trill rather than two taps
  r    says r

letter j
  j    says J

letter k
  k    says k

letter w
  w    says v

letter x
  x    says k s

letter q
  q    says k

letter a
  a    says a

letter l
  ll   says l l   marked geminate yes
  l    says l

letter m
  mm   says m m   marked geminate yes
  m    says m

letter n
  nn           says n n   marked geminate yes
  n before ce  says n
  n before ci  says n
  n before ge  says n
  n before gi  says n
  n before c   says G   marked diaph_ghost +n   # banca
  n before g   says G   marked diaph_ghost +n   # lungo
  n before q   says G   marked diaph_ghost +n   # cinque
  n            says n

letter c
  cch               says k k
  cc before ii      says t C
  cci before vowel  says t C
  cc before e       says t C
  cc before è       says t C
  cc before é       says t C
  cc before i       says t C
  cc before ì       says t C
  cc before í       says t C
  cc                says k k
  ch                says k
  ck                says k
  c before ii       says C
  ci before vowel   says C
  c before e        says C
  c before è        says C
  c before é        says C
  c before i        says C
  c before ì        says C
  c before í        says C
  c                 says k

letter s
  ss                          says s s   marked geminate yes
  sh                          says S     # flash, leadership
  sc before ii                says S     # struscii
  sci before vowel            says S     where the root is sci_notpronounced_sci
  sci                         says S i   where the root is sci_notpronounced_sc
  sci                         says S i   where the root begins sci_pronounced_sci
  sci before vowel            says S
  sc before e                 says S
  sc before è                 says S
  sc before é                 says S
  sc before i                 says S
  sc before ì                 says S
  sc before í                 says S
  s before b                  says z
  s before d                  says z
  s before g                  says z
  s before l                  says z
  s before m                  says z
  s before n                  says z
  s before r                  says z
  s before v                  says z
  s after vowel before vowel  says s     where the root begins VsV_pronounced_s
  s at start                  says s     # ri-salito, para-sole
  s after vowel before vowel  says z
  s                           says s

letter g
  gg before ii      says d J
  ggi before vowel  says d J
  gg before e       says d J
  gg before è       says d J
  gg before é       says d J
  gg before i       says d J
  gg before ì       says d J
  gg before í       says d J
  gg                says g g
  gh                says g
  gli at start      says g l i     # gliadina
  gli after n       says g l i     # anglicano, gangliare
  gli               says g l i     where the root begins gli_pronounced_gli
  gli before vowel  says L
  gl before i       says L          # caturegli, foglifero: the i is its own
  gn                says N
  g before ii       says J
  gi before vowel   says J     where the root begins giV_pronounced_gV
  gi after ol before a  says J i   # astrologia -- the stressed i of -logia
  gi after ol before e  says J i
  gi after ru before a  says J i   # drammaturgia
  gi after ru before e  says J i
  gi                says J i   where the root so far is i_pronounced_i
  gi                says J i   where the root is giV_pronounced_giV
  gi before vowel   says J
  g before e        says J
  g before è        says J
  g before é        says J
  g before i        says J
  g before ì        says J
  g before í        says J
  g                 says g

letter h
  h at start   is left alone   # hall, hitler: where it begins the root
  h            says nothing

letter y
  y before vowel   says y
  y after vowel    says y     # boy, display
  y                says i

letter z
  z at start  says D     # zimologo
  zz          says t T   where the root begins zz_pronounced_tT
  zz          says d D   where the root begins zz_pronounced_dD
  zz after i before vowel  says d D   # monetizzare, but grizzly is t T
  zz          says t T
  z           says D     where the word begins z_pronounced_D
  z after t before i  says T   # strelitzia
  z after t   says D     # gratza, trotzkista
  z after s   says D     # puszta
  z after g   says D     # zigzag
  z after l   says T     # calzettone
  z after nam before o  says D   # romanzo -- but romanzesco is T
  z after nort          says T   # stronzio
  z after nor           says D   # bronzo
  z after rag           says D   # garza
  z after vowel before iend         says D   # azienda
  z after vowel before i at end     says T   # carpazi
  z after vowel before vowel+vowel  says T   # stazione, anterozoo
  z after vowel before vowel        says D   # azoto, ozono
  z before consonant    says D   # izba, nazca
  z           says T
