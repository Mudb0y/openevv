# The rules ETI Eloquence 6.1 changed or added under punctuation, lifted by
# tools/rules/lift64.py out of Apple's Italian module. 6.1 reads a sentence
# mark standing on its own as punctuation where 4.3 said its name.

rule in_brackets takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3990c
  place p3994b
  place p3997e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p39a1c
  end
  place p399d2
  call test_string_s 1 1 sym eti_s_e9113
  if answer is not 0
    go to p39a1c
  end
  place p399ea
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p39a1c
  end
  place p39a00
  call test_string_s 1 1 sym eti_s_e90e7
  if answer is 0
    match
  end
  place p39a1c
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    go to p39a7c
  end
  place p39a32
  call test_string_s 1 1 sym eti_s_e912f
  if answer is not 0
    go to p39a7c
  end
  place p39a4a
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p39a7c
  end
  place p39a60
  call test_string_s 1 1 sym eti_s_e90e8
  if answer is 0
    match
  end
  place p39a7c
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p39a92
  call test_string_s 1 1 sym eti_s_e9131
  if answer is not 0
    give up
  end
  place p39aaa
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p39ac0
  call test_string_s 1 1 sym eti_s_e9130
  if answer is 0
    match
  end
  give up
end

