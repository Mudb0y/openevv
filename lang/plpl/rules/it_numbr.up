# 8 characters of the input statement, with the characters passed in. IBM
# compiled one of these for every length its own words needed; these are the
# lengths Polish's words need.
rule pol_insert_8 takes 4 from glob.obj
  bare
  raw push param 2
  raw push param 1
  raw push param 0
  raw call lpta_rpta_loadp arity 3 depth 3
  raw push imm 0
  raw push param 3
  raw push imm 8
  raw push imm 1
  raw push param 0
  raw call insert_2pt_s arity 5 depth 8
  raw popn 8
  raw alu negl none reg r0
  raw alu sbbl reg r0 reg r0
  raw alu negl none reg r0
  raw return reg r0
end
