# jeden, with the word baked in, for the arms that name their word rather than
# passing it.
rule pol_say_1 takes 3 from glob.obj
  bare
  raw push param 2
  raw push param 1
  raw push param 0
  raw call lpta_rpta_loadp arity 3 depth 3
  raw push imm 0
  raw push sym pol_num_1
  raw push imm 5
  raw push imm 1
  raw push param 0
  raw call insert_2pt_s arity 5 depth 8
  raw popn 8
  raw alu negl none reg r0
  raw alu sbbl reg r0 reg r0
  raw alu negl none reg r0
  raw return reg r0
end

# And the two the compound units want: jeden after a tens word is five
# characters where Italian's uno is three, and trzy is four where tré is
# three.

rule pol_insert_4 takes 4 from glob.obj
  bare
  raw push param 2
  raw push param 1
  raw push param 0
  raw call lpta_rpta_loadp arity 3 depth 3
  raw push imm 0
  raw push param 3
  raw push imm 4
  raw push imm 1
  raw push param 0
  raw call insert_2pt_s arity 5 depth 8
  raw popn 8
  raw alu negl none reg r0
  raw alu sbbl reg r0 reg r0
  raw alu negl none reg r0
  raw return reg r0
end
rule pol_insert_5 takes 4 from glob.obj
  bare
