# What a letter says, where Polish and Italian disagree about it.
#
# Italian's own rule for a letter is the one lifted from its objects and it is
# long: apply_ital_s_rules is 557 lines and forty alternatives, and every one
# of them is about Italian spelling. None of it can be reached from Polish
# text, which spells nothing the way Italian does, so a Polish letter gets a
# rule of its own rather than an edit of Italian's, and the dispatcher in
# it_phone.dr is pointed at it.
#
# The shape is Italian's, because it is the machine's. A letter rule is handed
# two pointers, the two ends of the run of letters it is being asked about,
# and it puts phonemes between them: lpta and rpta are those two ends and
# insert_2pt_s fills the range with a string of phoneme codes. A rule that
# wants to say two letters make one sound moves the right-hand end past the
# second letter first, which is what savescptr does -- it puts where the scan
# has got to into the cell -- and then answers that position to its caller
# through the second pointer, so the next letter to be read is the one after
# the digraph.
#
# The codes are the phone statement's own alphabet, which
# tools/lang-phonemes.py prints: S is the postalveolar Italian spells sc,
# lowered to a retroflex for Polish in is_val.up.

# Polish sz is one sound, and it is not an s. The letter on its own is simpler
# than Italian's, which voices an s between vowels where Polish keeps it
# voiceless, so the plain arm is one insert and no test.
rule apply_pol_s_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test soft
  # The scan starts at the far end of the letter and reads the one after it,
  # and it stops at the fence, so a word ending in s before one beginning
  # with z is two words and not a digraph.
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring148          # z?
    if answer is 0
      call savescptr 1 addr right
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring113 addr left addr right  # the hard sz
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place soft
  # s before an i is the soft one, and the i is a softener rather
  # than a vowel when a vowel follows it: Kasia is two syllables and dzis is
  # one. So the i is eaten when a vowel comes after it and spoken when a
  # consonant does or nothing does.
  plant test plain
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring140          # i?
    if answer is 0
      call ZZtestFldeq1_4_1                       # and a vowel after it?
      if answer is 0
        call savescptr 2 addr right
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring25 addr left addr right  # the soft ś
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring9 addr left addr right  # a plain s
  if answer is not 0
    backtrack
  end
place said
  call succeed
  # Where the letters this rule spoke end, which is one letter further on
  # than the caller asked about when it was a digraph.
  put cell right value into arg 2 at 4
  answer 0
end

# Polish c is not Italian's. On its own it is the affricate Italian spells z,
# and before z it is the retroflex one. Before h it is /x/, which is a phoneme
# of Polish's own now -- chleb was kleb until it was.
# Before i it is the alveolo-palatal affricate, which is the same phoneme as
# cz here until Polish has one of its own, and the i is left to be spoken --
# right in cisza, an extra vowel in ciasto, and a dictionary word rather than
# a rule is what tells those apart.
rule apply_pol_c_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test aitch
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring148          # z?
    if answer is 0
      call savescptr 1 addr right
      call lpta_rpta_loadp addr left addr right
      call insert_2pt_s 2 2 sym pol_ph_tsz 0
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place aitch
  plant test soft
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring68           # h?
    if answer is 0
      call savescptr 2 addr right
      call lpta_rpta_loadp addr left addr right
      call insert_2pt_s 2 1 sym pol_ph_x 0
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place soft
  # c before an i is the soft one, and the i is a softener rather
  # than a vowel when a vowel follows it: Kasia is two syllables and dzis is
  # one. So the i is eaten when a vowel comes after it and spoken when a
  # consonant does or nothing does.
  plant test plain
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring140          # i?
    if answer is 0
      call ZZtestFldeq1_4_1                       # and a vowel after it?
      if answer is 0
        call savescptr 3 addr right
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring53 addr left addr right  # the soft ć
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring68 addr left addr right  # ts
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish rz is the voiced retroflex, which is one sound and not an r. The
# words where it really is an r and then a z -- marznie, and the others where
# the two letters meet across a seam in the word -- are the dictionary's to
# say, not this rule's.
rule apply_pol_r_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test plain
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring148          # z?
    if answer is 0
      call savescptr 1 addr right
      call pol_devoices_here addr right
      if answer is 0
        call ZZlprp_load__insert_2pt_s_2_1_ZZstring113 addr left addr right  # sz, devoiced
        if answer is 0
          go to said
        end
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring103 addr left addr right  # the hard ż
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring96 addr left addr right  # an r
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish d makes three digraphs. dz is the voiced affricate Italian spells z in
# zona. dz with a dot is the hard one, dżem, and is the stop and the retroflex
# fricative laid down as a pair, because the hard series has no affricate code
# of its own. dz with an acute is the soft one, dziecko, and that is Italian's
# own J, which its phonology breaks into the stop and its palatal fricative
# without being asked.
rule apply_pol_d_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  # dzi is the soft one and is asked about first, because the dz below would
  # swallow it. The i is a softener when a vowel follows and a vowel when one
  # does not, as with si and ci.
  plant test hard
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring148          # z?
    if answer is 0
      # The span covers dz from here, and covers the i as well if the i turns
      # out to be a softener. Each test leaves the scan past what it matched,
      # so where the scan is is what the span should end at.
      call savescptr 1 addr right
      call ZZtest_string_s_1_1_ZZstring140        # and then i?
      if answer is 0
        call ZZtestFldeq1_4_1                     # and a vowel after that?
        if answer is 0
          call savescptr 2 addr right
        end
        call ZZlprp_load__insert_2pt_s_2_1_ZZstring39 addr left addr right  # the soft dź
        if answer is 0
          go to said
        end
      end
    end
  end
  backtrack
place hard
  plant test dotted
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring148          # z?
    if answer is 0
      call savescptr 3 addr right
      call pol_devoices_here addr right
      if answer is 0
        call ZZlprp_load__insert_2pt_s_2_1_ZZstring68 addr left addr right  # ts, devoiced
        if answer is 0
          go to said
        end
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring61 addr left addr right  # dz
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place dotted
  plant test acute
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym pol_letter_zdot
    if answer is 0
      call savescptr 2 addr right
      call pol_devoices_here addr right
      if answer is 0
        call lpta_rpta_loadp addr left addr right
        call insert_2pt_s 2 2 sym pol_ph_tsz 0
        if answer is 0
          go to said
        end
      end
      call lpta_rpta_loadp addr left addr right
      call insert_2pt_s 2 2 sym pol_ph_dzz 0
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place acute
  plant test ending
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call test_string_s 1 1 sym pol_letter_zacute
    if answer is 0
      call savescptr 3 addr right
      call pol_devoices_here addr right
      if answer is 0
        call ZZlprp_load__insert_2pt_s_2_1_ZZstring53 addr left addr right  # ć, devoiced
        if answer is 0
          go to said
        end
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring39 addr left addr right  # the soft dź
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place ending
  plant test plain
  call pol_devoices_here addr right
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring160 addr left addr right  # a t
    if answer is 0
      go to said
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring140 addr left addr right  # a d
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish z on its own is a z, where Italian's is one of the two affricates.
# Every digraph that ends in a z has consumed it before this rule is reached,
# so there is nothing here to test for: what is left is the letter itself.
# What is missing is the devoicing at the end of a word -- raz is ras -- and
# that is phonology across a word rather than a letter reading its neighbour.
rule apply_pol_z_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  # z before an i is the soft one, and the i is a softener rather
  # than a vowel when a vowel follows it: Kasia is two syllables and dzis is
  # one. So the i is eaten when a vowel comes after it and spoken when a
  # consonant does or nothing does.
  plant test ending
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring140          # i?
    if answer is 0
      call ZZtestFldeq1_4_1                       # and a vowel after it?
      if answer is 0
        call savescptr 1 addr right
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring18 addr left addr right  # the soft ź
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place ending
  # Polish devoices a voiced consonant at the end of a word: raz is ras. The
  # scan that reads the next letter stops at the fence, so a scan that fails
  # is a letter with nothing after it in its own word, which is the test.
  plant test plain
  call pol_devoices_here addr right
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring9 addr left addr right  # an s
    if answer is 0
      go to said
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring210 addr left addr right  # a plain z
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# The eight letters Italian has not got.
#
# A letter reaches its rule through a chain of alternatives in
# generate_ital_diaphons, one for each letter: the chain sets the scan at the
# letter, asks whether it is this letter, and calls that letter's rule. A
# letter Italian never had has no link in that chain, and adding one means
# renumbering the tags the whole rule backtracks through -- so instead the
# link for q, which Polish does not use, is pointed at these two: this one
# says whether the letter is one of ours, and the one below speaks it.
#
# The first of them is bare, which is the shape the language's own wrappers
# have: entered, and it answers. A rule standing where a wrapper stands must
# not be a rule of the ordinary shape, because the choice points around the
# call are its caller's and a `succeed' of ours would commit them. That reads
# later as a machine whose stack says something that is not so -- a word with
# no vowel in it crashed in the durations, several rules further on.
#
# The scan is left where the chain put it. A test of one character that fails
# does not move it -- test_string_s peeks, compares, and only advances when
# the compare held -- so eight of them in a row is eight questions about the
# same letter.
rule pol_test_own_letters takes 1 from it_phone.obj
  bare
  call test_string_s 1 1 sym pol_letter_aogonek
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_cacute
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_eogonek
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_lstroke
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_nacute
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_sacute
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_zacute
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_zdot
  if answer is 0
    answer 0
  end
  answer 1
end

# And what each of them says. The scan is set from the left-hand pointer, the
# way the chain itself sets it, because that is the letter being asked about:
# the two pointers are the ends of the run and a scan rightwards from the left
# one reads the letter between them.
#
# Every arm inserts between the same two points, so the letter is spoken and
# nothing else moves. Two of them insert two phonemes rather than one.
rule apply_pol_letter_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140

  call ZZlpta_load__setscan_r__1 addr left
  if answer is not 0
    give up
  end

  call test_string_s 1 1 sym pol_letter_aogonek
  if answer is 0
    # a with an ogonek is a nasal vowel of its own, on a code of its own: the
    # open o's rule speaks it, and pol_nasal_if_aogonek in is_sival.up is what
    # makes that one nasal and the plain o not.
    call lpta_rpta_loadp addr left addr right
    call insert_2pt_s 2 1 sym pol_ph_aogonek 0
    if answer is 0
      go to said
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_eogonek
  if answer is 0
    # e with an ogonek is a nasal vowel of its own now, on the close-mid o's
    # code, which nothing else produces. What made it possible is that
    # nasalize_vow writes one global to nasalise a vowel next to a nasal
    # consonant, and stanital_ph_o writes the same one without needing the
    # consonant.
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring153 addr left addr right
    if answer is 0
      go to said
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_lstroke
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring132 addr left addr right  # the glide
    if answer is 0
      go to said
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_nacute
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring79 addr left addr right  # the palatal nasal
    if answer is 0
      go to said
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_sacute
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring25 addr left addr right  # the soft ś
    if answer is 0
      go to said
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_cacute
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring53 addr left addr right  # the soft ć
    if answer is 0
      go to said
    end
  end
  # z with an acute is the soft one, Italian's own Z, and z with a dot is the
  # hard one, which is a phoneme of Polish's own.
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_zacute
  if answer is 0
    call pol_devoices_here addr right
    if answer is 0
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring25 addr left addr right  # ś, devoiced
      if answer is 0
        go to said
      end
    end
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring18 addr left addr right  # the soft ź
    if answer is 0
      go to said
    end
  end
  call ZZlpta_load__setscan_r__1 addr left
  call test_string_s 1 1 sym pol_letter_zdot
  if answer is 0
    call pol_devoices_here addr right
    if answer is 0
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring113 addr left addr right  # sz, devoiced
      if answer is 0
        go to said
      end
    end
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring103 addr left addr right  # the hard ż
    if answer is 0
      go to said
    end
  end
  give up
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish g is always a g. Italian's is not: it reads gn as the palatal nasal
# and gi as an affricate, so gniazdo came out with no g at all -- and Polish
# reads gn as two letters, g and then a softened n.
rule apply_pol_g_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test plain
  call pol_devoices_here addr right
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring176 addr left addr right  # a k
    if answer is 0
      go to said
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring188 addr left addr right  # a g
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# And Polish n softens before an i the way s, z, c and dz do: konie is konje
# and not kon-ye. Everything else about the letter is Italian's, including the
# assimilation to the velar nasal before a k or a g, which Polish wants too --
# bank is bank with the same nasal Italian gives banca.
rule apply_pol_n_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test plain
  call ZZlpta_load__setscan_nof_r__1 addr right
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring140          # i?
    if answer is 0
      call ZZtestFldeq1_4_1                       # and a vowel after it?
      if answer is 0
        call savescptr 1 addr right
      end
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring79 addr left addr right  # ń
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring77 addr left addr right  # a plain n
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# The vowels Italian reads its own way.
#
# Italian has seven vowels and Polish six, and the two it has spare are exactly
# the two Polish does not want: the close-mid e and the close-mid o. Polish e
# is always the open one, ɛ, and Polish o always the open ɔ, where Italian
# chooses between the pair by stress and syllable shape. So Polish's letter e
# and letter o are one insert each and no tests, and that leaves Italian's
# close-mid e with nothing producing it -- which is where Polish's y goes,
# since y is a sound no module has.

# Polish e is ɛ wherever it stands.
rule apply_pol_e_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring139 addr left addr right  # ɛ
  if answer is not 0
    give up
  end
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish o is ɔ, and o with an acute is u: mój is muj and sól is sul. Italian
# sends both letters to the same rule, so this one asks which it has.
rule apply_pol_o_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test plain
  call ZZlpta_load__setscan_r__1 addr left
  if answer is 0
    call ZZtest_string_s_1_1_ZZstring20           # o with an acute?
    if answer is 0
      call ZZlprp_load__insert_2pt_s_2_1_ZZstring148 addr left addr right  # u
      if answer is 0
        go to said
      end
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring154 addr left addr right  # ɔ
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish y is ɨ, a sound between i and u that no module has, and being spoken
# as an i costs a minimal pair: być is not bić. It takes over the close-mid e
# that the rule above has just left with nothing producing it, and
# stanital_ph_e in is_sival.dr carries its formants.
rule apply_pol_y_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring138 addr left addr right  # ɨ
  if answer is not 0
    give up
  end
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# And Polish j is the glide, where Italian's is an affricate: mój was ending in
# a dż.
rule apply_pol_j_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring123 addr left addr right  # the glide
  if answer is not 0
    give up
  end
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Whether a voiced consonant here comes out voiceless.
#
# Two reasons it does. Polish devoices at the end of a word -- raz is ras, chleb
# is chlep, Łódź is Łuć -- and it devoices in front of a voiceless consonant,
# which is the commoner of the two: wtorek is ftorek, wódka is wutka, wszystko
# is fszystko, kredka is kretka. Every letter that can be devoiced asks this,
# so it is written once and called from all of them.
#
# What makes the end of a word two questions rather than one: the scan can
# always be set, and testFldeq answers "no" both when what follows is a letter
# and when nothing follows at all. So the word ends here if the scan cannot be
# set, or if what follows is none of the four things a letter can be. That
# second half catches raz before a space and before a full stop; the first
# catches raz at the end of everything.
#
# The letters in front of which a voiced consonant devoices are p, t, k, f, s,
# c, h and the two soft ones. sz and cz need no test of their own, since a
# test of s and of c has already matched by the time the digraph matters.
rule pol_devoices_here takes 2 from it_phone.obj
  bare
  call ZZlpta_load__setscan_nof_r__1 arg 1
  if answer is not 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_p
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_t
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_k
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_f
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_s
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_c
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_h
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_sacute
  if answer is 0
    answer 0
  end
  call test_string_s 1 1 sym pol_letter_cacute
  if answer is 0
    answer 0
  end
  call testFldeq 1 4 1
  if answer is 0
    answer 1
  end
  call testFldeq 1 4 2
  if answer is 0
    answer 1
  end
  call testFldeq 1 4 3
  if answer is 0
    answer 1
  end
  call testFldeq 1 4 4
  if answer is 0
    answer 1
  end
  answer 0
end

# Polish b, which devoices to p at the end of a word: chleb is chlep.
rule apply_pol_b_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test plain
  call pol_devoices_here addr right
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring88 addr left addr right  # a p
    if answer is 0
      go to said
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring5 addr left addr right  # a b
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# Polish w is a v, and an f at the end of a word: rów is ruf. Italian's rule
# gives the v already, so this one is here for the f.
rule apply_pol_w_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  plant test plain
  call pol_devoices_here addr right
  if answer is 0
    call ZZlprp_load__insert_2pt_s_2_1_ZZstring205 addr left addr right  # an f
    if answer is 0
      go to said
    end
  end
  backtrack
place plain
  call ZZlprp_load__insert_2pt_s_2_1_ZZstring198 addr left addr right  # a v
  if answer is not 0
    backtrack
  end
place said
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end

# And h on its own, which Italian leaves silent and Polish says as the same
# /x/: herbata, hałas, ha.
rule apply_pol_h_rules takes 3 from it_phone.obj
  local left bytes 8
  local right bytes 8
  call ZZget_parm_ptr2 addr left arg 1 addr right arg 2
  call ZZfence_null
  call ZZfenceZZstring140
  call lpta_rpta_loadp addr left addr right
  call insert_2pt_s 2 1 sym pol_ph_x 0
  if answer is not 0
    give up
  end
  call succeed
  put cell right value into arg 2 at 4
  answer 0
end
