# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule init_platform takes 1
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c120 bytes 10
  local h_r15
  local s4f54
  place p4e67
  place p4e9c
  place p4efc
  and 0 into cell c120 half 4
  and 0 into cell c120 word 0
  and 0 into cell c108 half 0
  set c120 to -65535
  set c108 to -65536
  set cf0 to 65532
  call fence 0 sym eti_null
  call starttest 1
  call bspush_ca_boa 2
  call initializeIO
  set s4f54 to answer
  set h_r15 to 0
  set h_r15 to 0
  if s4f54 is 0
    set h_r15 to 1
  end
  set unwind to h_r15
  backtrack
  place p4fa0
  place t4fa0_1 on 1
  set h_r15 to unwind
  call turnLazyWriteOn
  place p4fa8
  place t4fa8_3 on 3
  set h_r15 to unwind
  call starttest 4
  call move_i addr cf0 2
  call setNonSequential addr cf0 addr c120 addr c108
  if answer is not 0
    set unwind to h_r15
    backtrack
  end
  place p4fe1
  place t4fe1_4 on 4
  set h_r15 to unwind
  call open_input 6
  place p4fec
  place t4fec_5 on 5
  set h_r15 to unwind
  call open_output 8
  place p4ff7
  place t4ff7_6 on 6
  set h_r15 to unwind
  call open_output 11
  match
  place p5011
  place t5011_2 on 2
  set h_r15 to unwind
  call bspop_boa
  give up
  place tm_7 on 7
  match
end

rule DeltaProc_flush takes 1
  instead
  place p5040
  place p5073
  place p50a2
  call fence 0 sym eti_null
  call init_delta
  and 0 into global half 1376
  call read_end
  match
end

rule read_end takes 1
  instead
  local h_r12
  local h_rsi
  local s51ca
  variable g938 word 1348
  place p50f1
  place p5126
  place p5186
  call fence 0 sym eti_null
  set h_rsi to 1
  call startloop h_rsi
  set h_r12 to 0
  place p51ab
  place t51ab_2 on 2
  place t51ab_3 on 3
  set h_r12 to unwind
  set h_rsi to 3
  call starttest h_rsi
  set h_rsi to 4
  call bspush_ca_boa h_rsi
  set h_rsi to 6
  call read_tvar h_rsi addr g938
  set s51ca to answer
  set h_rsi to 1
  if s51ca is 0
    set unwind to h_rsi
    backtrack
  end
  place p51d6
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place p520f
  place t520f_4 on 4
  set h_r12 to unwind
  call bspop_boa
  set h_rsi to addr g938
  call settvar_s h_rsi 90
  match
  place tm_1 on 1
  match
end

rule close_platform takes 1
  instead
  place p5239
  place p526c
  place p529b
  call fence 0 sym eti_null
  call closeIO
  match
end

rule print_prompt takes 1
  instead
  place p52da
  place p530d
  place p533c
  call fence 0 sym eti_null
  match
end

rule PhonemeIndex takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c118 bytes 10
  local c138 bytes 18
  local c148 bytes 8
  local c158 bytes 8
  local v100 word
  variable g4e8 word 724
  variable ge30 word 2456
  place p5373
  place p53b2
  place p5415
  call get_parm addr c158 arg 1 -6
  call get_parm addr c148 arg 2 -6
  set cell c138 word 0 to 0
  set cell c138 word 4 to 0
  set cell c138 word 6 to 0
  set cell c138 word 10 to 0
  set c138 to -65532
  set cell cf4 kind to 65532
  set cf0 to 65532
  and 0 into cell c118 word 0
  and 0 into cell c118 half 4
  set c118 to -65535
  call fence 0 sym eti_null
  and 0 into cell cf4 field
  set global half 2458 to 3
  call copyvar addr cf4 addr ge30
  call lpta_loadp addr c158
  call setscan_r 4
  if answer is not 0
    go to p54e6
  end
  place p54cb
  call advance_tok
  if answer is not 0
    go to p54e6
  end
  place p54d7
  call savetok addr c138
  place p54e6
  set v100 to addr g4e8
  place p5509
  place t5509_1 on 1
  call starttest 2
  call move_i addr cf0 0
  call placePhoneme addr c138 addr cf0 addr cf4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p553e
  place t553e_2 on 2
  call lpta_loadpn addr c148
  call rpta_loadpn addr g4e8
  call compare_ptas
  if answer is not 0
    match
  end
  place p556f
  call testeq
  if answer is not 0
    match
  end
  place p557f
  call settvar_s addr c118 197
  call starttest 3
  call move_i addr cf0 0
  call placePhonemeText addr c118 addr cf0 addr cf4
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_3 on 3
  match
end

rule DeltaProc_registerLanguages takes 1
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local cf8 bytes 8
  local cfc bytes 8
  local c10c bytes 8
  local c110 bytes 8
  local c114 bytes 8
  local c118 bytes 8
  local c11c bytes 8
  local v108 word
  local v128 word
  local v130 word
  variable g158 word 184
  variable g168 word 192
  place p560a
  place p563f
  place p569f
  set cf4 to 65532
  set cf0 to 65532
  set cfc to 65532
  set cf8 to 65532
  set c10c to 65532
  set c11c to 65532
  set c118 to 65532
  set c114 to 65532
  set c110 to 65532
  call fence 0 sym eti_null
  call set_voice_param_constants
  set v130 to addr g158
  set v128 to addr g168
  set v108 to state
  place p5728
  place t5728_1 on 1
  call register_SAPI_voices
  place p5730
  place t5730_2 on 2
  set cell cfc field to 6
  set cell cf8 field to 1
  call setup_lang_reg addr cf4 addr cf0
  place p5758
  place t5758_3 on 3
  call starttest 4
  call move_i addr c10c 1
  call move_i addr c11c 1
  call move_i addr c118 1
  call move_i addr c114 1
  call move_i addr c110 1
  call registerLanguage addr cf4 addr cf0 addr cfc addr cf8 addr g158 addr g168 addr c10c addr c11c addr c118 addr c114 addr c110
  if answer is 0
    go to p585c
  end
  set unwind to 0
  backtrack
  place p585c
  place t585c_4 on 4
  call initdelta 9 sym eti_s_ef000
  call register_voices addr cf4 addr cf0 addr cfc addr cf8
  place p5892
  place t5892_5 on 5
  and 0 into global half 2402
  call register_por_phones addr cf4 addr cf0
  place p58b0
  place t58b0_6 on 6
  call initdelta 9 sym eti_s_ef000
  match
end

