rule increment_output_file_number takes 1
  instead
  local h_rax
  local h_rcx
  local n7bd6_0
  local n7be4_0
  place p7b30
  place p7b5f
  place p7bb5
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 2702
  if h_rax is 0
    match
  end
  place p7bd6
  set n7bd6_0 to h_rax
  shift left 16 into n7bd6_0
  shift right 16 into n7bd6_0
  if n7bd6_0 is less than 999
    go to p7beb
  end
  place p7bdc
  set h_rcx to h_rax
  add -1999 to h_rcx
  set n7be4_0 to h_rcx
  and 65535 into n7be4_0
  if n7be4_0 is below 64538
    match
  end
  place p7beb
  increment h_rax
  set global half 2702 to h_rax
  match
end

