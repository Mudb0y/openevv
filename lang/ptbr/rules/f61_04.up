# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule generate_durations takes 1
  instead
  place p9037
  place p906a
  place p9099
  call fence 0 sym eti_null
  call insert_transitions
  call insert_pause_durs
  call find_nucleus
  call find_acoustic_nuc
  call assign_phone_durs
  call set_syll_offset_vals
  match
end

rule insert_transitions takes 1
  instead
  local cf0 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local v110 word
  variable g300 word 420
  variable g310 word 428
  variable g404 word 600
  variable g4c8 word 708
  variable g4d8 word 716
  variable g628 word 884
  variable g638 word 892
  variable g658 word 908
  place p9100
  place p9139
  place p919f
  set cell cf0 kind to 65532
  call push_ptr_init addr c140
  call push_ptr_init addr c130
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  set v110 to addr g300
  set cell c140 value to global word 424
  set cell c130 value to global word 432
  call lpta_loadpn addr g310
  call rpta_loadpn addr g4d8
  call compare_ptas
  if answer is not 0
    go to p9282
  end
  place p923f
  call testneq
  if answer is not 0
    go to p9282
  end
  place p924b
  call lpta_loadp addr g310
  call setscan_r 7
  if answer is not 0
    go to p9282
  end
  place p925d
  call advanc
  if answer is not 0
    go to p9282
  end
  place p9269
  go to p9270
  place p9270
  place t9270_2 on 2
  call savescptr 2 addr c130
  place p9282
  set v108 to addr g4c8
  set vf8 to addr g404
  place p92b3
  place t92b3_1 on 1
  call lpta_loadpn addr g300
  call rpta_loadpn addr g4c8
  call compare_ptas
  if answer is not 0
    go to p92f7
  end
  place p92dd
  call testeq
  if answer is not 0
    go to p92f7
  end
  place p92e9
  set cell c140 value to global word 800
  place p92f7
  set v100 to addr g658
  place p92fe
  place t92fe_3 on 3
  call startloop 4
  call lpta_loadpn addr c140
  call lpta_mover 4
  call lpta_storep addr g628
  call lpta_loadpn addr c130
  call lpta_mover 4
  call lpta_storep addr c120
  call forall_to_test addr g628 addr c120
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p9381
  place t9381_12 on 12
  call bspush_ca 6
  call lpta_loadp addr g628
  call setscan_r 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p93a2
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p93b2
  place t93b2_7 on 7
  call savescptr 7 addr g638
  place p93c0
  place t93c0_5 on 5
  call lpta_loadp addr g638
  call setscan_r 4
  if answer is not 0
    go to p93f1
  end
  place p93d2
  call advanc
  if answer is not 0
    go to p93f1
  end
  place p93de
  place t93de_9 on 9
  call savescptr 9 addr g658
  go to p9496
  place p93f1
  place t93f1_8 on 8
  call lpta_loadp addr g638
  call insert_r 4 1 sym eti_s_ef055 0
  call rpta_storep addr g658
  call lpta_loadpn addr g638
  call rpta_loadpn addr g310
  call compare_ptas
  if answer is not 0
    go to p9496
  end
  place p9450
  call testeq
  if answer is not 0
    go to p9496
  end
  place p945c
  call lpta_loadp addr g638
  call rpta_loadp addr g658
  call proj_r 7
  place p9496
  place t9496_10 on 10
  call get_trans_dur addr cf0
  place p94a5
  place t94a5_11 on 11
  call starttest 6
  call insert_dur addr cf0 addr g638 addr g658 addr g404
  place p94cc
  place t94cc_6 on 6
  call forto_adv_upto_r 4 5 12 4 addr g628 addr c120
  if answer is 0
    go to p952a
  end
  set unwind to 0
  backtrack
  place p952a
  match
  place tm_4 on 4
  match
end

