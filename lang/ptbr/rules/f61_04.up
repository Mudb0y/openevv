  end
  place p9a8d
  go to p9beb
  place p9a92
  place t9a92_16 on 16
  set h_r13 to unwind
  set h_rcx to h_r13
  place p9a95
  set h_r13 to h_rcx
  call savescptr 16 addr c190
  set h_rax to answer
  place p9aaa
  place t9aaa_15 on 15
