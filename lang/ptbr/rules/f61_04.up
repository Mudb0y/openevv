  place p9b0d
  go to p9b19
  place p9b16
  place t9b16_8 on 8
  place t9b16_22 on 22
  set h_r13 to unwind
  place p9b19
  call starttest 23
  set h_rax to answer
  set h_rcx to addr c118
  call insert_dur addr cf0 addr c150 h_rcx addr g400
