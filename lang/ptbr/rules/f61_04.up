rule find_acoustic_nuc takes 1
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local cf8 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local n9fbf_0
  local scratch
  variable g340 word 452
  variable g350 word 460
  variable g658 word 908
  place p9cd0
  place p9d01
  place p9d5d
  set cell ce0 kind to 65532
  call push_ptr_init addr cf8
  set h_rax to answer
  set ce4 to 65532
  call fence 0 sym eti_null
  and 0 into cell ce0 field
  if global half 3250 is not 0
    go to p9e52
  end
  place p9d9d
  set h_rax to global word 440
  set global word 456 to h_rax
  call starttest 2
  set h_rax to answer
  call lpta_loadp addr g340
  call setscan_l 4
  set h_rax to answer
  if h_rax is not 0
    go to p9e68
  end
  place p9dd3
  call advanc
  set h_rax to answer
  if h_rax is not 0
    go to p9e68
  end
  place p9de3
  go to p9dea
  place p9dea
  place t9dea_3 on 3
  call savescptr 3 addr g340
  set h_rax to answer
  set h_rcx to 2
  call testFldeq 4 9 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9e11
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p9e68
  end
  set unwind to 0
  backtrack
  place p9e52
  place t9e52_1 on 1
  set h_rax to global word 480
  set global word 456 to h_rax
  and 0 into global half 3250
  place p9e68
  place t9e68_2 on 2
  place t9e68_4 on 4
  set h_rax to global word 448
  set global word 464 to h_rax
  call starttest 5
  set h_rax to answer
  set h_rax to global word 464
  call lpta_loadp addr g350
  call setscan_nof_l 4
  set h_rax to answer
  if h_rax is not 0
    go to pa018
  end
  place p9eae
  place t9eae_6 on 6
  call savescptr 6 addr cf8
  set h_rax to answer
  set h_rcx to 2
  call testFldeq 4 9 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9ed9
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9ee9
  set h_rax to cell cf8 value
  call lpta_loadp addr cf8
  call setscan_nof_r 4
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9f16
  call advanc
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9f26
  place t9f26_7 on 7
  call savescptr 7 addr g658
  set h_rax to answer
  call starttest 8
  set h_rax to answer
  call lpta_loadp addr g350
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to pa00a
  end
  place p9f63
  set h_rcx to 2
  call testFldeq 4 1 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9f7c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p9f8c
  set global half 3250 to 1
  call lpta_rpta_loadp addr g350 addr g658
  set h_rax to answer
  call dur_expr 8 addr ce0
  set h_rax to answer
  set h_rax to cell ce0 field
  set h_rcx to h_rax
  set n9fbf_0 to h_rax
  shift left 16 into n9fbf_0
  shift right 16 into n9fbf_0
  if n9fbf_0 is less than 2
    go to pa018
  end
  place p9fc5
  set scratch to h_rax
  multiply 4 into scratch
  add h_rax to scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell ce4 field to h_rax
  call lpta_loadpn addr g350
  set h_rax to answer
  call lpta_loadv 8 addr ce4
  set h_rax to answer
  call lpta_storep addr g350
  set h_rax to answer
  go to pa018
  place pa00a
  place ta00a_8 on 8
  set h_rax to global word 912
  set global word 464 to h_rax
  place pa018
  place ta018_5 on 5
  place ta018_9 on 9
  if global half 654 is not 1
    match
  end
  place pa022
  call scale_word_final_trans
  set h_rax to answer
  match
  place tm_10 on 10
  match
end

rule assign_phone_durs takes 1
  instead
  variable g300 word 420
  variable g310 word 428
  variable g320 word 436
  variable g330 word 444
  place pa064
  place pa097
  place pa0c6
  call fence 0 sym eti_null
  call assign_cons_durs addr g300 addr g320
  call assign_cons_durs addr g330 addr g310
  call assign_nuc_durs
  match
end

rule set_syll_offset_vals takes 1
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local h_xmm0
  variable g1238 word 3232
  variable g300 word 420
  variable g310 word 428
  place pa131
  place pa16e
  place pa1a1
  set cell c100 kind to 65531
  set cf0 to 65532
  call fence 0 sym eti_null
  set cell c100 value to 0
  call lpta_rpta_loadp addr g1238 addr g300
  call dur_expr 8 addr c100
  set h_xmm0 to global word 1232
  add cell c100 value to h_xmm0
  set global word 1248 to h_xmm0
  call lpta_rpta_loadp addr g300 addr g310
  call dur_expr 8 addr cf0
  set h_xmm0 to cell cf0 field
  multiply 10000 into h_xmm0
  add global word 1248 to h_xmm0
  set global word 1256 to h_xmm0
  match
