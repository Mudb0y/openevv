  call lpta_rpta_loadp addr c100 addr c110
  set h_rax to answer
  call insert_2ptv 8 addr cf0 0
  set h_rax to answer
  place pb712
  place tb712_3 on 3
  call forto_adv_upto_r 1 2 7 8 addr c100 addr c148
  set h_rax to answer
  if h_rax is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_1 on 1
  match
end

rule setdur takes 3
  instead
  local ce0 bytes 8
  local cf0 bytes 8
  local h_xmm0
  local sb898
  place pb794
  place pb7cd
  place pb82b
  call get_parm addr cf0 arg 1 -5
  call get_parm addr ce0 arg 2 -4
  call fence 0 sym eti_null
  set h_xmm0 to global word 2868
  scale h_xmm0 by cell cf0 value over 10000
  set global word 2868 to h_xmm0
  call npush_v addr cf0
  set h_xmm0 to 10000
  call npush_f h_xmm0
  call if_testgt
  set sb898 to answer
  set h_xmm0 to cell ce0 field
  multiply 10000 into h_xmm0
  if sb898 is 0
    go to pb8cf
  end
  place pb8b2
  if h_xmm0 is at least global word 2868
    match
  end
  place pb8b8
  set global word 2868 to h_xmm0
  match
  place pb8cf
  if global word 2868 is less than h_xmm0
    go to pb8b8
  end
  match
end

rule delete_voice_change_pause takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_r13
  local fba2d
  place pb8dc
  place pb917
  place pb977
  set h_r13 to -6
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call delete_phone_from_left addr c110 addr c100
  set h_r13 to 0
  place pb9d6
  call starttest 2
  call bspush_ca_boa 3
  call lpta_loadp addr c100
  call setscan_r 4
  if answer is 0
    go to pba05
  end
  place pb9ff
  set unwind to h_r13
  backtrack
  place pba05
  call bspush_ca_scan_boa 4
  call advanc
  set fba2d to 0
  if answer is 0
    set fba2d to 1
  end
  go to pba2d
  place pba20
  place tba20_1 on 1
  set h_r13 to unwind
  go to pb9d6
  place pba2d
  if fba2d is not 0
    set h_r13 to 1
  end
  set unwind to h_r13
  backtrack
  place pba63
  place tba63_4 on 4
  set h_r13 to unwind
  call bspop_boa
  call advance_tok
  set fba2d to 0
  if answer is 0
    set fba2d to 1
  end
  go to pba2d
  place pba77
  place tba77_3 on 3
  set h_r13 to unwind
  call bspop_boa
  call lpta_loadp addr c100
  call delete_1pt 4
  match
  place tm_2 on 2
  match
end

rule set_end_of_pause_trans takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g4e8 word 724
  place pbac8
  place pbb0b
  place pbb3e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadpn addr c110
  call rpta_loadpn addr g4e8
  call compare_ptas
  if answer is not 0
    go to pbba9
  end
  place pbb9d
  call testeq
  if answer is 0
    go to pbbdf
  end
  place pbba9
  call lpta_loadp addr c110
  call setscan_r 4
  if answer is not 0
    go to pbbed
  end
  place pbbbf
  call advanc
  if answer is not 0
    go to pbbed
  end
  place pbbcb
  call savescptr 3 addr c100
  go to pbbed
  place pbbdf
  set cell c100 value to cell c110 value
  place pbbed
  put cell c100 value into arg 2 at 4
  match
end
