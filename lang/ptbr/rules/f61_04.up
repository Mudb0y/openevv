  end
  place p99e4
  go to p9aaa
  place p99f7
  call advance_tok
  set s99fa to answer
  set h_rax to s99fa
  set h_rcx to h_r13
  if h_rax is not 0
    go to p9aaa
  end
  place p9a18
  go to p9a95
  place p9a1a
  call npush_fld 4 11
  set h_rax to answer
  if h_rax is 0
    go to p9a3b
  end
  place p9a2c
  go to p98b8
  place p9a3b
  call npush_v addr gdf0
  set h_rax to answer
  call if_testle
  set h_rax to answer
  if h_rax is 0
