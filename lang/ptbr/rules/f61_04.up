  end
  place p99bd
  place p99c7
  place t99c7_14 on 14
  set h_r13 to unwind
  call starttest 15
  set h_rax to answer
  call lpta_loadp addr c108
  call setscan_r 4
  set h_rax to answer
  if h_rax is 0
