  go to p9a79
  place p9999
  place t9999_12 on 12
  set h_r13 to unwind
  place p999c
  call starttest 14
  set h_rax to answer
  call lpta_loadp addr c108
  call setscan_r 4
  set h_rax to answer
  if h_rax is 0
