  set h_rax to cell cf0 field
  set nc315_0 to h_rax
  shift left 16 into nc315_0
  shift right 16 into nc315_0
  if nc315_0 is more than 3000
    go to pc38c
  end
  place pc31b
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12000 over 10000
  go to pc412
  place pc32d
  place tc32d_18 on 18
  place tc32d_23 on 23
  set h_rax to cell cf0 field
  go to pc405
  place pc339
  place tc339_2 on 2
  set h_rax to cell cf0 field
  go to pc1d2
  place pc345
  place tc345_4 on 4
  set h_rax to cell cf0 field
  go to pc1dc
  place pc351
  place tc351_5 on 5
  set h_rax to cell cf0 field
  place pc358
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12500 over 10000
  go to pc412
  place pc36a
  place tc36a_8 on 8
  set h_rax to cell cf0 field
  go to pc3db
  place pc373
  place tc373_10 on 10
  set h_rax to cell cf0 field
  go to pc3e1
  place pc37c
  place tc37c_11 on 11
  set h_rax to cell cf0 field
  go to pc3e7
  place pc385
  place tc385_16 on 16
  set h_rax to cell cf0 field
  place pc38c
  set h_rcx to h_rax
  set nc38e_0 to h_rax
  shift left 16 into nc38e_0
  shift right 16 into nc38e_0
  if nc38e_0 is less than 3651
