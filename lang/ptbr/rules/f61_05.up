  place pc39f
  place tc39f_21 on 21
  set h_rax to cell cf0 field
  place pc3a6
  set h_rcx to h_rax
  set nc3a8_0 to h_rax
  shift left 16 into nc3a8_0
  shift right 16 into nc3a8_0
