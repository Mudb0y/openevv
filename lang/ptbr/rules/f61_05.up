rule eightkHz_filter takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_rdx
  local h_xmm0
  local nc593_0
  local nc5c6_0
  local nc62e_0
  local nc6a9_0
  local nc6c6_0
  local nc6d8_0
  local scratch
  local fc6e1
  variable g1270 word 3276
  place pc4a8
  place pc4e3
  place pc543
  set h_rdx to arg 1
  set h_rcx to -4
  call get_parm addr cf4 h_rdx h_rcx
  set h_rax to answer
  set h_rdx to arg 2
  set h_rcx to -4
  call get_parm addr cf0 h_rdx h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  set h_rcx to cell cf0 field
  if global half 1050 is not h_rax
    go to pc5b7
  end
  place pc593
  set nc593_0 to h_rcx
  shift left 16 into nc593_0
  shift right 16 into nc593_0
  if nc593_0 is at most 3600
    go to pc5b7
  end
  place pc59a
  set cell cf0 field to 3600
  set h_rcx to 3600
  set h_rdx to 3600
  if global half 1054 is not h_rax
    go to pc5d6
  end
  place pc5b2
  go to pc6ef
  place pc5b7
  if global half 1054 is not h_rax
    go to pc5d6
  end
  place pc5c0
  set h_rax to 3900
  set h_rdx to h_rcx
  set nc5c6_0 to h_rcx
  shift left 16 into nc5c6_0
  shift right 16 into nc5c6_0
  if nc5c6_0 is at least 3901
    go to pc6e6
  end
  place pc5d1
  go to pc6ef
  place pc5d6
  set h_rdx to h_rcx
  if global half 1074 is not h_rax
    go to pc63e
  end
  place pc5e1
  set h_rax to h_rdx
  set scratch to h_rax
  multiply 15 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  set global half 3278 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pc6b4
  end
  place pc621
  set h_rcx to cell cf0 field
  set h_rax to 3000
  set h_rdx to h_rcx
  set nc62e_0 to h_rcx
  shift left 16 into nc62e_0
  shift right 16 into nc62e_0
  if nc62e_0 is at least 3001
    go to pc6e6
  end
  place pc639
  go to pc6ef
  place pc63e
  if global half 1070 is not h_rax
    go to pc6ef
  end
  place pc64b
  set h_rax to global half 2830
  if h_rax is not global half 2822
    go to pc6ef
  end
  place pc65f
  set global half 3278 to 5
  set h_rdx to 30
  call if_testgt_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pc6ba
  end
  place pc681
  set global half 3278 to 5
  set h_rdx to 40
  call if_testge_v_i addr g1270 h_rdx
  set h_rax to answer
  set h_rcx to cell cf0 field
  if h_rax is 0
    go to pc6d1
  end
  place pc6a3
  set h_rax to h_rcx
  add h_rax to h_rax
  set h_rcx to h_rax
  set nc6a9_0 to h_rax
  and 65535 into nc6a9_0
  set h_rcx to 500
  set fc6e1 to 0
  if nc6a9_0 is less than 500
    set fc6e1 to 1
  end
  go to pc6e1
  place pc6b4
  set h_rax to 1000
  go to pc6e6
  place pc6ba
  set h_rax to cell cf0 field
  shift left 3 into h_rax
  set h_rcx to h_rax
  set nc6c6_0 to h_rax
  and 65535 into nc6c6_0
  set h_rcx to 3000
  set fc6e1 to 0
  if nc6c6_0 is less than 3000
    set fc6e1 to 1
  end
  go to pc6e1
  place pc6d1
  set h_rax to h_rcx
  shift left 2 into h_rax
  set h_rcx to h_rax
  set nc6d8_0 to h_rax
  shift left 16 into nc6d8_0
  shift right 16 into nc6d8_0
  set h_rcx to 1000
  set fc6e1 to 0
  if nc6d8_0 is less than 1000
    set fc6e1 to 1
  end
  place pc6e1
  if fc6e1 is not 0
    set h_rcx to h_rax
  end
  set h_rax to h_rcx
  place pc6e6
  set cell cf0 field to h_rax
  set h_rdx to h_rax
  place pc6ef
  put h_rdx into arg 2 at 2 half
  match
end

rule set_word_default_acoustic_vals takes 1
  instead
  local h_rax
  local h_rcx
  local h_rdx
  local h_xmm0
  local h_xmm1
  local sc96a
  local scratch
  variable g1270 word 3276
  place pc708
  place pc739
  place pc795
  call fence 0 sym eti_null
  set global half 3278 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pc868
  end
  place pc7c3
  set global half 3278 to 4
  set h_rdx to 0
  call if_testeq_v_i addr g1270 h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pc954
  end
  place pc7e1
  set h_rax to global signed half 3292
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  scale h_xmm0 by 430000 over 10000
  add 560000 to h_xmm0
  set h_rcx to h_xmm0
  add 1 to h_rcx
  if h_rcx is less than 1
    subtract 2 from h_rcx
  end
  truncate h_rcx by 1 over 10000
  set global half 2950 to h_rcx
  if global half 3258 is not 0
    go to pc833
  end
  place pc819
  set scratch to h_rax
  multiply 35 into scratch
  set h_rcx to scratch
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rcx to h_xmm0
  add 1 to h_rcx
  if h_rcx is less than 1
    subtract 2 from h_rcx
  end
  truncate h_rcx by 1 over 10000
  set global half 3154 to h_rcx
  place pc833
  if global half 3262 is not 0
    go to pc954
  end
  place pc841
  set scratch to h_rax
  multiply 20 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  add 340000 to h_xmm0
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3150 to h_rax
  go to pc954
  place pc868
  set h_rax to 100
  set h_rcx to global half 2734
  set h_rdx to 85
  if h_rcx is not 4
    set h_rdx to 100
  end
  set h_rax to 70
  if h_rcx is not 3
    set h_rax to h_rdx
  end
  set global half 2950 to h_rax
  if global half 3258 is not 0
    go to pc8b8
  end
  place pc897
  set h_rax to global signed half 3292
  set scratch to h_rax
  multiply 36 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3154 to h_rax
  place pc8b8
  if global half 3262 is not 0
