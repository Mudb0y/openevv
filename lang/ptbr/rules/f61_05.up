  end
  place pc3ae
  set cell cf0 field to 4600
  go to pc41d
  place pc3b9
  set h_rax to cell cf0 field
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11900 over 10000
  go to pc412
  place pc3ce
  set h_rax to cell cf0 field
  set nc3d5_0 to h_rax
  shift left 16 into nc3d5_0
  shift right 16 into nc3d5_0
  if nc3d5_0 is at most 1100
    go to pc3f6
  end
  place pc3db
  set nc3db_0 to h_rax
  shift left 16 into nc3db_0
  shift right 16 into nc3db_0
  if nc3db_0 is at most 1300
    go to pc405
  end
  place pc3e1
  set nc3e1_0 to h_rax
  shift left 16 into nc3e1_0
  shift right 16 into nc3e1_0
  if nc3e1_0 is at most 1700
    go to pc438
  end
  place pc3e7
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12100 over 10000
  go to pc412
  place pc3f6
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10700 over 10000
  go to pc412
  place pc405
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11500 over 10000
  place pc412
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
