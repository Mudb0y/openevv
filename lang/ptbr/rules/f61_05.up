# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule run_filters takes 3
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local h_rax
  local nbd74_0
  local nbdae_0
  local nbdb3_0
  local nbe0d_0
  variable g1270 word 3276
  place pbc5b
  place pbc94
  place pbcee
  call get_parm addr ce0 arg 1 -4
  set h_rax to answer
  call get_parm addr ce4 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set global half 3278 to 5
  call if_testneq_v_i addr g1270 50
  set h_rax to answer
  if h_rax is not 0
    go to pbd97
  end
  place pbd46
  if cell ce0 field is at least 6
    go to pbd57
  end
  place pbd50
  go to pbd81
  place pbd57
  place tbd57_2 on 2
  call starttest 1
  set h_rax to answer
  call bspush_ca 4
  set h_rax to answer
  set h_rax to global half 1074
  place pbd74
  set nbd74_0 to h_rax
  and 65535 into nbd74_0
  if nbd74_0 is not cell ce0 field
    set unwind to 0
    backtrack
  end
  place pbd81
  place tbd81_5 on 5
  call size_filter addr ce0 addr ce4
  set h_rax to answer
  place pbd97
  place tbd97_1 on 1
  place tbd97_3 on 3
  place tbd97_6 on 6
  set h_rax to global half 2830
  if h_rax is not global half 2822
    go to pbdcf
  end
  place pbda7
  set h_rax to cell ce0 field
  set nbdae_0 to h_rax
  shift left 16 into nbdae_0
  shift right 16 into nbdae_0
  if nbdae_0 is at most 0
    go to pbdcf
  end
  place pbdb3
  set nbdb3_0 to h_rax
  shift left 16 into nbdb3_0
  shift right 16 into nbdb3_0
  if nbdb3_0 is more than 5
    go to pbdcf
  end
  place pbdb9
  call filter_by_range addr ce0 addr ce4
  set h_rax to answer
  place pbdcf
  place tbdcf_7 on 7
  set global half 3278 to 3
  call if_testeq_v_i addr g1270 8000
  set h_rax to answer
  if h_rax is not 0
    go to pbe9e
  end
  place pbdf0
  call starttest_l 8
  set h_rax to answer
  call bspush_ca 9
  set h_rax to answer
  set h_rax to global half 1050
  place pbe0d
  set nbe0d_0 to h_rax
  and 65535 into nbe0d_0
  if nbe0d_0 is cell ce0 field
    go to pbe88
  end
  set unwind to 0
  backtrack
  place pbe4b
  place tbe4b_4 on 4
  set h_rax to global half 1078
  go to pbd74
  place pbe57
  place tbe57_9 on 9
  call bspush_ca 11
  set h_rax to answer
  set h_rax to global half 1054
  go to pbe0d
  place pbe6b
  place tbe6b_11 on 11
  call bspush_ca 12
  set h_rax to answer
  set h_rax to global half 1070
  go to pbe0d
  place pbe7f
  place tbe7f_12 on 12
  set h_rax to global half 1074
  go to pbe0d
  place pbe88
  place tbe88_10 on 10
  call eightkHz_filter addr ce0 addr ce4
  set h_rax to answer
  place pbe9e
  place tbe9e_8 on 8
  set h_rax to cell ce4 field
  put h_rax into arg 2 at 2 half
  match
end

rule size_filter takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local nbfc6_0
  local nc0ae_0
  variable g1270 word 3276
  place pbeec
  place pbf27
  place pbf87
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  set nbfc6_0 to h_rax
  shift left 16 into nbfc6_0
  shift right 16 into nbfc6_0
  if nbfc6_0 is at most 5
    go to pc019
  end
  place pbfcc
  if global half 1078 is not h_rax
    go to pc043
  end
  place pbfd5
  set global half 3278 to 5
  call if_testge_v_i addr g1270 40
  set h_rax to answer
  if h_rax is not 0
    go to pc0be
  end
  place pbff8
  set h_rax to global half 2826
  if h_rax is not global half 2822
    go to pc0be
  end
  place pc00c
  shift left 3 into cell cf0 field
  go to pc0be
  place pc019
  set h_rax to cell cf0 field
  set h_rcx to global signed half 3254
  multiply h_rax into h_rcx
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  go to pc0be
  place pc043
  if global half 1074 is not h_rax
    go to pc0be
  end
  place pc04c
  set global half 3278 to 4
  call if_testneq_v_i addr g1270 0
  set h_rax to answer
  if h_rax is not 0
    go to pc0be
  end
  place pc06d
  set global half 3278 to 5
  call if_testge_v_i addr g1270 40
  set h_rax to answer
  set h_rcx to cell cf0 field
  if h_rax is not 0
    go to pc0ae
  end
  place pc08f
  set h_rax to h_rcx
  shift left 4 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set h_rcx to h_rax
  set cell cf0 field to h_rax
  place pc0ae
  set nc0ae_0 to h_rcx
  shift left 16 into nc0ae_0
  shift right 16 into nc0ae_0
  if nc0ae_0 is less than 3001
    go to pc0be
  end
  place pc0b5
  set cell cf0 field to 3000
  place pc0be
  set h_rax to cell cf0 field
  put h_rax into arg 2 at 2 half
  match
end

rule filter_by_range takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
