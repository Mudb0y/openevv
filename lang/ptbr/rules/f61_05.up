    backtrack
  end
  place pc2c4
  go to pc30e
  place pc2c6
  place tc2c6_19 on 19
  if global signed half 3206 is at most 0
    set unwind to 0
    backtrack
  end
  place pc2d0
  go to pc2fc
  place pc2d2
  place tc2d2_7 on 7
  set h_rax to cell cf4 field
  go to pc215
  place pc2de
  place tc2de_1 on 1
  set h_rax to cell cf4 field
  go to pc206
  place pc2ea
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11000 over 10000
  go to pc412
  place pc2fc
  place tc2fc_20 on 20
  set h_rax to cell cf0 field
  set nc303_0 to h_rax
  shift left 16 into nc303_0
  shift right 16 into nc303_0
  if nc303_0 is at most 2700
