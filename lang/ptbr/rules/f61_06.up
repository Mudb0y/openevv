  end
  place pf7d0
  place tf7d0_10 on 10
  call starttest 11
  set h_rax to answer
  call move_i addr cf0 0
  set h_rax to answer
  call addStreamArraySsVal addr g7d8 addr cf0 addr c100 addr g860
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pf813
  place tf813_11 on 11
  call starttest 12
  set h_rax to answer
  call move_i addr cf0 0
  set h_rax to answer
  call addStreamArraySsVal addr g7c4 addr cf0 addr c100 addr g860
  set h_rax to answer
  if h_rax is 0
    go to pf887
  end
  set unwind to 0
  backtrack
  place pf887
  place tf887_12 on 12
  set h_xmm0 to cell c100 value
  set h_rax to arg 1
  put h_xmm0 into arg 1 at 4
  match
end

rule modulate_nas_AV takes 1
