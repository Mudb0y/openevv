rule doAF takes 6
  instead
  local cf0 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local v110 word
  local v118 word
  variable g638 word 892
