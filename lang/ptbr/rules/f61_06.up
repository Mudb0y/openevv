    go to pf094
  end
  place pf04f
  call testeq
  if answer is not 0
    go to pf094
  end
  place pf05b
  call lpta_loadpn addr c128
  call rpta_loadpn addr g638
  call compare_ptas
  if answer is not 0
    go to pf094
  end
  place pf088
  call testeq
  if answer is 0
    go to pf0e8
  end
  place pf094
  call addStreamArraySsVal addr g7dc addr cf0 addr c148 addr c138
  match
  place pf0e8
  call addStreamArrayPtVal addr g7dc addr cf0 addr g860 addr g7fc addr g638
  match
end

rule extend_vals takes 1
  instead
  place pf116
  place pf149
  place pf178
