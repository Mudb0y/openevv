# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule insert_acoustic_vals takes 1
  instead
  local vf8 word
  local v100 word
  local v108 word
  local v110 word
  local v118 word
  local v120 word
  local v128 word
  local v130 word
  local v138 word
  local v140 word
  local v148 word
  local v150 word
  local v158 word
  local v160 word
  local v168 word
  local v170 word
  local v178 word
  local v180 word
  local v188 word
  local v190 word
  local v198 word
  local v1a0 word
  local v1a8 word
  local v1b0 word
  local v1b8 word
  local v1c0 word
  local h_r12
  variable g1114 word 2964
  variable g1118 word 2968
  variable g111c word 2972
  variable g1120 word 2976
  variable g1124 word 2980
  variable g11e0 word 3168
  variable g11e4 word 3172
  variable g11e8 word 3176
  variable g11ec word 3180
  variable g11f0 word 3184
  variable g11f4 word 3188
  variable g11f8 word 3192
  variable g11fc word 3196
  variable g1200 word 3200
  variable g1204 word 3204
  variable g628 word 884
  variable g638 word 892
  variable g78c word 1040
  variable g790 word 1044
  variable g794 word 1048
  variable g798 word 1052
  variable g79c word 1056
  variable g7a0 word 1060
  variable g7a4 word 1064
  variable g7a8 word 1068
  variable g7ac word 1072
  variable g7b0 word 1076
  variable g850 word 1220
  variable g860 word 1228
  place pdecb
  place pdf08
  place pdf3b
  call fence 0 sym eti_null
  call doF addr g78c addr g11e0 addr g11e4
  set v1a8 to addr g794
  set v1a0 to addr g11f0
  set v198 to addr g11f4
  set v190 to addr g798
  set v188 to addr g11f8
  set v180 to addr g11fc
  set v178 to addr g79c
  set v170 to addr g1200
  set v168 to addr g1204
  set v160 to addr g7a0
  set v158 to addr g1114
  set vf8 to addr g850
  set v140 to addr g7a4
  set v138 to addr g1118
  set v130 to addr g7a8
  set v128 to addr g111c
  set v120 to addr g7ac
  set v118 to addr g1120
  set v110 to addr g7b0
  set v108 to addr g1124
  set h_r12 to 0
  set v1c0 to addr g790
  set v1b8 to addr g11e8
  set v1b0 to addr g11ec
  set v150 to addr g860
  set v148 to addr g628
  set v100 to addr g638
  place pe0dd
  call doF addr g790 addr g11e8 addr g11ec
  place pe0e5
  place te0e5_2 on 2
  set h_r12 to unwind
  call doF addr g794 addr g11f0 addr g11f4
  place pe102
  place te102_3 on 3
  set h_r12 to unwind
  call doF addr g798 addr g11f8 addr g11fc
  place pe11f
  place te11f_4 on 4
  set h_r12 to unwind
  call doF addr g79c addr g1200 addr g1204
  place pe13c
  place te13c_5 on 5
  set h_r12 to unwind
  call add_filtered_val addr g7a0 addr g1114 addr g850 addr g860 addr g628 addr g638
  place pe168
  call add_filtered_val addr g7a4 addr g1118 addr g850 addr g860 addr g628 addr g638
  place pe194
  call add_filtered_val addr g7a8 addr g111c addr g850 addr g860 addr g628 addr g638
  place pe1c0
  call add_filtered_val addr g7ac addr g1120 addr g850 addr g860 addr g628 addr g638
  place pe1ec
  place te1ec_9 on 9
  set h_r12 to unwind
  call add_filtered_val addr g7b0 addr g1124 addr g850 addr g860 addr g628 addr g638
  place pe21c
  place te21c_10 on 10
  set h_r12 to unwind
  call do_FTZ_FTP
  place pe224
  place te224_11 on 11
  set h_r12 to unwind
  call starttest 12
  call lpta_loadp addr g628
  call setscan_r 4
  if answer is not 0
    go to pe2f2
  end
  place pe245
  call bspush_ca_scan_boa 13
  call testFldeq 4 3 0
  if answer is 0
    set h_r12 to 1
  end
  set unwind to h_r12
  backtrack
  place pe29e
  place te29e_13 on 13
  set h_r12 to unwind
  call bspop_boa
  call advance_tok
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  place pe2b2
  go to pe302
  place pe2b4
  place te2b4_8 on 8
  set h_r12 to unwind
  go to pe1c0
  place pe2c0
  place te2c0_7 on 7
  set h_r12 to unwind
  go to pe194
  place pe2cc
  place te2cc_6 on 6
  set h_r12 to unwind
  go to pe168
  place pe2d8
  place te2d8_1 on 1
  set h_r12 to unwind
  go to pe0dd
  place pe2f2
  place te2f2_12 on 12
  set h_r12 to unwind
  call do_son_amps
  go to pe30a
  place pe302
  call do_non_son_amps
  place pe30a
  place te30a_14 on 14
  place te30a_15 on 15
  set h_r12 to unwind
  call do_release
  match
  place tm_16 on 16
  match
end

rule add_filtered_val takes 7
  instead
  local cf0 bytes 8
  local c11c bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local v110 word
  local v118 word
  place pe388
  set v118 to arg 5
  place pe3db
  set vf8 to arg 1
  set v100 to arg 2
  set v108 to arg 3
  set v110 to arg 4
  place pe42d
  call get_parm addr c11c arg 1 -4
  call get_parm addr cf0 arg 2 -4
  call get_parm addr c130 arg 3 -5
  call get_parm addr c160 arg 4 -5
  call get_parm addr c150 arg 5 -6
  call get_parm addr c140 arg 6 -6
  call fence 0 sym eti_null
  call run_filters addr c11c addr cf0
  call addStreamArraySsVal addr c11c addr cf0 addr c130 addr c160
  match
end

rule doAV takes 6
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local vf8 word
  variable g1270 word 3276
  variable g7d4 word 1112
  variable g800 word 1156
  place pe53d
  set vf8 to arg 5
  place pe585
  place pe5e5
  call get_parm addr cf0 arg 1 -4
  call get_parm addr c108 arg 2 -5
  call get_parm addr c128 arg 3 -5
  call get_parm addr c118 arg 4 -6
  call get_parm addr c138 arg 5 -6
  call fence 0 sym eti_null
  set global half 3278 to 6
  call if_testeq_v_i addr g1270 100
  if answer is not 0
    go to pe68b
  end
  place pe681
  if global half 2212 is 0
    match
  end
  place pe68b
  if global word 1272 is not 0
    go to pe6a6
  end
  place pe6a4
  go to pe6cc
  place pe6a6
  call addStreamArrayPtVal addr g7d4 addr cf0 addr c108 addr g800 addr c118
  match
  place pe6cc
  call addStreamArraySsVal addr g7d4 addr cf0 addr c108 addr c128
  match
end

rule addStreamArraySsVal takes 5
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local h_r15
  local h_rax
  local h_rcx
  local h_rsi
  local ke87c_0
  place pe6fd
  set h_r15 to arg 3
  place pe73e
  place pe79e
  set h_rsi to addr cf4
  set h_rcx to -4
  call get_parm h_rsi arg 1 h_rcx
  set h_rax to answer
  set h_rsi to addr cf0
  set h_rcx to -4
  call get_parm h_rsi arg 2 h_rcx
  set h_rax to answer
  set h_rsi to addr c108
  set h_rcx to -5
  call get_parm h_rsi arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr c118
  set h_rsi to addr c118
  set h_rcx to -5
  call get_parm h_rsi arg 4 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to 0
  if cell c118 value is not cell c108 value
    go to pe8ca
  end
  place pe824
  set h_rcx to 0
  if cell c108 value is not 0
    go to pe909
  end
  place pe83a
  set h_rsi to 3
  call starttest_e h_rsi
  set h_rax to answer
  set h_rsi to 4
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr cf4
  set h_rcx to addr c108
  call addStreamArrayPtValC h_rsi addr cf0 h_rcx
  set h_rax to answer
  set h_rcx to 0
  set ke87c_0 to h_rax
  set h_rax to 0
  if ke87c_0 is 0
    set h_rax to 1
  end
  set h_rcx to h_rax
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  go to pe8ca
  place te8ca_1 on 1
  set h_rax to unwind
  set h_rcx to unwind
  place pe8ca
  set h_r15 to h_rax
  set h_rsi to 7
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 8
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr cf4
  set h_rcx to addr c108
  call addStreamArraySsValC h_rsi addr cf0 h_rcx addr c118
  set h_rax to answer
  go to pe946
  go to pe909
  place te909_2 on 2
  set h_rax to unwind
  set h_rcx to unwind
  place pe909
  set h_r15 to h_rcx
  set h_rsi to 5
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 6
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr cf4
  set h_rcx to addr c108
  call addStreamArrayPtValC h_rsi addr cf0 h_rcx
  set h_rax to answer
  place pe946
  if h_rax is 0
    set h_r15 to 1
  end
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  go to pe954
  place te954_4 on 4
  place te954_6 on 6
  place te954_8 on 8
  set h_rax to unwind
  set h_rcx to unwind
  place pe954
  call bspop_boa
  set h_rax to answer
  match
  place tm_3 on 3
  place tm_5 on 5
  place tm_7 on 7
  match
end

rule addStreamArrayPtVal takes 6
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local cf8 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local v100 word
  local h_r13
  local h_rsi
  local seb1f
  place pe98c
  set v100 to arg 5
  set h_r13 to arg 2
  place pe9d4
  place pea34
  set h_rsi to addr cf8
  call get_parm h_rsi arg 1 -4
  set h_rsi to addr cf4
  set h_r13 to -4
  call get_parm h_rsi arg 2 -4
  set h_rsi to addr c110
  call get_parm h_rsi arg 3 -5
  set h_rsi to addr cf0
  call get_parm h_rsi arg 4 -4
  set h_rsi to addr c120
  call get_parm h_rsi arg 5 -6
  call fence 0 sym eti_null
  if cell c110 value is not 0
    go to peae4
  end
  place peac4
  if global half 1154 is not cell cf0 field
    go to peae4
  end
  place pead6
  set cell cf0 field to global half 1150
  place peae4
  set h_r13 to 0
  place peaf2
  place teaf2_1 on 1
  set h_r13 to unwind
  set h_rsi to 2
  call starttest h_rsi
  set h_rsi to 3
  call bspush_ca_boa h_rsi
  set h_rsi to addr cf8
  call addStreamArrayPtValC h_rsi addr cf4 addr c110
  set seb1f to answer
  set h_rsi to 1
  if seb1f is 0
    set unwind to h_rsi
    backtrack
  end
  place peb2b
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place peb5f
  place teb5f_3 on 3
  set h_r13 to unwind
  call bspop_boa
  match
  place tm_2 on 2
  match
end

