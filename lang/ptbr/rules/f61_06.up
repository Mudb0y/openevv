rule modulate_noise takes 1
  instead
  local ce0 bytes 8
  local cf0 bytes 8
  local c100 bytes 8
  local h_rax
  local h_xmm0
  variable g1140 word 3008
  variable g1144 word 3012
  variable g1148 word 3016
  variable g114c word 3020
  variable g1150 word 3024
  variable g1154 word 3028
  variable g628 word 884
  variable g638 word 892
  variable g7e0 word 1124
  variable g7e4 word 1128
  variable g7e8 word 1132
  variable g7ec word 1136
  variable g7f0 word 1140
  variable g7f4 word 1144
  variable g850 word 1220
  variable g860 word 1228
  place pf1af
  place pf1e0
  place pf23c
  set cell cf0 kind to 65531
  set ce0 to 65532
  call push_ptr_init addr c100
  set h_rax to answer
  call fence 0 sym eti_null
  set h_xmm0 to global word 2252
  scale h_xmm0 by 5000 over 10000
  add global word 1224 to h_xmm0
  set cell cf0 value to h_xmm0
  call starttest 1
  set h_rax to answer
  call c_assvar addr ce0
  set h_rax to answer
  set h_rax to global half 2994
  add -5 to h_rax
  set cell ce0 field to h_rax
  call doAF addr ce0 addr g850 addr g850 addr g628 addr g628
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pf2d9
  go to pf2e0
  place pf2e0
  place tf2e0_1 on 1
  call starttest 2
  set h_rax to answer
  call c_assvar addr ce0
  set h_rax to answer
  set h_rax to global half 2994
  add 5 to h_rax
  set cell ce0 field to h_rax
  call doAF addr ce0 addr cf0 addr cf0 addr c100 addr c100
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pf32f
  place tf32f_2 on 2
  call starttest 3
  set h_rax to answer
  call c_assvar addr ce0
  set h_rax to answer
  set h_rax to global half 2994
  add -5 to h_rax
  set cell ce0 field to h_rax
  call doAF addr ce0 addr g860 addr g860 addr g638 addr g638
  set h_rax to answer
  if h_rax is 0
    go to pf3b3
  end
  set unwind to 0
  backtrack
  place pf3b3
  place tf3b3_3 on 3
  call addStreamArraySsVal addr g7f4 addr g1154 addr g850 addr g860
  set h_rax to answer
  place pf3d3
  place tf3d3_4 on 4
  call addStreamArraySsVal addr g7e0 addr g1140 addr g850 addr g860
  set h_rax to answer
  place pf3f3
  place tf3f3_5 on 5
  call addStreamArraySsVal addr g7e4 addr g1144 addr g850 addr g860
  set h_rax to answer
  place pf413
  place tf413_6 on 6
  call addStreamArraySsVal addr g7e8 addr g1148 addr g850 addr g860
  set h_rax to answer
  place pf433
  place tf433_7 on 7
  call addStreamArraySsVal addr g7ec addr g114c addr g850 addr g860
  set h_rax to answer
  place pf453
  place tf453_8 on 8
  call addStreamArraySsVal addr g7f0 addr g1150 addr g850 addr g860
  set h_rax to answer
  place pf473
  place tf473_9 on 9
  set global half 3114 to 1
  match
end

