  place p10b39
  if global half 554 is not h_rcx
    go to p10b47
  end
  place p10b3e
  set h_rcx to global half 558
  go to p10b5b
  place p10b47
  if global half 550 is not global half 390
    match
  end
  place p10b50
  set h_rcx to global half 550
  if global half 550 is not global half 530
    match
  end
  place p10b5b
  set global half 526 to h_rcx
  match
end

rule is_target_syll takes 1
  instead
  place p10b76
  place p10ba5
  place p10bd4
  call fence 0 sym eti_null
  if global half 522 is not 1
    give up
  end
  match
end

