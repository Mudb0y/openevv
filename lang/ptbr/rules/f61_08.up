# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule generate_intonation takes 1
  instead
  place p10308
  place p1033d
  place p1039d
  call fence 0 sym eti_null
  if global half 514 is not 1
    go to p103c0
  end
  place p103b8
  call add_f0_for_new_voice
  place p103c0
  place p103d2
  place t103d2_1 on 1
  if global half 518 is not 1
    go to p103e4
  end
  place p103dc
  call init_phrase_inton_vars
  place p103e4
  place t103e4_2 on 2
  if global half 514 is not 1
    go to p103f6
  end
  place p103ee
  call init_word_inton_vars
  place p103f6
  place t103f6_3 on 3
  call init_syll_inton_vars
  place p103fe
  place t103fe_4 on 4
  if global half 518 is not 1
    go to p10410
  end
  place p10408
  call phr_initial_F0
  place p10410
  place t10410_5 on 5
  call is_target_syll
  if answer is not 0
    go to p104be
  end
  place p10420
  if global half 550 is global half 526
    go to p104fd
  end
  place p10434
  place t10434_7 on 7
  call starttest 9
  call bspush_ca 10
  if global half 554 is global half 526
    go to p104b6
  end
  set unwind to 0
  backtrack
  place p1048a
  place t1048a_10 on 10
  if global half 1474 is not global half 2148
    set unwind to 0
    backtrack
  end
  place p1049a
  go to p104b6
  place p1049c
  place t1049c_9 on 9
  if global half 542 is not global half 526
    go to p104b6
  end
  place p104ac
  call prenucl_f0
  go to p104be
  place p104b6
  place t104b6_11 on 11
  place t104b6_13 on 13
  call postnucl_f0
  place p104be
  place t104be_6 on 6
  place t104be_8 on 8
  place t104be_12 on 12
  place t104be_14 on 14
  call first_postnucl_accent
  place p104c6
  place t104c6_15 on 15
  call insert_target_t3
  place p104ce
  place t104ce_16 on 16
  call insert_phrase_final_tones
  place p104d6
  place t104d6_17 on 17
  if global half 1306 is not global half 502
    match
  end
  place p104e6
  call add_f0_for_next_voice
  match
  place p104fd
  call nucl_f0
  go to p104be
  place tm_18 on 18
  match
end

rule add_f0_for_new_voice takes 1
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c118 bytes 8
  local v100 word
  local v108 word
  variable g1270 word 3276
  variable g12b0 word 3328
  variable g300 word 420
  place p10554
  place p1058d
  place p105f0
  call push_ptr_init addr c118
  set cf4 to 65532
  set cf0 to 65532
  call fence 0 sym eti_null
  call lpta_loadp addr g300
  call setscan_l 2
  if answer is not 0
    match
  end
  place p1063e
  call advance_tok
  if answer is not 0
    match
  end
  place p1064e
  set v108 to addr g300
  call starttest_l 1
  call bspush_ca 2
  set global half 3278 to 9
  set v100 to addr g1270
  call npush_v addr g1270
  set global half 3330 to 9
  call npush_v addr g12b0
  call if_testneq
  if answer is not 0
    go to p1075e
  end
  place p106b8
  go to p106bf
  place p106bf
  place t106bf_3 on 3
  call init_voice_vars
  place p106c7
  place t106c7_4 on 4
  call lpta_loadp addr g300
  call setscan_l 4
  if answer is not 0
    match
  end
  place p106e1
  call test_string_s 4 1 sym eti_s_ef05e
  if answer is not 0
    match
  end
  place p106fe
  place t106fe_5 on 5
  call savescptr 5 addr c118
  call starttest_l 1
  call move_i addr cf4 95
  call move_i addr cf0 50
  call insert_f0 addr c118 addr cf4 addr cf0
  if answer is 0
    match
  end
  place p1075e
  set unwind to 0
  backtrack
  place p10798
  place t10798_2 on 2
  set global half 3278 to 10
  call npush_v addr g1270
  set global half 3330 to 10
  call npush_v addr g12b0
  call if_testneq
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p107ce
  go to p106bf
  place tm_1 on 1
  match
end

rule init_phrase_inton_vars takes 1
  instead
  local cf0 bytes 8
  variable g1500 word 3712
  variable g278 word 328
  variable g5a8 word 820
  variable g5b8 word 828
  place p107f0
  place p10823
  place p10881
  call push_ptr_init addr cf0
  call fence 0 sym eti_null
  set global half 706 to global half 1310
  set global half 390 to global half 542
  set global half 526 to global half 542
  and 0 into global half 3518
  or -1 into global half 3434
  set global half 3506 to 1
  set global half 3438 to 25
  set cell cf0 value to global word 832
  call estimate_nsylls addr g5a8 addr cf0 addr g1500
  call init_voice_vars
  call init_nuclwrd_vars
  if global half 1474 is not global half 2148
    match
  end
  place p10934
  call num_words_in_range addr g5a8 addr g5b8 addr g278
  match
end

rule init_word_inton_vars takes 1
  instead
  local h_rcx
  variable g280 word 332
  variable g6c8 word 964
  place p10962
  place p1098f
  place p109e7
  call fence 0 sym eti_null
  set h_rcx to global half 558
  if global half 550 is not global half 390
    go to p10a18
  end
  place p10a0f
  set global half 390 to h_rcx
  match
  place p10a18
  if h_rcx is global half 390
    match
  end
  place p10a1d
  call lpta_loadpn addr g280
  call rpta_loadpn addr g6c8
  call compare_ptas
  if answer is not 0
    match
  end
  place p10a47
  call testeq
  if answer is 0
    go to p10a62
  end
  match
  place p10a62
  set h_rcx to global half 550
  go to p10a0f
end

rule init_syll_inton_vars takes 1
