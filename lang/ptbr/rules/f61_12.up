rule is_afterslash_char takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p18cdc
  place p18d1f
  place p18d52
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p18da9
  call testFldeq 1 2 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p18dbd
  call advance_tok
  if answer is 0
    go to p18ded
  end
  set unwind to 0
  backtrack
  place p18ded
  call single_chars_to_punct addr c110 addr c100
  place p18e03
  place t18e03_2 on 2
  place t18e03_3 on 3
  put cell c100 value into arg 2 at 4
  match
end

rule SPR_anno takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable ga40 word 1556
  place p18e43
  place p18e89
  place p18ebc
  call get_parm addr c110 arg 1 -6
  call get_parm addr c130 arg 2 -6
  call get_parm addr c100 arg 3 -6
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  call lpta_loadp addr c130
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p18f2f
  call test_string_s 1 1 sym eti_s_ef08d
  if answer is not 0
    give up
  end
  place p18f47
  call savescptr 2 addr c120
  call handle_SPR addr c110 addr c120 addr c100 addr ga40
  if answer is 0
    go to p18f98
  end
  place p18f80
  call handle_invalid_anno addr c110 addr c100
  go to p18fa6
  place p18f98
  set global half 1546 to global half 1566
  place p18fa6
  put cell c100 value into arg 3 at 4
  match
end

