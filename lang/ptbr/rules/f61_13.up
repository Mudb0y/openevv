  place p1f94d
  place t1f94d_3 on 3
  set h_r15 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place p1f95a
  place t1f95a_11 on 11
  set h_r15 to unwind
  call bspop_boa
  set h_rax to answer
  place p1f962
  place t1f962_13 on 13
  set h_r15 to unwind
  set h_rax to cell c110 value
  call lpta_loadp addr c110
  set h_rsi to 2
  call remfence h_rsi
  set h_rax to answer
  set h_rsi to addr c140
  set h_rcx to addr gfc8
  call user_dict_error h_rsi addr c110 h_rcx
  set h_rax to answer
  give up
end
