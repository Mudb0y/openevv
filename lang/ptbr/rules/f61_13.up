  go to p1eaa8
  place p1eb6d
  place t1eb6d_1 on 1
  set h_r12 to unwind
  set h_rsi to 3
  go to p1ea9a
  place p1eb75
  place t1eb75_5 on 5
  set h_r12 to unwind
  set h_rsi to addr c118
  call isLegalWord h_rsi addr c108
  set h_rax to answer
  if h_rax is not 0
    go to p1ebcb
  end
  place p1eb8f
  set h_rsi to addr c118
  call insert_userdict_root h_rsi addr c108
  set h_rax to answer
  place p1eba5
  place t1eba5_6 on 6
  place t1eba5_9 on 9
  place t1eba5_11 on 11
  set h_r12 to unwind
  set global half 2630 to 1
  match
  place p1ebb6
  place t1ebb6_4 on 4
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place p1ebc3
  place t1ebc3_7 on 7
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  place p1ebcb
  place t1ebcb_10 on 10
  set h_r12 to unwind
  set h_rsi to addr c118
  set h_rcx to addr gfc4
  call user_dict_error h_rsi addr c108 h_rcx
