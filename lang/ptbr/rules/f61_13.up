  place p1ead6
  set h_rcx to h_r12
  set h_rsi to 1
  if h_rax is 0
    set unwind to h_rsi
    backtrack
  end
  place p1eae0
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place p1eb14
  place t1eb14_3 on 3
  set h_r12 to unwind
  set h_rsi to addr c118
  call is_spr h_rsi addr c130
  set h_rax to answer
