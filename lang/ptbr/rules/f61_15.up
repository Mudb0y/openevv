# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule count_input takes 2
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local h_rax
  variable g9a0 word 1432
  place p2109f
  place p210dd
  place p2110c
  call get_parm addr ce4 arg 1 -4
  set h_rax to answer
  set cell ce0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell ce0 field
  call count_normalized_inp
  set h_rax to answer
  call count_unnormalized_inp addr g9a0 addr ce0
  set h_rax to answer
  set h_rax to cell ce0 field
  add global half 1388 to h_rax
  set cell ce4 field to h_rax
  put h_rax into arg 1 at 2 half
  match
end

rule count_normalized_inp takes 1
  instead
  variable g96c word 1386
  variable g990 word 1424
  variable g9a0 word 1432
  place p211a8
  place p211db
  place p2120a
  call fence 0 sym eti_null
  call count_cumulative_chars addr g9a0 addr g990 addr g96c
  set global word 1436 to global word 1428
  match
end

rule count_unnormalized_inp takes 3
  instead
  local ce0 bytes 8
  local cf8 bytes 8
  local c108 bytes 8
  local h_rax
  local n213ef_2
  local n21466_2
  variable g568 word 788
  place p2126c
  place p212a5
  place p21303
  call get_parm addr c108 arg 1 -6
  set h_rax to answer
  call get_parm addr ce0 arg 2 -4
  set h_rax to answer
  and 0 into cell cf8 half 0
  set cf8 to -65536
  call fence 0 sym eti_null
  call lpta_loadp addr c108
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p21386
  end
  place p2135c
  set h_rax to global word 792
  call lpta_loadp addr g568
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    go to p21456
  end
  place p21386
  set h_rax to cell c108 value
  call lpta_loadp addr c108
  if global half 1388 is 0
    go to p213f8
  end
  place p213aa
  call lpta_tstctxtr 0
  set h_rax to answer
  if h_rax is not 0
    go to p213e1
  end
  place p213b8
  call setscan_l 0
  set h_rax to answer
  if h_rax is not 0
    go to p213e1
  end
  place p213c6
  call savetok addr cf8
  set h_rax to answer
  if h_rax is not 0
    go to p213e1
  end
  place p213d9
  call advance_tok
  set h_rax to answer
  place p213e1
  set h_rax to global half 1376
  subtract cell cf8 half 0 from h_rax
  add cell ce0 field to h_rax
  set n213ef_2 to h_rax
  and 65535 into n213ef_2
  go to p2143b
  place p213f8
  call lpta_tstmover 1
  set h_rax to answer
  if h_rax is not 0
    go to p21434
  end
  place p21407
  call setscan_l 0
  set h_rax to answer
  if h_rax is not 0
    go to p21434
  end
  place p21415
  call savetok addr cf8
  set h_rax to answer
  if h_rax is not 0
    go to p21434
  end
  place p21428
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p2145f
  end
  place p21434
  set h_rax to global half 1376
  place p2143b
  set cell ce0 field to h_rax
  place p21442
  put h_rax into arg 2 at 2 half
  match
  place p21456
  set h_rax to cell ce0 field
  go to p21442
  place p2145f
  set h_rax to global half 1376
  subtract cell cf8 half 0 from h_rax
  set n21466_2 to h_rax
  and 65535 into n21466_2
  go to p2143b
end

rule forced_synthesis takes 2
  instead
  local c100 bytes 8
  local h_r12
  local h_rsi
  local s2168c
  local s2169f
  variable g978 word 1398
  place p21474
  place p214ac
  place p2150c
  set h_rsi to addr c100
  call get_parm h_rsi arg 1 -6
  call fence 0 sym eti_null
  if global half 1396 is not 1
    go to p2154e
  end
  place p21533
  place t21533_2 on 2
  set h_r12 to unwind
  set h_rsi to addr c100
  call create_sentence h_rsi
  match
  place p2154e
  set h_r12 to 0
  place p21560
  place t21560_1 on 1
  set h_r12 to unwind
  if global signed half 1538 is at most global signed half 1470
    give up
  end
  place p21574
  place t21574_3 on 3
  set h_r12 to unwind
  if global half 1404 is not 1
    go to p2158c
  end
  place p2157e
  if global half 1360 is 1
    give up
  end
  place p2158c
  place t2158c_4 on 4
  set h_r12 to unwind
  set h_rsi to 5
  call starttest h_rsi
  set h_rsi to 6
  call bspush_ca_boa h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 0
  if answer is 0
    set h_r12 to 1
  end
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place p215ee
  place t215ee_5 on 5
  set h_r12 to unwind
  set h_rsi to 7
  call starttest h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is 0
    go to p21680
  end
  place p2160f
  place t2160f_7 on 7
  set h_r12 to unwind
  set h_rsi to 8
  call starttest h_rsi
  set h_rsi to 9
  call bspush_ca_boa h_rsi
  set h_rsi to 10
  call bspush_ca h_rsi
  set h_rsi to h_r12
  if global half 1626 is not global half 1602
    set unwind to h_rsi
    backtrack
  end
  place p21647
  go to p21678
  place p21649
  place t21649_10 on 10
  set h_r12 to unwind
  set h_rsi to 12
  call bspush_ca h_rsi
  set h_rsi to h_r12
  if global signed half 1546 is more than 0
    set unwind to h_rsi
    backtrack
  end
  place p21665
  go to p21678
  place p21667
  place t21667_12 on 12
  set h_r12 to unwind
  set h_rsi to h_r12
  if global signed half 1546 is less than 10
    set unwind to h_rsi
    backtrack
  end
  place p21678
  place t21678_11 on 11
  set h_r12 to unwind
  set h_rsi to 1
  set unwind to h_rsi
  backtrack
  place p21680
  set h_rsi to 1
  call testFldeq h_rsi 3 4
  set s2168c to answer
  set h_rsi to h_r12
  if s2168c is not 0
    set unwind to h_rsi
    backtrack
  end
  place p2169c
  call advance_tok
  set s2169f to answer
  set h_rsi to h_r12
  if s2169f is not 0
    set unwind to h_rsi
    backtrack
  end
  give up
  place p216b4
  place t216b4_6 on 6
  set h_r12 to unwind
  call bspop_boa
  give up
  place p216c1
  place t216c1_9 on 9
  set h_r12 to unwind
  call bspop_boa
  set h_rsi to addr g978
  call count_input h_rsi
  place p216d8
  place t216d8_8 on 8
  set h_r12 to unwind
  if global signed half 1408 is more than global signed half 1400
    give up
  end
  place p216ec
  go to p21533
  place tm_13 on 13
  match
end

rule single_chars_forced_syn takes 6
  instead
  local cf0 bytes 8
  local cfc bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local vf8 word
  local h_rcx
  local s2186e
  local n21881_1
  place p2172c
  set vf8 to arg 4
  place p21774
  place p217d4
  set h_rcx to -6
  call get_parm addr c130 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c120 arg 2 h_rcx
  set h_rcx to -6
  call get_parm addr c110 arg 3 h_rcx
  set h_rcx to -4
  call get_parm addr cfc arg 4 h_rcx
  set h_rcx to -4
  call get_parm addr cf0 arg 5 h_rcx
  call fence 0 sym eti_null
  set h_rcx to addr cfc
  call count_cumulative_chars addr c130 addr c120 h_rcx
  set s2186e to cell cfc field
  set h_rcx to addr cf0
  set h_rcx to cell cf0 field
  add s2186e to h_rcx
  set n21881_1 to h_rcx
  shift left 16 into n21881_1
  shift right 16 into n21881_1
  if global signed half 1408 is at most n21881_1
    go to p21893
  end
  place p2188a
  set h_rcx to cell c110 value
  go to p218aa
  place p21893
  set global half 1396 to 1
  set h_rcx to cell c120 value
  set cell c110 value to h_rcx
  place p218aa
  put h_rcx into arg 3 at 4
  set h_rcx to arg 4
  put s2186e into arg 4 at 2 half
  match
end

rule get_input takes 1
  instead
  local cf0 bytes 8
  local vf8 word
  local h_r12
  local h_r13
  local h_rax
  local h_rcx
  local s21978
  local n21a28_0
  variable g918 word 1328
  variable g9b0 word 1440
  variable gd10 word 2220
  place p218cd
  place p21902
  place p21962
  set cf0 to 65532
  call fence 0 sym eti_null
  set s21978 to global half 1376
  set h_r13 to s21978
  call count_input addr cf0
  set h_rax to answer
  call no_readin addr cf0
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2199e
  call startloop 3
  set h_rax to answer
  set h_rax to addr g918
  set vf8 to addr g918
  place p219c5
  set h_r12 to h_r13
  call get_tok
  set h_rax to answer
  set h_r13 to global half 1376
  set h_rax to h_r12
  set h_rcx to h_r13
  subtract h_rax from h_rcx
  set h_rax to h_rcx
  add h_rcx to cell cf0 field
  if global half 1360 is 1
    go to p21a46
  end
  place p219f3
  call lpta_loadpn addr g9b0
  set h_rax to answer
  call rpta_loadpn addr gd10
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p21a21
  end
  place p21a15
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p21a66
  end
  place p21a21
  set h_rax to global half 1412
  set n21a28_0 to h_rax
  shift left 16 into n21a28_0
  shift right 16 into n21a28_0
  if n21a28_0 is at most cell cf0 field
    go to p21a56
  end
  place p21a31
  call potential_sent_end addr g918
  set h_rax to answer
  if h_rax is not 0
    go to p219c5
  end
  match
  place p21a46
  set h_rax to global word 792
  set global word 1332 to h_rax
  match
  place p21a56
  set h_rax to global word 1332
  set global word 1444 to h_rax
  match
  place p21a66
  call get_tok
  set h_rax to answer
  match
end

rule no_readin takes 2
