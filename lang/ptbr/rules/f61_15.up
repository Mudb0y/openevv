  set h_rax to answer
  set h_rsi to 8
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr g158
  call lpta_loadp h_rsi
  call setscan_r 1
  set s21eb2 to answer
  set h_rax to s21eb2
  set h_rsi to h_r14
