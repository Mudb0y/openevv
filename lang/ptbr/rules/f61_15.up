  if answer is not 0
    give up
  end
  place p21bda
  call advance_tok
  if answer is not 0
    give up
  end
  place p21bea
  call advance_tok
  if answer is not 0
    give up
  end
  place p21bfa
  call advance_tok
  if answer is not 0
    give up
  end
  place p21c0a
  call advance_tok
  if answer is not 0
    give up
  end
  place p21c1a
  place t21c1a_2 on 2
  call starttest 6
  call lpta_loadp addr g8f8
  call setscan_l 1
  if answer is not 0
    go to p21c9d
  end
  place p21c3b
  place t21c3b_8 on 8
  call test_string_s 1 1 sym eti_s_ef0ae
  if answer is 0
    go to p21c60
  end
  set unwind to 0
  backtrack
  place p21c60
  call bspush_ca_scan 7
  go to p21c3b
  place p21c8b
  place t21c8b_7 on 7
  call savescptr 7 addr g918
  place p21c9d
  place t21c9d_6 on 6
  call lpta_loadp addr g990
  call setscan_r 1
  if answer is not 0
    go to p21ce3
  end
  place p21caf
  call lpta_loadp addr g918
  call test_ptr
  if answer is not 0
    go to p21ce3
  end
  place p21cd5
  set global word 1332 to global word 1324
  place p21ce3
  place t21ce3_9 on 9
  set global word 1444 to global word 1332
  match
end

