  set h_rax to answer
  set h_rsi to 10
  go to p21e12
  place p21f3a
  place t21f3a_1 on 1
  set h_r14 to unwind
  set h_rsi to 2
  go to p21e04
  place p21f42
  place t21f42_3 on 3
  place t21f42_10 on 10
  set h_r14 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place p21f4f
  place t21f4f_8 on 8
  set h_r14 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to addr g908
