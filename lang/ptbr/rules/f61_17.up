  end
  place p2c5a1
  and 0 into global half 1032
  call copyvar addr cf0 addr g770
  set h_rcx to cell cf0 field
  subtract cell cf4 field from h_rcx
  set cell cf8 field to h_rcx
  set cell cf4 field to cell cf0 field
  place p2c5dd
  set h_rcx to arg 2
  put cell cf8 field into arg 2 at 2 half
  put cell cf4 field into arg 3 at 2 half
  set h_rcx to arg 4
  put cell c100 field into arg 4 at 2 half
  put cell cfc field into arg 5 at 2 half
  match
end

