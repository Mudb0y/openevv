rule no_words_in_delta takes 1
  instead
  local c100 bytes 8
  variable g568 word 788
  variable g578 word 796
  place p2b2b7
  place p2b2f4
  place p2b327
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  if global half 1420 is not 1
    give up
  end
  place p2b34c
  place p2b361
  place t2b361_1 on 1
  call starttest 2
  call lpta_loadpn addr g578
  call lpta_mover 4
  call lpta_storep addr c100
  call text_index addr c100
  if answer is 0
    go to p2b3c6
  end
  set unwind to 0
  backtrack
  place p2b3c6
  place t2b3c6_2 on 2
  call lpta_loadp addr g568
  call setscan_l 4
  if answer is not 0
    go to p2b3fb
  end
  place p2b3dc
  call advance_tok
  if answer is not 0
    go to p2b3fb
  end
  place p2b3e8
  call handle_pause addr g578
  place p2b3f3
  place t2b3f3_4 on 4
  call resetStreamArrayC
  place p2b3fb
  place t2b3fb_3 on 3
  call clear_delta
  place p2b403
  place t2b403_5 on 5
  and 0 into global half 1384
  and 0 into global half 1376
  match
end

rule apply_rules takes 1
  instead
  local vf8 word
  local v100 word
  variable g280 word 332
  variable g290 word 340
  variable g578 word 796
  place p2b464
  place p2b499
  place p2b4f9
  call fence 0 sym eti_null
  call init_symbolic_vars
  set v100 to addr g578
  set vf8 to addr g290
  place p2b53b
  place t2b53b_1 on 1
  call startloop 2
  call lpta_loadpn addr g578
  call lpta_mover 2
  call lpta_storep addr g280
  place p2b56b
  place t2b56b_7 on 7
  call bspush_ca 4
  call lpta_loadp addr g280
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2b588
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2b594
  place t2b594_5 on 5
  call savescptr 5 addr g290
  place p2b5a6
  place t2b5a6_3 on 3
  call run_text_module
  place p2b5ae
  place t2b5ae_6 on 6
  call starttest 4
  if global half 1302 is global half 2282
    go to p2b5dc
  end
  place p2b5c9
  call starttest_e 4
  call run_speech_module
  place p2b5dc
  place t2b5dc_4 on 4
  call forall_adv_upto_r 2 3 7 2 addr g280
  if answer is 0
    go to p2b626
  end
  set unwind to 0
  backtrack
  place p2b626
  place t2b626_2 on 2
  call printouts
  place p2b62e
  place t2b62e_8 on 8
  if global half 2278 is not 1
    go to p2b640
  end
  place p2b638
  call pause
  place p2b640
  place t2b640_9 on 9
  if global half 2274 is not 1
    go to p2b652
  end
  place p2b64a
  call pause
  place p2b652
  place t2b652_10 on 10
  call init_delta
  match
  place tm_11 on 11
  match
end

rule text_index takes 2
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local cf8 bytes 8
  variable g95c word 1370
  variable g968 word 1382
  place p2b69c
  place p2b6da
  place p2b709
  call get_parm addr cf8 arg 1 -6
  set cell ce4 kind to 65532
  set cell ce0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell ce4 field
  and 0 into cell ce0 field
  call get_indices addr cf8 addr ce4 addr g968 addr g95c addr ce0
  call synthesizingWord addr ce4
  match
end

rule clear_delta takes 1
  instead
  variable g158 word 184
  variable g568 word 788
  place p2b7b1
  place p2b7ee
  place p2b81d
  call fence 0 sym eti_null
  call starttest 1
  call delete_2_more
  place p2b84d
  place t2b84d_1 on 1
  call lpta_rpta_loadp addr g158 addr g568
  call delete_2pt 1 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
end

rule run_text_module takes 1
  instead
  variable gf48 word 2652
  variable gf58 word 2660
  variable gf68 word 2668
  variable gf78 word 2676
  place p2b8c8
  place p2b8fb
  place p2b92a
