  call generate_acoustic_vals
  place p2bc02
  place t2bc02_5 on 5
  set h_r12 to unwind
  set h_rsi to 3
  call forto_adv_upto_r h_rsi 4 10 7 addr g300 addr c130
  set s2bc1b to answer
  set h_rsi to h_r12
  if s2bc1b is not 0
    set unwind to h_rsi
    backtrack
  end
  place p2bc2b
  place t2bc2b_3 on 3
  set h_r12 to unwind
  if global half 2286 is not global half 2282
    match
  end
  place p2bc3f
  set h_rsi to addr g290
  call lpta_loadp h_rsi
  call setscan_r 4
  if answer is not 0
    go to p2bc73
  end
  place p2bc55
  call advanc
  if answer is not 0
    go to p2bc73
  end
  place p2bc61
  place t2bc61_13 on 13
  set h_r12 to unwind
  set h_rsi to 13
  call savescptr h_rsi addr c120
  place p2bc73
  place t2bc73_12 on 12
  set h_r12 to unwind
  set h_rsi to 14
  call starttest h_rsi
  set h_rsi to addr c120
  call lpta_loadpn h_rsi
  set h_rsi to 0
