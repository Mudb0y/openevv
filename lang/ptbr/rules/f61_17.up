# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule DeltaProc_main takes 1
  instead
  place p2ac73
  place p2aca6
  place p2acd5
  call fence 0 sym eti_null
  match
end

rule DeltaProc_start takes 1
  instead
  variable gfc0 word 2716
  variable gfc4 word 2720
  variable gfc8 word 2724
  place p2ad0c
  place p2ad3f
  place p2ad6e
  call fence 0 sym eti_null
  call init_platform
  call set_global_constants
  call init_vars
  call init_user_dicts addr gfc0 addr gfc4 addr gfc8
  call initStreamArrays
  call resetStreamArrayC
  match
end

rule DeltaProc_process_remaining takes 1
  instead
  local ce0 bytes 8
  place p2adea
  place p2ae1b
  place p2ae77
  set ce0 to 65532
  call fence 0 sym eti_null
  call starttest 1
  call move_i addr ce0 0
  call process_input addr ce0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_1 on 1
  match
end

rule process_input takes 2
  instead
  local cf0 bytes 8
  local h_r13
  local h_rax
  local h_rsi
  variable g158 word 184
  variable g568 word 788
  variable g918 word 1328
  variable g990 word 1424
  variable g9b0 word 1440
  variable gd10 word 2220
  place p2aee5
  place p2af25
  place p2af58
  set h_rsi to addr cf0
  call get_parm h_rsi arg 1 -4
  set h_rax to answer
  call fence 0 sym eti_null
  and 0 into global half 1360
  set h_rsi to addr g158
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p2afc0
  end
  place p2af9a
  set h_rax to global word 792
  call lpta_loadp addr g568
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    go to p2afd8
  end
  place p2afc0
  place t2afc0_1 on 1
  set h_rax to unwind
  and 0 into global half 1338
  set h_rsi to 5
  call startloop h_rsi
  set h_rax to answer
  go to p2b07a
  place p2afd8
  call reset_sent_vars
  set h_rax to answer
  set h_rax to 0
  place p2afe2
  place t2afe2_2 on 2
  set h_rax to unwind
  set h_r13 to h_rax
  set h_rsi to 3
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 4
  call bspush_ca_boa h_rsi
  set h_rax to answer
  call get_tok
  set h_rax to answer
  set h_rsi to 1
  if h_rax is 0
    set unwind to h_rsi
    backtrack
  end
  place p2b00a
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place p2b049
  place t2b049_3 on 3
  set h_rax to unwind
  if cell cf0 field is not 3
    go to p2afc0
  end
  place p2b057
  if global half 1338 is not 1
    go to p2afc0
  end
  match
  place p2b06d
  place t2b06d_4 on 4
  set h_rax to unwind
  call bspop_boa
  set h_rax to answer
  match
  place p2b07a
  place t2b07a_6 on 6
  place t2b07a_14 on 14
  set h_rax to unwind
  call get_input
  set h_rax to answer
  place p2b082
  place t2b082_7 on 7
  set h_rax to unwind
  if cell cf0 field is not 3
    go to p2b0c6
  end
  place p2b08c
  set h_rsi to addr g9b0
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr gd10
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p2b0c6
  end
  place p2b0b6
  call testeq
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2b0c6
  place t2b0c6_8 on 8
  set h_rax to unwind
  set h_rsi to addr g990
  call normalize_text h_rsi addr g918
  set h_rax to answer
  place p2b0dc
  place t2b0dc_9 on 9
  set h_rax to unwind
  call no_words_in_delta
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2b0e8
  place t2b0e8_10 on 10
  set h_rax to unwind
  if global half 1364 is 0
    go to p2b13f
  end
  place p2b0f2
  place t2b0f2_11 on 11
  set h_rax to unwind
  call apply_rules
  set h_rax to answer
  place p2b0fa
  place t2b0fa_12 on 12
  set h_rax to unwind
  set h_rsi to addr g158
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p2b132
  end
  place p2b10c
  set h_rax to global word 792
  call lpta_loadp addr g568
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2b132
  place t2b132_13 on 13
  set h_rax to unwind
  call reset_sent_vars
  set h_rax to answer
  go to p2b07a
  place p2b13f
  set h_rax to global word 2224
  set global word 1444 to h_rax
  go to p2b07a
  place tm_5 on 5
  match
end

rule DeltaProc_process_sentences takes 1
