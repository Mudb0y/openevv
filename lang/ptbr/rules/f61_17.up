  place p2bbbc
  place t2bbbc_4 on 4
  set h_r12 to unwind
  call init_syll_vars
  place p2bbc4
  place t2bbc4_7 on 7
  set h_r12 to unwind
  call generate_durations
  place p2bbcc
  place t2bbcc_8 on 8
  set h_r12 to unwind
  call generate_intonation
  place p2bbd4
  place t2bbd4_9 on 9
  set h_r12 to unwind
