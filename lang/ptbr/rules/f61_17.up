rule get_indices takes 6
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local cf8 bytes 8
  local cfc bytes 8
  local c100 bytes 8
  local c130 bytes 8
  local v108 word
  local v110 word
  local v118 word
  local v120 word
  local h_rcx
  variable g770 word 1030
  place p2c42c
  set v118 to arg 5
  set h_rcx to 94
  place p2c47f
  set v120 to arg 1
  set v108 to arg 2
  set v110 to arg 4
  place p2c4d1
  set h_rcx to -6
  call get_parm addr c130 arg 1 h_rcx
  set h_rcx to -4
  call get_parm addr cf8 arg 2 h_rcx
  set h_rcx to -4
  call get_parm addr cf4 arg 3 h_rcx
  set h_rcx to -4
  call get_parm addr c100 arg 4 h_rcx
  set h_rcx to -4
  call get_parm addr cfc arg 5 h_rcx
  set cell cf0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  call lpta_loadp addr c130
  call setscan_l 0
  if answer is not 0
    go to p2c5dd
