    backtrack
  end
  place p2bcb8
  place t2bcb8_14 on 14
  set h_r12 to unwind
  set h_rsi to addr c120
  call handle_pause h_rsi
  match
  place p2bcd6
  place t2bcd6_2 on 2
  set h_r12 to unwind
  call bspop_boa
  give up
  place tm_11 on 11
  place tm_15 on 15
