# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule normalize_text takes 3
  instead
  local c100 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local v108 word
  local v110 word
  local h_rax
  local h_rsi
  local n2ce4a_0
  variable g568 word 788
  variable g978 word 1398
  variable g990 word 1424
  place p2c9e0
  place p2ca1b
  place p2ca7b
  set h_rsi to addr c140
  call get_parm h_rsi arg 1 -6
  set h_rax to answer
  set h_rsi to addr c120
  call get_parm h_rsi arg 2 -6
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c160
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rax to global word 2224
  set cell c130 value to h_rax
  set cell c100 value to h_rax
  if global half 1360 is not 1
    go to p2cb55
  end
  place p2cb15
  set h_rsi to addr c140
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p2cb55
  end
  place p2cb2b
  set h_rax to cell c120 value
  call lpta_loadp addr c120
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    go to p2cf56
  end
  place p2cb55
  set h_rax to addr g978
  set v110 to addr g978
  set h_rax to addr g568
  set v108 to addr g568
  place p2cb7f
  place t2cb7f_1 on 1
  and 0 into global half 1404
  set h_rsi to addr g978
  call count_input h_rsi
  set h_rax to answer
  place p2cb96
  place t2cb96_3 on 3
  set h_rsi to 4
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr c140
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to addr c120
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c160
  call lpta_storep h_rsi
  set h_rax to answer
  place p2cbfc
  place t2cbfc_14 on 14
  set h_rsi to addr c130
  call forall_to_test h_rsi addr c160
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2cc0e
  place t2cc0e_41 on 41
  set h_rsi to 6
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2cc2b
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p2cc97
  end
  set unwind to 0
  backtrack
  place p2cc6c
  place t2cc6c_6 on 6
  set h_rsi to 4
  call forto_adv_upto_r h_rsi 5 41 1 addr c130 addr c160
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  match
  place p2cc97
  place t2cc97_5 on 5
  set h_rsi to addr c130
  call reset_token_vars h_rsi
  set h_rax to answer
  place p2cca2
  place t2cca2_7 on 7
  set h_rsi to addr c130
  call merge_adjacent_spaces h_rsi
  set h_rax to answer
  place p2ccad
  place t2ccad_8 on 8
  set h_rsi to addr c130
  call space h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2ccc3
  place t2ccc3_9 on 9
  set h_rsi to addr c130
  call process_annotation h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2ccd9
  place t2ccd9_11 on 11
  set h_rsi to addr c130
  call ellipsis h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2ccef
  place t2ccef_12 on 12
  set h_rsi to addr c130
  call three_letter_extension h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2cf20
  end
  place p2cd02
  place t2cd02_13 on 13
  set h_rsi to addr c130
  call interpret_single_char_modes h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cd18
  place t2cd18_15 on 15
  set h_rsi to addr c130
  call tok_lookup h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2cf20
  end
  place p2cd2b
  place t2cd2b_16 on 16
  set h_rsi to addr c130
  call punctuation h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cd41
  place t2cd41_17 on 17
  set h_rsi to addr c130
  call parenthesis h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cd57
  place t2cd57_18 on 18
  set h_rsi to addr c130
  call apostrophe h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cd6d
  place t2cd6d_19 on 19
  set h_rsi to addr c130
  call email_address h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2cf20
  end
  place p2cd80
  place t2cd80_20 on 20
  set h_rsi to addr c130
  call URL h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2cf20
  end
  place p2cd93
  place t2cd93_21 on 21
  set h_rsi to addr c130
  call is_pathname h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2cf20
  end
  place p2cda6
  place t2cda6_22 on 22
  set h_rsi to addr c130
  call letter_sequence h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cdb8
  place t2cdb8_23 on 23
  set h_rsi to addr c130
  call convert_digits_to_words h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cdca
  place t2cdca_24 on 24
  set h_rsi to addr c130
  call hyphen h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cddc
  place t2cddc_25 on 25
  set h_rsi to addr c130
  call slash h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2cdee
  place t2cdee_26 on 26
  set h_rsi to addr c130
  call quote_mark h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2ce00
  place t2ce00_27 on 27
  set h_rsi to addr c130
  call span_inverted_punct h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2ce12
  place t2ce12_28 on 28
  set h_rsi to addr c130
  call bracket h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2ce32
  end
  place p2ce24
  place t2ce24_29 on 29
  set h_rsi to addr c130
  call misc_chars h_rsi addr c100
  set h_rax to answer
  place p2ce32
  place t2ce32_10 on 10
  set h_rsi to addr c130
  call init_ptr_End_reproc_string h_rsi addr c100
  set h_rax to answer
  place p2ce40
  place t2ce40_30 on 30
  set h_rax to global half 1546
  add -10 to h_rax
  set n2ce4a_0 to h_rax
  and 65535 into n2ce4a_0
  if n2ce4a_0 is below 65527
    go to p2ce5e
  end
  place p2ce50
  set h_rsi to addr c130
  call build_words h_rsi addr c100
  set h_rax to answer
  place p2ce5e
  place t2ce5e_31 on 31
  set h_rax to cell c100 value
  set global word 1428 to h_rax
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr g568
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p2cea7
  end
  place p2ce92
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p2cea7
  end
  place p2ce9e
  set global half 1404 to 1
  place p2cea7
  place t2cea7_32 on 32
  set h_rsi to addr c100
  call forced_synthesis h_rsi
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2ceba
  place t2ceba_33 on 33
  if global half 1470 is 0
    go to p2ced2
  end
  place p2cec4
  set h_rsi to addr c130
  call build_phrases h_rsi addr c100
  set h_rax to answer
  place p2ced2
  place t2ced2_34 on 34
  if global half 1404 is 1
    go to p2cf39
  end
  place p2cedc
  place t2cedc_35 on 35
  if global half 1364 is 1
    match
  end
  place p2cee6
  place t2cee6_40 on 40
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to 4
  call forall_cont_from h_rsi 5 0 addr c130 addr c150
  set h_rax to answer
  go to p2cbfc
  place p2cf20
  set h_rsi to 4
  call forall_cont_from h_rsi 5 0 addr c130 addr c130
  set h_rax to answer
  go to p2cbfc
  place p2cf39
  if global half 1360 is 0
    go to p2cf74
  end
  place p2cf43
  place t2cf43_36 on 36
  if global half 1364 is not 0
    match
  end
  place p2cf4d
  set h_rsi to addr c100
  go to p2cf5d
  place p2cf56
  set h_rsi to addr c120
  place p2cf5d
  call handle_end_of_delta h_rsi
  set h_rax to answer
  match
  place p2cf74
  set h_rsi to addr g990
  call create_final_sync h_rsi addr c100
  set h_rax to answer
  match
  place tm_2 on 2
  place tm_4 on 4
  place tm_37 on 37
  place tm_38 on 38
  place tm_39 on 39
  match
end

rule handle_end_of_delta takes 2
  instead
  local cf0 bytes 8
  local h_r14
  local s2d120
  place p2d038
  set h_r14 to arg 1
  place p2d06c
  place p2d0c8
  call get_parm addr cf0 arg 1 -6
  set h_r14 to 0
  call fence 0 sym eti_null
  call starttest 1
  call bspush_ca_boa 2
  call lpta_loadp addr cf0
  call setscan_l 2
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2d11d
  call advance_tok
  set s2d120 to answer
  set h_r14 to 0
  set h_r14 to 0
  if s2d120 is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p2d15e
  place t2d15e_1 on 1
  call create_sentence addr cf0
  match
  place p2d16f
  place t2d16f_2 on 2
  call bspop_boa
  set global half 1420 to 1
  match
  place tm_3 on 3
  match
end

rule reset_token_vars takes 2
  instead
  local ce0 bytes 8
  local h_rax
  place p2d194
  place p2d1c6
  place p2d220
  call get_parm addr ce0 arg 1 -6
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into global half 1838
  set h_rax to 1
  if global half 1842 is 1
    go to p2d272
  end
  place p2d25c
  if global half 1846 is not 1
    go to p2d270
  end
  place p2d266
  if global half 1546 is 0
    go to p2d272
  end
  place p2d270
  set h_rax to 0
  place p2d272
  set global half 1846 to h_rax
  and 0 into global half 1842
  set h_rax to global half 1546
  if h_rax is 0
    go to p2d294
  end
  place p2d28d
  set global half 1542 to h_rax
  place p2d294
  and 0 into global half 1546
  and 0 into global half 1602
  and 0 into global half 1630
  and 0 into global half 1830
  and 0 into global half 1754
  and 0 into global half 1470
  and 0 into global half 1722
  and 0 into global half 1550
  and 0 into global half 1458
  and 0 into global half 1738
  match
end

rule merge_adjacent_spaces takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r12
  local h_r13
  local h_rcx
  local s2d41b
  local s2d453
  place p2d2f8
  place p2d334
  place p2d397
  set h_r13 to addr c120
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  set h_r12 to 0
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c120
  call setscan_l 1
  if answer is 0
    go to p2d407
  end
  match
  place p2d407
  set h_rcx to sym eti_s_ef0d7
  call test_string_s 1 1 h_rcx
  set s2d41b to answer
  set h_r13 to 0
  if s2d41b is not 0
    match
  end
  place p2d42b
  set h_r12 to 0
  place p2d42e
  place t2d42e_2 on 2
  set h_r12 to unwind
  set h_r13 to h_r12
  call savescptr 2 addr c100
  set h_rcx to sym eti_s_ef0d7
  call test_string_s 1 1 h_rcx
  set s2d453 to answer
  set h_rcx to h_r12
  if s2d453 is not 0
    go to p2d4a1
  end
  place p2d45f
  place t2d45f_3 on 3
  set h_r12 to unwind
  call savescptr 3 addr c110
  call starttest_l 1
  call bspush_ca_boa 4
  call lpta_loadp addr c100
  call setscan_l 0
  if answer is 0
    set h_r12 to 1
  end
  set h_rcx to h_r12
  place p2d4a1
  set h_r12 to h_rcx
  set unwind to h_r12
  backtrack
  place p2d4dd
  place t2d4dd_4 on 4
  set h_r12 to unwind
  call bspop_boa
  call lpta_rpta_loadp addr c110 addr c120
  set h_r13 to 0
  set h_rcx to sym eti_s_ef0d7
  call insert_2pt_s 1 1 h_rcx 0
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  match
  place tm_1 on 1
  match
end

rule space takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p2d53c
  place p2d57f
  place p2d5b2
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p2d607
  call test_string_s 1 1 sym eti_s_ef0d7
  if answer is not 0
    give up
  end
  place p2d61f
  call savescptr 2 addr c100
  put cell c100 value into arg 2 at 4
  match
end

rule ellipsis takes 3
  instead
  local c100 bytes 8
  local c118 bytes 8
  local v108 word
  place p2d671
  set v108 to arg 2
  place p2d6b4
  place p2d6e3
  call get_parm addr c118 arg 1 -6
  call get_parm addr c100 arg 2 -6
