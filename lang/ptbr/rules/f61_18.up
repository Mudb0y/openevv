  place p2d8b1
  go to p2d995
  place p2d8b6
  call bspush_ca_scan 7
  place p2d8c1
  place t2d8c1_8 on 8
  call test_string_s 1 1 sym eti_s_ef10e
  if answer is 0
    go to p2d8b6
  end
  place p2d8da
  set unwind to 0
  backtrack
  place p2d8df
  place t2d8df_4 on 4
  call bspush_ca_scan 8
  call test_string_s 1 3 sym eti_s_ef109
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2d907
  go to p2d914
  place p2d909
  call bspush_ca_scan 9
  place p2d914
  place t2d914_10 on 10
  call test_string_s 1 2 sym eti_s_ef10c
  if answer is 0
    go to p2d909
  end
  place p2d929
  set unwind to 0
  backtrack
  place p2d92e
  call bspush_ca_scan 5
  place p2d939
  place t2d939_6 on 6
  call test_string_s 1 1 sym eti_s_ef0de
  if answer is 0
    go to p2d92e
  end
  place p2d952
  set unwind to 0
  backtrack
  place p2d957
  place t2d957_15 on 15
  call build_phrase_final_structure addr c100
  place p2d966
  place t2d966_17 on 17
  set global half 1698 to global half 1702
  place p2d974
  place t2d974_2 on 2
  place t2d974_12 on 12
  place t2d974_13 on 13
  place t2d974_16 on 16
  put cell c100 value into arg 2 at 4
  match
  place p2d995
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p2d974
  end
  place p2d9ab
  call test_string_s 1 1 sym eti_s_ef102
  if answer is not 0
