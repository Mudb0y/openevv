rule three_letter_extension takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local h_r15
  local h_rcx
  local h_rsi
  local s2db5e
  local s2dbb1
  local s2dbcd
  local s2dbf1
  local s2dc23
  local s2dc51
  local s2dc71
  local s2dc8d
  local s2dcad
  local s2dcd8
  local s2dd34
  local s2dd80
  place p2da44
  place p2da80
  place p2dab3
  set h_rsi to addr c100
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c140
  call push_ptr_init h_rsi
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  if global half 1678 is not global half 1674
    give up
  end
  place p2db29
  set h_rsi to 3
  set h_r15 to 0
  place p2db3e
  call starttest h_rsi
  set h_rsi to 4
  call bspush_ca h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 2
  set s2db5e to answer
  set h_rcx to h_r15
  if s2db5e is 0
    go to p2dd07
  end
  place p2db6e
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  place p2dba4
  place t2dba4_4 on 4
  set h_r15 to unwind
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 1
  set s2dbb1 to answer
  set h_rsi to h_r15
  if s2dbb1 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p2dbbd
  set h_rsi to 1
