rule get_number_info takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  place p3ea24
  place p3ea5d
  place p3eab7
  call get_parm addr c100 arg 1 -6
  call get_parm addr cf0 arg 2 -6
  call fence 0 sym eti_null
  if global half 3562 is not global half 3530
    go to p3eb0c
  end
  place p3eafd
  call identify_ordinal addr cf0
  place p3eb0c
  put cell cf0 value into arg 2 at 4
  match
end

rule convert_numbers takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  local h_rcx
  local n3ec49_0
  local n3ec53_0
  place p3eb2b
  place p3eb66
  place p3ebc6
  set h_rcx to -6
  call get_parm addr c110 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c100 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to global half 1830
  if h_rax is not 1
    go to p3ec39
  end
  place p3ec09
  call convert_single_digit addr c110 addr c100
  set h_rax to answer
  place p3ec1f
  place t3ec1f_2 on 2
  place t3ec1f_3 on 3
  place t3ec1f_5 on 5
  place t3ec1f_7 on 7
  place t3ec1f_11 on 11
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
  place p3ec39
  place p3ec47
  set h_rcx to h_rax
  set n3ec49_0 to h_rax
  and 65535 into n3ec49_0
  if n3ec49_0 is 2
    go to p3ed2e
  end
  place p3ec53
  set n3ec53_0 to h_rax
  and 65535 into n3ec53_0
  if n3ec53_0 is 3
    go to p3ed13
  end
  place p3ec5d
  place t3ec5d_6 on 6
  call starttest 8
  set h_rax to answer
  call bspush_ca 9
  set h_rax to answer
  if global signed half 1830 is less than 16
    go to p3ecdd
  end
  set unwind to 0
  backtrack
  place p3ecac
  place t3ecac_9 on 9
  set h_rax to global half 3534
  if h_rax is not global half 3530
    set unwind to 0
    backtrack
  end
  place p3ecbc
  if global signed half 1830 is more than 18
    set unwind to 0
    backtrack
  end
  place p3ecc6
  go to p3ecdd
  place p3ecc8
  place t3ecc8_4 on 4
  set h_rax to global half 1830
  go to p3ec53
  place p3ecd1
  place t3ecd1_1 on 1
  set h_rax to global half 1830
  go to p3ec47
  place p3ecdd
  place t3ecdd_10 on 10
  call convert_large_numbers addr c110 addr c100
  set h_rax to answer
  go to p3ec1f
  place p3ecf8
  place t3ecf8_8 on 8
  call spell_out_large_num addr c110 addr c100
  set h_rax to answer
  go to p3ec1f
  place p3ed13
  call convert_hundreds addr c110 addr c100
  set h_rax to answer
  go to p3ec1f
  place p3ed2e
  call convert_double addr c110 addr c100
  set h_rax to answer
  go to p3ec1f
end

rule reset_enum_ptr takes 2
  instead
  local ce0 bytes 8
  place p3ed7c
  place p3edae
  place p3ee04
  call get_parm addr ce0 arg 1 -6
  call fence 0 sym eti_null
  if global half 3562 is not global half 3530
    go to p3ee4f
  end
  place p3ee31
  if global half 1778 is not global half 1754
    go to p3ee4f
  end
  place p3ee41
  set cell ce0 value to global word 4224
  place p3ee4f
  put cell ce0 value into arg 1 at 4
  match
end

rule identify_ordinal takes 2
  instead
  local c100 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local vf0 word
  local v108 word
  local h_r15
  local h_rcx
  local h_rdx
  local h_rsi
  local s3f0fa
  local s3f158
  local s3f1a1
  local s3f1f0
  local s3f22d
  local s3f256
  local s3f2f9
  variable g1768 word 4220
  variable gd10 word 2220
  variable ge10 word 2436
  place p3ee6b
  place p3eea3
  place p3eed2
  set h_rsi to addr c128
  set h_rcx to -6
  set h_rdx to arg 1
  call get_parm h_rsi h_rdx h_rcx
  set h_rsi to addr c118
  call push_ptr_init h_rsi
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  call fence 0 sym eti_null
  if global half 1850 is not 1
    go to p3ef48
  end
  give up
  place p3ef48
  set v108 to addr g1768
  set h_r15 to 0
  set h_rsi to 3
  place p3ef6e
  call starttest h_rsi
  set h_rsi to addr c128
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is 0
    go to p3f0df
  end
  place p3ef90
  place t3ef90_3 on 3
  set h_r15 to unwind
  set h_rsi to addr c128
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    give up
  end
  place p3efaa
  set h_rsi to 1
  set h_rdx to 1
  set h_rcx to sym eti_s_ef16f
  call test_string_s h_rsi h_rdx h_rcx
  if answer is not 0
    give up
  end
  place p3efc7
  place t3efc7_8 on 8
  set h_r15 to unwind
  set h_rsi to 8
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rsi to 9
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
