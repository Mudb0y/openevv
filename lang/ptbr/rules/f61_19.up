  set h_rsi to 1
  set h_rdx to 1
  set h_rcx to sym eti_s_ef16d
  call test_string_s h_rsi h_rdx h_rcx
  set s3f0fa to answer
  set h_rcx to h_r15
  if s3f0fa is not 0
