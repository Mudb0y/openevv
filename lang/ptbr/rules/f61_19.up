  place p3f148
  place t3f148_4 on 4
  set h_r15 to unwind
  set h_rsi to 1
  set h_rdx to 1
  set h_rcx to sym eti_s_ef16e
  call test_string_s h_rsi h_rdx h_rcx
  set s3f158 to answer
  set h_rsi to h_r15
  if s3f158 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3f164
  go to p3f2c3
