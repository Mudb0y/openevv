# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule convert_digits_to_words takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3e11b
  place p3e15a
  place p3e189
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is 0
    go to p3e210
  end
  give up
  place p3e210
  call testFldeq 1 3 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p3e225
  call advance_tok
  if answer is 0
    go to p3e264
  end
  set unwind to 0
  backtrack
  place p3e264
  set global half 1546 to global half 1574
  call convert_lang_digits_to_words addr c110 addr c100
  place p3e288
  place t3e288_2 on 2
  call hyphen_between_nums addr c110 addr c100
  if answer is 0
    go to p3e2b1
  end
  place p3e2a2
  place t3e2a2_3 on 3
  call separate_tokens addr c100
  place p3e2b1
  place t3e2b1_4 on 4
  place t3e2b1_5 on 5
  put cell c100 value into arg 2 at 4
  match
end

rule convert_digits takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3e2d0
  place p3e313
  place p3e342
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call count_digits addr c110 addr c100
  call get_number_info addr c110 addr c100
  call convert_numbers addr c110 addr c100
  call reset_enum_ptr addr c100
  put cell c100 value into arg 2 at 4
  match
end

rule count_digits takes 3
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c128 bytes 8
