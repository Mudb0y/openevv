  call bspush_boa
  go to p3f284
  place p3f09f
  set h_rsi to 10
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rdx to 1
  set h_rcx to sym eti_s_ef170
  call test_string_s h_rsi h_rdx h_rcx
  if answer is not 0
