  place p3e601
  place t3e601_9 on 9
  set h_r13 to unwind
  set h_rsi to 9
  call savescptr h_rsi addr c108
  set h_rax to answer
  place p3e613
  place t3e613_7 on 7
  set h_r13 to unwind
  set h_rsi to addr c128
