    go to p3e663
  end
  place p3e625
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_ef16a
  set h_rax to answer
  if h_rax is not 0
    go to p3e663
  end
  place p3e63e
  set h_rsi to 10
  call starttest_l h_rsi
  set h_rax to answer
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is 0
    go to p3e8c3
  end
  place p3e663
  place t3e663_10 on 10
  set h_r13 to unwind
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p3e6b3
  end
  place p3e675
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_ef16b
  set h_rax to answer
