  end
  place p3e6b3
  place t3e6b3_12 on 12
  set h_r13 to unwind
  set h_rsi to 16
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is 0
    go to p3e6eb
  end
  place p3e6d0
  place t3e6d0_16 on 16
  set h_r13 to unwind
  set h_rsi to addr gb50
  call c_assvar h_rsi
  set h_rax to answer
  increment global half 1830
  go to p3e7d4
  place p3e6eb
  set h_rsi to 17
  place p3e6f0
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  place p3e6f6
  place t3e6f6_14 on 14
  set h_r13 to unwind
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e712
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    set h_r13 to 1
  end
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place p3e728
  place t3e728_3 on 3
  set h_r13 to unwind
  set h_rsi to 5
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rax to global half 3554
  go to p3e743
  place p3e73c
  place t3e73c_5 on 5
  set h_r13 to unwind
  set h_rax to global half 3558
  place p3e743
  set h_rsi to h_r13
  set n3e746_0 to h_rax
  and 65535 into n3e746_0
  if n3e746_0 is not global half 3530
    set unwind to h_rsi
    backtrack
  end
  place p3e753
  go to p3e542
  place p3e758
  place t3e758_11 on 11
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to addr cf0
  go to p3e7cc
  place p3e76c
  place t3e76c_13 on 13
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to 15
  call starttest h_rsi
  set h_rax to answer
  if cell cf0 field is 1
    go to p3e962
  end
  place p3e78d
  place t3e78d_15 on 15
  set h_r13 to unwind
  set h_rsi to addr c128
  call lpta_rpta_loadp h_rsi addr c108
  set h_rax to answer
  set h_rsi to 1
  call insert_2pt_s h_rsi 1 sym eti_s_ef16a 0
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e7c2
  set h_rsi to addr gb64
  place p3e7cc
  call move_i h_rsi 1
  set h_rax to answer
  place p3e7d4
  place t3e7d4_8 on 8
  set h_r13 to unwind
  set h_rsi to 6
  call forall_adv_over_r h_rsi 7 18 1 addr c128
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e7f6
  go to p3e962
  place p3e7fb
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e817
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e82a
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e846
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e859
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e875
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e888
  set h_rsi to 13
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_ef16a
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e8be
  go to p3e6f6
  place p3e8c3
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e8df
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e8f2
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e90e
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e921
  set h_rsi to 1
  call testFldeq h_rsi 3 2
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e93d
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p3e950
  set h_rsi to 11
  go to p3e6f0
  place p3e95a
  place t3e95a_17 on 17
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  place p3e962
  place t3e962_1 on 1
  place t3e962_6 on 6
  set h_r13 to unwind
  set h_rax to global half 1830
  set global half 1834 to h_rax
  if h_rax is not 1
