  end
  place p3f062
  place t3f062_22 on 22
  set h_r15 to unwind
  set h_rsi to 12
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is not 0
    go to p3f30f
  end
  place p3f087
  set h_rsi to 23
