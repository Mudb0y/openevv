  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rax to 0
  if global half 3534 is not global half 3530
    go to p3e545
  end
  place p3e542
  place t3e542_4 on 4
  set h_r13 to unwind
  set h_rax to 1
  place p3e545
  set v110 to addr gb64
  set h_rsi to h_rax
  set unwind to h_rsi
  backtrack
  place p3e595
  place t3e595_2 on 2
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  and 0 into global half 1850
  and 0 into cell cf0 field
  set h_rsi to 6
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call copyvar h_rsi addr c138
  set h_rax to answer
  place p3e5ca
  place t3e5ca_18 on 18
  set h_r13 to unwind
  set h_rsi to 8
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c128
