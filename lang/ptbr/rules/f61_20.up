  call fence h_rsi sym eti_null
  set h_rsi to 1
  call startloop h_rsi
  set h_rsi to addr g578
  set v108 to addr g578
  call lpta_loadpn h_rsi
  set h_rsi to 4
  call lpta_mover h_rsi
  set h_rsi to addr g628
  call lpta_storep h_rsi
  set h_rsi to addr g4d8
  set v100 to addr g4d8
  call lpta_loadpn h_rsi
  set h_rsi to 4
  call lpta_mover h_rsi
  set h_rsi to addr c128
  call lpta_storep h_rsi
  set vf8 to addr g4c8
  set h_r14 to 0
  place p418f0
  place t418f0_14 on 14
  set h_r14 to unwind
  set h_rsi to addr g628
  call forall_to_test h_rsi addr c128
  set s418fd to answer
  set h_rcx to h_r14
  if s418fd is not 0
    go to p4194d
  end
  place p41909
  set h_r14 to h_rcx
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rsi to addr g628
  call lpta_loadp h_rsi
  call setscan_r 4
  if answer is not 0
    go to p4194d
  end
  place p41929
  set h_rsi to 4
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 4
  set h_rcx to 40
  call testFldeq h_rsi 0 h_rcx
  if answer is 0
    set h_r14 to 1
  end
  place p4194d
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place p41989
  place t41989_3 on 3
  set h_r14 to unwind
  set h_rcx to addr c128
  set h_rsi to 1
  set h_rcx to 15
  call forto_adv_upto_r h_rsi 2 h_rcx 4 addr g628 addr c128
  set s419a9 to answer
  set h_rsi to h_r14
  if s419a9 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place p419ba
  place t419ba_4 on 4
  set h_r14 to unwind
  call bspop_boa
  call advance_tok
