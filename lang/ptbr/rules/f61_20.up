  place t419e3_2 on 2
  set h_r14 to unwind
  set h_rsi to addr g628
  call lpta_loadp h_rsi
  call setscan_l 2
  if answer is not 0
    go to p41a56
  end
  place p419f5
  set h_rsi to addr g628
  call lpta_loadpn h_rsi
  set h_rsi to addr g4c8
  call rpta_loadpn h_rsi
  call compare_ptas
