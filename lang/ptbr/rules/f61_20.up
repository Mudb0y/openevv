rule print_between_word_chars takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g4d8 word 716
  place p41c28
  place p41c6b
  place p41c9e
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call print_after_word_chars addr c110 addr c100
  call lpta_loadpn addr c110
  call rpta_loadpn addr g4d8
  call compare_ptas
  if answer is not 0
    go to p41d39
  end
  place p41d1b
  call testneq
  if answer is not 0
    go to p41d39
  end
  place p41d27
  call print_lit 8 sym eti_s_ebc22
  place p41d39
  match
end

