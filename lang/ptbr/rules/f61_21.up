# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule word_level_rules takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable g528 word 756
  variable g538 word 764
  variable gf00 word 2592
  place p43bc0
  place p43bff
  place p43c62
  call get_parm addr c120 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call push_ptr_init addr c130
  call push_ptr_init addr c110
  call fence 0 sym eti_null
  call startloop 1
  call lpta_loadpn addr c120
  call lpta_mover 2
  call lpta_storep addr g528
  call lpta_loadpn addr c100
  call lpta_mover 2
  call lpta_storep addr c130
  call forall_to_test addr g528 addr c130
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p43d37
  go to p43d3e
  place p43d3e
  place t43d3e_8 on 8
  call bspush_ca 3
  call lpta_loadp addr g528
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p43d5f
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p43d6f
  place t43d6f_4 on 4
  call savescptr 4 addr g538
  place p43d81
  place t43d81_2 on 2
  call is_spr addr g528 addr c110
  if answer is not 0
    go to p43da0
  end
  place p43d97
  set global half 2594 to 1
  place p43da0
  place t43da0_5 on 5
  call starttest 6
  if global half 3562 is not global half 3530
    go to p43dd8
  end
  place p43dbb
  call starttest_e 7
  call por_symbolic_rules addr g528 addr g538
  place p43dd8
  place t43dd8_6 on 6
  place t43dd8_7 on 7
  call move_i addr gf00 0
  place p43de9
  place t43de9_3 on 3
  call forto_adv_upto_r 1 2 8 2 addr g528 addr c130
  if answer is 0
    go to p43e3c
  end
  set unwind to 0
  backtrack
  place p43e3c
  place t43e3c_1 on 1
  set cell c120 value to cell c100 value
  put cell c100 value into arg 1 at 4
  match
end

rule phrase_level_rules takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p43e80
  place p43ec3
  place p43ef2
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call fence 0 sym eti_null
  call lang_phrase_level_rules addr c100 addr c110
  call copy_stress_to_phones addr c100 addr c110
  set cell c100 value to cell c110 value
  put cell c110 value into arg 1 at 4
  match
end

rule copy_stress_to_phones takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  place p43fa0
  place p43fdb
  place p4403f
  call get_parm addr c158 arg 1 -6
  call get_parm addr c138 arg 2 -6
  and 0 into cell c128 half 0
  set c128 to -65529
  set cell cf0 kind to 65532
  call push_ptr_init addr c100
  call push_ptr_init addr c110
  call push_ptr_init addr c148
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  call startloop 1
  call lpta_loadpn addr c158
  call lpta_mover 7
  call lpta_storep addr c100
  call lpta_loadpn addr c138
  call lpta_mover 7
  call lpta_storep addr c148
  call forall_to_test addr c100 addr c148
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p44142
  go to p44149
  place p44149
  place t44149_5 on 5
  call bspush_ca 3
  call lpta_loadp addr c100
  call setscan_r 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p4416e
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p4417e
  call savetok addr c128
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p44195
  place t44195_4 on 4
  call savescptr 4 addr c110
  place p441a7
  place t441a7_2 on 2
  and 0 into cell c128 field
  call copyvar addr cf0 addr c128
  call lpta_rpta_loadp addr c100 addr c110
  call mark_v 4 8 addr cf0 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p441f3
  place t441f3_3 on 3
  call forto_adv_upto_r 1 2 5 7 addr c100 addr c148
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_1 on 1
  match
end

rule build_words takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  place p4426c
  place p442a7
  place p44307
  call get_parm addr c140 arg 1 -6
  call get_parm addr c120 arg 2 -6
  call push_ptr_init addr c100
  call push_ptr_init addr c110
  call push_ptr_init addr c130
  call fence 0 sym eti_null
  if global half 2594 is not 1
    go to p4440c
  end
  place p44381
  set cell c100 value to cell c140 value
  call starttest_l 2
  call lpta_loadp addr c100
  call setscan_r 4
  if answer is not 0
    go to p443e9
  end
  place p443b0
  place t443b0_4 on 4
  go to p443c1
  place p443b6
  call bspush_ca_scan 3
  place p443c1
  call advance_tok
  if answer is 0
    go to p443b6
  end
  place p443cd
  go to p444f7
  place p443d7
  place t443d7_3 on 3
  call savescptr 3 addr c110
  place p443e9
  place t443e9_2 on 2
  call insert_word addr c100 addr c110
  place p443ff
  place t443ff_5 on 5
  and 0 into global half 2594
  go to p44589
  place p4440c
  place t4440c_1 on 1
  call fence 1 sym eti_s_ef1bc
  call lpta_loadp addr c120
  call addfence 2
  if global half 3554 is global half 3530
    go to p44564
  end
  place p44457
  call startloop 7
  call lpta_loadpn addr c140
  call lpta_mover 1
  call lpta_storep addr c100
  call lpta_loadpn addr c120
  call lpta_mover 1
  call lpta_storep addr c130
  place p444b8
  place t444b8_13 on 13
  call forall_to_test addr c100 addr c130
  if answer is not 0
    go to p444f7
  end
  place p444d2
  place t444d2_14 on 14
  call bspush_ca 9
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is 0
    go to p445a7
  end
  place p444f7
  set unwind to 0
  backtrack
  place p4453c
  place t4453c_9 on 9
  call forto_adv_upto_r 7 8 14 1 addr c100 addr c130
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p44564
  place t44564_7 on 7
  call lpta_loadp addr c120
  call remfence 2
  place p44589
  place t44589_6 on 6
  call reset_word_vals addr c120
  match
  place p445a7
  place t445a7_11 on 11
  place p445b3
  call testFldeq 1 3 1
  if answer is not 0
    go to p444f7
  end
  place p445cc
  call advance_tok
  if answer is not 0
    go to p444f7
  end
  place p445dc
  call bspush_ca_scan 10
  go to p445b3
  place p445e9
  place t445e9_10 on 10
  call savescptr 10 addr c110
  place p445fb
  place t445fb_8 on 8
  call insert_word addr c100 addr c110
  place p44611
  place t44611_12 on 12
  call forall_cont_from 7 8 0 addr c100 addr c110
  go to p444b8
  place tm_15 on 15
  match
end

rule insert_word takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r14
  local s447de
  variable ge10 word 2436
  variable ge30 word 2456
  place p44670
  set h_r14 to arg 2
  place p446ab
  place p4470b
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call push_ptr_init addr c120
  set h_r14 to 0
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr c100 addr c110
  call insert_2ptv 2 addr ge10 0
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p4478a
  call lpta_rpta_loadp addr c100 addr c110
  set h_r14 to 0
  call insert_2ptv 6 addr ge30 0
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p447bc
  call starttest 1
  call bspush_ca_boa 2
  call lpta_loadp addr c100
  call setscan_l 0
  set s447de to answer
  set h_r14 to 0
  set h_r14 to 0
  if s447de is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p44824
  place t44824_2 on 2
  call bspop_boa
  call rpta_loadp addr c100
  call lpta_loadpn addr c100
  set h_r14 to 0
  call lpta_ctxtl 0
  call lpta_storep addr c120
  call lpta_loadp addr c120
  call proj_r 0
  place p4489a
  place t4489a_1 on 1
  call lpta_loadp addr c100
  set h_r14 to 6
  call proj_def_mult 6 sym eti_s_ef1bd addr c100
  call lpta_loadp addr c110
  call proj_def_mult 6 sym eti_s_ef1c3 addr c110
  call init_word
  match
  place tm_3 on 3
  match
end

rule reset_word_vals takes 2
