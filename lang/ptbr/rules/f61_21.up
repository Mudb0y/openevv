  set h_rax to global half 3546
  place p44ca5
  set n44ca5_0 to h_rax
  and 65535 into n44ca5_0
  if n44ca5_0 is not global half 3530
    set unwind to 0
    backtrack
  end
  place p44cb2
  place t44cb2_4 on 4
  set cell c118 field to 10
  call npush_v addr c118
  set h_rax to answer
  set global half 2438 to 10
  call npop addr ge10
  set h_rax to answer
  place p44ce9
  place t44ce9_2 on 2
  set h_rax to global half 3562
  if h_rax is not global half 3530
    go to p44d30
  end
  place p44cf9
  set cell c118 field to 1
  call npush_v addr c118
  set h_rax to answer
  set global half 2438 to 1
  call npop addr ge10
  set h_rax to answer
  place p44d30
  place t44d30_7 on 7
  call starttest 8
  set h_rax to answer
  call bspush_ca 9
  set h_rax to answer
  set h_rax to global half 3562
  place p44d4d
  set n44d4d_0 to h_rax
  and 65535 into n44d4d_0
  if n44d4d_0 is global half 3530
    go to p44dc8
  end
  set unwind to 0
  backtrack
  place p44d85
  place t44d85_3 on 3
  call bspush_ca 5
  set h_rax to answer
  set h_rax to global half 3550
  go to p44ca5
  place p44d9c
  place t44d9c_5 on 5
  call bspush_ca 6
  set h_rax to answer
  set h_rax to global half 3562
  go to p44ca5
  place p44db3
  place t44db3_6 on 6
  set h_rax to global half 3538
  go to p44ca5
  place p44dbf
  place t44dbf_9 on 9
  set h_rax to global half 3534
  go to p44d4d
  place p44dc8
  place t44dc8_10 on 10
  set cell c118 field to 3
  call npush_v addr c118
  set h_rax to answer
  set global half 2438 to 3
  call npop addr ge10
  set h_rax to answer
  match
  place tm_8 on 8
  match
end

rule estimate_nsylls takes 4
  instead
  local cf0 bytes 8
