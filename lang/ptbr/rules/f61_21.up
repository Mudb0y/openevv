  set h_rax to answer
  set h_rax to global half 3550
  go to p449f4
  place p44aa2
  place t44aa2_4 on 4
  call bspush_ca 5
  set h_rax to answer
  set h_rax to global half 3562
  go to p449f4
  place p44ab9
  place t44ab9_5 on 5
  set h_rax to global half 3538
  go to p449f4
  place p44ac5
  place t44ac5_7 on 7
  set h_rax to global half 3562
  go to p44a4d
  place p44ad1
  place t44ad1_8 on 8
  set global half 2510 to 1
  call npush_v addr ge70
  set h_rax to answer
  set global half 2438 to 1
  call npop addr ge10
  set h_rax to answer
