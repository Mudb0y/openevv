  place p450ba
  call lpta_loadp addr c100
  call setscan_r 7
  set h_rax to answer
  if h_rax is not 0
    go to p451d1
  end
  place p450d4
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p451d1
  end
  place p450e4
  call startloop 7
  set h_rax to answer
  call lpta_loadpn addr c100
  set h_rax to answer
  call lpta_mover 7
  set h_rax to answer
  call lpta_storep addr c110
  set h_rax to answer
  call lpta_loadpn addr c128
  set h_rax to answer
  call lpta_mover 7
  set h_rax to answer
  call lpta_storep addr c188
  set h_rax to answer
  call forall_to_test addr c110 addr c188
