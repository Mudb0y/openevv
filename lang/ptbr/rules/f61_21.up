  set h_rax to global half 3554
  if h_rax is not global half 3530
    go to p44fca
  end
  place p44fb0
  place t44fb0_2 on 2
  set h_rax to cell cf0 field
  put h_rax into arg 3 at 2 half
  match
  place p44fca
  place p44fd1
  place t44fd1_1 on 1
  and 0 into cell cf0 field
  call startloop 2
  set h_rax to answer
  call lpta_loadpn addr c178
  set h_rax to answer
  call lpta_mover 2
  set h_rax to answer
  call lpta_storep addr c100
  set h_rax to answer
  call lpta_loadpn addr c168
  set h_rax to answer
  call lpta_mover 2
  set h_rax to answer
  call lpta_storep addr c138
  set h_rax to answer
