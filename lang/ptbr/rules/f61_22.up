# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule token_to_number takes 3
  instead
  local cf0 bytes 8
  local c110 bytes 10
  local c128 bytes 10
  local h_rax
  place p4542c
  place p4546b
  place p454ce
  set c110 to through arg 1 word 0
  set cell c110 word 0 to through arg 1 word 4
  set cell c110 half 4 to through arg 1 half 8
  set c110 to -65535
  call get_parm addr cf0 arg 2 -4
  set h_rax to answer
  and 0 into cell c128 word 0
  and 0 into cell c128 half 4
  set c128 to -65535
  call fence 0 sym eti_null
  set h_rax to answer
  call starttest 1
  set h_rax to answer
  call settvar_s addr c128 53
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is 0
    go to p4577a
  end
  place p4555d
  set unwind to 0
  backtrack
  place p455a0
  place t455a0_1 on 1
  call starttest 3
  set h_rax to answer
  call settvar_s addr c128 54
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p455cb
  go to p457a3
  place p455d0
  place t455d0_3 on 3
  call starttest 4
  set h_rax to answer
  call settvar_s addr c128 55
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p455ff
  go to p457b2
  place p45604
  place t45604_4 on 4
  call starttest 5
  set h_rax to answer
  call settvar_s addr c128 56
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45633
  go to p457c1
  place p45638
  place t45638_5 on 5
  call starttest 6
  set h_rax to answer
  call settvar_s addr c128 57
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45667
  go to p457d0
  place p4566c
  place t4566c_6 on 6
  call starttest 7
  set h_rax to answer
  call settvar_s addr c128 58
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4569b
  go to p457df
  place p456a0
  place t456a0_7 on 7
  call starttest 8
  set h_rax to answer
  call settvar_s addr c128 59
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p456cf
  go to p457ee
  place p456d4
  place t456d4_8 on 8
  call starttest 9
  set h_rax to answer
  call settvar_s addr c128 60
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45703
  go to p457fd
  place p45708
  place t45708_9 on 9
  call starttest 10
  set h_rax to answer
  call settvar_s addr c128 61
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45737
  go to p4580f
  place p4573c
  place t4573c_10 on 10
  call starttest 11
  set h_rax to answer
  call settvar_s addr c128 62
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4576b
  set cell cf0 field to 9
  set h_rax to 9
  go to p45784
  place p4577a
  and 0 into cell cf0 field
  set h_rax to 0
  place p45784
  put h_rax into arg 2 at 2 half
  match
  place p4579a
  place t4579a_2 on 2
  set h_rax to cell cf0 field
  go to p45784
  place p457a3
  set cell cf0 field to 1
  set h_rax to 1
  go to p45784
  place p457b2
  set cell cf0 field to 2
  set h_rax to 2
  go to p45784
  place p457c1
  set cell cf0 field to 3
  set h_rax to 3
  go to p45784
  place p457d0
  set cell cf0 field to 4
  set h_rax to 4
  go to p45784
  place p457df
  set cell cf0 field to 5
  set h_rax to 5
  go to p45784
  place p457ee
  set cell cf0 field to 6
  set h_rax to 6
  go to p45784
  place p457fd
  set cell cf0 field to 7
  set h_rax to 7
  go to p45784
  place p4580f
  set cell cf0 field to 8
  set h_rax to 8
  go to p45784
end

rule string_to_short takes 4
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local v100 word
  local h_r15
  local h_rax
  local h_rcx
  local scratch
  place p45850
  set v100 to arg 3
  place p45892
  place p458f2
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c110 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf4 arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr cf0
  set cell cf0 kind to 65532
  call push_ptr_init addr c130
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cf0 field
  and 0 into cell cf4 field
  set h_rax to addr c110
  set h_rax to cell c110 value
  set cell c130 value to h_rax
  call startloop 1
  set h_rax to answer
  set h_r15 to 1
  place p459a2
  place t459a2_6 on 6
  call bspush_ca 1
  set h_rax to answer
  call lpta_loadpn addr c130
  set h_rax to answer
  call rpta_loadpn addr c120
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p459d3
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p45a0d
  end
  set unwind to 0
  backtrack
  place p45a0d
  place t45a0d_2 on 2
  call token_to_digit addr c130 addr cf0
  set h_rax to answer
  place p45a1f
  place t45a1f_3 on 3
  set h_rax to h_r15
  multiply cell cf0 field into h_rax
  add h_rax to cell cf4 field
  set h_rax to h_r15
  set scratch to h_rax
  multiply 10 into scratch
  set h_rax to scratch
  set h_r15 to h_rax
  call lpta_loadp addr c130
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45a71
  end
  place p45a4c
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r15
  if h_rax is not 0
    go to p45a71
  end
  place p45a5b
  go to p45a60
  place p45a5d
  place t45a5d_5 on 5
  set h_rcx to h_r15
  place p45a60
  set h_r15 to h_rcx
  call savescptr 5 addr c130
  set h_rax to answer
  place p45a71
  place t45a71_4 on 4
  call while_iterate 1 2
  set h_rax to answer
  go to p459a2
  place p45a84
  place t45a84_1 on 1
  set h_rax to cell cf4 field
  set h_rcx to arg 3
  put h_rax into arg 3 at 2 half
  match
end

rule token_to_digit takes 3
  instead
  local c100 bytes 8
  local c104 bytes 8
  local h_rax
  place p45ac4
  place p45b07
  place p45b3a
  call get_parm addr c100 arg 1 -6
  set h_rax to answer
  call get_parm addr c104 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45ba6
  end
  place p45b8a
  call test_string_s 1 1 sym eti_s_ef1c9
  set h_rax to answer
  if h_rax is 0
    go to p45d66
  end
  place p45ba6
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45bd8
  end
  place p45bbc
  call test_string_s 1 1 sym eti_s_ef1ca
  set h_rax to answer
  if h_rax is 0
    go to p45d6a
  end
  place p45bd8
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45c0a
  end
  place p45bee
  call test_string_s 1 1 sym eti_s_ef1cb
  set h_rax to answer
  if h_rax is 0
    go to p45d70
  end
  place p45c0a
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45c3c
  end
  place p45c20
  call test_string_s 1 1 sym eti_s_ef1cc
  set h_rax to answer
  if h_rax is 0
    go to p45d76
  end
  place p45c3c
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45c6e
  end
  place p45c52
  call test_string_s 1 1 sym eti_s_ef1cd
  set h_rax to answer
  if h_rax is 0
    go to p45d7c
  end
  place p45c6e
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45ca0
  end
  place p45c84
  call test_string_s 1 1 sym eti_s_ef1ce
  set h_rax to answer
  if h_rax is 0
    go to p45d82
  end
  place p45ca0
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45cd2
  end
  place p45cb6
  call test_string_s 1 1 sym eti_s_ef1cf
  set h_rax to answer
  if h_rax is 0
    go to p45d88
  end
  place p45cd2
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45d04
  end
  place p45ce8
  call test_string_s 1 1 sym eti_s_ef1d0
  set h_rax to answer
  if h_rax is 0
    go to p45d8e
  end
  place p45d04
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45d32
  end
  place p45d1a
  call test_string_s 1 1 sym eti_s_ef1d1
  set h_rax to answer
  if h_rax is 0
    go to p45d94
  end
  place p45d32
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p45d48
  call test_string_s 1 1 sym eti_s_ef1d2
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p45d60
  set h_rax to 9
  go to p45d98
  place p45d66
  set h_rax to 0
  go to p45d98
  place p45d6a
  set h_rax to 1
  go to p45d98
  place p45d70
  set h_rax to 2
  go to p45d98
  place p45d76
  set h_rax to 3
  go to p45d98
  place p45d7c
  set h_rax to 4
  go to p45d98
  place p45d82
  set h_rax to 5
  go to p45d98
  place p45d88
  set h_rax to 6
  go to p45d98
  place p45d8e
  set h_rax to 7
  go to p45d98
  place p45d94
  set h_rax to 8
  place p45d98
  set cell c104 field to h_rax
  put h_rax into arg 2 at 2 half
  match
end

rule string_to_number takes 4
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local vf8 word
  local h_r15
  local h_rax
  local h_rcx
  local scratch
  place p45ddc
  set vf8 to arg 3
  place p45e1e
  place p45e7e
  set h_rcx to -6
  call get_parm addr c128 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c118 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -3
  call get_parm addr c108 arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr cf0
  set cell cf0 kind to 65532
  call push_ptr_init addr c138
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cf0 field
  set cell c108 value to 0
  set h_rax to addr c118
  set h_rax to cell c118 value
  set cell c138 value to h_rax
  call startloop 1
  set h_rax to answer
  set h_r15 to 1
  place p45f2b
  place t45f2b_6 on 6
  call bspush_ca 1
  set h_rax to answer
  call lpta_loadpn addr c138
  set h_rax to answer
  call rpta_loadpn addr c128
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p45f5c
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p45f96
  end
  set unwind to 0
  backtrack
  place p45f96
  place t45f96_2 on 2
  call token_to_digit addr c138 addr cf0
  set h_rax to answer
  place p45fa8
  place t45fa8_3 on 3
  set h_rax to cell cf0 field
  multiply h_r15 into h_rax
  add h_rax to cell c108 value
  set scratch to h_r15
  multiply 10 into scratch
  set h_r15 to scratch
  call lpta_loadp addr c138
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p45ff6
  end
  place p45fd1
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r15
  if h_rax is not 0
    go to p45ff6
  end
  place p45fe0
  go to p45fe5
  place p45fe2
  place t45fe2_5 on 5
  set h_rcx to h_r15
  place p45fe5
  set h_r15 to h_rcx
  call savescptr 5 addr c138
  set h_rax to answer
  place p45ff6
  place t45ff6_4 on 4
  call while_iterate 1 2
  set h_rax to answer
  go to p45f2b
  place p46009
  place t46009_1 on 1
  set h_rax to cell c108 value
  set h_rcx to arg 3
  put h_rax into arg 3 at 4
  match
end

rule absval takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rcx
  place p46048
  place p4608b
  place p460ba
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  call fence 0 sym eti_null
  set h_rcx to cell cf4 field
  negate h_rcx
  if h_rcx is less than 0
    set h_rcx to cell cf4 field
  end
  set cell cf0 field to h_rcx
  put h_rcx into arg 2 at 2 half
  match
end

rule find_last_syll takes 4
  instead
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local vf8 word
  local v100 word
  local h_r12
  local h_r13
  local h_r14
  local h_rcx
  local h_rsi
  local s46271
  local s4630e
  local s4631d
  local s46336
  local s463ba
  place p46154
  set v100 to arg 3
  set vf8 to arg 2
  set h_r12 to arg 1
  place p4619a
  place p461fa
  set h_r14 to addr c130
  set h_r13 to -6
  set h_rsi to addr c130
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c110
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rsi to addr c120
  set h_rcx to -6
  call get_parm h_rsi arg 3 h_rcx
  set h_r12 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_l 4
  set s46271 to answer
  set h_rcx to 0
  if s46271 is not 0
    go to p4635f
  end
  place p46281
  go to p46288
  place p46288
  set h_r14 to h_rcx
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rsi to 3
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 4
  set h_rcx to 2
  call testFldeq h_rsi 1 h_rcx
  if answer is 0
    set h_r14 to 1
  end
  set h_rcx to h_r14
  place p462bf
  set h_r12 to 1
  set h_r14 to 2
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place p46302
  place t46302_2 on 2
  set h_r13 to unwind
  set h_rsi to 4
  set h_rcx to 2
  call testFldeq h_rsi 1 h_rcx
  set s4630e to answer
  set h_rsi to h_r13
  if s4630e is not 0
    set unwind to h_rsi
    backtrack
  end
  place p4631a
  call advance_tok
  set s4631d to answer
  set h_rsi to h_r13
  if s4631d is not 0
    set unwind to h_rsi
    backtrack
  end
  place p46329
  go to p4634a
  place p4632b
  place t4632b_3 on 3
  set h_r13 to unwind
  call bspop_boa
  call advance_tok
  set s46336 to answer
  set h_rcx to h_r13
  set h_rsi to h_r13
  if s46336 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p46345
  go to p46288
  place p4634a
  place t4634a_5 on 5
  set h_r13 to unwind
  set h_rsi to 5
  call savescptr h_rsi addr c110
  place p4635c
  place t4635c_1 on 1
  set h_r13 to unwind
  set h_r12 to h_r13
  place p4635f
  set h_r14 to h_r12
  set h_rsi to 6
  call starttest h_rsi
  call lpta_loadp addr c110
  set h_rsi to 7
  call lpta_tstctxtl h_rsi
  if answer is not 0
    go to p463dc
  end
  place p46396
  set h_rsi to 7
  call setscan_r h_rsi
  if answer is not 0
    go to p463dc
  end
  place p463a5
  set h_rsi to 7
  call savescptr h_rsi addr c110
  call advance_tok
  set s463ba to answer
  set h_rcx to h_r14
  if s463ba is not 0
    go to p462bf
  end
  place p463ca
  place t463ca_8 on 8
  set h_r13 to unwind
  set h_rsi to 8
  call savescptr h_rsi addr c120
  place p463dc
  place t463dc_6 on 6
  set h_r13 to unwind
  set h_rcx to arg 2
  put cell c110 value into arg 2 at 4
  set h_rcx to arg 3
  put cell c120 value into arg 3 at 4
  match
  place p4640f
  place t4640f_4 on 4
  set h_r13 to unwind
  set h_rcx to h_r13
  go to p46288
  place p46417
  place t46417_7 on 7
  set h_r13 to unwind
  set h_r14 to h_r13
  go to p463a5
end

rule get_numRootSylls takes 5
  instead
  local cf0 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local vf8 word
  local v100 word
  place p4643c
  place p46488
  place p464c0
  call get_parm addr c140 arg 1 -6
  call get_parm addr c130 arg 2 -6
  set vf8 to arg 3
  call get_parm addr cf0 arg 3 -4
  set v100 to arg 4
  call get_parm addr c110 arg 4 -6
  call push_ptr_init addr c120
  call push_ptr_init addr c160
  call push_ptr_init addr c150
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  call find_last_syll addr c130 addr c120 addr c110
  place p4659b
  place t4659b_1 on 1
  call startloop 2
  call copyvar addr c160 addr c140
  call copyvar addr c150 addr c110
  call forall_to_test addr c160 addr c150
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p465dc
  place t465dc_5 on 5
  call bspush_ca 4
  call lpta_loadp addr c160
  call setscan_r 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p465f9
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p46605
  place t46605_3 on 3
  call c_assvar addr cf0
  increment cell cf0 field
  place p4661b
  place t4661b_4 on 4
  call forto_adv_r 2 3 5 7 addr c160 addr c150
  if answer is 0
    go to p4666e
  end
  set unwind to 0
  backtrack
  place p4666e
  place t4666e_2 on 2
  put cell cf0 field into arg 3 at 2 half
  put cell c110 value into arg 4 at 4
  match
end

rule mark_syll_stress takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  place p466dc
  place p46722
  place p46755
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr cf0 arg 3 -4
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr c110 addr c100
  call mark_v 7 0 addr cf0 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p467dd
  call lpta_rpta_loadp addr c110 addr c100
  call mark_v 4 8 addr cf0 0
