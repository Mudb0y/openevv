# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule set_por_global_constants takes 1
  instead
  place p4ec0b
  place p4ec42
  place p4ec71
  call fence 0 sym eti_null
  set global half 4174 to 3
  set global half 4178 to 9
  set global half 2100 to 3
  set global half 2104 to 2
  set global half 2092 to 5
  set global half 4194 to 1
  set global half 4198 to 2
  and 0 into global half 4202
  set global half 4206 to 1
  set global half 4166 to 9
  set global half 4170 to 10
  match
end

rule init_por_vars takes 1
  instead
  variable gc30 word 2030
  variable gc50 word 2044
  place p4ed0a
  place p4ed45
  place p4ed78
  call fence 0 sym eti_null
  set global half 3530 to global half 3562
  call npush_s 1
  set global half 2046 to 2
  call npop addr gc50
  call npush_s 1
  set global half 2046 to 3
  call npop addr gc50
  call npush_s 1
  set global half 2046 to 4
  call npop addr gc50
  call npush_s 5
  set global half 2032 to 2
  call npop addr gc30
  match
end

rule reset_por_sent_vars takes 1
  instead
  place p4ee4f
  place p4ee82
  place p4eeb1
  call fence 0 sym eti_null
  match
end

