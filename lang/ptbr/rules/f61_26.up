  shift right 16 into n66c8e_0
  if n66c8e_0 is at most 0
    go to p66737
  end
  place p66c97
  add h_rax to h_rcx
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 5000 over 10000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3178 to h_rax
  or -1 into global half 3182
  go to p66737
  place p66cbd
  call modulate_nas_AV
  set h_rax to answer
  place p66cc5
  place t66cc5_23 on 23
  set h_r15 to unwind
  set h_rsi to addr g658
  set h_rdx to 4
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p66cdb
  set h_rcx to sym eti_s_eff91
  set h_rsi to 4
  set h_rdx to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    match
  end
  place p66cf4
  set h_rax to global half 2986
  add -4 to h_rax
  set global half 3058 to h_rax
  match
  place tm_25 on 25
  match
end

rule do_por_voice_bar takes 1
  instead
  place p66d80
  place p66db3
  place p66de2
  call fence 0 sym eti_null
  set global half 2986 to 45
  set global half 2998 to 35
  match
end
