  end
  place p5b068
  set global half 3058 to 45
  go to p5b132
  place p5b076
  place p5b08c
  place t5b08c_2 on 2
  call savescptr 2 addr c100
  set h_rax to answer
  call testFldeq 4 1 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b0af
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b0bb
  call lpta_loadp addr c100
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b0cd
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b0d9
  call testFldeq 4 1 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p5b0ee
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p5b161
  end
  set unwind to 0
  backtrack
  place p5b129
  place t5b129_1 on 1
  set h_rax to 57
  go to p5b019
  place p5b132
  place t5b132_5 on 5
  set h_rax to global half 550
  set n5b139_0 to h_rax
  shift left 16 into n5b139_0
  shift right 16 into n5b139_0
  if n5b139_0 is at least global signed half 530
    match
  end
  place p5b142
  add -10 to global half 3146
  add -10 to global half 3098
  match
  place p5b161
  set h_rax to 62
  go to p5b019
  place tm_6 on 6
  match
end

