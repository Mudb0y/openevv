# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule find_por_nucleus takes 1
  instead
  local vf8 word
  variable g300 word 420
  variable g320 word 436
  variable g330 word 444
  place p6d470
  place p6d4a9
  place p6d50c
  call fence 0 sym eti_null
  call fence 1 sym eti_s_eff9d
  call starttest 1
  call lpta_loadp addr g300
  call setscan_r 4
  if answer is not 0
    match
  end
  place p6d554
  set vf8 to addr g320
  place p6d570
  place t6d570_2 on 2
  call bspush_ca_scan 3
  call bspush_ca_scan 4
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6d592
  place t6d592_4 on 4
  call savescptr 4 addr g320
  call testFldeq 4 1 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6d5b9
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6d5c5
  call bspush_ca_scan 5
  call testFldeq 4 4 6
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6d5e4
  call advance_tok
  if answer is 0
    go to p6d630
  end
  set unwind to 0
  backtrack
  place p6d61f
  place t6d61f_3 on 3
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6d62b
  go to p6d570
  place p6d630
  place t6d630_5 on 5
  call savescptr 5 addr g330
  match
  place tm_1 on 1
  match
end

rule assign_por_nuc_durs takes 1
  instead
  place p6d664
  place p6d69b
  place p6d6ca
  call fence 0 sym eti_null
  set global word 3608 to -10000
  set global word 3600 to -10000
  set global word 3592 to -10000
  call assign_por_start_dur
  call adjust_for_glides
  call context_adjust
  call word_stress_adjust
  call word_syll_adjust
  call shorten_weak_syllables
  call phrase_word_final_dur
  call adjust_single_word
  call distribute_nucdur
  match
end

