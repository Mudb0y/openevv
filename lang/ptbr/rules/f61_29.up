# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule get_por_nas_tilt_amp takes 1
  instead
  local h_rax
  local h_rcx
  local h_xmm0
  local scratch
  variable g628 word 884
  place p7603b
  place p7606e
  go to p760ce
  place p7609d
  place t7609d_4 on 4
  place t7609d_5 on 5
  set h_rcx to 94
  give up
  place p760ce
  call fence 0 sym eti_null
  call starttest 1
  set h_rax to answer
  call lpta_loadp addr g628
  call setscan_r 4
  set h_rax to answer
  set h_rcx to 0
  if h_rax is not 0
    match
  end
  place p760f9
  call bspush_ca_scan 2
  set h_rax to answer
  set h_rcx to 35
  go to p7610c
  place t7610c_2 on 2
  set h_rcx to 37
  place p7610c
  call testFldeq 4 0 h_rcx
  set h_rax to answer
  if h_rax is 0
    go to p7614f
  end
  set unwind to 0
  backtrack
  place p7614f
  place t7614f_3 on 3
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p7615b
  set h_rax to global signed half 3154
  set scratch to h_rax
  multiply 8 into scratch
  add h_rax to scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  add 100000 to h_xmm0
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 2998 to h_rax
  set global half 3122 to 1
  place p7618d
  place t7618d_1 on 1
  set h_rcx to 0
  match
end

