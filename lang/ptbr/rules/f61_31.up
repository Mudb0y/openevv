# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule mark_por_funct_words takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p839a8
  place p839e7
  place p83a16
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call mark_determiners addr c110 addr c100
  if answer is 0
    match
  end
  give up
end

rule mark_determiners takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  variable gbec word 1984
  place p83aa7
  place p83aea
  place p83b1d
  call get_parm addr c110 arg 1 -6
  set h_rax to answer
  call get_parm addr c100 arg 2 -6
  set h_rax to answer
  set cf0 to 65532
  call fence 0 sym eti_null
  set h_rax to answer
  call lpta_rpta_loadp addr c110 addr c100
  set h_rax to answer
  call setd_lookup 1 1
  set h_rax to answer
  if h_rax is not 0
    go to p83bd4
  end
  place p83b8c
  call lpta_rpta_loadp addr c110 addr c100
  set h_rax to answer
  call mark_s 2 2 3 0
  set h_rax to answer
  if h_rax is not 0
    go to p83bd4
  end
  place p83bb9
  call mark_s 2 3 3 0
  set h_rax to answer
  if h_rax is 0
    go to p83c90
  end
  place p83bd4
  call lpta_rpta_loadp addr c110 addr c100
  set h_rax to answer
  call setd_lookup 1 2
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p83bfc
  call lpta_rpta_loadp addr c110 addr c100
  set h_rax to answer
  call mark_s 2 1 9 0
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p83c2a
  call mark_s 2 2 1 0
  set h_rax to answer
  if h_rax is 0
    go to p83c75
  end
  give up
  place p83c75
  call mark_s 2 3 1 0
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p83c90
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p83cbe
  end
  place p83ca6
  call test_string_s 1 1 sym eti_s_effe9
  set h_rax to answer
  if h_rax is 0
    go to p83d06
  end
  place p83cbe
  set h_rax to global half 1954
  place p83cc5
  set cell cf0 field to h_rax
  call mark_number addr c110 addr c100 addr cf0
  set h_rax to answer
  call mark_word_stress addr c110 addr gbec
  set h_rax to answer
  match
  place p83d06
  set h_rax to global half 1958
  go to p83cc5
end

rule mark_number takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  local n83e4e_1
  place p83d14
  place p83d52
  place p83db2
  call get_parm addr c110 arg 1 -6
  set h_rax to answer
  call get_parm addr c100 arg 2 -6
  set h_rax to answer
  call get_parm addr cf0 arg 3 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to cell cf0 field
  if global half 1954 is not cell cf0 field
    go to p83e4e
  end
  place p83e19
  call lpta_rpta_loadp addr c110 addr c100
  set h_rax to answer
  call mark_s 2 4 1 0
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p83e47
  set h_rax to cell cf0 field
  place p83e4e
  set n83e4e_1 to h_rax
  and 65535 into n83e4e_1
  if global half 1958 is not n83e4e_1
    match
  end
  place p83e57
  call lpta_rpta_loadp addr c110 addr c100
  set h_rax to answer
  call mark_s 2 4 2 0
  set h_rax to answer
  match
end

