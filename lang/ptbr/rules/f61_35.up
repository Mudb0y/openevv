  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c168 bytes 10
  local c180 bytes 10
  local c190 bytes 8
  local h_rax
  local h_rcx
  local s9dc67
  variable gd10 word 2220
  place p9d890
  place p9d8cf
  place p9d902
