  set h_rax to answer
  if h_rax is 0
    go to p9da0f
  end
  give up
  place p9da0f
  call bspush_ca_scan 2
  set h_rax to answer
  set h_rcx to 2
  call testFldeq 1 3 h_rcx
  set h_rax to answer
