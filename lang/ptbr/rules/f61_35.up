# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule convert_por_digits_to_words takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p9ce50
  place p9ce8f
  place p9cef2
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call convert_por_time addr c110 addr c100
  if answer is 0
    go to p9d08e
  end
  place p9cf4e
  place p9cf59
  place t9cf59_1 on 1
  call convert_por_date addr c110 addr c100
  if answer is 0
    go to p9d08e
  end
  place p9cf77
  place t9cf77_3 on 3
  call starttest 4
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    go to p9d00b
  end
  place p9cf98
  call test_string_s 1 1 sym eti_s_f0140
  if answer is not 0
    go to p9d00b
  end
  place p9cfb1
  place t9cfb1_6 on 6
  call bspush_ca_scan 5
  call testFldeq 1 3 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p9cfd1
  call advance_tok
  if answer is 0
    go to p9cfb1
  end
  set unwind to 0
  backtrack
  place p9d00b
  place t9d00b_4 on 4
  call convert_digits addr c110 addr c100
  go to p9d04a
  place p9d023
  place t9d023_5 on 5
  call savescptr 5 addr c100
  call single_chars addr c110 addr c100
  place p9d04a
  place t9d04a_2 on 2
  place t9d04a_7 on 7
  if global half 1778 is global half 1754
    go to p9d086
  end
  place p9d05a
  place t9d05a_8 on 8
  call add_por_point_digits addr c100 addr c100
  if answer is 0
    go to p9d086
  end
  place p9d070
  place t9d070_10 on 10
  call process_por_fraction addr c100 addr c100
  if answer is not 0
    go to p9d08e
  end
  place p9d086
  place t9d086_9 on 9
  and 0 into global half 1842
  place p9d08e
  place t9d08e_11 on 11
  put cell c100 value into arg 2 at 4
  match
end

