  call get_parm addr c150 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c120 arg 2 h_rcx
  set h_rax to answer
  and 0 into cell c180 word 0
  and 0 into cell c180 half 4
  set c180 to -65535
  call push_ptr_init addr c100
  set h_rax to answer
  call push_ptr_init addr c140
  set h_rax to answer
  call push_ptr_init addr c130
  set h_rax to answer
  call push_ptr_init addr c110
  set h_rax to answer
  call push_ptr_init addr c190
  set h_rax to answer
  and 0 into cell c168 word 0
  and 0 into cell c168 half 4
  set c168 to -65535
  call fence 0 sym eti_null
  set h_rax to answer
  call starttest 1
  set h_rax to answer
