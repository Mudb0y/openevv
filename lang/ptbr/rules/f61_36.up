# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule adjust_phones takes 5
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  place pa5b44
  place pa5b8f
  place pa5bc2
  call get_parm addr c130 arg 1 -6
  call get_parm addr c160 arg 2 -6
  call get_parm addr c120 arg 3 -6
  call get_parm addr c150 arg 4 -6
  call push_ptr_init addr c100
  call push_ptr_init addr c140
  call push_ptr_init addr c110
  call fence 0 sym eti_null
  if global half 1306 is not global half 2594
    go to pa5ca0
  end
  place pa5c69
  place ta5c69_10 on 10
  give up
  place pa5ca0
  place pa5caf
  place ta5caf_1 on 1
  call mid_vowel_lowering addr c130 addr c160 addr c120 addr c150
  place pa5cd3
  place ta5cd3_2 on 2
  call startloop 3
  call lpta_loadpn addr c120
  call lpta_movel 4
  call lpta_storep addr c140
  call lpta_loadpn addr c130
  call lpta_movel 4
  call lpta_storep addr c110
  call forall_to_test addr c140 addr c110
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa5d55
  place ta5d55_9 on 9
  call bspush_ca 5
  call lpta_loadp addr c140
  call setscan_l 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa5d76
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa5d86
  place ta5d86_6 on 6
  call savescptr 6 addr c100
  place pa5d98
  place ta5d98_4 on 4
  call starttest 7
  call gliding addr c100 addr c140
  if answer is 0
    go to pa5df7
  end
  place pa5db9
  place ta5db9_7 on 7
  call starttest 5
  call vowel_epenthesis addr c100 addr c140
  if answer is not 0
    go to pa5df7
  end
  place pa5dda
  call starttest_l 8
  call affrication addr c100 addr c140
  place pa5df7
  place ta5df7_5 on 5
  place ta5df7_8 on 8
  call forto_adv_upto_l 3 4 9 4 addr c140 addr c110
  if answer is 0
    go to pa5e58
  end
  set unwind to 0
  backtrack
  place pa5e58
  match
  place tm_3 on 3
  match
end

