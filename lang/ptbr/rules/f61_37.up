rule b_rules takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place paaf1c
  place paaf5b
  place paafbe
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr c100 addr c110
  call insert_2pt_s 4 1 sym eti_s_f03f6 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
end

