  place pb0e08
  set h_rsi to 10
  call savescptr h_rsi addr c128
  set h_rax to answer
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r14
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  go to pb0e2d
  place tb0e2d_11 on 11
  set h_r14 to unwind
  place pb0e2d
  set h_rsi to 11
  call savescptr h_rsi addr c138
  set h_rax to answer
  set h_rsi to addr c138
  call lpta_rpta_loadp h_rsi addr c128
  set h_rax to answer
  set h_rsi to 5
  set h_rcx to 0
  call mark_s h_rsi 3 h_rcx 0
  set h_rax to answer
  set h_rsi to h_r14
  if h_rax is not 0
