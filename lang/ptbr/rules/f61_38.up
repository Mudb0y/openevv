rule por_said_phrase takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local h_rcx
  local h_rdx
  variable g598 word 812
  place pb14b4
  place pb14f2
  place pb1552
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c150 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c140 h_rdx h_rcx
  set h_rcx to -4
  set h_rdx to arg 3
  call get_parm addr cf0 h_rdx h_rcx
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  call push_ptr_init addr c130
  call push_ptr_init addr c120
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_f0448
  call fence 1 h_rdx
  if global half 1478 is not cell cf0 field
    go to pb163f
  end
  place pb1605
  call lpta_loadpn addr c140
  call rpta_loadpn addr g598
  call compare_ptas
  if answer is not 0
    go to pb163f
  end
  place pb162f
  call testneq
  if answer is 0
    give up
