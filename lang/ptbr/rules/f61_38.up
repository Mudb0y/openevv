# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule por_non_phrasal_comma takes 2
  instead
  local c100 bytes 8
  local h_r12
  local h_r15
  local h_rcx
  local h_rsi
  local sb0874
  local sb093a
  local sb094d
  local sb096d
  local sb0986
  local sb09a6
  place pb0750
  place pb078c
  place pb07bb
  set h_r12 to addr c100
  set h_rcx to -6
  set h_rsi to addr c100
  call get_parm h_rsi arg 1 h_rcx
  set h_r15 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r 2
  if answer is 0
    go to pb0839
  end
  give up
  place pb0839
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rsi to 2
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  if answer is not 0
    go to pb0884
  end
  place pb085d
  set h_rsi to 3
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 2
  set h_rcx to 23
  call testFldeq h_rsi 3 h_rcx
  set sb0874 to answer
  set h_r15 to 0
  set h_r15 to 0
  if sb0874 is 0
    set h_r15 to 1
  end
  place pb0884
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  place pb08c5
  place tb08c5_2 on 2
  set h_r12 to unwind
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  set h_rsi to 2
  set h_rcx to 4
  go to pb0939
  place pb08dd
  place tb08dd_3 on 3
  set h_r12 to unwind
  call bspop_boa
  set h_rsi to 4
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 2
  set h_rcx to 28
  call testFldeq h_rsi 3 h_rcx
  if answer is 0
    set h_r12 to 1
  end
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place pb090c
  place tb090c_4 on 4
  set h_r12 to unwind
  call bspop_boa
  go to pb094a
  place pb0916
  place tb0916_6 on 6
  set h_r12 to unwind
  set h_rsi to 7
  call bspush_ca_scan h_rsi
  set h_rsi to 2
  set h_rcx to 5
  go to pb0939
  place pb092e
  place tb092e_7 on 7
  set h_r12 to unwind
  set h_rsi to 2
  set h_rcx to 6
  place pb0939
  call testFldeq h_rsi 3 h_rcx
  set sb093a to answer
  set h_rsi to h_r12
  if sb093a is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb094a
  place tb094a_5 on 5
  set h_r12 to unwind
  call advance_tok
  set sb094d to answer
  set h_rsi to h_r12
  if sb094d is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb095d
  place tb095d_8 on 8
  set h_r12 to unwind
  set h_rsi to 8
  set h_rcx to sym eti_s_f0448
  call test_synch h_rsi 1 h_rcx
  set sb096d to answer
  set h_rsi to h_r12
  if sb096d is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb097d
  place tb097d_9 on 9
  set h_r12 to unwind
  set h_rsi to 9
  call chstream h_rsi 1
  set sb0986 to answer
  set h_rsi to h_r12
  if sb0986 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb0996
  set h_rsi to 1
  set h_rcx to sym eti_s_f0449
  call test_string_s h_rsi 1 h_rcx
  set sb09a6 to answer
  set h_rsi to h_r12
  if sb09a6 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb09b6
  place tb09b6_10 on 10
  set h_r12 to unwind
  call lpta_loadp addr c100
  set h_rsi to 5
  call delete_1pt h_rsi
  match
end

rule por_post_comma_phrase takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g9f0 word 1476
  place pb0a18
  place pb0a53
  place pb0ab7
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call tag_phrase addr c110 addr c100
  if answer is 0
    match
  end
  place pb0b16
  call vocative_phrase addr c110 addr c100
  if answer is 0
    match
  end
  place pb0b34
  call said_phrase addr c110 addr c100 addr g9f0
  if answer is not 0
    give up
  end
  match
end

