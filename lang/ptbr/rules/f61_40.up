  go to pb7122
  place pb710f
  set h_r15 to h_rcx
  set h_rcx to sym eti_s_f0460
  set h_rdx to 2
  place pb7122
  call test_string_s 1 h_rdx h_rcx
  set sb7122 to answer
  set h_r14 to h_r15
  if sb7122 is not 0
    go to pb71a9
  end
  place pb712e
  call starttest 27
