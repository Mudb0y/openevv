# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule strip_suffix takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  place pb625c
  place pb62a2
  place pb62d5
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr c120 arg 3 -6
  call fence 0 sym eti_null
  call strip_mente addr c110 addr c100 addr c120
  if answer is 0
    go to pb6378
  end
  place pb634d
  call strip_plural_suffix addr c100 addr c120
  call strip_diminutive addr c110 addr c100
  place pb6378
  put cell c100 value into arg 2 at 4
  match
end

rule strip_mente takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r13
  local h_rax
  local h_rcx
  local sb655b
  place pb63bb
  place pb63fd
  place pb6430
  set h_r13 to -6
  set h_rcx to -6
  call get_parm addr c110 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c100 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c120 arg 3 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call fence 1 sym eti_s_f044d
  set h_rax to answer
  call starttest 1
  set h_rax to answer
  call lpta_loadp addr c120
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place pb64ba
  set h_rcx to sym eti_s_f044e
  call test_string_s 1 5 h_rcx
  set h_rax to answer
  if h_rax is 0
    go to pb6504
  end
  give up
  place pb6504
  set h_r13 to 0
  place pb6518
  call savescptr 2 addr c100
  set h_rax to answer
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to h_r13
    backtrack
  end
  place pb652c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to h_r13
    backtrack
  end
  place pb6538
  call starttest 3
  set h_rax to answer
  call bspush_ca_boa 4
  set h_rax to answer
  call lpta_loadp addr c100
  call setscan_l 1
  set sb655b to answer
  set h_rax to sb655b
  go to pb656e
  place pb6562
  place tb6562_2 on 2
  set h_r13 to unwind
  go to pb6518
  place pb656e
  set h_rcx to h_r13
  if h_rax is not 0
    set unwind to h_r13
    backtrack
  end
  place pb6575
  set h_r13 to h_rcx
  call bspush_ca_scan 6
  set h_rax to answer
  set h_rcx to 1
  call testFldeq 1 4 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to h_r13
    backtrack
  end
  place pb6598
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    set h_r13 to 1
  end
  set unwind to h_r13
  backtrack
  place pb65d9
  place tb65d9_6 on 6
  set h_r13 to unwind
  call advance_tok
  set h_rax to answer
  go to pb656e
  place pb65e3
  place tb65e3_5 on 5
  set h_r13 to unwind
  set h_rcx to h_r13
  go to pb6575
  place pb65e8
  place tb65e8_3 on 3
  set h_r13 to unwind
  call one_syllable addr c110 addr c100
  set h_rax to answer
  if h_rax is 0
    give up
  end
  place pb6606
  place tb6606_7 on 7
  set h_r13 to unwind
  set h_rcx to addr c110
  call suffixes addr c100 addr c120 h_rcx
  set h_rax to answer
  place pb6623
  place tb6623_8 on 8
  set h_r13 to unwind
  call restore_antepenult_accent addr c110 addr c100
  set h_rax to answer
  place pb6639
  place tb6639_9 on 9
  place tb6639_10 on 10
  set h_r13 to unwind
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
  place pb6653
  place tb6653_4 on 4
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  give up
end

rule strip_plural_suffix takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local h_rcx
  local h_rdx
  place pb668c
  place pb66cb
  place pb672e
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c100 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c110 h_rdx h_rcx
  set cell c128 byte 0 to 0
  set c128 to -65533
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_f044d
  call fence 1 h_rdx
  set h_rdx to 1
  call lpta_loadp addr c100
  call setscan_l h_rdx
  if answer is 0
    go to pb67b2
  end
  give up
  place pb67b2
  set h_rcx to sym eti_s_f0459
  set h_rdx to 1
  call test_string_s 1 h_rdx h_rcx
  if answer is 0
    go to pb67d5
  end
  give up
  place pb67d5
  place pb67dc
  place tb67dc_2 on 2
  set h_rdx to addr c100
  call savescptr 2 h_rdx
  call starttest 3
  set h_rdx to 1
  call lpta_loadp addr c100
  call setscan_l h_rdx
  if answer is not 0
    go to pb68f3
  end
  place pb6819
  set h_rdx to 1
  set h_rcx to sym eti_s_f044d
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    go to pb68f3
  end
  place pb6836
  place tb6836_4 on 4
  set h_rdx to addr c100
  call savescptr 4 h_rdx
  call bspush_ca_scan 5
  set h_rdx to 1
  set h_rcx to sym eti_s_f045a
  place pb6863
  call test_string_s 1 h_rdx h_rcx
  if answer is 0
    go to pb68aa
  end
  set unwind to 0
  backtrack
  place pb689c
  place tb689c_5 on 5
  set h_rdx to 1
  set h_rcx to sym eti_s_f045b
  go to pb6863
  place pb68aa
  place tb68aa_6 on 6
  set h_rdx to 4
  set h_rcx to 1
  call testFldeq 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb68bf
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb68cb
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 2
  set h_rcx to sym eti_s_f045c
  go to pb6919
  place pb68f3
  place tb68f3_3 on 3
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to sym eti_s_f045e
  place pb6919
  call insert_2pt_s 4 h_rdx h_rcx 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb6929
  place tb6929_7 on 7
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 3
  call settvar_s addr c128 h_rdx
  set h_rdx to addr c128
  set h_rcx to 0
  call insert_2ptv 3 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb6978
  increment global half 4182
  put cell c100 value into arg 1 at 4
  match
end

rule strip_diminutive takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r12
  local h_r15
  local h_rcx
  local sb6af1
  local sb6b1b
  local sb6b80
  local sb6c13
  local sb6c27
  place pb69b0
  set h_r15 to arg 1
  place pb69ef
  place pb6a22
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  set h_r12 to addr c100
  set h_rcx to -6
  call get_parm addr c100 arg 2 h_rcx
  call push_ptr_init addr c110
  set h_r15 to 0
  call fence 0 sym eti_null
  call fence 1 sym eti_s_f044d
  call starttest 1
  call lpta_loadp addr c100
  call setscan_l 1
  if answer is 0
    go to pb6ad7
  end
  give up
  place pb6ad7
  call bspush_ca_scan 2
  set h_rcx to sym eti_s_f0453
  call test_string_s 1 1 h_rcx
  set sb6af1 to answer
  set h_rcx to 0
  if sb6af1 is not 0
    go to pb6bc4
  end
  place pb6b01
  go to pb6b08
  place pb6b08
  set h_r15 to h_rcx
  set h_rcx to sym eti_s_f0455
  call test_string_s 1 4 h_rcx
  set sb6b1b to answer
  set h_rcx to h_r15
  if sb6b1b is not 0
    go to pb6bc4
  end
  place pb6b2b
  go to pb6b30
  place pb6b2d
  place tb6b2d_4 on 4
  set h_r15 to unwind
  set h_rcx to h_r15
  place pb6b30
  set h_r15 to h_rcx
  call savescptr 4 addr c110
  call advance_tok
  if answer is not 0
    go to pb6bc4
  end
  place pb6b51
  call advance_tok
  if answer is not 0
    go to pb6bc4
  end
  place pb6b5d
  call starttest 5
  call bspush_ca_boa 6
  call lpta_loadp addr c100
  call setscan_l 1
  set sb6b80 to answer
  set h_rcx to h_r15
  if sb6b80 is not 0
    go to pb6bc4
  end
  place pb6b8c
  set h_r12 to h_rcx
  call bspush_ca_scan 8
  set h_r15 to 1
  set h_rcx to 1
  call testFldeq 1 4 h_rcx
  if answer is not 0
    go to pb6bc1
  end
  place pb6bb3
  call advance_tok
  if answer is 0
    set h_r12 to 1
  end
  place pb6bc1
  set h_r15 to h_r12
  place pb6bc4
  set h_r12 to 1
  set unwind to h_r15
  backtrack
  place pb6c03
  place tb6c03_2 on 2
  set h_r15 to unwind
  set h_rcx to sym eti_s_f0454
  call test_string_s 1 1 h_rcx
  set sb6c13 to answer
  set h_rcx to h_r15
  if sb6c13 is not 0
    set unwind to h_r15
    backtrack
  end
  place pb6c1f
  go to pb6b08
  place pb6c24
  place tb6c24_8 on 8
  set h_r15 to unwind
  call advance_tok
  set sb6c27 to answer
  set h_rcx to h_r15
  if sb6c27 is not 0
    set unwind to h_r15
    backtrack
  end
  place pb6c33
  go to pb6b8c
  place pb6c38
  place tb6c38_3 on 3
  set h_r15 to unwind
  set h_rcx to h_r15
  go to pb6b08
  place pb6c40
  place tb6c40_5 on 5
  set h_r15 to unwind
  set h_rcx to addr c120
  call suffixes addr c110 addr c100 h_rcx
  place pb6c5d
  place tb6c5d_9 on 9
  set h_r15 to unwind
  set cell c100 value to cell c110 value
  call restore_final_accent addr c120 addr c100
  if answer is 0
    go to pb6c98
  end
  place pb6c82
  place tb6c82_10 on 10
  set h_r15 to unwind
  call restore_antepenult_accent addr c120 addr c100
  place pb6c98
  place tb6c98_11 on 11
  place tb6c98_12 on 12
  set h_r15 to unwind
  put cell c100 value into arg 2 at 4
  match
  place pb6cb2
  place tb6cb2_6 on 6
  set h_r15 to unwind
  call bspop_boa
  give up
  place pb6cbf
  place tb6cbf_7 on 7
  set h_r15 to unwind
  set h_rcx to h_r15
  go to pb6b8c
end

rule restore_antepenult_accent takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local h_r12
  local h_r14
  local h_r15
  local h_rcx
  local h_rdx
  local sb6e10
  local sb6e5a
  local sb6ea6
  local sb6edc
  local sb6f15
  local sb6f60
  local sb7018
  local sb7047
  local sb7079
  local sb70a5
  local sb7122
  local sb7199
  local nb7139_1
  place pb6cf4
  set h_r15 to arg 2
  set h_r14 to arg 1
  place pb6d2d
  place pb6d8b
  set h_r12 to -6
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c130 h_rdx h_rcx
  set h_r14 to addr c120
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c120 h_rdx h_rcx
  call push_ptr_init addr c110
  call push_ptr_init addr cf0
  call push_ptr_init addr c100
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_f044d
  set h_r15 to 1
  call fence 1 h_rdx
  set sb6e10 to global half 4194
  set h_r12 to sb6e10
  call starttest 1
  set h_rdx to 1
  call lpta_loadp addr c120
  call setscan_l h_rdx
  if answer is not 0
    go to pb6e8e
  end
  place pb6e35
  call bspush_ca_scan 2
  call bspush_ca_scan 3
  set h_rcx to sym eti_s_f0454
  set h_rdx to 1
  call test_string_s 1 h_rdx h_rcx
  set sb6e5a to answer
  set h_rcx to h_r12
  set h_r15 to h_r12
  if sb6e5a is not 0
