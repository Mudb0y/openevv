  end
  place pb6e6d
  go to pb6e74
  place pb6e74
  set h_r12 to h_rcx
  set h_rdx to addr c110
  call savescptr 2 h_rdx
  go to pb6e8e
  place pb6e8b
  place tb6e8b_1 on 1
  set h_r12 to h_r15
  place pb6e8e
  call starttest 4
  set h_rdx to 1
  call lpta_loadp addr c120
  call setscan_l h_rdx
  set sb6ea6 to answer
  set h_r15 to h_r12
  if sb6ea6 is not 0
    give up
  end
  place pb6eb6
  place tb6eb6_5 on 5
  call bspush_ca_scan 6
  set h_rdx to 4
  set h_rcx to 1
  call testFldeq 1 h_rdx h_rcx
  if answer is not 0
    go to pb71a9
  end
  place pb6ed9
  call advance_tok
  set sb6edc to answer
  set h_rcx to h_r15
  if sb6edc is not 0
    go to pb71a9
  end
  place pb6eec
  set h_r15 to h_rcx
  call bspush_ca_scan 8
  set h_rdx to 4
  set h_rcx to 1
  call testFldeq 1 h_rdx h_rcx
  if answer is not 0
    go to pb71a9
  end
  place pb6f12
  call advance_tok
  set sb6f15 to answer
  set h_rcx to h_r15
  if sb6f15 is not 0
    go to pb71a9
  end
  place pb6f25
  set h_r15 to h_rcx
  call bspush_ca_scan 10
  place pb6f33
  place tb6f33_11 on 11
  set h_rdx to addr c100
  call savescptr 11 h_rdx
  set h_rdx to 4
  set h_rcx to 1
  call testFldeq 1 h_rdx h_rcx
  if answer is not 0
    go to pb71a9
  end
  place pb6f5d
  call advance_tok
  set sb6f60 to answer
  set h_r14 to h_r15
  if sb6f60 is not 0
    go to pb71a9
  end
  place pb6f70
  go to pb6f75
  place pb6f72
  place tb6f72_12 on 12
  set h_r14 to h_r15
  place pb6f75
  set h_rdx to addr cf0
  call savescptr 12 h_rdx
  call starttest 13
  set h_rdx to 1
  call lpta_loadp addr c120
  call setscan_l h_rdx
  if answer is 0
