  end
  place pb6fac
  set h_r15 to h_r14
  place pb6faf
  place tb6faf_13 on 13
  call starttest 19
  set h_rdx to 1
  call lpta_loadp addr cf0
  call setscan_r h_rdx
  if answer is 0
    go to pb705f
  end
  place pb6fd4
  place tb6fd4_19 on 19
  call starttest 22
  set h_rdx to 1
  call lpta_loadp addr c120
  call setscan_l h_rdx
  if answer is 0
    go to pb708b
  end
  place pb6ff9
  place tb6ff9_22 on 22
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c130 h_rdx
  set h_rdx to 58
  call setd_lookup 1 h_rdx
  set sb7018 to answer
  set h_r14 to h_r15
  if sb7018 is 0
    go to pb712e
  end
  give up
  place pb702d
  call bspush_ca_scan 14
  set h_rcx to sym eti_s_f0454
  set h_rdx to 1
  call test_string_s 1 h_rdx h_rcx
  set sb7047 to answer
  set h_rcx to h_r14
  set h_r15 to h_r14
  if sb7047 is not 0
