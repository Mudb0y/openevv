# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule print_por_SPR takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_rdx
  place pb76f3
  place pb7736
  place pb7769
  set h_rdx to arg 1
  call get_parm addr c100 h_rdx -6
  set h_rdx to arg 2
  call get_parm addr c110 h_rdx -6
  call fence 0 sym eti_null
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb77d8
  end
  place pb77bb
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0462
  if answer is 0
    go to pb7a31
  end
  place pb77d8
  place tb77d8_1 on 1
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb780b
  end
  place pb77ee
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0463
  if answer is 0
    go to pb7abd
  end
  place pb780b
  place tb780b_3 on 3
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb783e
  end
  place pb7821
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0464
  if answer is 0
    go to pb7ab4
  end
  place pb783e
  place tb783e_4 on 4
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb7871
  end
  place pb7854
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0465
  if answer is 0
    go to pb7aab
  end
  place pb7871
  place tb7871_5 on 5
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb78a4
  end
  place pb7887
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0466
  if answer is 0
    go to pb7aa2
  end
  place pb78a4
  place tb78a4_6 on 6
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb78d7
  end
  place pb78ba
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0467
  if answer is 0
    go to pb7a99
  end
  place pb78d7
  place tb78d7_7 on 7
  call starttest 8
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb792a
  end
  place pb78f8
  set h_rdx to 10
  call testFldeq 4 h_rdx 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb790d
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb7919
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb7925
  go to pb79b5
  place pb792a
  place tb792a_8 on 8
  call starttest 10
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb79d3
  end
  place pb794f
  set h_rdx to 10
  call testFldeq 4 h_rdx 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb7964
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb7970
  call advance_tok
  if answer is 0
    go to pb7a3a
  end
  set unwind to 0
  backtrack
  place pb79b5
  place tb79b5_9 on 9
  set h_rdx to addr c110
  call savescptr 9 h_rdx
  set h_rdx to sym eti_s_ebc5c
  go to pb7a53
  place pb79d3
  place tb79d3_10 on 10
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    go to pb7a02
  end
  place pb79e9
  set h_rdx to 1
  call test_string_s 4 h_rdx sym eti_s_f0468
  if answer is 0
    go to pb7a5e
  end
  place pb7a02
  place tb7a02_12 on 12
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 4
  call print_stream 8 h_rdx 0 sym eti_s_ec48c
  go to pb7a5e
  place pb7a31
  set h_rdx to sym eti_s_ebc3e
  go to pb7a53
  place pb7a3a
  place tb7a3a_11 on 11
  set h_rdx to addr c110
  call savescptr 11 h_rdx
  set h_rdx to sym eti_s_ebc5e
  place pb7a53
  call print_lit 8 h_rdx
  place pb7a5e
  place tb7a5e_2 on 2
  put cell c110 value into arg 2 at 4
  match
  place pb7a99
  set h_rdx to sym eti_s_ebc57
  go to pb7a53
  place pb7aa2
  set h_rdx to sym eti_s_ebc52
  go to pb7a53
  place pb7aab
  set h_rdx to sym eti_s_ebc4d
  go to pb7a53
  place pb7ab4
  set h_rdx to sym eti_s_ebc48
  go to pb7a53
  place pb7abd
  set h_rdx to sym eti_s_ebc43
  go to pb7a53
end

