# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule assign_stress takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_rcx
  place pb90dc
  place pb911f
  place pb9152
  set h_rcx to -6
  call get_parm addr c100 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c110 arg 2 h_rcx
  set cell cf0 kind to 65532
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  set cell cf0 field to 1
  set cell c120 value to cell c110 value
  if global half 2594 is not 1
    go to pb91ea
  end
  place pb91cf
  call assign_user_stress addr c100 addr c110
  match
  place pb91ea
  go to pb91fc
  place tb91fc_1 on 1
  place pb91fc
  if global half 2570 is not 1
    go to pb92ec
  end
  place pb920a
  call starttest 5
  call lpta_loadp addr c100
  call setscan_r 2
  if answer is not 0
    go to pb92c5
  end
  place pb922b
  call npush_fld 2 5
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb923d
  call npush_i 0
  call if_testgt
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb9253
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb925f
  call lpta_rpta_loadp addr c100 addr c110
  set h_rcx to sym eti_s_f8ffe
  place pb9284
  call insert_2pt_i 7 2 h_rcx 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  go to pb92c5
  place tb92c5_5 on 5
  place pb92c5
  call lpta_rpta_loadp addr c100 addr c110
  set h_rcx to sym eti_s_f049c
  go to pb9284
  go to pb92ec
  place tb92ec_4 on 4
  place pb92ec
  call assign_suffix_stress addr c120 addr cf0
  go to pb9302
  place tb9302_7 on 7
  place pb9302
  set h_rcx to addr cf0
  call assign_root_stress addr c100 addr c120 h_rcx
  go to pb931f
  place tb931f_8 on 8
  place pb931f
  if cell cf0 field is not 1
    go to pb933f
  end
  place pb9329
  call assign_secondary_stress addr c100 addr c120
  go to pb933f
  place tb933f_9 on 9
  place pb933f
  call insert_zero_sylls addr c100 addr c110
  match
  place tm_2 on 2
  place tm_3 on 3
  place tm_6 on 6
  match
end

rule assign_suffix_stress takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c110 bytes 8
  local v100 word
  local h_rax
  place pb93b4
  set v100 to arg 2
  place pb93f3
  place pb9453
  call get_parm addr c110 arg 1 -6
  set h_rax to answer
  call get_parm addr cf0 arg 2 -4
  set h_rax to answer
  set cf4 to 65532
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 1306
  if h_rax is not global half 2614
    go to pb95b4
  end
  place pb94b0
  call starttest 2
  set h_rax to answer
  call move_i addr cf4 1
  set h_rax to answer
  call insert_penult_stress addr c110 addr cf4
  set h_rax to answer
  if h_rax is 0
    go to pb951b
  end
  set unwind to 0
  backtrack
  place pb951b
  place tb951b_2 on 2
  call starttest 3
  set h_rax to answer
  call lpta_loadp addr c110
  call setscan_l 3
  set h_rax to answer
  if h_rax is not 0
    go to pb958b
  end
  place pb953c
  place tb953c_5 on 5
  place pb9547
  call testFldeq 3 0 3
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pb955c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pb956c
  call bspush_ca_scan 4
  set h_rax to answer
  go to pb9547
  place pb9579
  place tb9579_4 on 4
  call savescptr 4 addr c110
  set h_rax to answer
  place pb958b
  place tb958b_3 on 3
  if global signed half 2570 is less than 4
    go to pb95a5
  end
  place pb9595
  place tb9595_6 on 6
  set h_rax to global half 590
  if h_rax is not global half 4190
    go to pb95a9
  end
  place pb95a5
  set h_rax to 0
  go to pb95ad
  place pb95a9
  place tb95a9_7 on 7
  set h_rax to 2
  place pb95ad
  set cell cf0 field to h_rax
  place pb95b4
  place tb95b4_1 on 1
  set h_rax to cell c110 value
  put h_rax into arg 1 at 4
  set h_rax to cell cf0 field
  put h_rax into arg 2 at 2 half
  match
end

rule assign_root_stress takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_rcx
  local h_rsi
  place pb9604
  place pb9646
  place pb96a9
  set h_rsi to addr c110
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c100
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rcx to -4
  set h_rsi to addr cf0
  call get_parm h_rsi arg 3 h_rcx
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  if cell cf0 field is 0
    give up
  end
  place pb971b
  place pb9730
  place tb9730_1 on 1
  set h_rsi to addr c110
  call dict_assigned_stress h_rsi
  if answer is 0
    match
  end
  place pb9747
  place tb9747_3 on 3
  set h_rsi to addr c110
  set h_rcx to addr cf0
  call accented_vowel h_rsi addr c100 h_rcx
  if answer is 0
    match
  end
  place pb976c
  place tb976c_4 on 4
  set h_rsi to 5
  call starttest h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 4
  if answer is 0
    go to pb9805
  end
  place pb978d
  place tb978d_5 on 5
  set h_rsi to 8
  call starttest h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 1
  if answer is not 0
    go to pb9996
  end
  place pb97b2
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rsi to 10
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to sym eti_s_f049f
  call test_string_s h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb97e5
  place tb97e5_10 on 10
  set h_rsi to 11
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to sym eti_s_f04a0
  go to pb997e
  place pb9805
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  set h_rsi to 4
  set h_rcx to sym eti_s_f049e
  call test_string_s h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb982d
  place tb982d_6 on 6
  set h_rsi to 6
  call savescptr h_rsi addr c120
  set h_rsi to 4
  set h_rcx to 6
  call testFldeq h_rsi 4 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb9857
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb9863
  set h_rsi to 4
  set h_rcx to 2
  call testFldeq h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb9878
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb9884
  set h_rsi to addr c120
  call lpta_loadp h_rsi
  call setscan_l 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb989a
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi 4 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb98af
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb98bb
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi 4 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb98d0
  call advance_tok
  if answer is 0
    go to pb99be
  end
  set unwind to 0
  backtrack
  place pb990f
  place tb990f_9 on 9
  set h_rsi to 1
  set h_rcx to sym eti_s_f04a4
  call test_string_s h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb9928
  go to pb9963
  place pb992a
  place tb992a_13 on 13
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to sym eti_s_f04a2
  call test_string_s h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb994e
  place tb994e_14 on 14
  place tb994e_16 on 16
  set h_rsi to 1
  set h_rcx to sym eti_s_f04a3
  go to pb997e
  place pb995c
  place tb995c_11 on 11
  set h_rsi to 13
  go to pb9968
  place pb9963
  set h_rsi to 16
  place pb9968
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to sym eti_s_f04a1
  place pb997e
  call test_string_s h_rsi 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb998b
  go to pb99d9
  place pb9996
  place tb9996_8 on 8
  set h_rsi to addr c110
  call lpta_rpta_loadp h_rsi addr c100
  set h_rsi to 1
  call setd_lookup h_rsi 67
  if answer is 0
    go to pb99d9
  end
  place pb99be
  place tb99be_18 on 18
  set h_rsi to addr c100
  call insert_por_final_stress h_rsi addr cf0
  match
  place pb99d9
  place tb99d9_12 on 12
  place tb99d9_15 on 15
  set h_rsi to addr c100
  call insert_por_penult_stress h_rsi addr cf0
  match
  place tm_2 on 2
  place tm_7 on 7
  place tm_17 on 17
  place tm_19 on 19
  match
end

rule assign_secondary_stress takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  place pb9a48
  place pb9a87
  place pb9aba
  call get_parm addr c110 arg 1 -6
  call get_parm addr c120 arg 2 -6
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  if global signed half 4210 is less than 3
    give up
  end
  place pb9b16
  place pb9b2b
  place tb9b2b_1 on 1
  call starttest 2
  call lpta_loadp addr c110
  call setscan_r 7
  if answer is not 0
    go to pb9b62
  end
  place pb9b48
  call advanc
  if answer is not 0
    go to pb9b62
  end
  place pb9b54
  place tb9b54_3 on 3
  call savescptr 3 addr c100
  place pb9b62
  place tb9b62_2 on 2
  call lpta_rpta_loadp addr c110 addr c100
  call insert_2pt_i 7 2 sym eti_s_f04a5 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
end

rule dict_assigned_stress takes 2
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  variable g1758 word 4212
  variable gd10 word 2220
  place pb9bf8
  place pb9c34
  place pb9c97
  call get_parm addr c110 arg 1 -6
  call push_ptr_init addr c100
  set cf0 to 65532
  call fence 0 sym eti_null
  call lpta_loadpn addr g1758
  call rpta_loadpn addr gd10
  call compare_ptas
  if answer is not 0
    go to pb9d13
  end
  place pb9d03
  call testeq
  if answer is 0
    give up
  end
  place pb9d13
  place pb9d28
  place tb9d28_1 on 1
  call lpta_loadp addr g1758
  call setscan_r 4
  if answer is not 0
    go to pb9d54
  end
  place pb9d3a
  call advance_tok
  if answer is not 0
    go to pb9d54
  end
  place pb9d46
  place tb9d46_3 on 3
  call savescptr 3 addr c100
  place pb9d54
  place tb9d54_2 on 2
  call starttest 4
  call move_i addr cf0 1
  call stress_vowel addr c110 addr g1758 addr c100 addr cf0
  if answer is 0
    go to pb9db3
  end
  set unwind to 0
  backtrack
  place pb9db3
  place tb9db3_4 on 4
  set global word 4216 to global word 2224
  match
end

rule accented_vowel takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local h_r13
  local h_rcx
  local sb9fe6
  place pb9de8
  place pb9e2a
  place pb9e5d
  set h_r13 to -6
  set h_rcx to -6
  call get_parm addr c130 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c110 arg 2 h_rcx
  set h_rcx to -4
  call get_parm addr cf0 arg 3 h_rcx
  call push_ptr_init addr c120
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  call fence 1 sym eti_s_f04a3
  if global half 1306 is not global half 2626
    go to pb9f26
  end
  give up
  place pb9f26
  set h_r13 to 0
  place pb9f3a
  call starttest 2
  call lpta_loadp addr c110
  call setscan_l 1
  if answer is not 0
    give up
  end
  place pb9f58
  place tb9f58_3 on 3
  set h_r13 to unwind
  set h_rcx to h_r13
  place pb9f5b
  set h_r13 to h_rcx
  call bspush_ca_scan 4
  place pb9f69
  place tb9f69_5 on 5
  set h_r13 to unwind
  call savescptr 5 addr c100
  set h_rcx to 1
  call testFldeq 1 4 h_rcx
  if answer is not 0
    set unwind to h_r13
    backtrack
  end
  place pb9f90
  call bspush_ca_scan_boa 6
  set h_rcx to 0
  call testFldeq 1 5 h_rcx
  if answer is 0
    set h_r13 to 1
  end
  set unwind to h_r13
  backtrack
  place pb9fe3
  place tb9fe3_4 on 4
  set h_r13 to unwind
  call advance_tok
  set sb9fe6 to answer
  set h_rcx to h_r13
  if sb9fe6 is not 0
    set unwind to h_r13
    backtrack
  end
  place pb9ff2
  go to pb9f5b
  place pb9ff7
  place tb9ff7_6 on 6
  set h_r13 to unwind
  call bspop_boa
  call advance_tok
  if answer is not 0
    set unwind to h_r13
    backtrack
  end
  place pba00b
  go to pba01c
  place pba00d
  place tba00d_1 on 1
  set h_r13 to unwind
  go to pb9f3a
  place pba01c
  place tba01c_7 on 7
  set h_r13 to unwind
  call savescptr 7 addr c120
  set h_rcx to addr c100
  call stress_vowel addr c130 addr c120 h_rcx addr cf0
  match
  place tm_8 on 8
  place tm_9 on 9
  match
end

rule insert_por_final_stress takes 3
  instead
  local ce0 bytes 8
  local cf0 bytes 8
  local h_rax
  place pba08c
  place pba0cd
  place pba0fc
  call get_parm addr cf0 arg 1 -6
  set h_rax to answer
  call get_parm addr ce0 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call insert_final_stress addr cf0 addr ce0
  set h_rax to answer
  set h_rax to global half 2570
  decrement h_rax
  set global half 4210 to h_rax
  match
end

rule insert_por_penult_stress takes 3
  instead
  local ce0 bytes 8
  local cf0 bytes 8
  local h_rax
  place pba195
  place pba1d6
  place pba205
  call get_parm addr cf0 arg 1 -6
  set h_rax to answer
  call get_parm addr ce0 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call insert_penult_stress addr cf0 addr ce0
  set h_rax to answer
  set h_rax to global half 2570
  add -2 to h_rax
  set global half 4210 to h_rax
  match
end

rule stress_vowel takes 5
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  variable g1754 word 4208
  place pba29f
  place pba2e0
  place pba344
  call get_parm addr c160 arg 1 -6
  call get_parm addr c150 arg 2 -6
  call get_parm addr c140 arg 3 -6
  call get_parm addr cf0 arg 4 -4
  call push_ptr_init addr c130
  call push_ptr_init addr c100
  call push_ptr_init addr c120
  call push_ptr_init addr c110
  call fence 0 sym eti_null
  call lpta_loadpn addr c150
  call lpta_ctxtl 7
  call lpta_storep addr c130
  call lpta_rpta_loadp addr c130 addr c140
  call rpta_ctxtr 7
  call insert_2ptv 7 addr cf0 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pba455
  call startloop 1
  call copyvar addr c100 addr c160
  call copyvar addr c110 addr c130
  call forall_to_test addr c100 addr c110
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pba4a8
  go to pba4af
  place pba4af
  place tba4af_5 on 5
  call bspush_ca 3
  call lpta_loadp addr c100
  call setscan_r 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pba4d0
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pba4dc
  place tba4dc_4 on 4
  call savescptr 4 addr c120
  place pba4ee
  place tba4ee_2 on 2
  call c_assvar addr g1754
  increment global half 4210
  place pba504
  place tba504_3 on 3
  call forto_adv_r 1 2 5 7 addr c100 addr c110
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_1 on 1
  match
end
