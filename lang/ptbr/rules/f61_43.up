# The rules of Brazilian Portuguese, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule create_syllables takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local h_rax
  variable gedc word 2568
  place pba5e8
  place pba623
  place pba683
  call get_parm addr c130 arg 1 -6
  set h_rax to answer
  call get_parm addr c110 arg 2 -6
  set h_rax to answer
  call push_ptr_init addr c100
  set h_rax to answer
  call push_ptr_init addr c120
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call startloop 1
  set h_rax to answer
  call lpta_loadpn addr c130
  set h_rax to answer
  call lpta_mover 4
  set h_rax to answer
  call lpta_storep addr c100
  set h_rax to answer
  call lpta_loadpn addr c110
  set h_rax to answer
  call lpta_mover 4
  set h_rax to answer
  call lpta_storep addr c120
  set h_rax to answer
  call forall_to_test addr c100 addr c120
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pba754
  go to pba75b
  place pba75b
  place tba75b_5 on 5
  call bspush_ca 3
  set h_rax to answer
  call lpta_loadp addr c100
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pba77c
  call testFldeq 4 1 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pba791
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pba79d
  place tba79d_2 on 2
  call starttest 4
  set h_rax to answer
  call assign_syll_onset addr c100
  set h_rax to answer
  place pba7b7
  place tba7b7_4 on 4
  call c_assvar addr gedc
  set h_rax to answer
  increment global half 2570
  place pba7cd
  place tba7cd_3 on 3
  call forto_adv_upto_r 1 2 5 4 addr c100 addr c120
  set h_rax to answer
  if h_rax is 0
    go to pba828
  end
  set unwind to 0
  backtrack
  place pba828
  place tba828_1 on 1
  set h_rax to global half 2570
  set global half 4186 to h_rax
  if global half 1306 is not global half 2614
    match
  end
  place pba846
  add -2 to h_rax
  set global half 4186 to h_rax
  match
  place tm_6 on 6
  match
end

