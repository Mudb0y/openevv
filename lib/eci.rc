/* What the library says about itself.
 *
 * Not decoration. A screen reader driver reads ProductName out of here to
 * decide which engine it is talking to: if it sees IBMECI it turns on
 * IBMTTS-specific text fixes, a different pause style and a 22 kHz sample
 * rate. This is the Eloquence engine at 11 kHz, so it says what it is and
 * that driver treats it accordingly. It also raises rather than loading a
 * file with no version information at all, which is the other reason this
 * exists.
 *
 * The Translation block is what makes the rest readable: without a codepage
 * a reader looking for ProductName is told there is none.
 */

#include <windows.h>

/* The release's version, handed in by the build from the tag. A build
   nobody gave one to says nought rather than a number a release once had. */
#ifndef EVV_MAJOR
#define EVV_MAJOR 0
#endif
#ifndef EVV_MINOR
#define EVV_MINOR 0
#endif
#ifndef EVV_PATCH
#define EVV_PATCH 0
#endif
#define EVV_TEXT2(n) #n
#define EVV_TEXT(n)  EVV_TEXT2(n)
#define EVV_VERSION  EVV_TEXT(EVV_MAJOR) "." EVV_TEXT(EVV_MINOR) "." \
                     EVV_TEXT(EVV_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    EVV_MAJOR,EVV_MINOR,EVV_PATCH,0
PRODUCTVERSION EVV_MAJOR,EVV_MINOR,EVV_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenEVV"
            VALUE "FileDescription",  "IBM Embedded ViaVoice rebuilt as portable C"
            VALUE "FileVersion",      EVV_VERSION
            VALUE "InternalName",     "eci"
            VALUE "LegalCopyright",   "MIT for the engine; the language data is IBM's"
            VALUE "OriginalFilename", "eci.dll"
            VALUE "ProductName",      "OpenEVV"
            VALUE "ProductVersion",   EVV_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
