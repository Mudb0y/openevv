/* The settings dialog. It is in the voice, for the Settings button a SAPI
 * host shows, and in the configurator, for everywhere else -- the same
 * template in both, so it is a file of its own that each includes.
 *
 * Every control is an ordinary Win32 control with a mnemonic, and the combo
 * box has its label immediately in front of it in tab order, because that is
 * what a screen reader reads as its name.
 */

#include <windows.h>

#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 260, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP |
      WS_CAPTION | WS_SYSMENU
CAPTION "OpenEVV Voice Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
	CONTROL "Expand &abbreviations", IDC_ABBREVIATIONS, "Button",
	        BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 236, 12

	LTEXT "Shorten &pauses:", IDC_PAUSES_LABEL, 12, 32, 236, 9
	COMBOBOX IDC_PAUSES, 12, 44, 236, 60,
	         CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

	CONTROL "Allow backquote voice &tags", IDC_VOICE_TAGS, "Button",
	        BS_AUTOCHECKBOX | WS_TABSTOP, 12, 66, 236, 12

	CONTROL "Phrase predi&ction", IDC_PHRASE_PREDICTION, "Button",
	        BS_AUTOCHECKBOX | WS_TABSTOP, 12, 84, 236, 12

	LTEXT "", IDC_ABOUT, 12, 104, 236, 18

	DEFPUSHBUTTON "OK", IDOK, 148, 128, 48, 14
	PUSHBUTTON "Cancel", IDCANCEL, 200, 128, 48, 14
END
