/* The voice library's resources: the settings dialog, for the Settings
 * button a SAPI host shows, and a version, which is what Windows shows for
 * the file and what an installer compares when it replaces one.
 */

#include <windows.h>

#include "dialog.rc"

#ifndef EVV_MAJOR
#define EVV_MAJOR 0
#endif
#ifndef EVV_MINOR
#define EVV_MINOR 0
#endif
#ifndef EVV_PATCH
#define EVV_PATCH 0
#endif
#define EVV_TEXT2(n) #n
#define EVV_TEXT(n)  EVV_TEXT2(n)
#define EVV_VERSION  EVV_TEXT(EVV_MAJOR) "." EVV_TEXT(EVV_MINOR) "." \
                     EVV_TEXT(EVV_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    EVV_MAJOR,EVV_MINOR,EVV_PATCH,0
PRODUCTVERSION EVV_MAJOR,EVV_MINOR,EVV_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenEVV"
            VALUE "FileDescription",  "OpenEVV SAPI 5 voice"
            VALUE "FileVersion",      EVV_VERSION
            VALUE "InternalName",     "openevv_sapi5"
            VALUE "LegalCopyright",   "MIT for the voice and the engine; the language data is IBM's"
            VALUE "OriginalFilename", "openevv_sapi5.dll"
            VALUE "ProductName",      "OpenEVV"
            VALUE "ProductVersion",   EVV_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
