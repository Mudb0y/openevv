ssml 6 dbfb9af0560a281d 08ca90ac44fcbbcb <speak version="1.0" xml:lang="es-MX">Costo <say-as interpret-as="cardinal">1234</say-as> el <say-as interpret-as="ordinal">3</say-as>.</speak>
