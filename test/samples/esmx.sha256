ssml 3 dbfb9af0560a281d 08ca90ac44fcbbcb <speak version="1.0" xml:lang="es-MX"><prosody pitch="high" range="x-high" volume="loud">Los cuatro a la vez.</prosody></speak>
ssml 4 dbfb9af0560a281d 08ca90ac44fcbbcb <speak version="1.0" xml:lang="es-MX"><emphasis level="strong">Este</emphasis>, no aquel.</speak>
